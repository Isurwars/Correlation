import { MaterialPalette, MaterialTypography } from "../material/material.slint";

export component AppHeader inherits Rectangle {
    in property <string> title_text: "Correlation";
    in property <string> status_text: "";
    in property <bool> file_loaded: false;
    height: 40px;
    background: MaterialPalette.surface_container;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 8px;
        alignment: space-between;

        HorizontalLayout {
            spacing: 10px;

            Image {
                source: @image-url("../../Images/Logo.png");
                height: 24px;
                width: 24px;
                image-fit: contain;
            }

            Text {
                text: root.title_text;
                font-size: MaterialTypography.title_medium.font_size;
                font-weight: MaterialTypography.title_medium.font_weight;
                color: MaterialPalette.on_surface;
                vertical-alignment: center;
                accessible-role: text;
                accessible-label: "Application Title";
            }
        }

        if root.status_text != "": Text {
            text: root.status_text;
            font-size: MaterialTypography.body_small.font_size;
            color: root.file_loaded ? MaterialPalette.primary : MaterialPalette.outline;
            vertical-alignment: center;
            accessible-role: text;
            accessible-label: "File Status";
        }
    }
}
