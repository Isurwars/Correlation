import { MaterialStyleMetrics, MaterialAnimations, MaterialPalette, MaterialTypography, TooltipTarget } from "../material/material.slint";

export component AppFooter inherits Rectangle {
    in property <string> status_text: "";
    in property <float> progress: 0.0;
    in property <bool> analysis_running: false;
    in property <bool> update_available: false;
    in property <string> update_version: "";
    in property <string> update_url: "https://github.com/Isurwars/Correlation/releases";
    in property <string> backend_label: "";
    in property <bool> gpu_accelerated: false;
    callback open_url(string);
    callback open_command_palette();
    callback open_shortcuts();

    height: 24px;
    background: MaterialPalette.surface_container_lowest;

    property <bool> blink_state: true;
    blink_timer := Timer {
        interval: 800ms;
        running: root.update_available;
        triggered() => {
            root.blink_state = !root.blink_state;
        }
    }

    property <int> elapsed_seconds: 0;
    elapsed_timer := Timer {
        interval: 1000ms;
        running: root.analysis_running;
        triggered() => {
            root.elapsed_seconds += 1;
        }
    }

    changed analysis_running => {
        if root.analysis_running {
            root.elapsed_seconds = 0;
        }
    }

    // Slim progress bar on top edge
    if root.analysis_running: Rectangle {
        y: 0;
        x: 0;
        width: 100%;
        height: 2px;
        background: MaterialPalette.surface_container_high;

        Rectangle {
            x: 0;
            y: 0;
            width: parent.width * Math.min(1.0, Math.max(0.0, root.progress));
            height: 100%;
            background: MaterialPalette.primary;
            animate width {
                duration: MaterialAnimations.base_duration;
                easing: ease-out;
            }
        }
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        alignment: space-between;

        Text {
            text: root.analysis_running ?
                (root.status_text + " (" + Math.floor(root.elapsed_seconds / 60) + "m " + Math.mod(root.elapsed_seconds, 60) + "s)") :
                root.status_text;
            font-size: MaterialTypography.body_small.font_size;
            color: MaterialPalette.on_surface_variant;
            vertical-alignment: center;
            accessible-role: text;
            accessible-label: "Footer Status";
        }

        HorizontalLayout {
            spacing: 6px;
            alignment: center;

            // Compact 3D Render Backend Status Pill
            if root.backend_label != "": Rectangle {
                height: 18px;
                y: (parent.height - self.height) / 2;
                width: backend_row.preferred-width + 12px;
                border-radius: MaterialStyleMetrics.border_radius_4;
                background: MaterialPalette.surface_container_high.with_alpha(65%);

                backend_row := HorizontalLayout {
                    padding-left: 6px;
                    padding-right: 6px;
                    spacing: 5px;
                    alignment: center;

                    Rectangle {
                        width: 6px;
                        height: 6px;
                        y: (parent.height - self.height) / 2;
                        border-radius: 3px;
                        background: root.gpu_accelerated
                            ? MaterialPalette.tertiary
                            : MaterialPalette.on_surface_variant;
                    }

                    Text {
                        text: root.backend_label;
                        font-size: MaterialTypography.label_small.font_size;
                        color: MaterialPalette.on_surface_variant;
                        vertical-alignment: center;
                    }
                }
            }

            if root.update_available: Rectangle {
                background: update_touch.has_hover ? MaterialPalette.primary_container : MaterialPalette.surface_container_high;
                border-radius: MaterialStyleMetrics.border_radius_4;
                height: 20px;
                y: (parent.height - self.height) / 2;
                animate background { duration: MaterialAnimations.base_duration; }

                update_touch := TooltipTarget {
                    mouse-cursor: pointer;
                    tooltip_text: "New release v" + root.update_version + " is available. Click to open GitHub Releases.";
                    clicked => {
                        root.open_url(root.update_url);
                    }
                }

                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 6px;
                    alignment: center;

                    Rectangle {
                        width: 6px;
                        height: 6px;
                        border-radius: 3px;
                        background: MaterialPalette.primary;
                        opacity: root.blink_state ? 1.0 : 0.3;
                        y: (parent.height - self.height) / 2;
                        animate opacity { duration: MaterialAnimations.emphasized_decelerate_duration; easing: ease-in-out; }
                    }

                    Text {
                        text: "New version " + root.update_version + " available — Click to download";
                        font-size: MaterialTypography.label_small.font_size;
                        font-weight: MaterialTypography.label_small.font_weight;
                        color: update_touch.has_hover ? MaterialPalette.primary : MaterialPalette.on_surface_variant;
                        vertical-alignment: center;
                        accessible-role: text;
                        accessible-label: "New Version Notification";
                        animate color { duration: MaterialAnimations.base_duration; }
                    }
                }
            }

            // Command Palette quick trigger
            Rectangle {
                height: 18px;
                y: (parent.height - self.height) / 2;
                width: cmd_lbl.preferred-width + 12px;
                border-radius: MaterialStyleMetrics.border_radius_4;
                background: cmd_touch.has-hover ? MaterialPalette.surface_container_high : transparent;
                animate background { duration: MaterialAnimations.base_duration; }

                cmd_touch := TooltipTarget {
                    mouse-cursor: pointer;
                    tooltip_text: "Open Command Palette (Ctrl+K).";
                    accessible-role: button;
                    accessible-label: "Open Command Palette";
                    clicked => { root.open_command_palette(); }
                }

                cmd_lbl := Text {
                    width: 100%;
                    height: 100%;
                    text: "Ctrl+K Commands";
                    font-size: MaterialTypography.label_small.font_size;
                    color: cmd_touch.has-hover ? MaterialPalette.primary : MaterialPalette.outline;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            // Keyboard Shortcuts quick trigger
            Rectangle {
                height: 18px;
                y: (parent.height - self.height) / 2;
                width: sc_lbl.preferred-width + 12px;
                border-radius: MaterialStyleMetrics.border_radius_4;
                background: sc_touch.has-hover ? MaterialPalette.surface_container_high : transparent;
                animate background { duration: MaterialAnimations.base_duration; }

                sc_touch := TooltipTarget {
                    mouse-cursor: pointer;
                    tooltip_text: "View Keyboard Shortcuts (? or F1).";
                    accessible-role: button;
                    accessible-label: "View Keyboard Shortcuts";
                    clicked => { root.open_shortcuts(); }
                }

                sc_lbl := Text {
                    width: 100%;
                    height: 100%;
                    text: "? Shortcuts";
                    font-size: MaterialTypography.label_small.font_size;
                    color: sc_touch.has-hover ? MaterialPalette.primary : MaterialPalette.outline;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }
}
