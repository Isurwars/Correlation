import {
    MaterialStyleMetrics,
    MaterialTypography,
    MaterialPalette,
    OutlinedCard,
    MaterialText,
    FilledButton,
    Vertical,
    Icons,
    TooltipState,
    TooltipTarget,
} from "../../material/material.slint";

/// Pinned execution footer shared across left configuration panels (Stages 0-2).
export component PinnedExecutionBar inherits Rectangle {
    in property <bool> file_loaded: false;
    in property <bool> analysis_running: false;
    in property <bool> has_validation_errors: false;
    in property <string> validation_summary: "Fix validation errors before running";
    in property <bool> show_advanced_hint: false;
    in property <int> enabled_calculator_count: 0;
    in property <int> total_calculator_count: 0;

    callback run_analysis();
    callback cancel_analysis();
    callback open_advanced_options();

    property <string> run_tooltip_text: root.analysis_running
        ? "Abort the currently executing trajectory analysis."
        : (!root.file_loaded
            ? "Load a structure or trajectory file before running."
            : (root.has_validation_errors
                ? root.validation_summary
                : "Run all selected analyses on the loaded trajectory.\n\n🔬 Computes distribution functions across the selected frame range."));
    property <bool> btn_hovered: run_btn.has_hover;
    changed btn_hovered => {
        if (self.btn_hovered) {
            TooltipState.active = {
                text: root.run_tooltip_text,
                x: run_btn.hover_x,
                y: run_btn.hover_y,
                width: 0px,
                height: 0px,
            };
        } else if (TooltipState.active.text == root.run_tooltip_text) {
            TooltipState.active = { text: "", x: 0px, y: 0px, width: 0px, height: 0px };
        }
    }

    vertical-stretch: 0;
    height: card.preferred-height;

    card := OutlinedCard {
        width: 100%;

        Vertical {
            padding: MaterialStyleMetrics.spacing_8;
            spacing: MaterialStyleMetrics.spacing_4;

            if root.has_validation_errors && !root.analysis_running && root.validation_summary != "": MaterialText {
                text: "⚠ " + root.validation_summary;
                style: MaterialTypography.label_small;
                color: MaterialPalette.error;
                wrap: word-wrap;
                horizontal-alignment: center;
            }

            if root.show_advanced_hint && root.file_loaded && !root.analysis_running: Rectangle {
                width: 100%;
                height: 22px;
                border-radius: MaterialStyleMetrics.border_radius_4;
                background: adv_hint_touch.has-hover ? MaterialPalette.surface_container_high : transparent;

                adv_hint_touch := TooltipTarget {
                    mouse-cursor: pointer;
                    accessible-role: button;
                    accessible-label: "Customize analyses in Advanced Options";
                    tooltip_text: "Open Advanced Options to toggle individual calculators or fine-tune S(Q), XRD, Rings, and Smoothing.";
                    clicked => { root.open_advanced_options(); }

                    MaterialText {
                        width: 100%;
                        height: 100%;
                        text: root.total_calculator_count > 0 ?
                            "Preselected: " + root.enabled_calculator_count + "/" + root.total_calculator_count + " analyses · Customize in Advanced →" :
                            "Preselected analyses · Customize in Advanced →";
                        style: MaterialTypography.label_small;
                        color: adv_hint_touch.has-hover ? MaterialPalette.primary : MaterialPalette.on_surface_variant;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }
                }
            }

            run_btn := FilledButton {
                width: 100%;
                height: MaterialStyleMetrics.size_40;
                icon: root.analysis_running ? Icons.close : Icons.play_arrow;
                text: root.analysis_running ? "Cancel Analysis" : "Run Analysis";
                enabled: root.file_loaded && (root.analysis_running || !root.has_validation_errors);
                background: root.analysis_running ? MaterialPalette.error : MaterialPalette.run;
                text_color: root.analysis_running ? MaterialPalette.on_error : MaterialPalette.on_run;
                clicked => {
                    if (root.analysis_running) {
                        root.cancel_analysis();
                    } else {
                        root.run_analysis();
                    }
                }
            }
        }
    }
}

