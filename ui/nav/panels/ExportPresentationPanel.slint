import {
    MaterialStyleMetrics,
    MaterialPalette,
    ScrollView,
    Vertical,
    MenuItem,
} from "../../material/material.slint";
import {
    ComparisonCurveData,
    ExportConfig,
    ExportFormatOptions,
    ExportAnalysisItem,
    AppErrors,
} from "../../Types.slint";
import { ExportOptionsCard } from "../../cards/export/ExportOptionsCard.slint";
import { ExportSettingsCard } from "../../cards/plot/ExportSettingsCard.slint";
import { ComparisonOverlayCard } from "../../cards/plot/ComparisonOverlayCard.slint";
import { PresetManagerCard } from "../../cards/presets/PresetManagerCard.slint";

/// Modular Host Component for Stage 2: Export, Presentation & Presets
export component ExportPresentationPanel inherits Rectangle {
    in property <bool> enabled: true;
    in property <bool> analysis_done: false;

    // Export formats state
    in-out property <ExportFormatOptions> export_format_options;
    in-out property <[ExportAnalysisItem]> export_analysis_items;
    in-out property <bool> export_all_analyses: true;
    callback toggle_export_analysis(string, bool);
    callback toggle_all_export_analyses(bool);
    callback write_files();
    callback export_structure();
    callback reset_export_options();

    // Plot Export & Visual Styling Configuration
    in-out property <ExportConfig> export_config;
    in property <string> export_font_scale_error: "";
    in property <string> export_line_width_error: "";
    in property <string> export_marker_size_error: "";
    callback reset_export_settings();

    // Multi-Run Comparison state
    in property <[ComparisonCurveData]> comparison_curves: [];
    in property <int> pinned_runs_count: 0;
    in property <bool> show_difference: false;
    callback pin_run();
    callback import_comparison_file();
    callback remove_comparison_curve(int);
    callback toggle_difference_plot(bool);
    callback clear_comparison_curves();

    // Presets state
    in property <[MenuItem]> preset_items: [];
    in-out property <int> selected_preset: -1;
    callback load_preset(int);
    callback save_preset(string);
    callback delete_preset(int);
    callback reset_presets();

    out property <string> hovered_tooltip_text:
        export_card.hovered_tooltip_text != "" ? export_card.hovered_tooltip_text :
        export_settings_card.hovered_tooltip_text != "" ? export_settings_card.hovered_tooltip_text :
        comparison_card.hovered_tooltip_text != "" ? comparison_card.hovered_tooltip_text :
        preset_card.hovered_tooltip_text != "" ? preset_card.hovered_tooltip_text : "";

    out property <length> hovered_x:
        export_card.hovered_tooltip_text != "" ? export_card.hovered_x :
        export_settings_card.hovered_tooltip_text != "" ? export_settings_card.hovered_x :
        comparison_card.hovered_tooltip_text != "" ? comparison_card.hovered_x :
        preset_card.hovered_tooltip_text != "" ? preset_card.hovered_x : 0px;

    out property <length> hovered_y:
        export_card.hovered_tooltip_text != "" ? export_card.hovered_y :
        export_settings_card.hovered_tooltip_text != "" ? export_settings_card.hovered_y :
        comparison_card.hovered_tooltip_text != "" ? comparison_card.hovered_y :
        preset_card.hovered_tooltip_text != "" ? preset_card.hovered_y : 0px;

    out property <length> hovered_width: 0px;
    out property <length> hovered_height: 0px;

    ScrollView {
        width: 100%;
        height: 100%;

        Vertical {
            padding: 0;
            spacing: MaterialStyleMetrics.spacing_8;

            // 1. Data Formats & Write Files Action
            export_card := ExportOptionsCard {
                enabled: root.enabled;
                analysis_done: root.analysis_done;
                format_options <=> root.export_format_options;
                write_files => { root.write_files(); }
                export_structure => { root.export_structure(); }
                reset => { root.reset_export_options(); }
            }

            // 2. Publication Plot Figure Styling
            export_settings_card := ExportSettingsCard {
                expanded: false;
                enabled: root.enabled;
                export_size_preset <=> root.export_config.size_preset;
                export_palette <=> root.export_config.palette;
                export_font_scale <=> root.export_config.font_scale;
                export_line_width <=> root.export_config.line_width;
                export_marker_size <=> root.export_config.marker_size;
                export_show_legend <=> root.export_config.show_legend;
                export_show_grid <=> root.export_config.show_grid;
                export_show_markers <=> root.export_config.show_markers;
                export_fill_area <=> root.export_config.fill_area;
                export_manual_ticks <=> root.export_config.manual_ticks;
                export_x_major_step <=> root.export_config.x_major_step;
                export_y_major_step <=> root.export_config.y_major_step;
                export_minor_subdivisions <=> root.export_config.minor_subdivisions;
                export_font_scale_error: root.export_font_scale_error;
                export_line_width_error: root.export_line_width_error;
                export_marker_size_error: root.export_marker_size_error;
                reset => { root.reset_export_settings(); }
            }

            // 3. Multi-Run Comparison Overlays
            comparison_card := ComparisonOverlayCard {
                expanded: false;
                enabled: root.enabled;
                comparison_curves: root.comparison_curves;
                pinned_runs_count: root.pinned_runs_count;
                show_difference: root.show_difference;
                pin_current_run => { root.pin_run(); }
                import_comparison_file => { root.import_comparison_file(); }
                remove_comparison_curve(id) => { root.remove_comparison_curve(id); }
                toggle_difference_plot(show) => { root.toggle_difference_plot(show); }
                clear_comparison_curves => { root.clear_comparison_curves(); }
            }

            // 4. Parameter & Workflow Presets
            preset_card := PresetManagerCard {
                enabled: root.enabled;
                preset_items: root.preset_items;
                selected_preset <=> root.selected_preset;
                load_preset(idx) => { root.load_preset(idx); }
                save_preset(name) => { root.save_preset(name); }
                delete_preset(idx) => { root.delete_preset(idx); }
                reset => { root.reset_presets(); }
            }
        }
    }
}
