import {
    MaterialStyleMetrics,
    ScrollView,
    Vertical,
} from "../../material/material.slint";
import {
    AnalysisOptions,
    AppErrors,
    PhysicsDiagnostics,
    WorkflowState,
} from "../../Types.slint";
import { SQOptionsCard } from "../../cards/advanced/SQOptionsCard.slint";
import { XRDOptionsCard } from "../../cards/advanced/XRDOptionsCard.slint";
import { RingsOptionsCard } from "../../cards/advanced/RingsOptionsCard.slint";
import {
    SmoothingOptionsCard,
} from "../../cards/advanced/SmoothingOptionsCard.slint";
import {
    AdvancedOptionsCard,
} from "../../cards/advanced/AdvancedOptionsCard.slint";
import {
    DynamicPropertiesCard,
} from "../../cards/dynamic/DynamicPropertiesCard.slint";
import { PinnedExecutionBar } from "../components/PinnedExecutionBar.slint";

/// Modular Host Component for Stage 2: Advanced Options
export component AdvancedOptionsPanel inherits Rectangle {
    in property <bool> file_loaded: false;
    in property <bool> has_scattering_active: true;
    in property <bool> has_rings_active: true;
    in property <WorkflowState> workflow_state;
    callback run_analysis();
    callback cancel_analysis();

    // Calculated dynamic & hyperuniformity diagnostics
    in property <PhysicsDiagnostics> physics_diagnostics: {
        deborah_level: -1,
        hyper_level: -1,
    };

    in-out property <AnalysisOptions> analysis_options;
    in property <AppErrors> app_errors;

    callback reset_sq_options();
    callback reset_xrd_options();
    callback xrd_radiation_preset_changed(int);
    callback reset_rings_options();
    callback reset_smoothing_options();
    callback reset_advanced_options();

    Vertical {
        width: 100%;
        height: 100%;
        spacing: MaterialStyleMetrics.spacing_8;
        padding: 0;

        ScrollView {
            content_height: adv_content.preferred-height;

            adv_content := Vertical {
                padding: 0;
                spacing: MaterialStyleMetrics.spacing_8;

                sq_card := SQOptionsCard {
                    file_loaded: root.file_loaded;
                    q_max <=> root.analysis_options.q_max;
                    q_bin_width <=> root.analysis_options.q_bin_width;
                    r_int_max <=> root.analysis_options.r_int_max;
                    sq_exact_direct <=> root.analysis_options.sq_exact_direct;
                    q_max_error: root.app_errors.q_max_error;
                    q_bin_error: root.app_errors.q_bin_error;
                    r_int_max_error: root.app_errors.r_int_max_error;
                    reset => { root.reset_sq_options(); }
                    visible: root.has_scattering_active;
                }

                xrd_card := XRDOptionsCard {
                    file_loaded: root.file_loaded;
                    radiation_preset <=> root.analysis_options.xrd_radiation_preset;
                    lambda <=> root.analysis_options.xrd_lambda;
                    theta_min <=> root.analysis_options.xrd_theta_min;
                    theta_max <=> root.analysis_options.xrd_theta_max;
                    bin_width <=> root.analysis_options.xrd_bin_width;
                    lambda_error: root.app_errors.xrd_lambda_error;
                    theta_min_error: root.app_errors.xrd_theta_min_error;
                    theta_max_error: root.app_errors.xrd_theta_max_error;
                    bin_width_error: root.app_errors.xrd_bin_width_error;
                    reset => { root.reset_xrd_options(); }
                    radiation_preset_changed(idx) => { root.xrd_radiation_preset_changed(idx); }
                    visible: root.has_scattering_active;
                }

                rings_card := RingsOptionsCard {
                    expanded: false;
                    file_loaded: root.file_loaded;
                    max_ring_size <=> root.analysis_options.max_ring_size;
                    max_ring_error: root.app_errors.max_ring_error;
                    reset => { root.reset_rings_options(); }
                    visible: root.has_rings_active;
                }

                dynamic_properties := DynamicPropertiesCard {
                    diagnostics: root.physics_diagnostics;
                }

                smoothing_card := SmoothingOptionsCard {
                    expanded: false;
                    file_loaded: root.file_loaded;
                    smoothing_enabled <=> root.analysis_options.smoothing_enabled;
                    smoothing_sigma <=> root.analysis_options.smoothing_sigma;
                    smoothing_kernel <=> root.analysis_options.smoothing_kernel;
                    smoothing_sigma_error: root.app_errors.smoothing_sigma_error;
                    reset => { root.reset_smoothing_options(); }
                }

                advanced_card := AdvancedOptionsCard {
                    expanded: false;
                    file_loaded: root.file_loaded;
                    lef_cutoff <=> root.analysis_options.lef_cutoff;
                    lef_sigma <=> root.analysis_options.lef_sigma;
                    lef_cutoff_error: root.app_errors.lef_cutoff_error;
                    lef_sigma_error: root.app_errors.lef_sigma_error;
                    hyper_samples <=> root.analysis_options.hyper_samples;
                    hyper_samples_error: root.app_errors.hyper_samples_error;
                    vacf_max_lag <=> root.analysis_options.vacf_max_lag;
                    vacf_max_lag_error: root.app_errors.vacf_max_lag_error;
                    vdos_window <=> root.analysis_options.vdos_window;
                    vdos_zero_pad <=> root.analysis_options.vdos_zero_pad;
                    vdos_zero_pad_error: root.app_errors.vdos_zero_pad_error;
                    reset => { root.reset_advanced_options(); }
                }
            }
        }

        exec_bar := PinnedExecutionBar {
            width: 100%;
            file_loaded: root.file_loaded;
            analysis_running: root.workflow_state.analysis_running;
            has_validation_errors: root.workflow_state.has_validation_errors;
            run_analysis => { root.run_analysis(); }
            cancel_analysis => { root.cancel_analysis(); }
        }
    }
}
