import { CalculatorGroup } from "../../Types.slint";
import { AnalysesPanelCard } from "../../cards/analyses/AnalysesPanelCard.slint";

/// Modular Host Component for Panel 4: Analyses Selection
export component AnalysesPanel inherits Rectangle {
    in property <bool> file_loaded: false;
    in-out property <[CalculatorGroup]> calculator_groups: [];
    in property <int> total_calculator_count: 0;
    in property <int> enabled_calculator_count: 0;

    callback toggle_calculator(string, bool);
    callback toggle_calculator_group(string, bool);
    callback toggle_all_calculators(bool);
    callback set_calculator_group_expanded(string, bool);
    callback set_all_calculator_groups_expanded(bool);
    callback reset_analyses_selection();

    out property <string> hovered_tooltip_text: card.hovered_tooltip_text;
    out property <length> hovered_x: card.hovered_x;
    out property <length> hovered_y: card.hovered_y;
    out property <length> hovered_width: card.hovered_width;
    out property <length> hovered_height: card.hovered_height;

    card := AnalysesPanelCard {
        width: 100%;
        height: 100%;
        file_loaded: root.file_loaded;
        calculator_groups: root.calculator_groups;
        total_calculator_count: root.total_calculator_count;
        enabled_calculator_count: root.enabled_calculator_count;
        toggle_calculator(id, enabled) => { root.toggle_calculator(id, enabled); }
        toggle_calculator_group(grp, enabled) => { root.toggle_calculator_group(grp, enabled); }
        toggle_all_calculators(enabled) => { root.toggle_all_calculators(enabled); }
        set_calculator_group_expanded(grp, exp) => { root.set_calculator_group_expanded(grp, exp); }
        set_all_calculator_groups_expanded(exp) => { root.set_all_calculator_groups_expanded(exp); }
        reset_analyses_selection => { root.reset_analyses_selection(); }
    }
}
