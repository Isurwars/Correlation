import { MenuItem } from "../../material/material.slint";
import { ExportFormatOptions, ExportAnalysisItem } from "../../Types.slint";
import { SaveExportPanelCard } from "../../cards/export/SaveExportPanelCard.slint";

/// Modular Host Component for Panel 5: Save & Export and Preset Profiles
export component SaveExportPanel inherits Rectangle {
    in property <bool> enabled: true;
    in property <bool> analysis_done: false;

    // Export formats state
    in-out property <ExportFormatOptions> export_format_options;
    in-out property <[ExportAnalysisItem]> export_analysis_items;
    in-out property <bool> export_all_analyses: true;

    callback toggle_export_analysis(string, bool);
    callback toggle_all_export_analyses(bool);
    callback write_files();
    callback reset_export_options();

    // Presets state
    in property <[MenuItem]> preset_items: [];
    in-out property <int> selected_preset: -1;
    callback load_preset(int);
    callback save_preset(string);
    callback delete_preset(int);
    callback reset_presets();

    out property <string> hovered_tooltip_text: card.hovered_tooltip_text;
    out property <length> hovered_x: card.hovered_x;
    out property <length> hovered_y: card.hovered_y;
    out property <length> hovered_width: card.hovered_width;
    out property <length> hovered_height: card.hovered_height;

    card := SaveExportPanelCard {
        width: 100%;
        height: 100%;
        enabled: root.enabled;
        analysis_done: root.analysis_done;

        format_options <=> root.export_format_options;
        export_analyses <=> root.export_analysis_items;
        export_all_analyses <=> root.export_all_analyses;

        toggle_analysis(id, val) => { root.toggle_export_analysis(id, val); }
        toggle_all_analyses(val) => { root.toggle_all_export_analyses(val); }
        write_files => { root.write_files(); }
        reset_export_options => { root.reset_export_options(); }

        preset_items: root.preset_items;
        selected_preset <=> root.selected_preset;
        load_preset(idx) => { root.load_preset(idx); }
        save_preset(name) => { root.save_preset(name); }
        delete_preset(idx) => { root.delete_preset(idx); }
        reset_presets => { root.reset_presets(); }
    }
}
