import {
    MaterialStyleMetrics,
    ScrollView,
    Vertical,
} from "../../material/material.slint";
import {
    AtomCount,
    BondCutoff,
    AnalysisOptions,
    AppErrors,
    SanityBadgeState,
    WorkflowState,
} from "../../Types.slint";
import { MaterialTypeCard } from "../../cards/operations/MaterialTypeCard.slint";
import { BondCutoffsCard } from "../../cards/common/BondCutoffsCard.slint";
import { RDFOptionsCard } from "../../cards/common/RDFOptionsCard.slint";
import { BondAngleOptionsCard } from "../../cards/common/BondAngleOptionsCard.slint";
import { TrajectoryOptionsCard } from "../../cards/operations/TrajectoryOptionsCard.slint";
import { PinnedExecutionBar } from "../components/PinnedExecutionBar.slint";

/// Modular Host Component for Stage 1: Calculators & Parameters
export component CalculatorsPanel inherits Rectangle {
    in property <bool> file_loaded: false;
    in property <int> num_frames: 0;
    in property <WorkflowState> workflow_state;
    callback run_analysis();
    callback cancel_analysis();

    // Material Type preset state
    in-out property <int> material_type: 0;
    callback reset_material_type();

    // Active domain flags
    in property <bool> has_radial_active: true;
    in property <bool> has_angular_active: true;

    // Bond Cutoffs state
    in property <[AtomCount]> atom_counts: [];
    in-out property <[BondCutoff]> bond_cutoffs: [];
    in property <int> bond_cutoffs_reset_trigger: 0;
    in property <SanityBadgeState> sanity_badge_state;
    callback fix_sanity_issue(int);
    callback reset_bond_cutoffs();
    callback apply_min_factor(float);
    callback apply_max_factor(float);
    callback apply_global_cutoff(float);
    callback apply_scaled_cutoffs(float);
    callback set_uniform_cutoff(float);

    // Parameter options & errors
    in-out property <AnalysisOptions> analysis_options;
    in property <AppErrors> app_errors;
    callback reset_rdf_options();
    callback reset_angle_options();
    callback reset_trajectory_options();

    out property <string> hovered_tooltip_text:
        material_card.hovered_tooltip_text != "" ? material_card.hovered_tooltip_text :
        bond_cutoffs_card.hovered_tooltip_text != "" ? bond_cutoffs_card.hovered_tooltip_text :
        rdf_card.hovered_tooltip_text != "" ? rdf_card.hovered_tooltip_text :
        angle_card.hovered_tooltip_text != "" ? angle_card.hovered_tooltip_text :
        trajectory_card.hovered_tooltip_text != "" ? trajectory_card.hovered_tooltip_text :
        exec_bar.has_hover ? exec_bar.hovered_tooltip_text : "";

    out property <length> hovered_x:
        material_card.hovered_tooltip_text != "" ? material_card.hovered_x :
        bond_cutoffs_card.hovered_tooltip_text != "" ? bond_cutoffs_card.hovered_x :
        rdf_card.hovered_tooltip_text != "" ? rdf_card.hovered_x :
        angle_card.hovered_tooltip_text != "" ? angle_card.hovered_x :
        trajectory_card.hovered_tooltip_text != "" ? trajectory_card.hovered_x :
        exec_bar.has_hover ? exec_bar.hover_x : 0px;

    out property <length> hovered_y:
        material_card.hovered_tooltip_text != "" ? material_card.hovered_y :
        bond_cutoffs_card.hovered_tooltip_text != "" ? bond_cutoffs_card.hovered_y :
        rdf_card.hovered_tooltip_text != "" ? rdf_card.hovered_y :
        angle_card.hovered_tooltip_text != "" ? angle_card.hovered_y :
        trajectory_card.hovered_tooltip_text != "" ? trajectory_card.hovered_y :
        exec_bar.has_hover ? exec_bar.hover_y : 0px;

    out property <length> hovered_width: 0px;
    out property <length> hovered_height: 0px;

    Vertical {
        width: 100%;
        height: 100%;
        spacing: MaterialStyleMetrics.spacing_8;
        padding: 0;

        ScrollView {
            vertical-stretch: 1;

            Vertical {
                padding: 0;
                spacing: MaterialStyleMetrics.spacing_8;

                // 1. Material Type Preset Card (Expanded on top by default)
                material_card := MaterialTypeCard {
                    expanded: true;
                    file_loaded: root.file_loaded;
                    material_type <=> root.material_type;
                    reset => { root.reset_material_type(); }
                }

                // 2. Bond Cutoffs & Calibration Card (Expanded on top by default)
                bond_cutoffs_card := BondCutoffsCard {
                    expanded: true;
                    file_loaded: root.file_loaded;
                    atom_counts: root.atom_counts;
                    bond_cutoffs <=> root.bond_cutoffs;
                    bond_cutoffs_reset_trigger: root.bond_cutoffs_reset_trigger;
                    sanity_badge_state: root.sanity_badge_state;
                    fix_sanity_issue(action) => { root.fix_sanity_issue(action); }
                    reset_bond_cutoffs => { root.reset_bond_cutoffs(); }
                    apply_min_factor(factor) => { root.apply_min_factor(factor); }
                    apply_max_factor(factor) => { root.apply_max_factor(factor); }
                    apply_global_cutoff(cutoff) => { root.apply_global_cutoff(cutoff); }
                    apply_scaled_cutoffs(factor) => { root.apply_scaled_cutoffs(factor); }
                    set_uniform_cutoff(max_val) => { root.set_uniform_cutoff(max_val); }
                }

                // 3. Radial Distribution Functions (RDF) Card (Expanded by default)
                rdf_card := RDFOptionsCard {
                    expanded: true;
                    file_loaded: root.file_loaded;
                    r_max <=> root.analysis_options.r_max;
                    r_bin_width <=> root.analysis_options.r_bin_width;
                    r_max_error: root.app_errors.r_max_error;
                    r_bin_error: root.app_errors.r_bin_error;
                    reset => { root.reset_rdf_options(); }
                    visible: root.has_radial_active;
                }

                // 4. Bond Angle & Dihedral Distribution Card (Collapsed by default)
                angle_card := BondAngleOptionsCard {
                    expanded: false;
                    file_loaded: root.file_loaded;
                    angle_bin_width <=> root.analysis_options.angle_bin_width;
                    dihedral_bin_width <=> root.analysis_options.dihedral_bin_width;
                    angle_bin_error: root.app_errors.angle_bin_error;
                    dihedral_bin_error: root.app_errors.dihedral_bin_error;
                    reset => { root.reset_angle_options(); }
                    visible: root.has_angular_active;
                }

                // 5. Trajectory Options Card (Expanded by default)
                trajectory_card := TrajectoryOptionsCard {
                    expanded: true;
                    file_loaded: root.file_loaded;
                    num_frames: root.num_frames;
                    time_step <=> root.analysis_options.time_step;
                    time_step_error: root.app_errors.time_step_error;
                    min_frame <=> root.analysis_options.min_frame;
                    max_frame <=> root.analysis_options.max_frame;
                    min_frame_error: root.app_errors.min_frame_error;
                    max_frame_error: root.app_errors.max_frame_error;
                    frame_stride <=> root.analysis_options.frame_stride;
                    frame_stride_error: root.app_errors.frame_stride_error;
                    reset => { root.reset_trajectory_options(); }
                }
            }
        }

        // 6. Pinned Bottom Run / Cancel Analysis Action Trigger
        exec_bar := PinnedExecutionBar {
            width: 100%;
            file_loaded: root.file_loaded;
            analysis_running: root.workflow_state.analysis_running;
            has_validation_errors: root.workflow_state.has_validation_errors;
            run_analysis => { root.run_analysis(); }
            cancel_analysis => { root.cancel_analysis(); }
        }
    }
}
