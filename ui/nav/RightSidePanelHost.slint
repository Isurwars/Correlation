import {
    MaterialPalette,
    MaterialStyleMetrics,
    MaterialTypography,
    MaterialText,
    Horizontal,
    Vertical,
    IconButton,
    Icons,
} from "../material/material.slint";

import {
    CurveToggleItem,
    PlotAxisSettings,
    TaggedPeakRecord,
    ExportConfig,
} from "../Types.slint";

import { CrystalMarker } from "../cards/preview/PreviewCard.slint";
import { CurveSidebar } from "../cards/preview/components/CurveSidebar.slint";
import {
    Structure3DSidebar,
} from "../cards/preview/components/Structure3DSidebar.slint";

/// Container hosting the unified right-hand activity panels (Plot & 3D Structure Inspectors)
export component RightSidePanelHost inherits Vertical {
    padding: 0;
    spacing: 0;

    // Panel control state
    in-out property <int> active_panel: -1;
    in-out property <int> last_active_panel: 0;

    // Callbacks for panel control
    callback select_panel(int);

    // =========================================================================
    // 2D Plot Inspector Properties & Callbacks
    // =========================================================================
    in property <[CurveToggleItem]> curve_toggle_items: [];
    in-out property <PlotAxisSettings> axis_settings;
    in-out property <ExportConfig> export_config;
    in-out property <int> active_color_picker_id: -1;
    in property <[TaggedPeakRecord]> tagged_peaks: [];

    callback filter_curves(string);
    callback invert_curves();
    callback toggle_curve_visibility(int, bool);
    callback toggle_all_curves(bool);
    callback set_curve_color(int, string);
    callback set_curve_width(string);
    callback apply_axis_settings();
    callback reset_axis_settings();
    callback reset_export_settings();
    callback remove_tagged_peak(int);
    callback clear_tagged_peaks();
    callback export_tagged_peaks();

    // =========================================================================
    // Structure 3D Inspector Properties & Callbacks
    // =========================================================================
    in property <bool> phase_enabled: false;
    in property <int> preset_index: 0;
    in property <int> descriptor_index: 0;
    in property <int> colormap_index: 0;
    in property <float> min_threshold: 0.46;
    in property <float> max_threshold: 0.58;
    in property <float> domain_min: 0.0;
    in property <float> domain_max: 1.0;
    in property <float> halo_intensity: 0.85;
    in property <float> halo_radius_ratio: 1.35;
    in property <float> atom_scale: 0.35;
    in property <bool> dim_non_matching: false;
    in property <bool> hide_non_matching: false;
    in property <[float]> histogram_counts: [];
    in property <int> matching_atoms: 0;
    in property <int> total_atoms: 0;
    in property <image> colorbar_image;
    in property <string> descriptor_name: "q̄₆";

    // 2D Heatmap Mode properties
    in property <bool> is_2d_mode: false;
    in property <int> descriptor_y_index: 0;
    in property <float> min_threshold_y: 0.46;
    in property <float> max_threshold_y: 0.58;
    in property <float> domain_min_y: 0.0;
    in property <float> domain_max_y: 1.0;
    in property <string> descriptor_name_y: "q̄₆";
    in property <image> heatmap_image;
    in property <[CrystalMarker]> crystal_markers: [];

    // Scene / Render properties
    in property <bool> bonds_enabled: true;
    in property <bool> wireframe_enabled: true;
    in property <bool> in_cell_enabled: false;
    in property <bool> dist_hud_visible: true;

    callback toggle_phase_enabled(bool);
    callback set_preset(int);
    callback set_descriptor(int);
    callback set_colormap(int);
    callback set_thresholds(float, float);
    callback set_intensity(float);
    callback set_radius_ratio(float);
    callback set_atom_scale(float);
    callback set_dim_non_matching(bool);
    callback set_hide_non_matching(bool);
    callback set_2d_mode(bool);
    callback set_descriptor_y(int);
    callback set_thresholds_2d(float, float, float, float);
    callback export_heatmap_png();
    callback reset_view();
    callback toggle_bonds(bool);
    callback toggle_wireframe(bool);
    callback toggle_in_cell(bool);
    callback toggle_dist_hud(bool);

    // Tooltip reflection properties
    out property <string> hovered_tooltip_text:
        root.active_panel == 0 ? panel_curves.tooltip_text :
        root.active_panel == 1 ? panel_structure.tooltip_text : "";

    out property <length> hovered_x:
        root.active_panel == 0 ? panel_curves.tooltip_x :
        root.active_panel == 1 ? panel_structure.tooltip_x : 0px;

    out property <length> hovered_y:
        root.active_panel == 0 ? panel_curves.tooltip_y :
        root.active_panel == 1 ? panel_structure.tooltip_y : 0px;

    out property <length> hovered_width: 0px;
    out property <length> hovered_height: 0px;

    // Header with Title and Close Button
    Horizontal {
        height: 36px;
        padding-left: 8px;
        padding-right: 4px;
        alignment: center;

        MaterialText {
            text: root.active_panel == 0 ? "Plot Inspector" : "Structure 3D Inspector";
            style: MaterialTypography.title_small;
            color: MaterialPalette.on_surface;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }

        close_btn := IconButton {
            icon: Icons.close;
            tooltip: "Close Panel";
            inline: true;
            clicked => {
                if (root.active_panel >= 0) {
                    root.last_active_panel = root.active_panel;
                }
                root.select_panel(-1);
            }
        }
    }

    // Panel Content Area
    Rectangle {
        vertical-stretch: 1;

        // Stage 0: 2D Plot Inspector (Curves, Style & Axes, Peaks)
        panel_curves := CurveSidebar {
            width: 100%;
            height: 100%;
            visible: root.active_panel == 0;

            curve_toggle_items: root.curve_toggle_items;
            axis_settings <=> root.axis_settings;
            export_config <=> root.export_config;
            active_color_picker_id <=> root.active_color_picker_id;
            tagged_peaks: root.tagged_peaks;

            filter_curves(f) => { root.filter_curves(f); }
            invert_curves => { root.invert_curves(); }
            toggle_curve_visibility(id, vis) => { root.toggle_curve_visibility(id, vis); }
            toggle_all_curves(vis) => { root.toggle_all_curves(vis); }
            set_curve_color(id, col) => { root.set_curve_color(id, col); }
            set_curve_width(w) => { root.set_curve_width(w); }
            apply_axis_settings => { root.apply_axis_settings(); }
            reset_axis_settings => { root.reset_axis_settings(); }
            reset_export_settings => { root.reset_export_settings(); }
            toggle_collapse => {
                if (root.active_panel >= 0) {
                    root.last_active_panel = root.active_panel;
                }
                root.select_panel(-1);
            }
            remove_tagged_peak(id) => { root.remove_tagged_peak(id); }
            clear_tagged_peaks => { root.clear_tagged_peaks(); }
            export_tagged_peaks => { root.export_tagged_peaks(); }
        }

        // Stage 1: Structure 3D Inspector (Phase Search, Halos, Scene & Camera)
        panel_structure := Structure3DSidebar {
            width: 100%;
            height: 100%;
            visible: root.active_panel == 1;

            phase_enabled: root.phase_enabled;
            preset_index: root.preset_index;
            descriptor_index: root.descriptor_index;
            colormap_index: root.colormap_index;
            min_threshold: root.min_threshold;
            max_threshold: root.max_threshold;
            domain_min: root.domain_min;
            domain_max: root.domain_max;
            halo_intensity: root.halo_intensity;
            halo_radius_ratio: root.halo_radius_ratio;
            atom_scale: root.atom_scale;
            dim_non_matching: root.dim_non_matching;
            hide_non_matching: root.hide_non_matching;
            histogram_counts: root.histogram_counts;
            matching_atoms: root.matching_atoms;
            total_atoms: root.total_atoms;
            colorbar_image: root.colorbar_image;
            descriptor_name: root.descriptor_name;

            is_2d_mode: root.is_2d_mode;
            descriptor_y_index: root.descriptor_y_index;
            min_threshold_y: root.min_threshold_y;
            max_threshold_y: root.max_threshold_y;
            domain_min_y: root.domain_min_y;
            domain_max_y: root.domain_max_y;
            descriptor_name_y: root.descriptor_name_y;
            heatmap_image: root.heatmap_image;
            crystal_markers: root.crystal_markers;

            bonds_enabled: root.bonds_enabled;
            wireframe_enabled: root.wireframe_enabled;
            in_cell_enabled: root.in_cell_enabled;
            dist_hud_visible: root.dist_hud_visible;

            toggle_collapse => {
                if (root.active_panel >= 0) {
                    root.last_active_panel = root.active_panel;
                }
                root.select_panel(-1);
            }
            toggle_phase_enabled(en) => { root.toggle_phase_enabled(en); }
            set_preset(idx) => { root.set_preset(idx); }
            set_descriptor(idx) => { root.set_descriptor(idx); }
            set_colormap(idx) => { root.set_colormap(idx); }
            set_thresholds(min, max) => { root.set_thresholds(min, max); }
            set_intensity(val) => { root.set_intensity(val); }
            set_radius_ratio(val) => { root.set_radius_ratio(val); }
            set_atom_scale(val) => { root.set_atom_scale(val); }
            set_dim_non_matching(dim) => { root.set_dim_non_matching(dim); }
            set_hide_non_matching(hide) => { root.set_hide_non_matching(hide); }
            set_2d_mode(is_2d) => { root.set_2d_mode(is_2d); }
            set_descriptor_y(idx) => { root.set_descriptor_y(idx); }
            set_thresholds_2d(min_x, max_x, min_y, max_y) => {
                root.set_thresholds_2d(min_x, max_x, min_y, max_y);
            }
            export_heatmap_png => { root.export_heatmap_png(); }
            reset_view => { root.reset_view(); }
            toggle_bonds(en) => { root.toggle_bonds(en); }
            toggle_wireframe(en) => { root.toggle_wireframe(en); }
            toggle_in_cell(en) => { root.toggle_in_cell(en); }
            toggle_dist_hud(v) => { root.toggle_dist_hud(v); }
        }
    }
}
