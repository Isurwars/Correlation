import {
    MaterialStyleMetrics,
    MaterialTypography,
    MaterialPalette,
    OutlinedCard,
    MaterialText,
    ExpandableHeader,
    InfoRow,
    Vertical,
    Horizontal,
} from "../../material/material.slint";
import { AtomCount } from "../../Types.slint";

component SpeciesRemapRow inherits Horizontal {
    in property <AtomCount> info;
    callback rename_element(string, string);

    spacing: MaterialStyleMetrics.spacing_6;
    alignment: space-between;
    padding-left: MaterialStyleMetrics.spacing_4;
    padding-right: MaterialStyleMetrics.spacing_4;
    height: 26px;

    Horizontal {
        spacing: MaterialStyleMetrics.spacing_6;
        vertical-stretch: 0;

        Rectangle {
            width: 10px;
            height: 10px;
            y: (parent.height - self.height) / 2;
            border-radius: 5px;
            background: root.info.color;
            border-width: 1px;
            border-color: MaterialPalette.outline_variant;
        }

        Rectangle {
            width: 54px;
            height: 22px;
            y: (parent.height - self.height) / 2;
            border-radius: MaterialStyleMetrics.border_radius_4;
            background: MaterialPalette.surface_container_highest;
            border-width: 1px;
            border-color: species_input.has-focus ? MaterialPalette.primary :
                (root.info.is_unknown ? MaterialPalette.tertiary : MaterialPalette.outline_variant);

            species_input := TextInput {
                width: 100%;
                height: 100%;
                text: root.info.symbol;
                horizontal-alignment: center;
                vertical-alignment: center;
                color: MaterialPalette.on_surface;
                font-size: MaterialTypography.label_medium.font_size;
                font-weight: MaterialTypography.label_medium.font_weight;
                accepted => {
                    if (self.text != "" && self.text != root.info.symbol) {
                        root.rename_element(root.info.symbol, self.text);
                    }
                }
            }
        }

        if root.info.is_unknown: MaterialText {
            text: "Set element";
            style: MaterialTypography.label_small;
            color: MaterialPalette.tertiary;
            vertical-alignment: center;
        }
    }

    MaterialText {
        text: "" + root.info.count;
        style: MaterialTypography.body_small;
        color: MaterialPalette.on_surface;
        vertical-alignment: center;
    }
}

export component OperationsDiagnosticsCard inherits OutlinedCard {
    in property <bool> file_loaded;
    in property <string> file_basename: "";
    in property <string> file_status_text: "";
    in property <int> num_frames;
    in property <int> total_atoms;
    in property <int> removed_frames_count;
    in property <[AtomCount]> atom_counts;
    in property <string> box_volume: "";
    in property <string> box_density: "";
    in property <string> box_dimensions: "";
    in-out property <bool> atoms_expanded: true;

    callback rename_element(string, string);

    out property <bool> header_has_hover: file_header_area.has-hover;
    out property <length> header_hover_x: file_header_area.absolute-position.x + file_header_area.mouse-x;
    out property <length> header_hover_y: file_header_area.absolute-position.y + file_header_area.mouse-y;
    out property <bool> diagnostics_has_hover: diagnostics_header.has-hover;
    out property <length> diagnostics_hover_x: diagnostics_header.absolute-position.x + diagnostics_header.mouse-x;
    out property <length> diagnostics_hover_y: diagnostics_header.absolute-position.y + diagnostics_header.mouse-y;

    Vertical {
        padding: MaterialStyleMetrics.spacing_8;
        spacing: MaterialStyleMetrics.spacing_6;

        // Tier 1: Summary Header (Basename + Metrics chip)
        file_header_area := TouchArea {
            Vertical {
                spacing: MaterialStyleMetrics.spacing_2;
                padding: 0;

                Horizontal {
                    alignment: space-between;
                    MaterialText {
                        text: root.file_loaded ? root.file_basename : "No file loaded";
                        style: MaterialTypography.title_small;
                        color: root.file_loaded ? MaterialPalette.on_surface : MaterialPalette.on_surface_variant;
                    }
                    if root.file_loaded: MaterialText {
                        text: root.num_frames > 1 ? ("" + root.total_atoms + " atoms • " + root.num_frames + " frames") : ("" + root.total_atoms + " atoms");
                        style: MaterialTypography.label_small;
                        color: MaterialPalette.on_surface_variant;
                    }
                }
            }
        }

        // Tier 2: Collapsible Diagnostics Drawer
        diagnostics_header := ExpandableHeader {
            text: "System Diagnostics";
            expanded <=> root.atoms_expanded;
            enabled: root.file_loaded;
            opacity: root.file_loaded ? 1.0 : 0.4;
        }

        Vertical {
            height: root.atoms_expanded ? self.preferred-height : 0px;
            visible: self.height > 0px;
            opacity: root.atoms_expanded ? 1.0 : 0.0;
            animate height, opacity {
                duration: 250ms;
                easing: ease-in-out;
            }
            spacing: MaterialStyleMetrics.spacing_4;

            if (root.box_dimensions != ""): InfoRow {
                label: "Lattice:";
                value: root.box_dimensions;
            }
            if (root.box_volume != ""): InfoRow {
                label: "Volume:";
                value: root.box_volume;
            }
            if (root.box_density != ""): InfoRow {
                label: "Density:";
                value: root.box_density;
            }

            if (root.atom_counts.length > 0): MaterialText {
                text: "Composition Breakdown (Click species to remap):";
                style: MaterialTypography.label_small;
                color: MaterialPalette.on_surface_variant;
            }
            for info in root.atom_counts: SpeciesRemapRow {
                info: info;
                rename_element(old_sym, new_sym) => {
                    root.rename_element(old_sym, new_sym);
                }
            }

            if (root.num_frames > 1 && root.removed_frames_count > 0): InfoRow {
                label: "Skipped Frames:";
                value: root.removed_frames_count;
                text-color: MaterialPalette.error;
            }
        }
    }
}

