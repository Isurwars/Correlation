import {
    MaterialStyleMetrics,
    MaterialPalette,
    OutlinedCard,
    FilledButton,
    LinearProgressIndicator,
    Vertical,
    Horizontal,
    IconButton,
    Icons,
    ScrollView,
} from "../../material/material.slint";
import { AtomCount } from "../../Types.slint";
import { PinnedExecutionBar } from "../../nav/components/PinnedExecutionBar.slint";
import { OperationsDiagnosticsCard } from "OperationsDiagnosticsCard.slint";

// ============================================================================
// OperationsPanelCard Component (Panel 0)
// ============================================================================
export component OperationsPanelCard inherits Rectangle {
    // File Loading
    in property <bool> load_enabled: true;
    in property <bool> file_loading: false;
    callback browse_file();
    callback reload_file();
    callback export_structure();
    callback rename_element(string, string);

    // File Status & Metadata
    in property <string> file_basename: "";
    in-out property <string> file_status_text;
    in property <bool> file_loaded;
    in property <int> num_frames;
    in property <int> total_atoms;
    in property <int> removed_frames_count;
    in property <[AtomCount]> atom_counts;

    // Box Diagnostics
    in property <string> box_volume: "";
    in property <string> box_density: "";
    in property <string> box_dimensions: "";

    // Analysis Execution
    in property <bool> analysis_running;
    in property <bool> has_validation_errors;
    callback run_analysis();
    callback cancel_analysis();

    out property <string> hovered_tooltip_text:
        btn_load.has_hover ? "Load a structure or trajectory file" :
        btn_reload.has_hover ? "Reload the currently loaded file from disk.\n\n🔄 Useful when the trajectory is updated by an active external simulation." :
        btn_export.has_hover ? "Convert or export the currently loaded structure into POSCAR, CELL, CIF, or CAR format." :
        diagnostics_card.header_has_hover ? ("Loaded File: " + (root.file_status_text != "" ? root.file_status_text : "None")) :
        diagnostics_card.diagnostics_has_hover ? "System Diagnostics & Composition.\n\n🔬 Details lattice dimensions, cell volume, macroscopic density, and atomic species counts." :
        exec_bar.has_hover ? exec_bar.hovered_tooltip_text : "";

    out property <length> hovered_x:
        btn_load.has_hover ? btn_load.hover_x :
        btn_reload.has_hover ? btn_reload.hover_x :
        btn_export.has_hover ? btn_export.hover_x :
        diagnostics_card.header_has_hover ? diagnostics_card.header_hover_x :
        diagnostics_card.diagnostics_has_hover ? diagnostics_card.diagnostics_hover_x :
        exec_bar.has_hover ? exec_bar.hover_x : 0px;
    out property <length> hovered_y:
        btn_load.has_hover ? btn_load.hover_y :
        btn_reload.has_hover ? btn_reload.hover_y :
        btn_export.has_hover ? btn_export.hover_y :
        diagnostics_card.header_has_hover ? diagnostics_card.header_hover_y :
        diagnostics_card.diagnostics_has_hover ? diagnostics_card.diagnostics_hover_y :
        exec_bar.has_hover ? exec_bar.hover_y : 0px;
    out property <length> hovered_width: 0px;
    out property <length> hovered_height: 0px;

    in-out property <bool> atoms_expanded: true;

    Vertical {
        width: 100%;
        height: 100%;
        spacing: MaterialStyleMetrics.spacing_8;
        padding: 0;

        ScrollView {
            vertical-stretch: 1;

            Vertical {
                spacing: MaterialStyleMetrics.spacing_8;
                padding: 0;

                // --- File Loading Card ---
                OutlinedCard {
                    Vertical {
                        padding: MaterialStyleMetrics.spacing_8;
                        spacing: MaterialStyleMetrics.spacing_6;

                        Horizontal {
                            spacing: MaterialStyleMetrics.spacing_8;

                            btn_load := FilledButton {
                                height: MaterialStyleMetrics.size_40;
                                horizontal-stretch: 1;
                                text: "Load File";
                                tooltip: "";
                                icon: Icons.folder_open;
                                enabled: root.load_enabled && !root.analysis_running;
                                clicked => {
                                    root.browse_file();
                                }
                            }

                            btn_reload := IconButton {
                                accessible-label: "Reload Current File";
                                height: MaterialStyleMetrics.size_40;
                                width: MaterialStyleMetrics.size_40;
                                horizontal-stretch: 0;
                                icon: Icons.restart_alt;
                                tooltip: "";
                                enabled: root.load_enabled && root.file_loaded && !root.analysis_running;
                                clicked => {
                                    root.reload_file();
                                }
                            }

                            btn_export := IconButton {
                                accessible-label: "Export or Convert Structure";
                                height: MaterialStyleMetrics.size_40;
                                width: MaterialStyleMetrics.size_40;
                                horizontal-stretch: 0;
                                icon: Icons.save;
                                tooltip: "";
                                enabled: root.load_enabled && root.file_loaded && !root.analysis_running;
                                clicked => {
                                    root.export_structure();
                                }
                            }
                        }

                        if root.file_loading: LinearProgressIndicator {
                            width: 100%;
                            height: 4px;
                            indeterminate: true;
                        }
                    }
                }

                // --- File Summary & Diagnostics Card ---
                diagnostics_card := OperationsDiagnosticsCard {
                    file_loaded: root.file_loaded;
                    file_basename: root.file_basename;
                    file_status_text: root.file_status_text;
                    num_frames: root.num_frames;
                    total_atoms: root.total_atoms;
                    removed_frames_count: root.removed_frames_count;
                    atom_counts: root.atom_counts;
                    box_volume: root.box_volume;
                    box_density: root.box_density;
                    box_dimensions: root.box_dimensions;
                    atoms_expanded <=> root.atoms_expanded;
                    rename_element(old_sym, new_sym) => {
                        root.rename_element(old_sym, new_sym);
                    }
                }
            }
        }

        // --- Pinned Execution Bar outside ScrollView ---
        exec_bar := PinnedExecutionBar {
            width: 100%;
            file_loaded: root.file_loaded;
            analysis_running: root.analysis_running;
            has_validation_errors: root.has_validation_errors;
            run_analysis => { root.run_analysis(); }
            cancel_analysis => { root.cancel_analysis(); }
        }
    }
}
