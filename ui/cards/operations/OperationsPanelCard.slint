import {
    MaterialStyleMetrics,
    MaterialTypography,
    MaterialPalette,
    OutlinedCard,
    MaterialText,
    FilledButton,
    LinearProgressIndicator,
    ExpandableHeader,
    InfoRow,
    Vertical,
    Horizontal,
    IconButton,
    Icons,
    ScrollView,
} from "../../material/material.slint";
import { AtomCount } from "../../Types.slint";
import { MaterialTypeCard } from "MaterialTypeCard.slint";
import { TrajectoryOptionsCard } from "TrajectoryOptionsCard.slint";

// ============================================================================
// OperationsPanelCard Component (Panel 0)
// ============================================================================
export component OperationsPanelCard inherits Rectangle {
    // File Loading
    in property <bool> load_enabled: true;
    in property <bool> file_loading: false;
    callback browse_file();
    callback reload_file();

    // File Status & Metadata
    in property <string> file_basename: "";
    in-out property <string> file_status_text;
    in property <bool> file_loaded;
    in property <int> num_frames;
    in property <int> total_atoms;
    in property <int> removed_frames_count;
    in property <[AtomCount]> atom_counts;

    // Box Diagnostics
    in property <string> box_volume: "";
    in property <string> box_density: "";
    in property <string> box_dimensions: "";

    // Material & Trajectory Setup Options
    in-out property <int> material_type: 0;
    callback reset_material_type();

    in-out property <string> time_step: "1.0";
    in property <string> time_step_error: "";
    in-out property <string> min_frame: "1";
    in-out property <string> max_frame: "End";
    in property <string> min_frame_error: "";
    in property <string> max_frame_error: "";
    in-out property <string> frame_stride: "1";
    in property <string> frame_stride_error: "";
    callback reset_trajectory_options();

    // Analysis Execution
    in property <bool> analysis_running;
    in property <bool> has_validation_errors;
    callback run_analysis();
    callback cancel_analysis();

    out property <string> hovered_tooltip_text:
        load_area.has-hover ? "Load a structure or trajectory file" :
        reload_area.has-hover ? "Reload the currently loaded file from disk.\n\n🔄 Useful when the trajectory is updated by an active external simulation." :
        file_header_area.has-hover ? ("Loaded File: " + (root.file_status_text != "" ? root.file_status_text : "None")) :
        diagnostics_header.has-hover ? "System Diagnostics & Composition.\n\n🔬 Details lattice dimensions, cell volume, macroscopic density, and atomic species counts." :
        (material_card.hovered_tooltip_text != "" ? material_card.hovered_tooltip_text :
        (trajectory_card.hovered_tooltip_text != "" ? trajectory_card.hovered_tooltip_text :
        run_area.has-hover ? "Run all selected analyses on the loaded trajectory.\n\n🔬 This computes distribution functions (RDF, S(Q), PAD, etc.) across the selected frame range, averaging over all frames. Results appear in the Preview panel and can be saved afterward." : ""));

    out property <length> hovered_x:
        load_area.has-hover ? load_area.absolute-position.x + load_area.mouse-x :
        reload_area.has-hover ? reload_area.absolute-position.x + reload_area.mouse-x :
        file_header_area.has-hover ? file_header_area.absolute-position.x + file_header_area.mouse-x :
        diagnostics_header.has-hover ? diagnostics_header.absolute-position.x + diagnostics_header.mouse-x :
        (material_card.hovered_tooltip_text != "" ? material_card.hovered_x :
        (trajectory_card.hovered_tooltip_text != "" ? trajectory_card.hovered_x :
        run_area.has-hover ? run_area.absolute-position.x + run_area.mouse-x : 0px));
    out property <length> hovered_y:
        load_area.has-hover ? load_area.absolute-position.y + load_area.mouse-y :
        reload_area.has-hover ? reload_area.absolute-position.y + reload_area.mouse-y :
        file_header_area.has-hover ? file_header_area.absolute-position.y + file_header_area.mouse-y :
        diagnostics_header.has-hover ? diagnostics_header.absolute-position.y + diagnostics_header.mouse-y :
        (material_card.hovered_tooltip_text != "" ? material_card.hovered_y :
        (trajectory_card.hovered_tooltip_text != "" ? trajectory_card.hovered_y :
        run_area.has-hover ? run_area.absolute-position.y + run_area.mouse-y : 0px));
    out property <length> hovered_width: 0px;
    out property <length> hovered_height: 0px;

    in-out property <bool> atoms_expanded: true;

    Vertical {
        width: 100%;
        height: 100%;
        spacing: MaterialStyleMetrics.spacing_8;
        padding: 0;

        ScrollView {
            vertical-stretch: 1;

            Vertical {
                spacing: MaterialStyleMetrics.spacing_8;
                padding: 0;

                // --- File Loading & Diagnostics Card (Option B) ---
                OutlinedCard {
                    Vertical {
                        padding: MaterialStyleMetrics.spacing_8;
                        spacing: MaterialStyleMetrics.spacing_6;

                        Horizontal {
                            spacing: MaterialStyleMetrics.spacing_8;

                            load_area := TouchArea {
                                accessible-role: button;
                                accessible-label: "Load Structure or Trajectory File";
                                height: MaterialStyleMetrics.size_40;
                                horizontal-stretch: 1;
                                FilledButton {
                                    width: 100%;
                                    height: 100%;
                                    text: "Load File";
                                    icon: Icons.folder_open;
                                    enabled: root.load_enabled && !root.analysis_running;
                                    clicked => {
                                        root.browse_file();
                                    }
                                }
                            }

                            reload_area := TouchArea {
                                accessible-role: button;
                                accessible-label: "Reload Current File";
                                height: MaterialStyleMetrics.size_40;
                                width: MaterialStyleMetrics.size_40;
                                horizontal-stretch: 0;
                                IconButton {
                                    width: 100%;
                                    height: 100%;
                                    icon: Icons.restart_alt;
                                    enabled: root.load_enabled && root.file_loaded && !root.analysis_running;
                                    clicked => {
                                        root.reload_file();
                                    }
                                }
                            }
                        }

                        if root.file_loading: LinearProgressIndicator {
                            width: 100%;
                            height: 4px;
                            indeterminate: true;
                        }

                        // Tier 1: Summary Header (Basename + Metrics chip)
                        file_header_area := TouchArea {
                            Vertical {
                                spacing: MaterialStyleMetrics.spacing_2;
                                padding: 0;

                                Horizontal {
                                    alignment: space-between;
                                    MaterialText {
                                        text: root.file_loaded ? root.file_basename : "No file loaded";
                                        style: MaterialTypography.title_small;
                                        color: root.file_loaded ? MaterialPalette.on_surface : MaterialPalette.on_surface_variant;
                                        overflow: elide;
                                    }
                                    if root.file_loaded: MaterialText {
                                        text: root.num_frames > 1 ? ("" + root.total_atoms + " atoms • " + root.num_frames + " frames") : ("" + root.total_atoms + " atoms");
                                        style: MaterialTypography.label_small;
                                        color: MaterialPalette.on_surface_variant;
                                    }
                                }
                            }
                        }

                        // Tier 2: Collapsible Diagnostics Drawer
                        diagnostics_header := ExpandableHeader {
                            text: "System Diagnostics";
                            expanded <=> root.atoms_expanded;
                            enabled: root.file_loaded;
                            opacity: root.file_loaded ? 1.0 : 0.4;
                        }

                        Vertical {
                            height: root.atoms_expanded ? self.preferred-height : 0px;
                            visible: self.height > 0px;
                            opacity: root.atoms_expanded ? 1.0 : 0.0;
                            animate height, opacity {
                                duration: 250ms;
                                easing: ease-in-out;
                            }
                            spacing: MaterialStyleMetrics.spacing_4;

                            if (root.box_dimensions != ""): InfoRow {
                                label: "Lattice:";
                                value: root.box_dimensions;
                            }
                            if (root.box_volume != ""): InfoRow {
                                label: "Volume:";
                                value: root.box_volume;
                            }
                            if (root.box_density != ""): InfoRow {
                                label: "Density:";
                                value: root.box_density;
                            }

                            if (root.atom_counts.length > 0): MaterialText {
                                text: "Composition Breakdown:";
                                style: MaterialTypography.label_small;
                                color: MaterialPalette.on_surface_variant;
                            }
                            for info in root.atom_counts: InfoRow {
                                label: "  " + info.symbol + ":";
                                value: info.count;
                            }

                            if (root.num_frames > 1 && root.removed_frames_count > 0): InfoRow {
                                label: "Skipped Frames:";
                                value: root.removed_frames_count;
                                text-color: MaterialPalette.error;
                            }
                        }
                    }
                }

                // --- Setup Options (Material & Trajectory) ---
                material_card := MaterialTypeCard {
                    file_loaded: root.file_loaded;
                    material_type <=> root.material_type;
                    reset => { root.reset_material_type(); }
                }

                trajectory_card := TrajectoryOptionsCard {
                    file_loaded: root.file_loaded;
                    num_frames: root.num_frames;
                    time_step <=> root.time_step;
                    time_step_error: root.time_step_error;
                    min_frame <=> root.min_frame;
                    max_frame <=> root.max_frame;
                    min_frame_error: root.min_frame_error;
                    max_frame_error: root.max_frame_error;
                    frame_stride <=> root.frame_stride;
                    frame_stride_error: root.frame_stride_error;
                    reset => { root.reset_trajectory_options(); }
                    opacity: (root.file_loaded && root.num_frames > 1) ? 1.0 : 0.5;
                }
            }
        }

        // --- Option A: Pinned Execution Bar outside ScrollView ---
        OutlinedCard {
            vertical-stretch: 0;

            Vertical {
                padding: MaterialStyleMetrics.spacing_8;
                spacing: MaterialStyleMetrics.spacing_4;

                if root.has_validation_errors && !root.analysis_running: MaterialText {
                    text: "⚠ Fix validation errors before running";
                    color: MaterialPalette.error;
                    wrap: word-wrap;
                    horizontal-alignment: center;
                }

                run_area := TouchArea {
                    accessible-role: button;
                    accessible-label: root.analysis_running ? "Cancel Analysis" : "Run Analysis";
                    height: MaterialStyleMetrics.size_40;
                    FilledButton {
                        width: 100%;
                        height: 100%;
                        text: root.analysis_running ? "Cancel Analysis" : "Run Analysis";
                        enabled: root.analysis_running || (root.file_loaded && !root.has_validation_errors);
                        background: root.analysis_running ? MaterialPalette.error : MaterialPalette.run;
                        text_color: root.analysis_running ? MaterialPalette.on_error : MaterialPalette.on_run;
                        clicked => {
                            if (root.analysis_running) {
                                root.cancel_analysis();
                            } else {
                                root.run_analysis();
                            }
                        }
                    }
                }
            }
        }
    }
}
