import { DropDownMenu, TooltipTarget } from "../../material/material.slint";
import { OptionSection } from "../common/OptionSection.slint";

export component MaterialTypeCard inherits OptionSection {
    title: "Material Type";
    reset_enabled: root.file_loaded;

    in property <bool> file_loaded;
    in-out property <int> material_type: 0; // 0: Amorphous, 1: Liquid, 2: Crystalline

    TooltipTarget {
        tooltip_text: "Select the material type to load recommended parameter defaults.";
        DropDownMenu {
            width: 100%;
            label: "Material Defaults";
            enabled: root.file_loaded;
            items: [
                { text: "Amorphous", enabled: true },
                { text: "Liquid", enabled: true },
                { text: "Crystalline", enabled: true }
            ];
            current_index <=> root.material_type;
        }
    }
}
