import {
    MaterialStyleMetrics,
    Horizontal,
} from "../../material/material.slint";
import { OptionSection } from "../common/OptionSection.slint";
import { ValidatedField } from "../common/ValidatedField.slint";

export component TrajectoryOptionsCard inherits OptionSection {
    title: "Trajectory Options";
    reset_enabled: root.file_loaded;

    in property <bool> file_loaded;
    in property <int> num_frames;

    in-out property <string> time_step;
    in property <string> time_step_error: "";

    in-out property <string> min_frame;
    in-out property <string> max_frame;
    in property <string> min_frame_error: "";
    in property <string> max_frame_error: "";

    in-out property <string> frame_stride: "1";
    in property <string> frame_stride_error: "";

    ValidatedField {
        accessible-role: text-input;
        accessible-label: "Time Step in femtoseconds";
        field_enabled: root.file_loaded && root.num_frames > 1;
        label: "Time Step (fs)";
        text <=> root.time_step;
        error: root.time_step_error;
        stepper: true;
        step: 0.5;
        minimum: 0.01;
        maximum: 1000.0;
        decimals: 2;
        tooltip_text: "Time interval between parsed frames in femtoseconds (fs).\n\n📏 Auto-calculated from atomic masses using √(9m/5), where m is the lightest element's mass.\n\n🔬 Physics: The time step determines the time axis for dynamic properties (MSD, VACF, vDoS). Verify this matches your simulation's actual time step for accurate diffusion coefficients and vibrational spectra.";
    }

    Horizontal {
        spacing: MaterialStyleMetrics.spacing_8;

        ValidatedField {
            horizontal-stretch: 1;
            accessible-role: text-input;
            accessible-label: "Start Frame";
            field_enabled: root.file_loaded && root.num_frames > 1;
            label: "Start Frame";
            text <=> root.min_frame;
            error: root.min_frame_error;
            tooltip_text: "First frame to include in the analysis.\n\n📏 Tip: Use 'Start' or '1' for the first frame.\n\n🔬 Physics: In molecular dynamics, the initial frames may represent an equilibration phase. Excluding early frames ensures only the production run is analyzed. A common practice is to discard the first 10–20% of frames.";
        }

        ValidatedField {
            horizontal-stretch: 1;
            accessible-role: text-input;
            accessible-label: "End Frame";
            field_enabled: root.file_loaded && root.num_frames > 1;
            label: "End Frame";
            text <=> root.max_frame;
            error: root.max_frame_error;
            tooltip_text: "Last frame to include in the analysis.\n\n📏 Tip: Use 'End' to include all remaining frames.\n\n🔬 Physics: Selecting a subset of frames can speed up analysis during parameter exploration. Once you find good settings, use the full range for publication-quality results.";
        }
    }

    ValidatedField {
        accessible-role: text-input;
        accessible-label: "Frame Stride";
        field_enabled: root.file_loaded && root.num_frames > 1;
        label: "Frame Stride (1 = all)";
        text <=> root.frame_stride;
        error: root.frame_stride_error;
        stepper: true;
        minimum: 1.0;
        maximum: 10000.0;
        decimals: 0;
        tooltip_text: "Sampling stride between frames (e.g. 10 evaluates every 10th frame).\n\n🔬 Physics: Useful for rapid preliminary screening of long trajectories to save compute time while maintaining statistical convergence.";
    }
}
