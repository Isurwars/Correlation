import { OptionSection } from "OptionSection.slint";
import { ValidatedField } from "ValidatedField.slint";

export component RDFOptionsCard inherits OptionSection {
    title: "Radial Distribution";
    reset_enabled: root.file_loaded;

    in property <bool> file_loaded;
    in-out property <string> r_max;
    in-out property <string> r_bin_width;
    in property <string> r_max_error: "";
    in property <string> r_bin_error: "";

    ValidatedField {
        field_enabled: root.file_loaded;
        label: "RDF Max r (Å)";
        text <=> root.r_max;
        error: root.r_max_error;
        tooltip_text: "Maximum radius for RDF calculations g(r), J(r), G(r).\n\n📏 Recommended: 20 Å (half the simulation box length).\n\n🔬 Physics: Should be ≤ L/2 to avoid self-correlation artifacts from periodic boundary conditions. For liquids, g(r) converges to 1.0 well before this limit.";
    }

    ValidatedField {
        field_enabled: root.file_loaded;
        label: "RDF Bin Width (Å)";
        text <=> root.r_bin_width;
        error: root.r_bin_error;
        tooltip_text: "Bin width for the RDF histograms g(r), J(r), G(r).\n\n📏 Recommended: 0.02 Å.\n\n🔬 Physics: Smaller bins resolve finer features in the pair distribution but increase noise for small systems. 0.02 Å balances resolution and statistical quality for most simulations (>500 atoms).";
    }
}
