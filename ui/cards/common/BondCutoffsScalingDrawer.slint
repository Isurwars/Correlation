import {
    MaterialStyleMetrics,
    MaterialTypography,
    MaterialPalette,
    NumberField,
    FilledButton,
    MaterialText,
    Icon,
    Icons,
    TooltipTarget,
} from "../../material/material.slint";

export component BondCutoffsScalingDrawer inherits VerticalLayout {
    in property <bool> file_loaded;
    in-out property <bool> show_scaling_tools: false;
    in-out property <string> min_factor: "0.6";
    in-out property <string> max_factor: "1.2";
    in-out property <string> global_cutoff: "3.5";

    callback apply_min_factor(float);
    callback apply_max_factor(float);
    callback apply_global_cutoff(float);
    callback set_uniform_cutoff(float);

    spacing: MaterialStyleMetrics.spacing_8;

    Rectangle {
        visible: root.file_loaded;
        height: root.file_loaded ? 28px : 0px;
        clip: true;
        border-radius: MaterialStyleMetrics.border_radius_6;
        background: scaling_toggle_touch.has-hover ? MaterialPalette.surface_container_high : MaterialPalette.surface_container_low;
        border-width: 1px;
        border-color: MaterialPalette.outline_variant;

        scaling_toggle_touch := TooltipTarget {
            mouse-cursor: pointer;
            tooltip_text: "Expand or collapse bulk scaling factors (Min Factor, Max Factor, Global Cutoff).";
            accessible-role: button;
            accessible-label: "Toggle Quick Scaling Tools";
            clicked => {
                root.show_scaling_tools = !root.show_scaling_tools;
            }
        }

        HorizontalLayout {
            padding-left: MaterialStyleMetrics.padding_8;
            padding-right: MaterialStyleMetrics.padding_8;
            alignment: space-between;

            MaterialText {
                text: "Quick Scaling Tools";
                style: MaterialTypography.label_medium;
                color: MaterialPalette.on_surface_variant;
                vertical-alignment: center;
            }

            VerticalLayout {
                alignment: center;
                Icon {
                    width: 18px;
                    height: 18px;
                    source: root.show_scaling_tools ? Icons.arrow_drop_up : Icons.arrow_drop_down;
                    colorize: MaterialPalette.on_surface_variant;
                }
            }
        }
    }

    VerticalLayout {
        visible: root.file_loaded && root.show_scaling_tools;
        height: (root.file_loaded && root.show_scaling_tools) ? self.preferred-height : 0px;
        spacing: MaterialStyleMetrics.spacing_8;

        // Row 1: Min factor (default 0.6)
        HorizontalLayout {
            spacing: 8px;
            TooltipTarget {
                horizontal-stretch: 1;
                min-width: 90px;
                tooltip_text: "Minimum bond distance scaling factor (default: 0.6).\n\n🔬 Scales the sum of covalent/vdW radii to reject unphysically close atomic overlaps.";
                NumberField {
                    width: 100%;
                    enabled: root.file_loaded;
                    label: "Min Factor";
                    text <=> root.min_factor;
                    step: 0.05;
                    minimum: 0.1;
                    maximum: 2.0;
                    decimals: 2;
                }
            }
            FilledButton {
                horizontal-stretch: 0;
                enabled: root.file_loaded;
                text: "Apply Min";
                tooltip: "Recalculate and apply minimum distance thresholds across all atom pairs.";
                clicked => {
                    root.apply_min_factor(root.min_factor.to-float());
                }
            }
        }

        // Row 2: Max factor (default 1.2)
        HorizontalLayout {
            spacing: 8px;
            TooltipTarget {
                horizontal-stretch: 1;
                min-width: 90px;
                tooltip_text: "Maximum bond distance scaling factor (default: 1.2).\n\n🔬 Scales the sum of covalent/vdW radii to capture the first coordination shell.";
                NumberField {
                    width: 100%;
                    enabled: root.file_loaded;
                    label: "Max Factor";
                    text <=> root.max_factor;
                    step: 0.05;
                    minimum: 0.5;
                    maximum: 3.0;
                    decimals: 2;
                }
            }
            FilledButton {
                horizontal-stretch: 0;
                enabled: root.file_loaded;
                text: "Apply Max";
                tooltip: "Recalculate and apply maximum distance thresholds across all atom pairs.";
                clicked => {
                    root.apply_max_factor(root.max_factor.to-float());
                }
            }
        }

        // Row 3: Global cutoff (default 3.5)
        HorizontalLayout {
            spacing: 8px;
            TooltipTarget {
                horizontal-stretch: 1;
                min-width: 90px;
                tooltip_text: "Global uniform cutoff in Ångströms (default: 3.5 Å).\n\n🔬 Sets an identical isotropic cutoff across all pairs.";
                NumberField {
                    width: 100%;
                    enabled: root.file_loaded;
                    label: "Global Cutoff";
                    text <=> root.global_cutoff;
                    step: 0.1;
                    minimum: 0.5;
                    maximum: 20.0;
                    decimals: 2;
                }
            }
            FilledButton {
                horizontal-stretch: 0;
                enabled: root.file_loaded;
                text: "Set Global";
                tooltip: "Apply the uniform global cutoff distance across all matrix entries.";
                clicked => {
                    root.apply_global_cutoff(root.global_cutoff.to-float());
                }
            }
        }
    }
}

