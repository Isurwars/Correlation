import {
    MaterialStyleMetrics,
    MaterialTypography,
    MaterialPalette,
    OutlinedCard,
    ExpandableHeader,
    TextField,
    FilledButton,
    MaterialText,
    Vertical,
    Horizontal,
    Matrix,
    TabItem,
} from "../../material/material.slint";
import { BondCutoff, AtomCount } from "../../Types.slint";

export component BondCutoffsCard inherits OutlinedCard {
    in-out property <bool> expanded: true;
    in property <bool> file_loaded;
    in property <[AtomCount]> atom_counts;
    in-out property <[BondCutoff]> bond_cutoffs;
    in property <int> bond_cutoffs_reset_trigger: 0;
    in-out property <string> min_factor: "0.6";
    in-out property <string> max_factor: "1.2";
    in-out property <string> global_cutoff: "3.5";
    in-out property <string> scale_factor: "1.15";
    in-out property <string> uniform_cutoff: "3.5";
    callback reset_bond_cutoffs();
    callback apply_min_factor(float);
    callback apply_max_factor(float);
    callback apply_global_cutoff(float);
    callback apply_scaled_cutoffs(float);
    callback set_uniform_cutoff(float);

    pure function get_flat_index(i: int, j: int, N: int) -> int {
        let r = min(i, j);
        let c = max(i, j);
        let r_term = (r == 0) ? 0 : 
                     (r == 1) ? 1 : 
                     (r == 2) ? 3 : 
                     (r == 3) ? 6 : 
                     (r == 4) ? 10 : 
                     (r == 5) ? 15 : 
                     (r == 6) ? 21 : 
                     (r == 7) ? 28 : 
                     (r == 8) ? 36 : 
                     (r == 9) ? 45 : 
                     (r == 10) ? 55 : 
                     (r == 11) ? 66 : 
                     (r == 12) ? 78 : 
                     (r == 13) ? 91 : 
                     (r == 14) ? 105 : 120;
        return r * N - r_term + c;
    }

    pure function pair_has_error(r: int, c: int) -> bool {
        let idx = root.get_flat_index(min(r, c), max(r, c), root.atom_counts.length);
        if (idx < root.bond_cutoffs.length) {
            let min_val = root.bond_cutoffs[idx].min_distance.to-float();
            let max_val = root.bond_cutoffs[idx].max_distance.to-float();
            return min_val >= max_val || min_val < 0.0 || max_val <= 0.0;
        }
        return false;
    }

    out property <string> hovered_tooltip_text:
        !root.file_loaded ? "" :
        (min_factor_area.has-hover ? "Minimum bond distance scaling factor (default: 0.6).\n\n🔬 Scales the sum of covalent/vdW radii to reject unphysically close atomic overlaps." :
        apply_min_area.has-hover ? "Recalculate and apply minimum distance thresholds across all atom pairs." :
        max_factor_area.has-hover ? "Maximum bond distance scaling factor (default: 1.2).\n\n🔬 Scales the sum of covalent/vdW radii to capture the first coordination shell." :
        apply_max_area.has-hover ? "Recalculate and apply maximum distance thresholds across all atom pairs." :
        global_cutoff_area.has-hover ? "Global uniform cutoff in Ångströms (default: 3.5 Å).\n\n🔬 Sets an identical isotropic cutoff across all pairs." :
        apply_global_area.has-hover ? "Apply the global cutoff distance across all matrix entries." :
        matrix_legend_area.has-hover ? "Pairwise bond cutoffs matrix in Ångströms.\n\n▲ Upper Triangle: Max distance (bonding cutoff)\n▼ Lower Triangle: Min distance (core exclusion)\n\n✏️ Direct Editing: Click any cell in the table below to customize individual pair limits." : "");

    out property <length> hovered_x:
        !root.file_loaded ? 0px :
        (min_factor_area.has-hover ? min_factor_area.absolute-position.x + min_factor_area.mouse-x :
        apply_min_area.has-hover ? apply_min_area.absolute-position.x + apply_min_area.mouse-x :
        max_factor_area.has-hover ? max_factor_area.absolute-position.x + max_factor_area.mouse-x :
        apply_max_area.has-hover ? apply_max_area.absolute-position.x + apply_max_area.mouse-x :
        global_cutoff_area.has-hover ? global_cutoff_area.absolute-position.x + global_cutoff_area.mouse-x :
        apply_global_area.has-hover ? apply_global_area.absolute-position.x + apply_global_area.mouse-x :
        matrix_legend_area.has-hover ? matrix_legend_area.absolute-position.x + matrix_legend_area.mouse-x : 0px);

    out property <length> hovered_y:
        !root.file_loaded ? 0px :
        (min_factor_area.has-hover ? min_factor_area.absolute-position.y + min_factor_area.mouse-y :
        apply_min_area.has-hover ? apply_min_area.absolute-position.y + apply_min_area.mouse-y :
        max_factor_area.has-hover ? max_factor_area.absolute-position.y + max_factor_area.mouse-y :
        apply_max_area.has-hover ? apply_max_area.absolute-position.y + apply_max_area.mouse-y :
        global_cutoff_area.has-hover ? global_cutoff_area.absolute-position.y + global_cutoff_area.mouse-y :
        apply_global_area.has-hover ? apply_global_area.absolute-position.y + apply_global_area.mouse-y :
        matrix_legend_area.has-hover ? matrix_legend_area.absolute-position.y + matrix_legend_area.mouse-y : 0px);

    out property <length> hovered_width: 0px;
    out property <length> hovered_height: 0px;

    Vertical {
        padding: MaterialStyleMetrics.spacing_8;
        spacing: MaterialStyleMetrics.spacing_8;

        ExpandableHeader {
            text: "Bond Cutoffs";
            expanded <=> root.expanded;
            show_reset: true;
            reset_enabled: root.file_loaded;
            reset => {
                root.min_factor = "0.6";
                root.max_factor = "1.2";
                root.global_cutoff = "3.5";
                root.reset_bond_cutoffs();
            }
        }

        Vertical {
            height: root.expanded ? self.preferred-height : 0px;
            visible: self.height > 0px;
            opacity: root.expanded ? 1.0 : 0.0;
            padding: 0;
            spacing: MaterialStyleMetrics.spacing_8;
            animate height, opacity {
                duration: 250ms;
                easing: ease-in-out;
            }

            if (!root.file_loaded): MaterialText {
                text: "No file loaded.";
                color: MaterialPalette.on_surface_variant;
            }

            matrix_legend_area := TouchArea {
                visible: root.file_loaded;
                height: root.file_loaded ? self.preferred-height : 0px;
                HorizontalLayout {
                    spacing: 12px;
                    alignment: start;

                    // Upper / Max badge
                    HorizontalLayout {
                        spacing: 4px;
                        alignment: center;
                        Rectangle {
                            width: 10px;
                            height: 10px;
                            border-radius: 2px;
                            background: MaterialPalette.primary;
                        }
                        MaterialText {
                            text: "▲ Upper: Max (Å)";
                            style: MaterialTypography.label_small;
                            font_size: 11px;
                            color: MaterialPalette.on_surface_variant;
                        }
                    }

                    // Lower / Min badge
                    HorizontalLayout {
                        spacing: 4px;
                        alignment: center;
                        Rectangle {
                            width: 10px;
                            height: 10px;
                            border-radius: 2px;
                            background: MaterialPalette.tertiary;
                        }
                        MaterialText {
                            text: "▼ Lower: Min (Å)";
                            style: MaterialTypography.label_small;
                            font_size: 11px;
                            color: MaterialPalette.on_surface_variant;
                        }
                    }
                }
            }

            VerticalLayout {
                visible: root.file_loaded;
                height: root.file_loaded ? self.preferred-height : 0px;
                spacing: MaterialStyleMetrics.spacing_8;

                // Row 1: Min factor (default 0.6)
                HorizontalLayout {
                    spacing: 8px;
                    min_factor_area := TouchArea {
                        horizontal-stretch: 1;
                        min-width: 90px;
                        TextField {
                            width: 100%;
                            enabled: root.file_loaded;
                            label: "Min Factor";
                            text <=> root.min_factor;
                        }
                    }
                    apply_min_area := TouchArea {
                        horizontal-stretch: 0;
                        FilledButton {
                            enabled: root.file_loaded;
                            text: "Apply Min";
                            clicked => {
                                root.apply_min_factor(root.min_factor.to-float());
                            }
                        }
                    }
                }

                // Row 2: Max factor (default 1.2)
                HorizontalLayout {
                    spacing: 8px;
                    max_factor_area := TouchArea {
                        horizontal-stretch: 1;
                        min-width: 90px;
                        TextField {
                            width: 100%;
                            enabled: root.file_loaded;
                            label: "Max Factor";
                            text <=> root.max_factor;
                        }
                    }
                    apply_max_area := TouchArea {
                        horizontal-stretch: 0;
                        FilledButton {
                            enabled: root.file_loaded;
                            text: "Apply Max";
                            clicked => {
                                root.apply_max_factor(root.max_factor.to-float());
                            }
                        }
                    }
                }

                // Row 3: Global cutoff (default 3.5)
                HorizontalLayout {
                    spacing: 8px;
                    global_cutoff_area := TouchArea {
                        horizontal-stretch: 1;
                        min-width: 90px;
                        TextField {
                            width: 100%;
                            enabled: root.file_loaded;
                            label: "Global Cutoff";
                            text <=> root.global_cutoff;
                        }
                    }
                    apply_global_area := TouchArea {
                        horizontal-stretch: 0;
                        FilledButton {
                            enabled: root.file_loaded;
                            text: "Set Global";
                            clicked => {
                                root.apply_global_cutoff(root.global_cutoff.to-float());
                                root.set_uniform_cutoff(root.global_cutoff.to-float());
                            }
                        }
                    }
                }
            }

            if (root.file_loaded): Matrix {
                headers: root.atom_counts;
                enabled: root.file_loaded;
                reset_trigger: root.bond_cutoffs_reset_trigger;

                cell_value(r, c) => {
                    let r_idx = min(r, c);
                    let c_idx = max(r, c);
                    let idx = root.get_flat_index(r_idx, c_idx, root.atom_counts.length);
                    if (idx < root.bond_cutoffs.length) {
                        return (c > r) ? root.bond_cutoffs[idx].max_distance : root.bond_cutoffs[idx].min_distance;
                    }
                    return "";
                }

                diagonal_max_value(i) => {
                    let idx = root.get_flat_index(i, i, root.atom_counts.length);
                    if (idx < root.bond_cutoffs.length) {
                        return root.bond_cutoffs[idx].max_distance;
                    }
                    return "";
                }

                diagonal_min_value(i) => {
                    let idx = root.get_flat_index(i, i, root.atom_counts.length);
                    if (idx < root.bond_cutoffs.length) {
                        return root.bond_cutoffs[idx].min_distance;
                    }
                    return "";
                }

                cell_has_error(r, c) => {
                    return root.pair_has_error(r, c);
                }

                cell_edited(r, c, val) => {
                    let r_idx = min(r, c);
                    let c_idx = max(r, c);
                    let idx = root.get_flat_index(r_idx, c_idx, root.atom_counts.length);
                    if (idx < root.bond_cutoffs.length) {
                        if (c > r) {
                            root.bond_cutoffs[idx].max_distance = val;
                        } else {
                            root.bond_cutoffs[idx].min_distance = val;
                        }
                    }
                }

                diagonal_max_edited(i, val) => {
                    let idx = root.get_flat_index(i, i, root.atom_counts.length);
                    if (idx < root.bond_cutoffs.length) {
                        root.bond_cutoffs[idx].max_distance = val;
                    }
                }

                diagonal_min_edited(i, val) => {
                    let idx = root.get_flat_index(i, i, root.atom_counts.length);
                    if (idx < root.bond_cutoffs.length) {
                        root.bond_cutoffs[idx].min_distance = val;
                    }
                }
            }
        }
    }
}
