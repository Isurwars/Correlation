import {
    MaterialAnimations,
    MaterialStyleMetrics,
    OutlinedCard,
    ExpandableHeader,
    Vertical,
} from "../../material/material.slint";

/// Collapsible OutlinedCard section with an ExpandableHeader and animated body.
export component OptionSection inherits OutlinedCard {
    in property <string> title;
    in-out property <bool> expanded: true;
    in property <bool> show_reset: true;
    in property <bool> reset_enabled: true;
    in property <string> header_tooltip: "";
    in property <string> reset_tooltip: "Reset this section's parameters to their default values.";
    callback reset();

    Vertical {
        padding: MaterialStyleMetrics.spacing_8;
        spacing: MaterialStyleMetrics.spacing_8;

        ExpandableHeader {
            text: root.title;
            expanded <=> root.expanded;
            show_reset: root.show_reset;
            reset_enabled: root.reset_enabled;
            header_tooltip: root.header_tooltip;
            reset_tooltip: root.reset_tooltip;
            reset => { root.reset(); }
        }

        Vertical {
            height: root.expanded ? self.preferred-height : 0px;
            visible: self.height > 0px;
            opacity: root.expanded ? 1.0 : 0.0;
            padding: 0;
            spacing: MaterialStyleMetrics.spacing_8;
            animate height, opacity {
                duration: MaterialAnimations.base_duration;
                easing: ease-in-out;
            }

            @children
        }
    }
}
