import { TextField } from "../../material/material.slint";

/// Full-width TextField wrapped in a TouchArea for tooltip hover coordinates.
export component ValidatedField inherits TouchArea {
    in property <string> label;
    in-out property <string> text;
    in property <string> error: "";
    in property <bool> field_enabled: true;

    out property <length> hover_x: self.absolute-position.x + self.mouse-x;
    out property <length> hover_y: self.absolute-position.y + self.mouse-y;


    TextField {
        enabled: root.field_enabled;
        width: 100%;
        label: root.label;
        text <=> root.text;
        has_error: root.error != "";
        supporting_text: root.error;
    }
}
