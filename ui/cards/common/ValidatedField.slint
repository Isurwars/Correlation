import { NumberField, TextField, TooltipState } from "../../material/material.slint";

/// Full-width TextField (or NumberField when stepper is true) wrapped in a TouchArea for tooltip hover coordinates.
export component ValidatedField inherits TouchArea {
    in property <string> label;
    in-out property <string> text;
    in property <string> error: "";
    in property <bool> field_enabled: true;
    in property <string> tooltip_text: "";
    in property <bool> stepper: false;
    in property <float> step: 1.0;
    in property <float> minimum: 0.0;
    in property <float> maximum: 1000000.0;
    in property <int> decimals: 1;

    out property <length> hover_x: self.absolute-position.x + self.mouse-x;
    out property <length> hover_y: self.absolute-position.y + self.mouse-y;

    changed has-hover => {
        if (self.has-hover && root.tooltip_text != "") {
            TooltipState.active = {
                text: root.tooltip_text,
                x: self.absolute-position.x + self.mouse-x,
                y: self.absolute-position.y + self.mouse-y,
                width: 0px,
                height: 0px,
            };
        } else if (root.tooltip_text != "" && TooltipState.active.text == root.tooltip_text) {
            TooltipState.active = { text: "", x: 0px, y: 0px, width: 0px, height: 0px };
        }
    }

    min-height: content.min-height;
    preferred-height: content.preferred-height;

    content := VerticalLayout {
        if !root.stepper: TextField {
            enabled: root.field_enabled;
            width: 100%;
            label: root.label;
            text <=> root.text;
            has_error: root.error != "";
            supporting_text: root.error;
        }

        if root.stepper: NumberField {
            enabled: root.field_enabled;
            width: 100%;
            label: root.label;
            text <=> root.text;
            has_error: root.error != "";
            supporting_text: root.error;
            step: root.step;
            minimum: root.minimum;
            maximum: root.maximum;
            decimals: root.decimals;
        }
    }
}
