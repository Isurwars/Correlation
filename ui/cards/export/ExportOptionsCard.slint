import {
    MaterialStyleMetrics,
    MaterialPalette,
    MaterialTypography,
    MaterialText,
    OutlinedCard,
    ExpandableHeader,
    CheckBoxRow,
    Chip,
    FilledButton,
    Vertical,
    Horizontal,
    Icons,
    TooltipTarget,
} from "../../material/material.slint";
import { ExportFormatOptions, ExportAnalysisItem } from "../../Types.slint";

export component ExportOptionsCard inherits OutlinedCard {
    in-out property <bool> expanded: true;
    in property <bool> enabled: true;
    in property <bool> analysis_done: false;
    in property <bool> hdf5_available: true;
    in property <bool> parquet_available: true;

    in-out property <ExportFormatOptions> format_options: {
        export_csv: true,
        export_hdf5: false,
        export_arrow: false,
        export_images: true,
        use_zip: false,
    };
    in-out property <[ExportAnalysisItem]> export_analysis_items: [];
    in-out property <bool> export_all_analyses: true;

    callback toggle_export_analysis(string, bool);
    callback toggle_all_export_analyses(bool);
    callback write_files();
    callback export_structure();
    callback reset();

    Vertical {
        padding: MaterialStyleMetrics.spacing_8;
        spacing: MaterialStyleMetrics.spacing_8;

        ExpandableHeader {
            text: "Export Options";
            expanded <=> root.expanded;
            show_reset: true;
            reset_enabled: root.enabled;
            reset => { root.reset(); }
        }

        Vertical {
            height: root.expanded ? self.preferred-height : 0px;
            visible: self.height > 0px;
            opacity: root.expanded ? 1.0 : 0.0;
            padding: 0;
            spacing: MaterialStyleMetrics.spacing_8;
            animate height, opacity {
                duration: 250ms;
                easing: ease-in-out;
            }

            // Section: File Formats
            MaterialText {
                text: "Export Formats";
                style: MaterialTypography.label_medium;
                color: MaterialPalette.on_surface_variant;
            }

            Vertical {
                spacing: MaterialStyleMetrics.spacing_4;
                padding-left: MaterialStyleMetrics.spacing_4;

                CheckBoxRow {
                    text: "Comma Separated Values (.csv)";
                    check_state_bool: root.format_options.export_csv;
                    enabled: root.enabled;
                    tooltip_text: "Export standard tabular Comma-Separated Values into csv/ directory.\n\n📄 Contains normalized distribution values and coordinate grids.";
                    checked_state_changed(val) => {
                        root.format_options.export_csv = val;
                    }
                }

                CheckBoxRow {
                    text: "Plots & Figures (.svg)";
                    check_state_bool: root.format_options.export_images;
                    enabled: root.enabled;
                    tooltip_text: "Export publication-quality vector plots into plots/ directory.\n\n📊 High-resolution SVG files formatted using current plot styling settings.";
                    checked_state_changed(val) => {
                        root.format_options.export_images = val;
                    }
                }

                TooltipTarget {
                    tooltip_text: root.hdf5_available
                        ? "Export hierarchical binary HDF5 dataset into hdf5/analysis.h5.\n\n💾 Ideal for large datasets, multi-frame trajectories, and Python/SciPy pipelines."
                        : "HDF5 support was disabled at build time (CORRELATION_USE_HDF5=OFF).";
                    CheckBoxRow {
                        text: root.hdf5_available ? "Hierarchical Data Format (.h5)" : "HDF5 (.h5 — Unavailable)";
                        check_state_bool: root.format_options.export_hdf5 && root.hdf5_available;
                        enabled: root.enabled && root.hdf5_available;
                        checked_state_changed(val) => {
                            root.format_options.export_hdf5 = val;
                        }
                    }
                }

                TooltipTarget {
                    tooltip_text: root.parquet_available
                        ? "Export high-throughput Apache Arrow/Parquet columnar tables into arrow/ directory.\n\n⚡ Optimized for Polars, DuckDB, Pandas, and fast analytics."
                        : "Apache Arrow/Parquet support was disabled at build time (CORRELATION_USE_ARROW=OFF).";
                    CheckBoxRow {
                        text: root.parquet_available ? "Apache Arrow / Parquet (.parquet)" : "Parquet (.parquet — Unavailable)";
                        check_state_bool: root.format_options.export_arrow && root.parquet_available;
                        enabled: root.enabled && root.parquet_available;
                        checked_state_changed(val) => {
                            root.format_options.export_arrow = val;
                        }
                    }
                }
            }

            if root.analysis_done && root.export_analysis_items.length > 0: VerticalLayout {
                spacing: MaterialStyleMetrics.spacing_4;

                Rectangle {
                    height: 1px;
                    background: MaterialPalette.outline_variant;
                }

                MaterialText {
                    text: "Included Analyses";
                    style: MaterialTypography.label_medium;
                    color: MaterialPalette.on_surface_variant;
                }

                CheckBoxRow {
                    text: "Export all computed analyses (" + root.export_analysis_items.length + ")";
                    check_state_bool: root.export_all_analyses;
                    enabled: root.enabled;
                    tooltip_text: "Uncheck to hand-pick individual computed distributions for export.";
                    checked_state_changed(val) => {
                        root.export_all_analyses = val;
                        if (val) {
                            root.toggle_all_export_analyses(true);
                        }
                    }
                }

                if !root.export_all_analyses: VerticalLayout {
                    padding-left: MaterialStyleMetrics.spacing_8;
                    spacing: MaterialStyleMetrics.spacing_2;

                    HorizontalLayout {
                        spacing: MaterialStyleMetrics.spacing_4;
                        Chip {
                            label: "All";
                            outlined: false;
                            clicked => { root.toggle_all_export_analyses(true); }
                        }
                        Chip {
                            label: "None";
                            outlined: false;
                            clicked => { root.toggle_all_export_analyses(false); }
                        }
                    }

                    for item in root.export_analysis_items: CheckBoxRow {
                        text: item.name;
                        check_state_bool: item.enabled;
                        enabled: root.enabled;
                        checked_state_changed(val) => {
                            root.toggle_export_analysis(item.id, val);
                        }
                    }
                }
            }

            Rectangle {
                height: 1px;
                background: MaterialPalette.outline_variant;
            }

            // Section: Archive Packaging
            MaterialText {
                text: "Packaging";
                style: MaterialTypography.label_medium;
                color: MaterialPalette.on_surface_variant;
            }

            Vertical {
                spacing: MaterialStyleMetrics.spacing_4;
                padding-left: MaterialStyleMetrics.spacing_4;

                CheckBoxRow {
                    text: "Create consolidated ZIP archive";
                    check_state_bool: root.format_options.use_zip;
                    enabled: root.enabled;
                    tooltip_text: "Package all selected formats into a single compressed .zip file archive.\n\n📦 If unchecked (default), exports a clean categorized folder with subdirectories.";
                    checked_state_changed(val) => {
                        root.format_options.use_zip = val;
                    }
                }
            }

            // Export Action Button
            TooltipTarget {
                height: 38px;
                tooltip_text: !root.analysis_done ? "Run an analysis first (Ctrl+R) before exporting distribution data." : "";
                FilledButton {
                    width: 100%;
                    height: 100%;
                    text: root.format_options.use_zip ? "Export ZIP Archive (Ctrl+S)" : "Export Categorized Folder (Ctrl+S)";
                    enabled: root.enabled && root.analysis_done;
                    background: MaterialPalette.primary;
                    text_color: MaterialPalette.on_primary;
                    clicked => {
                        root.write_files();
                    }
                }
            }

            Rectangle {
                height: 1px;
                background: MaterialPalette.outline_variant;
            }

            // Section: Structure Format Translation
            MaterialText {
                text: "Structure Translator";
                style: MaterialTypography.label_medium;
                color: MaterialPalette.on_surface_variant;
            }

            FilledButton {
                height: 38px;
                text: "Convert / Export Cell (Ctrl+E)";
                icon: Icons.save;
                enabled: root.enabled;
                background: MaterialPalette.secondary;
                text_color: MaterialPalette.on_secondary;
                clicked => {
                    root.export_structure();
                }
            }
        }
    }
}
