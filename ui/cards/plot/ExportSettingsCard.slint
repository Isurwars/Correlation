import {
    MaterialStyleMetrics,
    MaterialPalette,
    MaterialText,
    FilledButton,
    InfoRow,
    Icons,
} from "../../material/material.slint";
import { OptionSection } from "../common/OptionSection.slint";

export component ExportSettingsCard inherits OptionSection {
    title: "Publication Plot Settings";
    reset_enabled: root.enabled;
    in property <bool> enabled: true;

    in property <int> export_size_preset: 0;
    in property <int> export_palette: 0;
    in property <string> export_font_scale: "1.0";
    in property <string> export_line_width: "3.0";

    callback open_style_inspector();

    property <[string]> size_labels: [
        "Default (1200×900)",
        "Single Column (3.5\")",
        "Double Column (7.0\")",
        "Presentation (10.0\")",
    ];

    property <[string]> palette_labels: [
        "Okabe-Ito",
        "Grayscale",
        "Viridis",
        "Magma",
        "Heatmap",
        "Rainbow",
        "Turbo",
        "Plasma",
        "Inferno",
        "Cividis",
    ];

    InfoRow {
        label: "Figure Size:";
        value: (root.export_size_preset >= 0 && root.export_size_preset < root.size_labels.length)
            ? root.size_labels[root.export_size_preset]
            : "Default";
    }

    InfoRow {
        label: "Palette:";
        value: (root.export_palette >= 0 && root.export_palette < root.palette_labels.length)
            ? root.palette_labels[root.export_palette]
            : "Okabe-Ito";
    }

    InfoRow {
        label: "Typography & Stroke:";
        value: "Font ×" + root.export_font_scale + " • " + root.export_line_width + " pt";
    }

    FilledButton {
        height: 36px;
        text: "Open Style & Axes Inspector";
        icon: Icons.tune;
        background: MaterialPalette.surface_container_highest;
        text_color: MaterialPalette.primary;
        clicked => { root.open_style_inspector(); }
    }
}
