import {
    MaterialPalette,
    MaterialStyleMetrics,
    MaterialTypography,
    MaterialText,
    FilledButton,
    Horizontal,
    Vertical,
    Icons,
    ScrollView,
    CheckBoxRow,
} from "../../material/material.slint";
import { OptionSection } from "../common/OptionSection.slint";
import { ComparisonCurveData } from "../../Types.slint";

// ============================================================================
// ComparisonOverlayCard Component
// ============================================================================
export component ComparisonOverlayCard inherits OptionSection {
    title: "Analysis Comparison Overlay";
    expanded: false;
    reset_enabled: root.pinned_runs_count > 0 || root.comparison_curves.length > 0;
    reset => { root.clear_comparison_curves(); }
    in property <bool> enabled: true;
    in property <[ComparisonCurveData]> comparison_curves: [];
    in property <int> pinned_runs_count: 0;
    in property <bool> show_difference: false;

    callback import_comparison_file();
    callback remove_comparison_curve(int);
    callback toggle_difference_plot(bool);
    callback pin_current_run();
    callback clear_comparison_curves();

            FilledButton {
                height: MaterialStyleMetrics.size_40;
                text: "Pin Current Run";
                icon: Icons.pin;
                tooltip: "Pin currently calculated results to memory for visual overlay against future parameter runs.";
                clicked => { root.pin_current_run(); }
            }

            FilledButton {
                height: MaterialStyleMetrics.size_40;
                text: "Import File...";
                icon: Icons.folder_open;
                tooltip: "Import external reference curve (.csv or .dat) to overlay directly onto the plot.";
                clicked => { root.import_comparison_file(); }
            }

            // Difference Plot Toggle
            CheckBoxRow {
                height: 32px;
                text: "Show Overlaid Absolute Difference (Y_diff = Y_ref - Y_target)";
                check_state_bool: root.show_difference;
                tooltip_text: "Display residual difference curve (Current - Reference) below the distribution function.";
                checked_state_changed(checked) => {
                    root.toggle_difference_plot(checked);
                }
            }

            // Curve Items Table
            if root.comparison_curves.length > 0: ScrollView {
                content-height: root.comparison_curves.length * 36px;
                max-height: 200px;

                VerticalLayout {
                    spacing: 4px;
                    for curve in root.comparison_curves: Rectangle {
                        height: 32px;
                        background: MaterialPalette.surface_container_low;
                        border-radius: MaterialStyleMetrics.border_radius_2;

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 8px;
                            alignment: center;

                            Rectangle {
                                width: 14px;
                                height: 14px;
                                border-radius: 7px;
                                background: curve.color_hex;
                            }

                            MaterialText {
                                horizontal-stretch: 1;
                                text: curve.label;
                                style: MaterialTypography.body_medium;
                                color: MaterialPalette.on_surface;
                            }

                            FilledButton {
                                width: 60px;
                                height: 26px;
                                text: "Remove";
                                clicked => { root.remove_comparison_curve(curve.id); }
                            }
                        }
                    }
                }
            }
}
