import {
    MaterialPalette,
    MaterialStyleMetrics,
    MaterialTypography,
    OutlinedCard,
    ExpandableHeader,
    MaterialText,
    FilledButton,
    Horizontal,
    Vertical,
    Icons,
    ScrollView,
} from "../../material/material.slint";
import { ComparisonCurveData } from "../../Types.slint";

// ============================================================================
// ComparisonOverlayCard Component
// ============================================================================
export component ComparisonOverlayCard inherits OutlinedCard {
    in-out property <bool> expanded: true;
    in property <bool> enabled: true;
    in property <[ComparisonCurveData]> comparison_curves: [];
    in property <bool> show_difference: false;

    callback import_comparison_file();
    callback remove_comparison_curve(int);
    callback toggle_difference_plot(bool);
    callback pin_current_run();
    callback clear_comparison_curves();

    out property <string> hovered_tooltip_text:
        pin_btn_area.has-hover ? "Pin the currently calculated results to memory for instant visual overlay against future parameter runs." :
        import_btn_area.has-hover ? "Import external reference curve (.csv or .dat) to overlay directly onto the plot." :
        diff_toggle_area.has-hover ? "Display residual difference curve (Current - Reference) below the distribution function." : "";

    out property <length> hovered_x:
        pin_btn_area.has-hover ? pin_btn_area.absolute-position.x + pin_btn_area.mouse-x :
        import_btn_area.has-hover ? import_btn_area.absolute-position.x + import_btn_area.mouse-x :
        diff_toggle_area.has-hover ? diff_toggle_area.absolute-position.x + diff_toggle_area.mouse-x : 0px;

    out property <length> hovered_y:
        pin_btn_area.has-hover ? pin_btn_area.absolute-position.y + pin_btn_area.mouse-y :
        import_btn_area.has-hover ? import_btn_area.absolute-position.y + import_btn_area.mouse-y :
        diff_toggle_area.has-hover ? diff_toggle_area.absolute-position.y + diff_toggle_area.mouse-y : 0px;

    out property <length> hovered_width: 0px;
    out property <length> hovered_height: 0px;

    Vertical {
        padding: MaterialStyleMetrics.spacing_8;
        spacing: MaterialStyleMetrics.spacing_8;

        ExpandableHeader {
            text: "Analysis Comparison Overlay";
            expanded <=> root.expanded;
            show_reset: true;
            reset_enabled: root.comparison_curves.length > 0;
            reset => { root.clear_comparison_curves(); }
        }

        Vertical {
            height: root.expanded ? self.preferred-height : 0px;
            visible: self.height > 0px;
            opacity: root.expanded ? 1.0 : 0.0;
            padding: 0;
            spacing: MaterialStyleMetrics.spacing_8;
            animate height, opacity {
                duration: 250ms;
                easing: ease-in-out;
            }

            pin_btn_area := TouchArea {
                height: MaterialStyleMetrics.size_40;
                FilledButton {
                    width: 100%;
                    height: 100%;
                    text: "Pin Current Run";
                    icon: Icons.pin;
                    clicked => { root.pin_current_run(); }
                }
            }

            import_btn_area := TouchArea {
                height: MaterialStyleMetrics.size_40;
                FilledButton {
                    width: 100%;
                    height: 100%;
                    text: "Import File...";
                    icon: Icons.edit;
                    clicked => { root.import_comparison_file(); }
                }
            }

            // Difference Plot Toggle
            diff_toggle_area := TouchArea {
                height: 32px;
                clicked => { root.toggle_difference_plot(!root.show_difference); }

                HorizontalLayout {
                    spacing: MaterialStyleMetrics.spacing_8;
                    alignment: start;

                    Rectangle {
                        width: 18px;
                        height: 18px;
                        border-radius: 4px;
                        background: root.show_difference ? MaterialPalette.primary : MaterialPalette.surface_container_high;
                        border-width: 1px;
                        border-color: MaterialPalette.outline;
                    }

                    MaterialText {
                        text: "Show Overlaid Absolute Difference (Y_diff = Y_ref - Y_target)";
                        style: MaterialTypography.body_medium;
                        color: MaterialPalette.on_surface;
                        vertical-alignment: center;
                    }
                }
            }

            // Curve Items Table
            if root.comparison_curves.length > 0: ScrollView {
                content-height: root.comparison_curves.length * 36px;
                max-height: 200px;

                VerticalLayout {
                    spacing: 4px;
                    for curve in root.comparison_curves: Rectangle {
                        height: 32px;
                        background: MaterialPalette.surface_container_low;
                        border-radius: MaterialStyleMetrics.border_radius_2;

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 8px;
                            alignment: center;

                            Rectangle {
                                width: 14px;
                                height: 14px;
                                border-radius: 7px;
                                background: curve.color_hex;
                            }

                            MaterialText {
                                horizontal-stretch: 1;
                                text: curve.label;
                                style: MaterialTypography.body_medium;
                                color: MaterialPalette.on_surface;
                                overflow: elide;
                            }

                            FilledButton {
                                width: 60px;
                                height: 26px;
                                text: "Remove";
                                clicked => { root.remove_comparison_curve(curve.id); }
                            }
                        }
                    }
                }
            }
        }
    }
}
