import {
    MaterialStyleMetrics,
    MaterialPalette,
    MaterialTypography,
    MaterialText,
    OutlinedCard,
    InfoRow,
    Horizontal,
    Vertical,
    TooltipTarget,
} from "../../material/material.slint";
import { PhysicsDiagnostics } from "../../Types.slint";

component RegimeBadge inherits Rectangle {
    in property <string> label;
    in property <int> level: 0; // 0: neutral/info, 1: success, 2: warning

    height: 22px;
    border-radius: MaterialStyleMetrics.border_radius_8;
    background:
        root.level == 1 ? MaterialPalette.success_container :
        root.level == 2 ? MaterialPalette.warning_container :
        MaterialPalette.surface_container_highest;
    border-width: 1px;
    border-color:
        root.level == 1 ? MaterialPalette.success.with_alpha(45%) :
        root.level == 2 ? MaterialPalette.warning.with_alpha(45%) :
        MaterialPalette.outline_variant;

    Horizontal {
        padding-left: MaterialStyleMetrics.padding_8;
        padding-right: MaterialStyleMetrics.padding_8;
        spacing: MaterialStyleMetrics.spacing_6;
        alignment: center;

        Rectangle {
            width: 6px;
            height: 6px;
            border-radius: 3px;
            y: (parent.height - self.height) / 2;
            background:
                root.level == 1 ? MaterialPalette.success :
                root.level == 2 ? MaterialPalette.warning :
                MaterialPalette.primary;
        }

        MaterialText {
            text: root.label;
            style: MaterialTypography.label_small;
            font_weight: 600;
            color:
                root.level == 1 ? MaterialPalette.on_success_container :
                root.level == 2 ? MaterialPalette.on_warning_container :
                MaterialPalette.on_surface_variant;
            vertical-alignment: center;
        }
    }
}

export component DynamicPropertiesCard inherits OutlinedCard {
    in property <PhysicsDiagnostics> diagnostics: {
        deborah_level: -1,
        hyper_level: -1,
        electronic_level: -1,
        eliashberg_level: -1,
    };

    out property <bool> has_dynamics:
        root.diagnostics.diff_msd != "" ||
        root.diagnostics.diff_vacf != "" ||
        root.diagnostics.relaxation_time != "" ||
        root.diagnostics.deborah_number != "";

    out property <bool> has_hyperuniformity:
        root.diagnostics.hyper_beta != "" ||
        root.diagnostics.hyper_chi_h != "" ||
        root.diagnostics.hyper_h_index != "" ||
        root.diagnostics.hyper_alpha != "" ||
        root.diagnostics.hyper_verdict != "";

    out property <bool> has_electronic:
        root.diagnostics.electronic_fermi_dos != "" ||
        root.diagnostics.electronic_band_gap != "" ||
        root.diagnostics.electronic_regime != "";

    out property <bool> has_eliashberg:
        root.diagnostics.eliashberg_lambda != "" ||
        root.diagnostics.eliashberg_omega_log != "" ||
        root.diagnostics.eliashberg_tc != "" ||
        root.diagnostics.eliashberg_regime != "";

    out property <bool> has_properties:
        root.has_dynamics || root.has_hyperuniformity || root.has_electronic || root.has_eliashberg;

    visible: root.has_properties;
    height: root.has_properties ? self.preferred-height : 0px;

    Vertical {
        padding: MaterialStyleMetrics.spacing_8;
        spacing: MaterialStyleMetrics.spacing_8;

        MaterialText {
            text: "Calculated Properties & Diagnostics";
            style: MaterialTypography.title_small;
            color: MaterialPalette.on_surface;
        }

        // Dynamics & Deborah Number Section
        if root.has_dynamics: Vertical {
            padding: 0;
            spacing: MaterialStyleMetrics.spacing_4;

            if root.diagnostics.deborah_regime != "": TooltipTarget {
                tooltip_text: "Deborah number regime (De = τ / t_obs).\n\n🔬 Physics: De < 0.1 indicates liquid-like viscous relaxation; 0.1 ≤ De ≤ 10 is viscoelastic; De > 10 indicates solid-like elasticity.";
                Horizontal {
                    padding: 0;
                    spacing: MaterialStyleMetrics.spacing_6;
                    alignment: space-between;

                    MaterialText {
                        text: "Dynamics Regime";
                        style: MaterialTypography.label_small;
                        color: MaterialPalette.on_surface_variant;
                        vertical-alignment: center;
                    }

                    RegimeBadge {
                        label: root.diagnostics.deborah_regime;
                        level: root.diagnostics.deborah_level == 0 ? 1 : (root.diagnostics.deborah_level == 1 ? 2 : 0);
                    }
                }
            }

            if root.diagnostics.diff_msd != "": TooltipTarget {
                tooltip_text: "Self-diffusion coefficient (D) computed from Mean Squared Displacement slope via Einstein relation: ⟨|r(t)-r(0)|²⟩ = 6Dt.\n\n📏 Units: Å²/fs (1 Å²/fs = 10⁻⁵ m²/s).";
                InfoRow {
                    label: "Self-diffusion (MSD):";
                    value: root.diagnostics.diff_msd;
                }
            }

            if root.diagnostics.diff_vacf != "": TooltipTarget {
                tooltip_text: "Self-diffusion coefficient (D) computed from Green-Kubo integral of Velocity Autocorrelation Function: D = (1/3) ∫ ⟨v(t)·v(0)⟩ dt.\n\n📏 Units: Å²/fs (1 Å²/fs = 10⁻⁵ m²/s).";
                InfoRow {
                    label: "Self-diffusion (VACF):";
                    value: root.diagnostics.diff_vacf;
                }
            }

            if root.diagnostics.relaxation_time != "": TooltipTarget {
                tooltip_text: "Velocity autocorrelation decay time scale (τ).\n\n📏 Units: femtoseconds (fs).";
                InfoRow {
                    label: "Relaxation time (τ):";
                    value: root.diagnostics.relaxation_time;
                }
            }

            if root.diagnostics.deborah_number != "": TooltipTarget {
                tooltip_text: "Deborah number (De = τ / t_obs).\n\n🔬 Physics: De ≪ 1 characterizes liquid-like viscous relaxation; De ≫ 1 indicates solid-like elasticity.";
                InfoRow {
                    label: "Deborah number (De):";
                    value: root.diagnostics.deborah_number;
                }
            }
        }

        // Divider when both sections are present
        if root.has_dynamics && root.has_hyperuniformity: Rectangle {
            height: 1px;
            background: MaterialPalette.outline_variant;
        }

        // Hyperuniformity Check Section
        if root.has_hyperuniformity: Vertical {
            padding: 0;
            spacing: MaterialStyleMetrics.spacing_4;

            if root.diagnostics.hyper_verdict != "": TooltipTarget {
                tooltip_text: "Hyperuniformity check combining real-space variance scaling (σ²_N(R) ∝ R^β) and reciprocal-space Torquato-Stillinger index (H = S(0⁺)/S(q_peak)).\n\n🔬 Thresholds: H ≤ 10⁻³ or β ≤ 2.35 → Effectively Hyperuniform; H ≤ 10⁻² or β ≤ 2.70 → Near-Hyperuniform; otherwise Non-Hyperuniform Liquid.";
                Horizontal {
                    padding: 0;
                    spacing: MaterialStyleMetrics.spacing_6;
                    alignment: space-between;

                    MaterialText {
                        text: "Hyperuniformity";
                        style: MaterialTypography.label_small;
                        color: MaterialPalette.on_surface_variant;
                        vertical-alignment: center;
                    }

                    RegimeBadge {
                        label: root.diagnostics.hyper_verdict;
                        level: root.diagnostics.hyper_level;
                    }
                }
            }

            if root.diagnostics.hyper_beta != "": TooltipTarget {
                tooltip_text: "Real-space local number variance scaling exponent β from log-log fit σ²_N(R) ∝ R^β.\n\n🔬 Physics: β ≈ 2 indicates surface-dominated Class I hyperuniformity; 2 < β < 3 indicates Class II/III; β ≈ 3 is standard volume-scaling (non-hyperuniform liquid).";
                InfoRow {
                    label: "Variance slope (β):";
                    value: root.diagnostics.hyper_beta;
                }
            }

            if root.diagnostics.hyper_chi_h != "": TooltipTarget {
                tooltip_text: "Large-R tail average of the real-space hyperuniformity index χ_H(R) = σ²_N(R) / ⟨N(R)⟩.\n\n🔬 Physics: Approaches 0 for hyperuniform systems and ρ k_B T κ_T (isothermal compressibility) for equilibrium liquids.";
                InfoRow {
                    label: "Large-R index χ_H:";
                    value: root.diagnostics.hyper_chi_h;
                }
            }

            if root.diagnostics.hyper_h_index != "": TooltipTarget {
                tooltip_text: "Reciprocal-space Torquato-Stillinger hyperuniformity index H = S(q → 0⁺) / S(q_peak).\n\n🔬 Physics: H ≤ 10⁻³ indicates effective hyperuniformity; H ≤ 10⁻⁴ indicates strong hyperuniformity.";
                InfoRow {
                    label: "Torquato H index:";
                    value: root.diagnostics.hyper_h_index;
                }
            }

            if root.diagnostics.hyper_alpha != "": TooltipTarget {
                tooltip_text: "Low-q power-law scaling exponent α from S(q) ∝ q^α as q → 0⁺.\n\n🔬 Physics: α > 1 (Class I), α = 1 (Class II), 0 < α < 1 (Class III) for hyperuniform systems; α ≈ 0 for equilibrium liquids with finite S(0⁺).";
                InfoRow {
                    label: "Low-q slope (α):";
                    value: root.diagnostics.hyper_alpha;
                }
            }
        }

        // Electronic Structure (LDOS/TDOS) Section
        if (root.has_dynamics || root.has_hyperuniformity) && root.has_electronic: Rectangle {
            height: 1px;
            background: MaterialPalette.outline_variant;
        }

        if root.has_electronic: Vertical {
            padding: 0;
            spacing: MaterialStyleMetrics.spacing_4;

            if root.diagnostics.electronic_regime != "": TooltipTarget {
                tooltip_text: "Electronic regime classified from MLIP LDOS/TDOS around E_F = 0 eV.\n\n🔬 Physics: Metallic (E_g = 0, finite N(E_F)), Semiconducting (0 < E_g ≤ 3.5 eV), or Insulating (E_g > 3.5 eV).";
                Horizontal {
                    padding: 0;
                    spacing: MaterialStyleMetrics.spacing_6;
                    alignment: space-between;

                    MaterialText {
                        text: "Electronic Structure";
                        style: MaterialTypography.label_small;
                        color: MaterialPalette.on_surface_variant;
                        vertical-alignment: center;
                    }

                    RegimeBadge {
                        label: root.diagnostics.electronic_regime;
                        level: root.diagnostics.electronic_level;
                    }
                }
            }

            if root.diagnostics.electronic_fermi_dos != "": TooltipTarget {
                tooltip_text: "Electronic Density of States at the Fermi level N(E_F).\n\n📏 Units: states / eV / atom.";
                InfoRow {
                    label: "Fermi DOS N(E_F):";
                    value: root.diagnostics.electronic_fermi_dos;
                }
            }

            if root.diagnostics.electronic_band_gap != "": TooltipTarget {
                tooltip_text: "Estimated electronic band gap E_g = CBM − VBM around E_F = 0 eV.\n\n📏 Units: eV.";
                InfoRow {
                    label: "Band gap (E_g):";
                    value: root.diagnostics.electronic_band_gap;
                }
            }
        }

        // Superconductivity (Eliashberg α²F(ω)) Section
        if (root.has_dynamics || root.has_hyperuniformity || root.has_electronic) && root.has_eliashberg: Rectangle {
            height: 1px;
            background: MaterialPalette.outline_variant;
        }

        if root.has_eliashberg: Vertical {
            padding: 0;
            spacing: MaterialStyleMetrics.spacing_4;

            if root.diagnostics.eliashberg_regime != "": TooltipTarget {
                tooltip_text: "Hybrid MLIP-VDOS Eliashberg α²F(ω) screening estimate.\n\n⚠️ Note: Estimated from MLIP LDOS deformation sensitivity and 2PT vibrational VDOS rather than full ab-initio DFPT.";
                Horizontal {
                    padding: 0;
                    spacing: MaterialStyleMetrics.spacing_6;
                    alignment: space-between;

                    MaterialText {
                        text: "Eliashberg α²F(ω)";
                        style: MaterialTypography.label_small;
                        color: MaterialPalette.on_surface_variant;
                        vertical-alignment: center;
                    }

                    RegimeBadge {
                        label: root.diagnostics.eliashberg_regime;
                        level: root.diagnostics.eliashberg_level;
                    }
                }
            }

            if root.diagnostics.eliashberg_lambda != "": TooltipTarget {
                tooltip_text: "Electron-phonon coupling constant λ = 2 ∫ [α²F(ω) / ω] dω (dimensionless MLIP-VDOS estimate).";
                InfoRow {
                    label: "Coupling (λ):";
                    value: root.diagnostics.eliashberg_lambda;
                }
            }

            if root.diagnostics.eliashberg_omega_log != "": TooltipTarget {
                tooltip_text: "Logarithmic average phonon frequency ω_log from Eliashberg α²F(ω).\n\n📏 Units: meV (and K).";
                InfoRow {
                    label: "ω_log:";
                    value: root.diagnostics.eliashberg_omega_log;
                }
            }

            if root.diagnostics.eliashberg_tc != "": TooltipTarget {
                tooltip_text: "Allen-Dynes superconducting critical temperature T_c estimate from λ, ω_log, ω_2, and μ*.\n\n📏 Units: Kelvin (K).";
                InfoRow {
                    label: "Allen-Dynes T_c:";
                    value: root.diagnostics.eliashberg_tc;
                }
            }
        }
    }
}
