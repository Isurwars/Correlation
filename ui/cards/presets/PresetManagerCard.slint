import {
    MaterialStyleMetrics,
    MaterialPalette,
    DropDownMenu,
    MenuItem,
    FilledButton,
    Icons,
} from "../../material/material.slint";
import { OptionSection } from "../common/OptionSection.slint";
import { ValidatedField } from "../common/ValidatedField.slint";

export component PresetManagerCard inherits OptionSection {
    title: "Parameter Presets";
    expanded: false;
    reset_enabled: root.enabled && root.selected_preset >= 0;
    in property <bool> enabled: true;

    in property <[MenuItem]> preset_items: [];
    in-out property <int> selected_preset: -1;

    callback load_preset(int);
    callback save_preset(string);
    callback delete_preset(int);

    property <string> save_name: "";

    VerticalLayout {
        spacing: MaterialStyleMetrics.spacing_8;

        DropDownMenu {
            width: 100%;
            label: "Saved Presets";
            enabled: root.enabled && root.preset_items.length > 0;
            tooltip_text: "Select a previously saved preset configuration.";
            items: root.preset_items;
            current_index <=> root.selected_preset;
        }

        HorizontalLayout {
            spacing: MaterialStyleMetrics.spacing_8;
            height: MaterialStyleMetrics.size_40;

            FilledButton {
                horizontal-stretch: 1;
                height: 100%;
                text: "Load Preset";
                enabled: root.enabled && root.selected_preset >= 0 && root.preset_items.length > 0;
                clicked => {
                    root.load_preset(root.selected_preset);
                }
            }

            FilledButton {
                horizontal-stretch: 1;
                height: 100%;
                text: "Delete";
                background: MaterialPalette.error_container;
                text_color: MaterialPalette.on_error_container;
                enabled: root.enabled && root.selected_preset >= 0 && root.preset_items.length > 0;
                clicked => {
                    root.delete_preset(root.selected_preset);
                }
            }
        }
    }

    VerticalLayout {
        spacing: MaterialStyleMetrics.spacing_8;

        ValidatedField {
            label: "New Preset Name";
            field_enabled: root.enabled;
            text <=> root.save_name;
            tooltip_text: "Enter a unique name to save your current parameter settings.";
        }

        FilledButton {
            height: MaterialStyleMetrics.size_40;
            text: "Save Current Options";
            icon: Icons.save;
            enabled: root.enabled && root.save_name != "";
            clicked => {
                root.save_preset(root.save_name);
                root.save_name = "";
            }
        }
    }
}
