import {
    MaterialAnimations,
    MaterialStyleMetrics,
    MaterialTypography,
    MaterialPalette,
    OutlinedCard,
    ExpandableHeader,
    Chip,
    MaterialText,
    Vertical,
} from "../../material/material.slint";
import { CalculatorGroup } from "../../Types.slint";
import { AnalysesGroupSection } from "AnalysesGroupSection.slint";

export component AnalysesSelectionCard inherits OutlinedCard {
    in-out property <bool> expanded: true;
    in-out property <bool> compact_mode: false;
    in property <bool> file_loaded;
    in property <[CalculatorGroup]> calculator_groups: [];
    in property <int> total_calculator_count: 0;
    in property <int> enabled_calculator_count: 0;

    callback toggle_calculator(string, bool);
    callback toggle_calculator_group(string, bool);
    callback toggle_all_calculators(bool);
    callback set_calculator_group_expanded(string, bool);
    callback set_all_calculator_groups_expanded(bool);
    callback reset();

    Vertical {
        padding: MaterialStyleMetrics.spacing_8;
        spacing: MaterialStyleMetrics.spacing_8;

        ExpandableHeader {
            text: root.total_calculator_count > 0 ?
                "Analyses (" + root.enabled_calculator_count + "/" + root.total_calculator_count + ")" :
                "Analyses Selection";
            expanded <=> root.expanded;
            show_reset: true;
            reset_enabled: root.file_loaded;
            reset => { root.reset(); }
        }

        Vertical {
            height: root.expanded ? self.preferred-height : 0px;
            visible: self.height > 0px;
            opacity: root.expanded ? 1.0 : 0.0;
            padding: 0;
            spacing: MaterialStyleMetrics.spacing_8;
            animate height, opacity {
                duration: 250ms;
                easing: ease-in-out;
            }

            // Tree Action Toolbar: Select All / Select None | Compact | Expand / Collapse All
            HorizontalLayout {
                spacing: MaterialStyleMetrics.spacing_4;
                alignment: space-between;

                HorizontalLayout {
                    spacing: MaterialStyleMetrics.spacing_4;

                    Chip {
                        label: "All";
                        enabled: root.file_loaded;
                        selected: root.total_calculator_count > 0 && root.enabled_calculator_count == root.total_calculator_count;
                        tooltip_text: "Enable all available structural and dynamical calculators.";
                        clicked => { root.toggle_all_calculators(true); }
                    }

                    Chip {
                        label: "None";
                        enabled: root.file_loaded;
                        selected: root.total_calculator_count > 0 && root.enabled_calculator_count == 0;
                        tooltip_text: "Disable all calculators.";
                        clicked => { root.toggle_all_calculators(false); }
                    }
                }

                HorizontalLayout {
                    spacing: MaterialStyleMetrics.spacing_4;

                    Chip {
                        label: "Compact";
                        selected: root.compact_mode;
                        tooltip_text: "Toggle compact chip view for calculator groups.";
                        clicked => { root.compact_mode = !root.compact_mode; }
                    }

                    Chip {
                        label: "Expand";
                        tooltip_text: "Expand all calculator category groups.";
                        clicked => { root.set_all_calculator_groups_expanded(true); }
                    }

                    Chip {
                        label: "Collapse";
                        tooltip_text: "Collapse all calculator category groups.";
                        clicked => { root.set_all_calculator_groups_expanded(false); }
                    }
                }
            }

            Vertical {
                padding: 0;
                spacing: MaterialStyleMetrics.spacing_4;
                alignment: start;

                for group[gi] in root.calculator_groups: AnalysesGroupSection {
                    group: group;
                    show_divider: gi > 0;
                    file_loaded: root.file_loaded;
                    compact_mode: root.compact_mode;
                    toggle_calculator(id, enabled) => { root.toggle_calculator(id, enabled); }
                    toggle_calculator_group(grp, enabled) => { root.toggle_calculator_group(grp, enabled); }
                    set_calculator_group_expanded(grp, exp) => { root.set_calculator_group_expanded(grp, exp); }
                }
            }
        }
    }
}
