import {
    MaterialStyleMetrics,
    MaterialPalette,
    ScrollView,
    Vertical,
} from "../../material/material.slint";
import { CalculatorGroup } from "../../Types.slint";
import { AnalysesSelectionCard } from "AnalysesSelectionCard.slint";

// ============================================================================
// AnalysesPanelCard Component (Panel 5)
// ============================================================================
export component AnalysesPanelCard inherits Rectangle {
    in property <bool> file_loaded: false;
    in property <[CalculatorGroup]> calculator_groups: [];
    in property <int> total_calculator_count: 0;
    in property <int> enabled_calculator_count: 0;

    callback toggle_calculator(string, bool);
    callback toggle_calculator_group(string, bool);
    callback toggle_all_calculators(bool);
    callback set_calculator_group_expanded(string, bool);
    callback set_all_calculator_groups_expanded(bool);
    callback reset_analyses_selection();

    out property <string> hovered_tooltip_text:
        analyses_card.hovered_calculator_description != "" ? analyses_card.hovered_calculator_description : "";

    out property <length> hovered_x:
        analyses_card.hovered_calculator_description != "" ? analyses_card.hovered_x : 0px;

    out property <length> hovered_y:
        analyses_card.hovered_calculator_description != "" ? analyses_card.hovered_y : 0px;

    out property <length> hovered_width:
        analyses_card.hovered_calculator_description != "" ? analyses_card.hovered_width : 0px;

    out property <length> hovered_height:
        analyses_card.hovered_calculator_description != "" ? analyses_card.hovered_height : 0px;

    ScrollView {
        width: 100%;
        height: 100%;

        Vertical {
            padding: 0;
            spacing: MaterialStyleMetrics.spacing_8;

            analyses_card := AnalysesSelectionCard {
                file_loaded: root.file_loaded;
                calculator_groups: root.calculator_groups;
                total_calculator_count: root.total_calculator_count;
                enabled_calculator_count: root.enabled_calculator_count;
                toggle_calculator(id, val) => { root.toggle_calculator(id, val); }
                toggle_calculator_group(grp, val) => { root.toggle_calculator_group(grp, val); }
                toggle_all_calculators(val) => { root.toggle_all_calculators(val); }
                set_calculator_group_expanded(grp, exp) => { root.set_calculator_group_expanded(grp, exp); }
                set_all_calculator_groups_expanded(exp) => { root.set_all_calculator_groups_expanded(exp); }
                reset => { root.reset_analyses_selection(); }
            }
        }
    }
}
