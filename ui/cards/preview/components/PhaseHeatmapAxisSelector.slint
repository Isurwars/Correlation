import {
    MaterialStyleMetrics,
    MaterialPalette,
    MaterialTypography,
    MaterialText,
    Chip,
} from "../../../material/material.slint";

export component PhaseHeatmapAxisSelector inherits VerticalLayout {
    in property <int> descriptor_x: 1;
    in property <int> descriptor_y: 0;

    callback set_descriptor_x(int);
    callback set_descriptor_y(int);

    property <[string]> axis_labels: ["q̄₆", "q̄₄", "q₆", "q₄", "ŵ₆", "ŵ₄", "s₂", "N_conn", "q_tet"];

    spacing: MaterialStyleMetrics.spacing_4;

    HorizontalLayout {
        spacing: MaterialStyleMetrics.spacing_4;
        alignment: center;

        MaterialText {
            width: MaterialStyleMetrics.size_32;
            text: "X:";
            style: MaterialTypography.label_small_prominent;
            color: MaterialPalette.on_surface_variant;
            vertical-alignment: center;
        }

        for label[idx] in root.axis_labels: Chip {
            horizontal-stretch: 1;
            chip_height: MaterialStyleMetrics.size_18;
            label: label;
            selected: root.descriptor_x == idx;
            active_bg: MaterialPalette.primary.with_alpha(30%);
            active_fg: MaterialPalette.primary;
            idle_fg: MaterialPalette.on_surface;
            clicked => { root.set_descriptor_x(idx); }
        }
    }

    HorizontalLayout {
        spacing: MaterialStyleMetrics.spacing_4;
        alignment: center;

        MaterialText {
            width: MaterialStyleMetrics.size_32;
            text: "Y:";
            style: MaterialTypography.label_small_prominent;
            color: MaterialPalette.on_surface_variant;
            vertical-alignment: center;
        }

        for label[idx] in root.axis_labels: Chip {
            horizontal-stretch: 1;
            chip_height: MaterialStyleMetrics.size_18;
            label: label;
            selected: root.descriptor_y == idx;
            active_bg: MaterialPalette.secondary.with_alpha(30%);
            active_fg: MaterialPalette.secondary;
            idle_fg: MaterialPalette.on_surface;
            clicked => { root.set_descriptor_y(idx); }
        }
    }
}
