import {
    MaterialPalette,
    MaterialStyleMetrics,
    MaterialTypography,
    MaterialText,
    Horizontal,
    Vertical,
    ScrollView,
    SplitterHandle,
    CheckBoxRow,
    FilledButton,
    DropDownMenu,
    MenuItem,
    Icons,
    TabItem,
} from "../../../material/material.slint";
import { CurveToggleItem, PlotAxisSettings, TaggedPeakRecord, ExportConfig } from "../../../Types.slint";

component CompactInputField inherits Rectangle {
    in-out property <string> text <=> input.text;
    in property <string> placeholder_text: "";
    in property <bool> enabled: true;
    callback accepted(string);
    callback edited(string);

    height: 28px;
    border-radius: MaterialStyleMetrics.border_radius_4;
    background: root.enabled ? MaterialPalette.surface_container_highest : MaterialPalette.surface_container_highest.with_alpha(38%);
    border-width: 1px;
    border-color: input.has-focus ? MaterialPalette.primary : MaterialPalette.outline_variant;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;

        Rectangle {
            horizontal-stretch: 1;

            if root.text == "" && !input.has-focus: MaterialText {
                width: 100%;
                height: 100%;
                text: root.placeholder_text;
                style: MaterialTypography.body_small;
                color: MaterialPalette.on_surface_variant.with_alpha(60%);
                vertical-alignment: center;
            }

            input := TextInput {
                width: 100%;
                height: 100%;
                enabled: root.enabled;
                single-line: true;
                color: root.enabled ? MaterialPalette.on_surface : MaterialPalette.on_surface.with_alpha(38%);
                font-size: MaterialTypography.body_small.font_size;
                vertical-alignment: center;

                accepted => {
                    root.accepted(self.text);
                }
                edited => {
                    root.edited(self.text);
                }
            }
        }
    }
}

export component CurveSidebar inherits Rectangle {
    in property <[CurveToggleItem]> curve_toggle_items: [];
    in-out property <PlotAxisSettings> axis_settings;
    in-out property <ExportConfig> export_config;
    in-out property <int> active_tab: 0; // 0: Curves, 1: Style & Axes, 2: Peaks
    in-out property <int> active_color_picker_id: -1;
    in property <[TaggedPeakRecord]> tagged_peaks: [];
    in-out property <string> curve_filter: "";

    callback filter_curves(string);
    callback invert_curves();
    callback toggle_curve_visibility(int, bool);
    callback toggle_all_curves(bool);
    callback set_curve_color(int, string);
    callback set_curve_width(string);
    callback apply_axis_settings();
    callback reset_axis_settings();
    callback reset_export_settings();
    callback toggle_collapse();
    callback remove_tagged_peak(int);
    callback clear_tagged_peaks();
    callback export_tagged_peaks();

    out property <string> tooltip_text:
        collapse_touch.has-hover ? "Collapse sidebar\n\n⇥ Hide this panel to expand the plot canvas." : "";

    out property <length> tooltip_x:
        collapse_touch.has-hover ? collapse_touch.absolute-position.x + collapse_touch.mouse-x : 0px;

    out property <length> tooltip_y:
        collapse_touch.has-hover ? collapse_touch.absolute-position.y + collapse_touch.mouse-y : 0px;

    private property <[MenuItem]> palette_menu_items: [
        { text: "Okabe-Ito (Colorblind)", enabled: true },
        { text: "Grayscale (B&W)", enabled: true },
        { text: "Viridis", enabled: true },
        { text: "Magma (Continuous)", enabled: true },
        { text: "Heatmap (Continuous)", enabled: true },
        { text: "Rainbow (Continuous)", enabled: true },
        { text: "Turbo (Continuous)", enabled: true },
        { text: "Plasma (Continuous)", enabled: true },
        { text: "Inferno (Continuous)", enabled: true },
        { text: "Cividis (Continuous)", enabled: true }
    ];

    private property <[color]> swatch_colors: [
        #e69f00, #56b4e9, #009e73, #f0e442,
        #0072b2, #d55e00, #cc79a7, #00c49f,
        #1f77b4, #ff7f0e, #2ca02c, #d62728,
        #9467bd, #8c564b, #e377c2, #7f7f7f,
        #bcbd22, #17becf, #332288, #117733,
        #44aa99, #88ccee, #ddcc77, #cc6677
    ];

    private property <[string]> swatch_hexes: [
        "#e69f00", "#56b4e9", "#009e73", "#f0e442",
        "#0072b2", "#d55e00", "#cc79a7", "#00c49f",
        "#1f77b4", "#ff7f0e", "#2ca02c", "#d62728",
        "#9467bd", "#8c564b", "#e377c2", "#7f7f7f",
        "#bcbd22", "#17becf", "#332288", "#117733",
        "#44aa99", "#88ccee", "#ddcc77", "#cc6677"
    ];

    background: MaterialPalette.surface_container_low;
    border-radius: MaterialStyleMetrics.border_radius_2;
    clip: true;

    VerticalLayout {
        width: 100%;
        height: 100%;
        padding: 8px;
        spacing: 8px;

            // 1. Header with Tab Switcher and Collapse Button
            HorizontalLayout {
                spacing: 6px;
                alignment: center;
                height: 32px;

                // Connected Segmented Button Group
                Rectangle {
                    horizontal-stretch: 1;
                    height: 30px;
                    background: MaterialPalette.surface_container;
                    border-radius: MaterialStyleMetrics.border_radius_8;
                    border-width: 1px;
                    border-color: MaterialPalette.outline_variant;
                    clip: true;

                    HorizontalLayout {
                        spacing: 0px;

                        TabItem {
                            horizontal-stretch: 1;
                            compact: true;
                            text: "Curves (" + root.curve_toggle_items.length + ")";
                            active: root.active_tab == 0;
                            clicked => { root.active_tab = 0; }
                        }

                        Rectangle {
                            width: 1px;
                            background: MaterialPalette.outline_variant;
                        }

                        TabItem {
                            horizontal-stretch: 1;
                            compact: true;
                            text: "Style & Axes";
                            active: root.active_tab == 1;
                            clicked => { root.active_tab = 1; }
                        }

                        Rectangle {
                            width: 1px;
                            background: MaterialPalette.outline_variant;
                        }

                        TabItem {
                            horizontal-stretch: 1;
                            compact: true;
                            text: "Peaks (" + root.tagged_peaks.length + ")";
                            active: root.active_tab == 2;
                            clicked => { root.active_tab = 2; }
                        }
                    }
                }

                // Collapse Panel Button
                collapse_touch := TouchArea {
                    width: 26px;
                    height: 26px;
                    mouse-cursor: pointer;
                    clicked => {
                        root.toggle_collapse();
                    }

                    Rectangle {
                        border-radius: MaterialStyleMetrics.border_radius_4;
                        background: collapse_touch.has-hover ? MaterialPalette.surface_container_highest : transparent;

                        MaterialText {
                            text: "⇥";
                            font-size: 15px;
                            font-weight: 600;
                            color: collapse_touch.has-hover ? MaterialPalette.primary : MaterialPalette.on_surface_variant;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // ================================================================
            // Tab 0: Curves & Styling
            // ================================================================
            if root.active_tab == 0: VerticalLayout {
                spacing: 6px;
                vertical-stretch: 1;

                // 1. Search Filter Box
                HorizontalLayout {
                    height: 28px;

                    search_container := Rectangle {
                        horizontal-stretch: 1;
                        height: 28px;
                        border-radius: MaterialStyleMetrics.border_radius_4;
                        background: MaterialPalette.surface_container_highest;
                        border-width: 1px;
                        border-color: search_input.has-focus ? MaterialPalette.primary : MaterialPalette.outline_variant;

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 6px;
                            spacing: 6px;
                            alignment: center;

                            MaterialText {
                                text: "🔍";
                                font-size: 11px;
                                color: MaterialPalette.on_surface_variant;
                                vertical-alignment: center;
                            }

                            Rectangle {
                                horizontal-stretch: 1;

                                if root.curve_filter == "" && !search_input.has-focus: MaterialText {
                                    width: 100%;
                                    height: 100%;
                                    text: "Filter curves (e.g. Fe, O-H)...";
                                    style: MaterialTypography.body_small;
                                    color: MaterialPalette.on_surface_variant.with_alpha(60%);
                                    vertical-alignment: center;
                                }

                                search_input := TextInput {
                                    width: 100%;
                                    height: 100%;
                                    single-line: true;
                                    text <=> root.curve_filter;
                                    color: MaterialPalette.on_surface;
                                    font-size: MaterialTypography.body_small.font_size;
                                    vertical-alignment: center;

                                    edited => {
                                        root.filter_curves(self.text);
                                    }
                                }
                            }

                            if root.curve_filter != "": clear_search_touch := TouchArea {
                                width: 18px;
                                height: 18px;
                                mouse-cursor: pointer;
                                clicked => {
                                    root.curve_filter = "";
                                    root.filter_curves("");
                                }

                                Rectangle {
                                    border-radius: 9px;
                                    background: clear_search_touch.has-hover ? MaterialPalette.surface_container_high : transparent;

                                    MaterialText {
                                        text: "✕";
                                        font-size: 10px;
                                        color: MaterialPalette.on_surface_variant;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }

                // 2. All / None / Invert Batch Visibility Row
                HorizontalLayout {
                    spacing: 4px;
                    alignment: center;

                    MaterialText {
                        horizontal-stretch: 1;
                        text: (root.curve_filter == "") ? "Visibility" : "Matching";
                        style: MaterialTypography.label_small;
                        color: MaterialPalette.on_surface_variant;
                        vertical-alignment: center;
                    }

                    toggle_all_true_area := TouchArea {
                        width: 28px;
                        height: 20px;
                        mouse-cursor: pointer;
                        clicked => { root.toggle_all_curves(true); }

                        MaterialText {
                            text: "All";
                            font-size: 11px;
                            font-weight: 600;
                            color: MaterialPalette.primary;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    MaterialText {
                        text: "/";
                        font-size: 11px;
                        color: MaterialPalette.outline;
                        vertical-alignment: center;
                    }

                    toggle_all_false_area := TouchArea {
                        width: 36px;
                        height: 20px;
                        mouse-cursor: pointer;
                        clicked => { root.toggle_all_curves(false); }

                        MaterialText {
                            text: "None";
                            font-size: 11px;
                            font-weight: 600;
                            color: MaterialPalette.primary;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    MaterialText {
                        text: "/";
                        font-size: 11px;
                        color: MaterialPalette.outline;
                        vertical-alignment: center;
                    }

                    invert_curves_area := TouchArea {
                        width: 38px;
                        height: 20px;
                        mouse-cursor: pointer;
                        clicked => { root.invert_curves(); }

                        MaterialText {
                            text: "Invert";
                            font-size: 11px;
                            font-weight: 600;
                            color: MaterialPalette.primary;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

                // Curves Scrollable List
                ScrollView {
                    vertical-stretch: 1;
                    content-height: root.curve_toggle_items.length * 30px;

                    VerticalLayout {
                        spacing: 2px;
                        alignment: start;

                        for item in root.curve_toggle_items: VerticalLayout {
                            spacing: 0px;
                            padding: 0px;

                            if item.matches_filter: VerticalLayout {
                                spacing: 2px;

                                if item.id == 1 && root.curve_toggle_items.length > 1 && root.curve_filter == "" : HorizontalLayout {
                                    padding-top: 6px;
                                    padding-bottom: 2px;
                                    padding-left: 4px;
                                    MaterialText {
                                        text: "Partials:";
                                        font-size: 11px;
                                        font-weight: 600;
                                        color: MaterialPalette.primary;
                                    }
                                }

                                item_touch := TouchArea {
                                    height: 28px;
                                    mouse-cursor: pointer;
                                    clicked => { root.toggle_curve_visibility(item.id, !item.visible); }

                                    Rectangle {
                                        background: item_touch.has-hover ? MaterialPalette.surface_container_high : transparent;
                                        border-radius: MaterialStyleMetrics.border_radius_2;

                                        HorizontalLayout {
                                            padding-left: (item.label == "Total") ? 6px : 12px;
                                            padding-right: 6px;
                                            spacing: 8px;

                                            Vertical {
                                                alignment: center;
                                                height: 100%;

                                                color_dot_touch := TouchArea {
                                                    width: 18px;
                                                    height: 18px;
                                                    mouse-cursor: pointer;
                                                    clicked => { root.active_color_picker_id = (root.active_color_picker_id == item.id) ? -1 : item.id; }

                                                    Rectangle {
                                                        width: 12px;
                                                        height: 12px;
                                                        border-radius: 6px;
                                                        background: item.visible ? item.color_hex : MaterialPalette.outline;
                                                        border-width: color_dot_touch.has-hover ? 2px : 0px;
                                                        border-color: MaterialPalette.primary;
                                                    }
                                                }
                                            }

                                            MaterialText {
                                                horizontal-stretch: 1;
                                                text: item.label;
                                                style: (item.label == "Total") ? MaterialTypography.label_large : MaterialTypography.body_medium;
                                                color: item.visible ? MaterialPalette.on_surface : MaterialPalette.on_surface_variant;
                                                overflow: elide;
                                                horizontal-alignment: left;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // In-Place Color Palette Picker
                if root.active_color_picker_id >= 0: Rectangle {
                    background: MaterialPalette.surface_container_high;
                    border-radius: MaterialStyleMetrics.border_radius_4;
                    border-width: 1px;
                    border-color: MaterialPalette.outline;

                    VerticalLayout {
                        padding: 8px;
                        spacing: 6px;

                        HorizontalLayout {
                            alignment: center;
                            MaterialText {
                                horizontal-stretch: 1;
                                text: "Select Color";
                                style: MaterialTypography.label_medium;
                                color: MaterialPalette.on_surface;
                                vertical-alignment: center;
                            }

                            TouchArea {
                                width: 20px;
                                height: 20px;
                                mouse-cursor: pointer;
                                clicked => { root.active_color_picker_id = -1; }
                                MaterialText {
                                    text: "✕";
                                    style: MaterialTypography.label_small;
                                    color: MaterialPalette.on_surface_variant;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        VerticalLayout {
                            spacing: 4px;
                            for r_idx in 6: HorizontalLayout {
                                spacing: 4px;
                                alignment: center;
                                for c_idx in 4: swatch_touch := TouchArea {
                                    width: 28px;
                                    height: 24px;
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.set_curve_color(root.active_color_picker_id, root.swatch_hexes[r_idx * 4 + c_idx]);
                                        root.active_color_picker_id = -1;
                                    }
                                    Rectangle {
                                        width: 20px;
                                        height: 20px;
                                        border-radius: 10px;
                                        background: root.swatch_colors[r_idx * 4 + c_idx];
                                        border-width: swatch_touch.has-hover ? 2px : 1px;
                                        border-color: swatch_touch.has-hover ? MaterialPalette.primary : MaterialPalette.outline;
                                    }
                                }
                            }
                        }

                        CompactInputField {
                            placeholder_text: "#RRGGBB";
                            accepted(hex) => {
                                if (hex != "") {
                                    root.set_curve_color(root.active_color_picker_id, hex);
                                    root.active_color_picker_id = -1;
                                }
                            }
                        }
                    }
                }

                // Line Width Configuration
                HorizontalLayout {
                    spacing: 8px;
                    alignment: center;

                    MaterialText {
                        text: "Line Width:";
                        style: MaterialTypography.label_small;
                        color: MaterialPalette.on_surface_variant;
                        vertical-alignment: center;
                    }

                    CompactInputField {
                        horizontal-stretch: 1;
                        placeholder_text: "1.5";
                        text <=> root.axis_settings.line_width;
                        accepted(w) => {
                            root.set_curve_width(w);
                            root.apply_axis_settings();
                        }
                    }

                    MaterialText {
                        text: "pt";
                        style: MaterialTypography.body_small;
                        color: MaterialPalette.on_surface_variant;
                        vertical-alignment: center;
                    }
                }
            }

            // ================================================================
            // Tab 1: Style, Presets, Axes & Gridlines
            // ================================================================
            if root.active_tab == 1: ScrollView {
                vertical-stretch: 1;
                content-height: 820px;

                VerticalLayout {
                    spacing: 12px;
                    padding-right: 2px;

                    // 1. Publication Sizing Preset (Segmented 4-way Pill Bar)
                    VerticalLayout {
                        spacing: 4px;

                        MaterialText {
                            text: "Publication Preset";
                            style: MaterialTypography.label_medium;
                            color: MaterialPalette.on_surface;
                        }

                        Rectangle {
                            height: 30px;
                            background: MaterialPalette.surface_container_high;
                            border-radius: MaterialStyleMetrics.border_radius_4;

                            HorizontalLayout {
                                padding: 2px;
                                spacing: 2px;

                                preset_btn_0 := TouchArea {
                                    horizontal-stretch: 1;
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.export_config.size_preset = 0;
                                        root.apply_axis_settings();
                                    }
                                    Rectangle {
                                        background: (root.export_config.size_preset == 0) ? MaterialPalette.primary_container :
                                                    preset_btn_0.has-hover ? MaterialPalette.surface_container_highest : transparent;
                                        border-radius: MaterialStyleMetrics.border_radius_2;
                                        MaterialText {
                                            text: "Default";
                                            font-size: 10px;
                                            font-weight: (root.export_config.size_preset == 0) ? 600 : 400;
                                            color: (root.export_config.size_preset == 0) ? MaterialPalette.on_primary_container : MaterialPalette.on_surface_variant;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                preset_btn_1 := TouchArea {
                                    horizontal-stretch: 1;
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.export_config.size_preset = 1;
                                        root.apply_axis_settings();
                                    }
                                    Rectangle {
                                        background: (root.export_config.size_preset == 1) ? MaterialPalette.primary_container :
                                                    preset_btn_1.has-hover ? MaterialPalette.surface_container_highest : transparent;
                                        border-radius: MaterialStyleMetrics.border_radius_2;
                                        MaterialText {
                                            text: "1-Col";
                                            font-size: 10px;
                                            font-weight: (root.export_config.size_preset == 1) ? 600 : 400;
                                            color: (root.export_config.size_preset == 1) ? MaterialPalette.on_primary_container : MaterialPalette.on_surface_variant;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                preset_btn_2 := TouchArea {
                                    horizontal-stretch: 1;
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.export_config.size_preset = 2;
                                        root.apply_axis_settings();
                                    }
                                    Rectangle {
                                        background: (root.export_config.size_preset == 2) ? MaterialPalette.primary_container :
                                                    preset_btn_2.has-hover ? MaterialPalette.surface_container_highest : transparent;
                                        border-radius: MaterialStyleMetrics.border_radius_2;
                                        MaterialText {
                                            text: "2-Col";
                                            font-size: 10px;
                                            font-weight: (root.export_config.size_preset == 2) ? 600 : 400;
                                            color: (root.export_config.size_preset == 2) ? MaterialPalette.on_primary_container : MaterialPalette.on_surface_variant;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                preset_btn_3 := TouchArea {
                                    horizontal-stretch: 1;
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.export_config.size_preset = 3;
                                        root.apply_axis_settings();
                                    }
                                    Rectangle {
                                        background: (root.export_config.size_preset == 3) ? MaterialPalette.primary_container :
                                                    preset_btn_3.has-hover ? MaterialPalette.surface_container_highest : transparent;
                                        border-radius: MaterialStyleMetrics.border_radius_2;
                                        MaterialText {
                                            text: "Slide";
                                            font-size: 10px;
                                            font-weight: (root.export_config.size_preset == 3) ? 600 : 400;
                                            color: (root.export_config.size_preset == 3) ? MaterialPalette.on_primary_container : MaterialPalette.on_surface_variant;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // 2. Publication Color Palette
                    VerticalLayout {
                        spacing: 4px;

                        MaterialText {
                            text: "Color Palette";
                            style: MaterialTypography.label_medium;
                            color: MaterialPalette.on_surface;
                        }

                        DropDownMenu {
                            width: 100%;
                            items: root.palette_menu_items;
                            current_index <=> root.export_config.palette;
                        }
                    }

                    // 3. Typography & Stroke Metrics
                    VerticalLayout {
                        spacing: 4px;

                        MaterialText {
                            text: "Typography & Strokes";
                            style: MaterialTypography.label_medium;
                            color: MaterialPalette.on_surface;
                        }

                        HorizontalLayout {
                            spacing: 6px;

                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 2px;
                                MaterialText {
                                    text: "Font Scale:";
                                    style: MaterialTypography.label_small;
                                    color: MaterialPalette.on_surface_variant;
                                }
                                CompactInputField {
                                    placeholder_text: "1.0";
                                    text <=> root.export_config.font_scale;
                                    accepted(_) => { root.apply_axis_settings(); }
                                }
                            }

                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 2px;
                                MaterialText {
                                    text: "Line (pt):";
                                    style: MaterialTypography.label_small;
                                    color: MaterialPalette.on_surface_variant;
                                }
                                CompactInputField {
                                    placeholder_text: "3.0";
                                    text <=> root.export_config.line_width;
                                    accepted(_) => { root.apply_axis_settings(); }
                                }
                            }

                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 2px;
                                MaterialText {
                                    text: "Marker (px):";
                                    style: MaterialTypography.label_small;
                                    color: MaterialPalette.on_surface_variant;
                                }
                                CompactInputField {
                                    placeholder_text: "3.5";
                                    text <=> root.export_config.marker_size;
                                    accepted(_) => { root.apply_axis_settings(); }
                                }
                            }
                        }
                    }

                    // 4. Display Toggles
                    VerticalLayout {
                        spacing: 4px;

                        MaterialText {
                            text: "Display Elements";
                            style: MaterialTypography.label_medium;
                            color: MaterialPalette.on_surface;
                        }

                        HorizontalLayout {
                            spacing: 6px;
                            CheckBoxRow {
                                horizontal-stretch: 1;
                                text: "Legend";
                                check_state_bool: root.export_config.show_legend;
                                checked_state_changed(s) => {
                                    root.export_config.show_legend = s;
                                    root.apply_axis_settings();
                                }
                            }
                            CheckBoxRow {
                                horizontal-stretch: 1;
                                text: "Markers";
                                check_state_bool: root.export_config.show_markers;
                                checked_state_changed(s) => {
                                    root.export_config.show_markers = s;
                                    root.apply_axis_settings();
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 6px;
                            CheckBoxRow {
                                horizontal-stretch: 1;
                                text: "Major Grid";
                                check_state_bool: root.axis_settings.show_major_grid;
                                checked_state_changed(s) => {
                                    root.axis_settings.show_major_grid = s;
                                    root.export_config.show_grid = s;
                                    root.apply_axis_settings();
                                }
                            }
                            CheckBoxRow {
                                horizontal-stretch: 1;
                                text: "Fill Area";
                                check_state_bool: root.export_config.fill_area;
                                checked_state_changed(s) => {
                                    root.export_config.fill_area = s;
                                    root.apply_axis_settings();
                                }
                            }
                        }
                    }

                    // 5. X-Axis Section
                    VerticalLayout {
                        spacing: 4px;

                        HorizontalLayout {
                            alignment: center;
                            MaterialText {
                                horizontal-stretch: 1;
                                text: "X-Axis Range";
                                style: MaterialTypography.label_medium;
                                color: MaterialPalette.on_surface;
                                vertical-alignment: center;
                            }
                            CheckBoxRow {
                                text: "Auto";
                                check_state_bool: root.axis_settings.auto_x;
                                checked_state_changed(checked) => {
                                    root.axis_settings.auto_x = checked;
                                    if (checked) {
                                        root.apply_axis_settings();
                                    }
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 6px;
                            CompactInputField {
                                horizontal-stretch: 1;
                                placeholder_text: "X Min";
                                text <=> root.axis_settings.x_min;
                                enabled: !root.axis_settings.auto_x;
                                accepted(_) => {
                                    root.axis_settings.auto_x = false;
                                    root.apply_axis_settings();
                                }
                            }
                            CompactInputField {
                                horizontal-stretch: 1;
                                placeholder_text: "X Max";
                                text <=> root.axis_settings.x_max;
                                enabled: !root.axis_settings.auto_x;
                                accepted(_) => {
                                    root.axis_settings.auto_x = false;
                                    root.apply_axis_settings();
                                }
                            }
                        }
                    }

                    // 6. Y-Axis Section
                    VerticalLayout {
                        spacing: 4px;

                        HorizontalLayout {
                            alignment: center;
                            MaterialText {
                                horizontal-stretch: 1;
                                text: "Y-Axis Range";
                                style: MaterialTypography.label_medium;
                                color: MaterialPalette.on_surface;
                                vertical-alignment: center;
                            }
                            CheckBoxRow {
                                text: "Auto";
                                check_state_bool: root.axis_settings.auto_y;
                                checked_state_changed(checked) => {
                                    root.axis_settings.auto_y = checked;
                                    if (checked) {
                                        root.apply_axis_settings();
                                    }
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 6px;
                            CompactInputField {
                                horizontal-stretch: 1;
                                placeholder_text: "Y Min";
                                text <=> root.axis_settings.y_min;
                                enabled: !root.axis_settings.auto_y;
                                accepted(_) => {
                                    root.axis_settings.auto_y = false;
                                    root.apply_axis_settings();
                                }
                            }
                            CompactInputField {
                                horizontal-stretch: 1;
                                placeholder_text: "Y Max";
                                text <=> root.axis_settings.y_max;
                                enabled: !root.axis_settings.auto_y;
                                accepted(_) => {
                                    root.axis_settings.auto_y = false;
                                    root.apply_axis_settings();
                                }
                            }
                        }
                    }

                    // 7. Tick Steps Section
                    VerticalLayout {
                        spacing: 4px;

                        HorizontalLayout {
                            alignment: center;
                            MaterialText {
                                horizontal-stretch: 1;
                                text: "Major Tick Steps";
                                style: MaterialTypography.label_medium;
                                color: MaterialPalette.on_surface;
                                vertical-alignment: center;
                            }
                            CheckBoxRow {
                                text: "Auto";
                                check_state_bool: root.axis_settings.auto_ticks;
                                checked_state_changed(checked) => {
                                    root.axis_settings.auto_ticks = checked;
                                    if (checked) {
                                        root.apply_axis_settings();
                                    }
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 6px;
                            CompactInputField {
                                horizontal-stretch: 1;
                                placeholder_text: "ΔX Step";
                                text <=> root.axis_settings.x_major_step;
                                enabled: !root.axis_settings.auto_ticks;
                                accepted(_) => {
                                    root.axis_settings.auto_ticks = false;
                                    root.apply_axis_settings();
                                }
                            }
                            CompactInputField {
                                horizontal-stretch: 1;
                                placeholder_text: "ΔY Step";
                                text <=> root.axis_settings.y_major_step;
                                enabled: !root.axis_settings.auto_ticks;
                                accepted(_) => {
                                    root.axis_settings.auto_ticks = false;
                                    root.apply_axis_settings();
                                }
                            }
                        }
                    }

                    // 8. Minor Subdivisions & Log Scale
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: center;

                        MaterialText {
                            horizontal-stretch: 1;
                            text: "Minor Subdivisions (0-5):";
                            style: MaterialTypography.label_small;
                            color: MaterialPalette.on_surface_variant;
                            vertical-alignment: center;
                        }

                        TouchArea {
                            width: 24px;
                            height: 24px;
                            mouse-cursor: pointer;
                            clicked => {
                                if (root.axis_settings.minor_subdivisions > 0) {
                                    root.axis_settings.minor_subdivisions -= 1;
                                    root.apply_axis_settings();
                                }
                            }
                            Rectangle {
                                background: parent.has-hover ? MaterialPalette.surface_container_highest : transparent;
                                border-radius: MaterialStyleMetrics.border_radius_2;
                                border-width: 1px;
                                border-color: MaterialPalette.outline;
                                MaterialText {
                                    text: "-";
                                    style: MaterialTypography.label_medium;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        MaterialText {
                            text: "\{root.axis_settings.minor_subdivisions}";
                            style: MaterialTypography.label_large;
                            color: MaterialPalette.on_surface;
                            vertical-alignment: center;
                        }

                        TouchArea {
                            width: 24px;
                            height: 24px;
                            mouse-cursor: pointer;
                            clicked => {
                                if (root.axis_settings.minor_subdivisions < 5) {
                                    root.axis_settings.minor_subdivisions += 1;
                                    root.apply_axis_settings();
                                }
                            }
                            Rectangle {
                                background: parent.has-hover ? MaterialPalette.surface_container_highest : transparent;
                                border-radius: MaterialStyleMetrics.border_radius_2;
                                border-width: 1px;
                                border-color: MaterialPalette.outline;
                                MaterialText {
                                    text: "+";
                                    style: MaterialTypography.label_medium;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    // Scaling & Grid Options
                    VerticalLayout {
                        spacing: 2px;

                        CheckBoxRow {
                            text: "Y Log₁₀ Scale";
                            check_state_bool: root.axis_settings.y_log_scale;
                            checked_state_changed(s) => {
                                root.axis_settings.y_log_scale = s;
                                root.apply_axis_settings();
                            }
                        }
                        CheckBoxRow {
                            text: "Show Minor Grid";
                            check_state_bool: root.axis_settings.show_minor_grid;
                            checked_state_changed(s) => {
                                root.axis_settings.show_minor_grid = s;
                                root.apply_axis_settings();
                            }
                        }
                    }

                    // Action Buttons (Update & Defaults)
                    HorizontalLayout {
                        spacing: 8px;
                        padding-top: 6px;

                        FilledButton {
                            horizontal-stretch: 1;
                            height: 32px;
                            text: "Update";
                            clicked => {
                                root.apply_axis_settings();
                            }
                        }

                        TouchArea {
                            horizontal-stretch: 1;
                            height: 32px;
                            mouse-cursor: pointer;
                            clicked => {
                                root.reset_axis_settings();
                                root.reset_export_settings();
                            }
                            Rectangle {
                                background: parent.has-hover ? MaterialPalette.surface_container_highest : transparent;
                                border-radius: MaterialStyleMetrics.border_radius_4;
                                border-width: 1px;
                                border-color: MaterialPalette.outline;
                                MaterialText {
                                    text: "Defaults";
                                    style: MaterialTypography.label_medium;
                                    color: MaterialPalette.on_surface_variant;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }

            // 4. Tab 2: Tagged Peaks & CN Table
            if root.active_tab == 2: VerticalLayout {
                spacing: 6px;

                if root.tagged_peaks.length == 0: Rectangle {
                    height: 160px;
                    background: MaterialPalette.surface_container;
                    border-radius: MaterialStyleMetrics.border_radius_4;
                    VerticalLayout {
                        alignment: center;
                        padding: 12px;
                        spacing: 8px;
                        Image {
                            width: 24px;
                            height: 24px;
                            source: Icons.analytics;
                            colorize: MaterialPalette.outline;
                            horizontal-alignment: center;
                        }
                        MaterialText {
                            text: "No peaks tagged yet.\n\nDouble-click a peak on the plot or use tool (🔬) to inspect shell & coordination number.";
                            style: MaterialTypography.body_small;
                            color: MaterialPalette.on_surface_variant;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                    }
                }

                if root.tagged_peaks.length > 0: HorizontalLayout {
                    spacing: 6px;
                    height: 28px;
                    FilledButton {
                        horizontal-stretch: 1;
                        height: 28px;
                        text: "Export CSV";
                        clicked => { root.export_tagged_peaks(); }
                    }
                    clear_all_touch := TouchArea {
                        horizontal-stretch: 1;
                        height: 28px;
                        mouse-cursor: pointer;
                        clicked => { root.clear_tagged_peaks(); }
                        Rectangle {
                            background: clear_all_touch.has-hover ? MaterialPalette.error_container : MaterialPalette.surface_container_high;
                            border-radius: MaterialStyleMetrics.border_radius_4;
                            border-width: 1px;
                            border-color: MaterialPalette.outline_variant;
                            MaterialText {
                                text: "Clear All";
                                style: MaterialTypography.label_medium;
                                color: clear_all_touch.has-hover ? MaterialPalette.on_error_container : MaterialPalette.error;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                if root.tagged_peaks.length > 0: ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 6px;
                        for peak in root.tagged_peaks: Rectangle {
                            background: MaterialPalette.surface_container;
                            border-radius: MaterialStyleMetrics.border_radius_4;
                            border-width: 1px;
                            border-color: peak.color_hex;

                            VerticalLayout {
                                padding: 6px;
                                spacing: 4px;
                                HorizontalLayout {
                                    alignment: space-between;
                                    MaterialText {
                                        text: peak.curve_name + " @ " + peak.r_peak;
                                        style: MaterialTypography.label_medium_prominent;
                                        color: MaterialPalette.on_surface;
                                        vertical-alignment: center;
                                    }
                                    del_btn := TouchArea {
                                        width: 18px;
                                        height: 18px;
                                        mouse-cursor: pointer;
                                        clicked => { root.remove_tagged_peak(peak.id); }
                                        Image {
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                            width: 12px;
                                            height: 12px;
                                            source: Icons.close;
                                            colorize: del_btn.has-hover ? MaterialPalette.error : MaterialPalette.outline;
                                        }
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 8px;
                                    MaterialText {
                                        text: peak.coordination_num != "—" ? ("CN: " + peak.coordination_num) : ("Area: " + peak.area);
                                        style: MaterialTypography.label_small;
                                        font-weight: 600;
                                        color: MaterialPalette.primary;
                                    }
                                    MaterialText {
                                        text: "Shell: [" + peak.r_min + " - " + peak.r_max + "]";
                                        style: MaterialTypography.label_small;
                                        color: MaterialPalette.on_surface_variant;
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 8px;
                                    MaterialText {
                                        text: "Height: " + peak.peak_height;
                                        style: MaterialTypography.label_small;
                                        color: MaterialPalette.outline;
                                    }
                                    MaterialText {
                                        text: "FWHM: " + peak.fwhm;
                                        style: MaterialTypography.label_small;
                                        color: MaterialPalette.outline;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
