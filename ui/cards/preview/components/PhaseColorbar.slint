import {
    MaterialPalette,
    MaterialTypography,
    MaterialText,
} from "../../../material/material.slint";

export component PhaseColorbar inherits VerticalLayout {
    in property <image> colorbar_image;
    in property <float> min_threshold: 0.0;
    in property <float> max_threshold: 1.0;
    in property <string> descriptor_name: "q̄₆";

    spacing: 2px;

    Rectangle {
        height: 8px;
        border-radius: 4px;
        clip: true;
        background: MaterialPalette.surface_container_high;
        border-width: 0.5px;
        border-color: MaterialPalette.outline_variant.with_alpha(40%);

        Image {
            width: 100%;
            height: 100%;
            source: root.colorbar_image;
            image-fit: fill;
        }
    }

    HorizontalLayout {
        alignment: space-between;

        MaterialText {
            text: "" + (Math.round(root.min_threshold * 100) / 100);
            font-size: 10px;
            color: MaterialPalette.on_surface_variant;
        }

        MaterialText {
            text: root.descriptor_name + " Scalar Palette";
            font-size: 10px;
            font-weight: 600;
            color: MaterialPalette.primary;
        }

        MaterialText {
            text: "" + (Math.round(root.max_threshold * 100) / 100);
            font-size: 10px;
            color: MaterialPalette.on_surface_variant;
        }
    }
}
