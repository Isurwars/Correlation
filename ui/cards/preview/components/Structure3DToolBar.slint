import {
    MaterialPalette,
    MaterialStyleMetrics,
    MaterialTypography,
    MaterialText,
    Icons,
} from "../../../material/material.slint";
import { PhaseSlider } from "./PhaseSlider.slint";

component ToolbarPresetChip inherits TouchArea {
    in property <string> label;
    in property <string> accessible_name;

    width: 26px;
    height: 100%;
    mouse-cursor: pointer;
    accessible-role: button;
    accessible-label: root.accessible_name;

    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: MaterialStyleMetrics.border_radius_4;
        background: root.has-hover ? MaterialPalette.surface_container_high : transparent;

        MaterialText {
            text: root.label;
            style: MaterialTypography.label_small;
            font_weight: 700;
            color: MaterialPalette.on_surface_variant;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

component ToolbarToggleChip inherits TouchArea {
    in property <image> icon;
    in property <string> glyph: "";
    in property <bool> active: false;
    in property <string> accessible_name;

    width: 30px;
    height: 30px;
    mouse-cursor: pointer;
    accessible-role: button;
    accessible-label: root.accessible_name;

    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: MaterialStyleMetrics.border_radius_full;
        background: root.active ? MaterialPalette.primary.with_alpha(20%) :
                    (root.has-hover ? MaterialPalette.surface_container_high : transparent);
        border-width: root.active ? 1.5px : 0px;
        border-color: root.active ? MaterialPalette.primary : transparent;
        animate background, border-color { duration: 150ms; }

        if root.glyph == "": Image {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 16px;
            height: 16px;
            source: root.icon;
            colorize: root.active ? MaterialPalette.primary : MaterialPalette.on_surface;
        }

        if root.glyph != "": MaterialText {
            width: 100%;
            height: 100%;
            text: root.glyph;
            style: MaterialTypography.label_large;
            color: root.active ? MaterialPalette.primary : MaterialPalette.on_surface;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

export component Structure3DToolBar inherits Rectangle {
    in property <bool> bonds_enabled: true;
    in property <bool> wireframe_enabled: true;
    in property <bool> in_cell_enabled: false;
    in property <bool> phase_panel_open: false;
    in property <bool> phase_enabled: false;
    in property <bool> dist_hud_enabled: true;
    in property <float> atom_scale: 0.35;

    callback reset_view();
    callback set_camera_preset(int);
    callback toggle_bonds(bool);
    callback toggle_wireframe(bool);
    callback toggle_in_cell(bool);
    callback toggle_phase_panel();
    callback toggle_dist_hud();
    callback set_atom_scale(float);

    height: 38px;
    border-radius: MaterialStyleMetrics.border_radius_full;
    background: MaterialPalette.surface_container_highest;
    border-width: 1.5px;
    border-color: MaterialPalette.outline;
    width: tools_layout.preferred-width + 16px;

    tools_layout := HorizontalLayout {
        height: 100%;
        padding-left: MaterialStyleMetrics.padding_8;
        padding-right: MaterialStyleMetrics.padding_8;
        spacing: MaterialStyleMetrics.spacing_6;
        alignment: center;

        ToolbarToggleChip {
            y: (parent.height - self.height) / 2;
            icon: Icons.home;
            accessible_name: "Home / Reset 3D Camera";
            clicked => { root.reset_view(); }
        }

        // Camera Orientation Presets (Top XY, Front XZ, Side YZ, Isometric 3D)
        HorizontalLayout {
            spacing: 2px;
            height: 24px;
            y: (parent.height - self.height) / 2;

            ToolbarPresetChip {
                label: "XY";
                accessible_name: "Camera Preset Top (XY)";
                clicked => { root.set_camera_preset(0); }
            }
            ToolbarPresetChip {
                label: "XZ";
                accessible_name: "Camera Preset Front (XZ)";
                clicked => { root.set_camera_preset(1); }
            }
            ToolbarPresetChip {
                label: "YZ";
                accessible_name: "Camera Preset Side (YZ)";
                clicked => { root.set_camera_preset(2); }
            }
            ToolbarPresetChip {
                label: "3D";
                accessible_name: "Camera Preset Isometric (3D)";
                clicked => { root.set_camera_preset(3); }
            }
        }

        ToolbarToggleChip {
            y: (parent.height - self.height) / 2;
            glyph: "B";
            active: root.bonds_enabled;
            accessible_name: root.bonds_enabled ? "Hide Atomic Bonds" : "Show Atomic Bonds";
            clicked => { root.toggle_bonds(!root.bonds_enabled); }
        }

        ToolbarToggleChip {
            y: (parent.height - self.height) / 2;
            glyph: "⬡";
            active: root.wireframe_enabled;
            accessible_name: root.wireframe_enabled ? "Hide Unit Cell Wireframe" : "Show Unit Cell Wireframe";
            clicked => { root.toggle_wireframe(!root.wireframe_enabled); }
        }

        ToolbarToggleChip {
            y: (parent.height - self.height) / 2;
            glyph: "⊞";
            active: root.in_cell_enabled;
            accessible_name: root.in_cell_enabled ? "In-Cell PBC Active (Folded & Boundary-Clipped)" : "Standard Non-Forced Coordinates";
            clicked => { root.toggle_in_cell(!root.in_cell_enabled); }
        }

        ToolbarToggleChip {
            y: (parent.height - self.height) / 2;
            icon: Icons.science;
            active: root.phase_panel_open || root.phase_enabled;
            accessible_name: root.phase_panel_open ? "Hide Phase Search" : "Show Phase Search";
            clicked => { root.toggle_phase_panel(); }
        }

        ToolbarToggleChip {
            y: (parent.height - self.height) / 2;
            icon: Icons.analytics;
            active: root.dist_hud_enabled;
            accessible_name: root.dist_hud_enabled ? "Hide Distribution Graph" : "Show Distribution Graph";
            clicked => { root.toggle_dist_hud(); }
        }

        // Divider
        Rectangle {
            width: 1px;
            height: 20px;
            y: (parent.height - self.height) / 2;
            background: MaterialPalette.outline_variant;
        }

        // Ball Radius Slider
        PhaseSlider {
            width: 92px;
            y: (parent.height - self.height) / 2;
            label: "Ball";
            value: root.atom_scale;
            min_val: 0.1;
            max_val: 1.5;
            display_text: "" + (Math.round(root.atom_scale * 100) / 100) + "x";
            value_changed(val) => { root.set_atom_scale(val); }
        }
    }
}
