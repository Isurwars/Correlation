import {
    MaterialPalette,
    MaterialTypography,
    MaterialText,
    Icons,
} from "../../../material/material.slint";
import { PhaseSlider } from "./PhaseSlider.slint";

export component Structure3DToolBar inherits Rectangle {
    in property <bool> bonds_enabled: true;
    in property <bool> wireframe_enabled: true;
    in property <bool> in_cell_enabled: false;
    in property <bool> phase_panel_open: false;
    in property <bool> phase_enabled: false;
    in property <float> atom_scale: 0.35;

    callback reset_view();
    callback toggle_bonds(bool);
    callback toggle_wireframe(bool);
    callback toggle_in_cell(bool);
    callback toggle_phase_panel();
    callback set_atom_scale(float);

    height: 38px;
    border-radius: 19px;
    background: MaterialPalette.surface_container_highest;
    border-width: 1.5px;
    border-color: MaterialPalette.outline;
    width: tools_layout.preferred-width + 16px;

    tools_layout := HorizontalLayout {
        height: 100%;
        padding-left: 8px;
        padding-right: 8px;
        spacing: 6px;
        alignment: center;

        // Home / Reset view
        TouchArea {
            width: 30px;
            height: 30px;
            y: (parent.height - self.height) / 2;
            mouse-cursor: pointer;
            accessible-role: button;
            accessible-label: "Home / Reset 3D Camera";
            clicked => { root.reset_view(); }

            Rectangle {
                width: 100%;
                height: 100%;
                border-radius: 15px;
                background: parent.has-hover ? MaterialPalette.surface_container_high : transparent;

                Image {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: 16px;
                    height: 16px;
                    source: Icons.home;
                    colorize: MaterialPalette.on_surface;
                }
            }
        }

        // Toggle Bonds
        TouchArea {
            width: 30px;
            height: 30px;
            y: (parent.height - self.height) / 2;
            mouse-cursor: pointer;
            clicked => { root.toggle_bonds(!root.bonds_enabled); }

            Rectangle {
                width: 100%;
                height: 100%;
                border-radius: 15px;
                background: root.bonds_enabled ? MaterialPalette.primary.with_alpha(20%) :
                    (parent.has-hover ? MaterialPalette.surface_container_high : transparent);
                border-width: root.bonds_enabled ? 1.5px : 0px;
                border-color: root.bonds_enabled ? MaterialPalette.primary : transparent;

                MaterialText {
                    width: 100%;
                    height: 100%;
                    text: root.bonds_enabled ? "🔗" : "⛓";
                    font-size: 14px;
                    color: root.bonds_enabled ? MaterialPalette.primary : MaterialPalette.on_surface;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        // Toggle Wireframe
        TouchArea {
            width: 30px;
            height: 30px;
            y: (parent.height - self.height) / 2;
            mouse-cursor: pointer;
            clicked => { root.toggle_wireframe(!root.wireframe_enabled); }

            Rectangle {
                width: 100%;
                height: 100%;
                border-radius: 15px;
                background: root.wireframe_enabled ? MaterialPalette.primary.with_alpha(20%) :
                    (parent.has-hover ? MaterialPalette.surface_container_high : transparent);
                border-width: root.wireframe_enabled ? 1.5px : 0px;
                border-color: root.wireframe_enabled ? MaterialPalette.primary : transparent;

                MaterialText {
                    width: 100%;
                    height: 100%;
                    text: "⬡";
                    font-size: 16px;
                    color: root.wireframe_enabled ? MaterialPalette.primary : MaterialPalette.on_surface;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        // Toggle In-Cell PBC
        TouchArea {
            width: 30px;
            height: 30px;
            y: (parent.height - self.height) / 2;
            mouse-cursor: pointer;
            accessible-role: button;
            accessible-label: root.in_cell_enabled ? "In-Cell PBC Active (Folded & Boundary-Clipped)" : "Standard Non-Forced Coordinates";
            clicked => { root.toggle_in_cell(!root.in_cell_enabled); }

            Rectangle {
                width: 100%;
                height: 100%;
                border-radius: 15px;
                background: root.in_cell_enabled ? MaterialPalette.primary.with_alpha(20%) :
                    (parent.has-hover ? MaterialPalette.surface_container_high : transparent);
                border-width: root.in_cell_enabled ? 1.5px : 0px;
                border-color: root.in_cell_enabled ? MaterialPalette.primary : transparent;

                MaterialText {
                    width: 100%;
                    height: 100%;
                    text: "⊞";
                    font-size: 15px;
                    color: root.in_cell_enabled ? MaterialPalette.primary : MaterialPalette.on_surface;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        // Toggle Phase Search Panel
        TouchArea {
            width: 30px;
            height: 30px;
            y: (parent.height - self.height) / 2;
            mouse-cursor: pointer;
            accessible-role: button;
            accessible-label: root.phase_panel_open ? "Hide Phase Search" : "Show Phase Search";
            clicked => { root.toggle_phase_panel(); }

            Rectangle {
                width: 100%;
                height: 100%;
                border-radius: 15px;
                background: (root.phase_panel_open || root.phase_enabled) ? MaterialPalette.primary.with_alpha(20%) :
                    (parent.has-hover ? MaterialPalette.surface_container_high : transparent);
                border-width: (root.phase_panel_open || root.phase_enabled) ? 1.5px : 0px;
                border-color: (root.phase_panel_open || root.phase_enabled) ? MaterialPalette.primary : transparent;

                MaterialText {
                    width: 100%;
                    height: 100%;
                    text: "🔮";
                    font-size: 14px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        // Divider
        Rectangle {
            width: 1px;
            height: 20px;
            y: (parent.height - self.height) / 2;
            background: MaterialPalette.outline_variant;
        }

        // Ball Radius Slider
        PhaseSlider {
            width: 92px;
            y: (parent.height - self.height) / 2;
            label: "Ball";
            value: root.atom_scale;
            min_val: 0.1;
            max_val: 1.5;
            display_text: "" + (Math.round(root.atom_scale * 100) / 100) + "x";
            value_changed(val) => { root.set_atom_scale(val); }
        }
    }
}
