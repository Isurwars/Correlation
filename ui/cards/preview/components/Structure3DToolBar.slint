import {
    MaterialPalette,
    MaterialStyleMetrics,
    Icons,
    Chip,
} from "../../../material/material.slint";

component DockChip inherits Chip {
    chip_height: MaterialStyleMetrics.size_30;
    corner_radius: MaterialStyleMetrics.border_radius_full;
    outlined: false;
}

/// Compact vertical floating 3D tool dock anchored to the left edge of Structure3DViewport.
export component Structure3DToolBar inherits Rectangle {
    in property <bool> bonds_enabled: true;
    in property <bool> wireframe_enabled: true;
    in property <bool> in_cell_enabled: true;
    in property <bool> is_isometric: false;
    in property <bool> phase_panel_open: false;
    in property <bool> phase_enabled: false;
    in property <bool> dist_hud_enabled: true;

    callback reset_view();
    callback toggle_bonds(bool);
    callback toggle_wireframe(bool);
    callback toggle_in_cell(bool);
    callback toggle_projection(bool);
    callback toggle_phase_panel();
    callback toggle_dist_hud();
    callback export_snapshot();

    width: 40px;
    height: tools_layout.preferred-height + 12px;
    border-radius: MaterialStyleMetrics.border_radius_full;
    background: MaterialPalette.surface_container_highest.with_alpha(88%);
    border-width: 1px;
    border-color: MaterialPalette.outline_variant.with_alpha(60%);

    tools_layout := VerticalLayout {
        width: 100%;
        padding-top: MaterialStyleMetrics.padding_6;
        padding-bottom: MaterialStyleMetrics.padding_6;
        padding-left: MaterialStyleMetrics.padding_4;
        padding-right: MaterialStyleMetrics.padding_4;
        spacing: MaterialStyleMetrics.spacing_4;
        alignment: center;

        DockChip {
            icon: Icons.home;
            accessible_name: "Home / Reset 3D Camera";
            tooltip_text: "Reset 3D camera to default isometric view (H).";
            clicked => { root.reset_view(); }
        }

        Rectangle {
            width: 20px;
            height: 1px;
            x: (parent.width - self.width) / 2;
            background: MaterialPalette.outline_variant.with_alpha(60%);
        }

        DockChip {
            icon: Icons.hub;
            selected: root.bonds_enabled;
            accessible_name: root.bonds_enabled ? "Hide Atomic Bonds" : "Show Atomic Bonds";
            tooltip_text: root.bonds_enabled ? "Hide atomic bonds." : "Show atomic bonds.";
            clicked => { root.toggle_bonds(!root.bonds_enabled); }
        }

        DockChip {
            icon: Icons.deployed_code;
            selected: root.wireframe_enabled;
            accessible_name: root.wireframe_enabled ? "Hide Unit Cell Wireframe" : "Show Unit Cell Wireframe";
            tooltip_text: root.wireframe_enabled ? "Hide unit cell wireframe." : "Show unit cell wireframe.";
            clicked => { root.toggle_wireframe(!root.wireframe_enabled); }
        }

        DockChip {
            icon: Icons.grid_on;
            selected: root.in_cell_enabled;
            accessible_name: root.in_cell_enabled ? "In-Cell PBC Active" : "Standard Coordinates";
            tooltip_text: root.in_cell_enabled ? "In-Cell PBC active (atoms wrapped into primary cell)." : "Wrap atoms into primary unit cell (PBC).";
            clicked => { root.toggle_in_cell(!root.in_cell_enabled); }
        }

        DockChip {
            label: root.is_isometric ? "ISO" : "P";
            selected: root.is_isometric;
            accessible_name: root.is_isometric ? "Switch to Perspective View" : "Switch to Isometric View";
            tooltip_text: root.is_isometric ? "Isometric (Orthographic) projection active. Click for Perspective." : "Perspective projection active. Click for Isometric.";
            clicked => { root.toggle_projection(!root.is_isometric); }
        }

        Rectangle {
            width: 20px;
            height: 1px;
            x: (parent.width - self.width) / 2;
            background: MaterialPalette.outline_variant.with_alpha(60%);
        }

        DockChip {
            icon: Icons.science;
            selected: root.phase_enabled;
            accessible_name: root.phase_enabled ? "Hide Phase Search" : "Show Phase Search";
            tooltip_text: "Toggle 3D Phase Search & Order Parameter Inspector.";
            clicked => { root.toggle_phase_panel(); }
        }

        DockChip {
            icon: Icons.analytics;
            selected: root.dist_hud_enabled;
            accessible_name: root.dist_hud_enabled ? "Hide Distribution Graph" : "Show Distribution Graph";
            tooltip_text: root.dist_hud_enabled ? "Hide Distribution Mini-HUD." : "Show Distribution Mini-HUD.";
            clicked => { root.toggle_dist_hud(); }
        }

        Rectangle {
            width: 20px;
            height: 1px;
            x: (parent.width - self.width) / 2;
            background: MaterialPalette.outline_variant.with_alpha(60%);
        }

        DockChip {
            icon: Icons.download;
            accessible_name: "Export Hi-Res 3D Snapshot (PNG)";
            tooltip_text: "Export high-resolution 3D viewport snapshot (PNG).";
            clicked => { root.export_snapshot(); }
        }
    }
}
