import {
    MaterialPalette,
    MaterialTypography,
    MaterialText,
    MaterialStyleMetrics,
    Chip,
} from "../../../material/material.slint";

export component PhaseDescriptorSelector inherits VerticalLayout {
    in property <int> descriptor_index: 0;
    in property <int> colormap_index: 0;
    callback set_descriptor(int);
    callback set_colormap(int);

    private property <[string]> desc_tips: [
        "Averaged Steinhardt q̄₆: strong FCC/HCP/BCC crystallinity discriminator.",
        "Averaged Steinhardt q̄₄: distinguishes cubic vs hexagonal local symmetry.",
        "Local Steinhardt q₆: six-fold bond-orientational order.",
        "Local Steinhardt q₄: four-fold bond-orientational order.",
        "Normalized Steinhardt ŵ₆: sensitive to icosahedral (ŵ₆ < 0) vs FCC/HCP.",
        "Normalized Steinhardt ŵ₄: separates FCC (ŵ₄ < 0) from BCC/HCP.",
        "Two-body excess entropy s₂: local structural ordering from pair correlations.",
        "Coordination number N_c: number of bonded neighbors within cutoff.",
        "Tetrahedral order q_tet: measures tetrahedrality (1.0 = ideal diamond/tetrahedron).",
    ];
    private property <[string]> cmap_tips: [
        "Viridis perceptually uniform colormap.",
        "Plasma high-contrast perceptually uniform colormap.",
        "Cool cyan-to-magenta colormap.",
        "Turbo high-dynamic-range rainbow colormap.",
    ];

    spacing: MaterialStyleMetrics.spacing_6;

    // Descriptor Pills
    VerticalLayout {
        horizontal-stretch: 1;
        spacing: 2px;

        MaterialText {
            text: "Descriptor";
            font-size: MaterialTypography.label_small.font_size;
            font-weight: 600;
            color: MaterialPalette.on_surface_variant;
        }

        HorizontalLayout {
            spacing: 2px;
            height: 22px;
            property <[string]> desc_labels: ["q̄₆", "q̄₄", "q₆", "q₄", "ŵ₆", "ŵ₄", "s₂", "N_c", "q_tet"];

            for d_label[d_idx] in self.desc_labels: Chip {
                horizontal-stretch: 1;
                chip_height: MaterialStyleMetrics.size_20 + MaterialStyleMetrics.size_2;
                corner_radius: MaterialStyleMetrics.border_radius_8;
                label: d_label;
                selected: root.descriptor_index == d_idx;
                active_bg: MaterialPalette.secondary.with_alpha(25%);
                active_fg: MaterialPalette.secondary;
                tooltip_text: root.desc_tips[d_idx];
                clicked => { root.set_descriptor(d_idx); }
            }
        }
    }

    // Colormap Pills
    VerticalLayout {
        horizontal-stretch: 1;
        spacing: 2px;

        MaterialText {
            text: "Colormap";
            font-size: MaterialTypography.label_small.font_size;
            font-weight: 600;
            color: MaterialPalette.on_surface_variant;
        }

        HorizontalLayout {
            spacing: 2px;
            height: 22px;
            property <[string]> cmap_labels: ["Viridis", "Plasma", "Cool", "Turbo"];

            for c_label[c_idx] in self.cmap_labels: Chip {
                horizontal-stretch: 1;
                chip_height: MaterialStyleMetrics.size_20 + MaterialStyleMetrics.size_2;
                corner_radius: MaterialStyleMetrics.border_radius_8;
                label: c_label;
                selected: root.colormap_index == c_idx;
                active_bg: MaterialPalette.tertiary.with_alpha(25%);
                active_fg: MaterialPalette.tertiary;
                tooltip_text: root.cmap_tips[c_idx];
                clicked => { root.set_colormap(c_idx); }
            }
        }
    }
}
