import {
    MaterialPalette,
    MaterialStyleMetrics,
    MaterialTypography,
    MaterialText,
    ScrollView,
    CheckBoxRow,
    FilledButton,
    MaterialSlider,
} from "../../../material/material.slint";
import { SlabClipState } from "../../../Types.slint";

/// Tab 1 of Structure3DSidebar: camera reset, atomic representation, slab clipping, and HUD overlay toggles.
export component Structure3DSceneTab inherits ScrollView {
    in property <float> atom_scale: 0.35;
    in property <bool> bonds_enabled: true;
    in property <bool> wireframe_enabled: true;
    in property <bool> in_cell_enabled: true;
    in property <bool> is_isometric: false;
    in property <bool> dist_hud_visible: true;
    in property <SlabClipState> slab_clip: {
        enabled: false,
        x_min: 0.0, x_max: 1.0,
        y_min: 0.0, y_max: 1.0,
        z_min: 0.0, z_max: 1.0,
    };

    callback reset_view();
    callback set_atom_scale(float);
    callback toggle_bonds(bool);
    callback toggle_wireframe(bool);
    callback toggle_in_cell(bool);
    callback toggle_projection(bool);
    callback toggle_dist_hud(bool);
    callback set_slab_clip(SlabClipState);
    callback reset_slab_clip();

    viewport_height: content_layout.preferred-height + 8px;

    content_layout := VerticalLayout {
        alignment: start;
        spacing: MaterialStyleMetrics.spacing_12;
        padding-right: 6px;
        padding-bottom: 8px;

        // Camera Controls Section
        VerticalLayout {
            spacing: MaterialStyleMetrics.spacing_6;

            MaterialText {
                text: "Camera & Orientation";
                style: MaterialTypography.label_medium;
                color: MaterialPalette.on_surface;
            }

            FilledButton {
                height: 32px;
                text: "Reset Camera View";
                tooltip: "Reset 3D camera rotation, pan, and zoom to the default isometric view.";
                clicked => { root.reset_view(); }
            }

            CheckBoxRow {
                text: "Isometric (Orthographic)";
                check_state_bool: root.is_isometric;
                tooltip_text: "Toggle parallel orthographic projection without perspective foreshortening.";
                checked_state_changed(en) => { root.toggle_projection(en); }
            }
        }

        // Atomic Representation Section
        VerticalLayout {
            spacing: MaterialStyleMetrics.spacing_8;

            MaterialText {
                text: "Atomic Representation";
                style: MaterialTypography.label_medium;
                color: MaterialPalette.on_surface;
            }

            MaterialSlider {
                label: "Ball Scale";
                value: root.atom_scale;
                minimum: 0.1;
                maximum: 1.5;
                display_text: "" + (Math.round(root.atom_scale * 100) / 100) + "x";
                tooltip_text: "Scale atomic sphere radii relative to covalent radii.";
                changed(val) => { root.set_atom_scale(val); }
            }

            CheckBoxRow {
                text: "Render Bonds";
                check_state_bool: root.bonds_enabled;
                tooltip_text: "Show or hide chemical bonds computed from active pairwise cutoffs.";
                checked_state_changed(en) => { root.toggle_bonds(en); }
            }

            CheckBoxRow {
                text: "Unit Cell Wireframe";
                check_state_bool: root.wireframe_enabled;
                tooltip_text: "Show or hide the simulation unit cell bounding box.";
                checked_state_changed(en) => { root.toggle_wireframe(en); }
            }

            CheckBoxRow {
                text: "In-Cell PBC Coordinates";
                check_state_bool: root.in_cell_enabled;
                tooltip_text: "Wrap all atoms inside the primary unit cell using periodic boundary conditions.";
                checked_state_changed(en) => { root.toggle_in_cell(en); }
            }
        }

        // Slab Clipping Section (X / Y / Z)
        VerticalLayout {
            spacing: MaterialStyleMetrics.spacing_6;

            MaterialText {
                text: "Slab Clipping (X / Y / Z)";
                style: MaterialTypography.label_medium;
                color: MaterialPalette.on_surface;
            }

            CheckBoxRow {
                text: "Enable Slab Clipping";
                check_state_bool: root.slab_clip.enabled;
                tooltip_text: "Slice through the atomic box along X, Y, and Z normalized bounds.";
                checked_state_changed(en) => {
                    root.set_slab_clip({
                        enabled: en,
                        x_min: root.slab_clip.x_min, x_max: root.slab_clip.x_max,
                        y_min: root.slab_clip.y_min, y_max: root.slab_clip.y_max,
                        z_min: root.slab_clip.z_min, z_max: root.slab_clip.z_max,
                    });
                }
            }

            if root.slab_clip.enabled: VerticalLayout {
                spacing: MaterialStyleMetrics.spacing_6;

                HorizontalLayout {
                    spacing: MaterialStyleMetrics.spacing_6;
                    MaterialSlider {
                        horizontal-stretch: 1;
                        label: "X Min";
                        value: root.slab_clip.x_min;
                        maximum: Math.max(0.01, root.slab_clip.x_max);
                        display_text: "" + Math.round(root.slab_clip.x_min * 100) + "%";
                        changed(val) => {
                            root.set_slab_clip({
                                enabled: true, x_min: val, x_max: root.slab_clip.x_max,
                                y_min: root.slab_clip.y_min, y_max: root.slab_clip.y_max,
                                z_min: root.slab_clip.z_min, z_max: root.slab_clip.z_max,
                            });
                        }
                    }
                    MaterialSlider {
                        horizontal-stretch: 1;
                        label: "X Max";
                        value: root.slab_clip.x_max;
                        minimum: Math.min(0.99, root.slab_clip.x_min);
                        display_text: "" + Math.round(root.slab_clip.x_max * 100) + "%";
                        changed(val) => {
                            root.set_slab_clip({
                                enabled: true, x_min: root.slab_clip.x_min, x_max: val,
                                y_min: root.slab_clip.y_min, y_max: root.slab_clip.y_max,
                                z_min: root.slab_clip.z_min, z_max: root.slab_clip.z_max,
                            });
                        }
                    }
                }

                HorizontalLayout {
                    spacing: MaterialStyleMetrics.spacing_6;
                    MaterialSlider {
                        horizontal-stretch: 1;
                        label: "Y Min";
                        value: root.slab_clip.y_min;
                        maximum: Math.max(0.01, root.slab_clip.y_max);
                        display_text: "" + Math.round(root.slab_clip.y_min * 100) + "%";
                        changed(val) => {
                            root.set_slab_clip({
                                enabled: true, x_min: root.slab_clip.x_min, x_max: root.slab_clip.x_max,
                                y_min: val, y_max: root.slab_clip.y_max,
                                z_min: root.slab_clip.z_min, z_max: root.slab_clip.z_max,
                            });
                        }
                    }
                    MaterialSlider {
                        horizontal-stretch: 1;
                        label: "Y Max";
                        value: root.slab_clip.y_max;
                        minimum: Math.min(0.99, root.slab_clip.y_min);
                        display_text: "" + Math.round(root.slab_clip.y_max * 100) + "%";
                        changed(val) => {
                            root.set_slab_clip({
                                enabled: true, x_min: root.slab_clip.x_min, x_max: root.slab_clip.x_max,
                                y_min: root.slab_clip.y_min, y_max: val,
                                z_min: root.slab_clip.z_min, z_max: root.slab_clip.z_max,
                            });
                        }
                    }
                }

                HorizontalLayout {
                    spacing: MaterialStyleMetrics.spacing_6;
                    MaterialSlider {
                        horizontal-stretch: 1;
                        label: "Z Min";
                        value: root.slab_clip.z_min;
                        maximum: Math.max(0.01, root.slab_clip.z_max);
                        display_text: "" + Math.round(root.slab_clip.z_min * 100) + "%";
                        changed(val) => {
                            root.set_slab_clip({
                                enabled: true, x_min: root.slab_clip.x_min, x_max: root.slab_clip.x_max,
                                y_min: root.slab_clip.y_min, y_max: root.slab_clip.y_max,
                                z_min: val, z_max: root.slab_clip.z_max,
                            });
                        }
                    }
                    MaterialSlider {
                        horizontal-stretch: 1;
                        label: "Z Max";
                        value: root.slab_clip.z_max;
                        minimum: Math.min(0.99, root.slab_clip.z_min);
                        display_text: "" + Math.round(root.slab_clip.z_max * 100) + "%";
                        changed(val) => {
                            root.set_slab_clip({
                                enabled: true, x_min: root.slab_clip.x_min, x_max: root.slab_clip.x_max,
                                y_min: root.slab_clip.y_min, y_max: root.slab_clip.y_max,
                                z_min: root.slab_clip.z_min, z_max: val,
                            });
                        }
                    }
                }

                FilledButton {
                    height: 28px;
                    text: "Reset Clipping Bounds";
                    background: MaterialPalette.surface_container_highest;
                    text_color: MaterialPalette.on_surface;
                    clicked => { root.reset_slab_clip(); }
                }
            }
        }

        // Viewport Overlays Section
        VerticalLayout {
            spacing: MaterialStyleMetrics.spacing_8;

            MaterialText {
                text: "Overlays";
                style: MaterialTypography.label_medium;
                color: MaterialPalette.on_surface;
            }

            CheckBoxRow {
                text: "Distribution Mini-HUD";
                check_state_bool: root.dist_hud_visible;
                tooltip_text: "Toggle the floating bond-length / coordination distribution mini-HUD.";
                checked_state_changed(v) => { root.toggle_dist_hud(v); }
            }
        }
    }
}
