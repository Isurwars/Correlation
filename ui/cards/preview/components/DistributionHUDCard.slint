import {
    MaterialPalette,
    MaterialStyleMetrics,
    MaterialTypography,
    MaterialText,
    Icons,
} from "../../../material/material.slint";

component HudMetricPill inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;

    callback clicked();

    width: 40px;
    height: 20px;
    border-radius: MaterialStyleMetrics.border_radius_full;
    background: root.active ? MaterialPalette.primary : MaterialPalette.surface_container_high;

    TouchArea {
        mouse-cursor: pointer;
        accessible-role: button;
        accessible-label: "Show " + root.label + " mini plot";
        clicked => { root.clicked(); }

        MaterialText {
            text: root.label;
            style: MaterialTypography.label_small;
            font_weight: root.active ? 700 : 500;
            color: root.active ? MaterialPalette.on_primary : MaterialPalette.on_surface_variant;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

export component DistributionHUDCard inherits Rectangle {
    in property <image> chart_image;
    in property <int> active_metric: 0; // 0 = g(r), 1 = PAD, 2 = S(Q)
    in property <string> peak_text: "";
    in property <int> current_frame: 0;

    callback set_metric(int);
    callback close_hud();

    width: 276px;
    height: 184px;
    border-radius: MaterialStyleMetrics.border_radius_12;
    background: MaterialPalette.surface_container_highest.with_alpha(92%);
    border-width: 1px;
    border-color: MaterialPalette.outline_variant.with_alpha(55%);
    clip: true;

    VerticalLayout {
        padding-left: MaterialStyleMetrics.padding_8;
        padding-right: MaterialStyleMetrics.padding_8;
        padding-top: MaterialStyleMetrics.padding_6;
        padding-bottom: MaterialStyleMetrics.padding_6;
        spacing: MaterialStyleMetrics.spacing_4;

        // Header: metric pills & close button
        HorizontalLayout {
            alignment: space-between;
            spacing: MaterialStyleMetrics.spacing_6;

            HorizontalLayout {
                spacing: MaterialStyleMetrics.spacing_4;

                HudMetricPill {
                    label: "g(r)";
                    active: root.active_metric == 0;
                    clicked => { root.set_metric(0); }
                }

                HudMetricPill {
                    label: "PAD";
                    active: root.active_metric == 1;
                    clicked => { root.set_metric(1); }
                }

                HudMetricPill {
                    label: "S(Q)";
                    active: root.active_metric == 2;
                    clicked => { root.set_metric(2); }
                }
            }

            // Close button
            Rectangle {
                width: 20px;
                height: 20px;
                border-radius: MaterialStyleMetrics.border_radius_full;
                background: close_touch.has-hover ? MaterialPalette.surface_container_high : MaterialPalette.surface_container_low;

                close_touch := TouchArea {
                    mouse-cursor: pointer;
                    accessible-role: button;
                    accessible-label: "Close Distribution Mini-HUD";
                    clicked => { root.close_hud(); }

                    Image {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        width: 12px;
                        height: 12px;
                        source: Icons.close;
                        colorize: MaterialPalette.on_surface_variant;
                    }
                }
            }
        }

        // Rendered Mini-Plot Image
        Rectangle {
            width: 260px;
            height: 126px;
            border-radius: MaterialStyleMetrics.border_radius_6;
            clip: true;
            background: MaterialPalette.hud_canvas;

            Image {
                width: 100%;
                height: 100%;
                source: root.chart_image;
                image-fit: fill;
            }
        }

        // Footer Legend & Peak Info
        HorizontalLayout {
            alignment: space-between;

            HorizontalLayout {
                spacing: MaterialStyleMetrics.spacing_8;

                // Mean indicator
                HorizontalLayout {
                    spacing: MaterialStyleMetrics.spacing_4;
                    Rectangle {
                        y: (parent.height - self.height) / 2;
                        width: 10px;
                        height: 2px;
                        background: MaterialPalette.on_surface_variant;
                    }
                    MaterialText {
                        text: "Mean";
                        style: MaterialTypography.label_small;
                        color: MaterialPalette.on_surface_variant;
                        vertical-alignment: center;
                    }
                }

                // Current Frame indicator
                HorizontalLayout {
                    spacing: MaterialStyleMetrics.spacing_4;
                    Rectangle {
                        y: (parent.height - self.height) / 2;
                        width: 10px;
                        height: 3px;
                        border-radius: 1px;
                        background: MaterialPalette.hud_accent;
                    }
                    MaterialText {
                        text: "Frame " + (root.current_frame + 1);
                        style: MaterialTypography.label_small;
                        font_weight: 600;
                        color: MaterialPalette.on_surface;
                        vertical-alignment: center;
                    }
                }
            }

            if (root.peak_text != ""): MaterialText {
                text: root.peak_text;
                style: MaterialTypography.label_small;
                font_weight: 600;
                color: MaterialPalette.hud_peak;
                vertical-alignment: center;
            }
        }
    }
}
