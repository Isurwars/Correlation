import {
    MaterialPalette,
    MaterialStyleMetrics,
} from "../../../material/material.slint";
import { TabItem } from "../../../material/ui/components/tab_item.slint";

export component DualViewPlotSelector inherits VerticalLayout {
    in-out property <int> active_view: 0; // 0: g(r), 1: S(Q), 2: PAD, 3: XRD, 4: 2D Heatmap
    callback select_view(int);

    property <[string]> view_labels: ["g(r)", "S(Q)", "PAD", "XRD", "2D Heatmap"];

    Rectangle {
        height: 38px;
        background: MaterialPalette.surface_container;

        HorizontalLayout {
            alignment: start;
            spacing: 8px;
            padding-left: 8px;
            padding-right: 8px;
            padding-top: 5px;
            padding-bottom: 5px;

            Rectangle {
                height: 28px;
                background: MaterialPalette.surface_container_high;
                border-radius: MaterialStyleMetrics.border_radius_8;
                border-width: 1px;
                border-color: MaterialPalette.outline_variant;
                clip: true;

                HorizontalLayout {
                    for label[idx] in root.view_labels: HorizontalLayout {
                        if idx > 0: Rectangle {
                            width: 1px;
                            background: MaterialPalette.outline_variant;
                        }

                        TabItem {
                            text: label;
                            compact: true;
                            active: root.active_view == idx;
                            clicked => {
                                root.active_view = idx;
                                root.select_view(idx);
                            }
                        }
                    }
                }
            }
        }
    }

    Rectangle {
        height: 1px;
        background: MaterialPalette.outline_variant;
    }
}
