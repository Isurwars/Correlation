import {
    MaterialPalette,
    MaterialStyleMetrics,
    MaterialTypography,
    MaterialText,
    Icons,
} from "../../../material/material.slint";

export component Structure3DWorkflowBar inherits Rectangle {
    in property <string> file_basename: "";
    in property <string> total_atoms: "";
    in property <bool> analysis_running: false;
    in property <bool> has_validation_errors: false;
    in property <bool> analysis_done: false;

    callback run_analysis();
    callback cancel_analysis();
    callback open_panel(int);

    height: 36px;
    border-radius: MaterialStyleMetrics.border_radius_full;
    background: MaterialPalette.surface_container_highest.with_alpha(88%);
    border-width: 1px;
    border-color: MaterialPalette.outline_variant.with_alpha(55%);
    width: workflow_layout.preferred-width + 16px;

    workflow_layout := HorizontalLayout {
        height: 100%;
        padding-left: MaterialStyleMetrics.padding_8;
        padding-right: MaterialStyleMetrics.padding_8;
        spacing: MaterialStyleMetrics.spacing_8;
        alignment: center;

        // Compact Structure Status Pill
        HorizontalLayout {
            spacing: MaterialStyleMetrics.spacing_6;
            alignment: center;

            VerticalLayout {
                alignment: center;
                Image {
                    width: 14px;
                    height: 14px;
                    source: Icons.folder_open;
                    colorize: MaterialPalette.on_surface_variant;
                }
            }

            MaterialText {
                text: root.file_basename + " (" + root.total_atoms + " atoms)";
                style: MaterialTypography.label_large;
                color: MaterialPalette.on_surface_variant;
                vertical-alignment: center;
            }
        }

        // Quick Action CTA (shown while running or before analysis completes)
        if !root.analysis_done || root.analysis_running: run_btn_touch := TouchArea {
            accessible-role: button;
            accessible-label: root.analysis_running ? "Cancel Analysis" : "Run Analysis";
            height: 28px;
            y: (parent.height - self.height) / 2;
            width: run_btn_layout.preferred-width + 20px;
            enabled: root.analysis_running || !root.has_validation_errors;
            mouse-cursor: self.enabled ? pointer : default;
            clicked => {
                if (root.analysis_running) {
                    root.cancel_analysis();
                } else {
                    root.run_analysis();
                }
            }

            Rectangle {
                width: 100%;
                height: 100%;
                border-radius: MaterialStyleMetrics.border_radius_full;
                background: !run_btn_touch.enabled ? MaterialPalette.surface_container_high :
                    root.analysis_running ? (run_btn_touch.has-hover ? MaterialPalette.error.darker(8%) : MaterialPalette.error) :
                    (run_btn_touch.has-hover ? MaterialPalette.run.darker(8%) : MaterialPalette.run);

                animate background { duration: 150ms; }

                run_btn_layout := HorizontalLayout {
                    padding-left: MaterialStyleMetrics.padding_10;
                    padding-right: MaterialStyleMetrics.padding_10;
                    spacing: MaterialStyleMetrics.spacing_6;
                    alignment: center;

                    Image {
                        width: 14px;
                        height: 14px;
                        y: (parent.height - self.height) / 2;
                        source: root.analysis_running ? Icons.close : Icons.play_arrow;
                        colorize: !run_btn_touch.enabled ? MaterialPalette.outline :
                            root.analysis_running ? MaterialPalette.on_error : MaterialPalette.on_run;
                    }

                    MaterialText {
                        text: root.analysis_running ? "Cancel" : "Run";
                        style: MaterialTypography.label_large;
                        font_weight: 600;
                        color: !run_btn_touch.enabled ? MaterialPalette.outline :
                            root.analysis_running ? MaterialPalette.on_error : MaterialPalette.on_run;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }
                }
            }
        }

        // Open 3D Inspector / Calculators Button
        options_touch := TouchArea {
            width: 28px;
            height: 28px;
            y: (parent.height - self.height) / 2;
            mouse-cursor: pointer;
            accessible-role: button;
            accessible-label: "Open Calculators and Parameters";
            clicked => { root.open_panel(1); }

            Rectangle {
                width: 100%;
                height: 100%;
                border-radius: MaterialStyleMetrics.border_radius_full;
                background: options_touch.has-hover ? MaterialPalette.surface_container_high : transparent;

                Image {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: 15px;
                    height: 15px;
                    source: Icons.tune;
                    colorize: MaterialPalette.on_surface_variant;
                }
            }
        }
    }
}
