import {
    MaterialPalette,
    MaterialTypography,
    MaterialStyleMetrics,
    MaterialText,
    Icons,
} from "../../../material/material.slint";

export component TrajectoryPlaybackBar inherits Rectangle {
    in-out property <int> current_frame: 0;
    in property <int> total_frames: 0;
    in-out property <bool> is_playing: false;
    in-out property <int> playback_mode: 0; // 0: Loop (🔁), 1: Ping-Pong (🔀), 2: Play-Once (➡️)
    in-out property <int> speed_index: 1; // 0: 0.5x, 1: 1.0x, 2: 2.0x, 3: 5.0x
    property <bool> play_forward: true;

    out property <duration> playback_interval:
        root.speed_index == 0 ? 100ms :
        root.speed_index == 1 ? 50ms :
        root.speed_index == 2 ? 25ms : 10ms;

    callback seek_frame(int);
    callback step_frame(bool);

    playback_timer := Timer {
        interval: root.playback_interval;
        running: root.is_playing && root.total_frames > 1;
        triggered() => {
            if (root.playback_mode == 0) {
                root.step_frame(true);
            } else if (root.playback_mode == 1) {
                if (root.play_forward) {
                    if (root.current_frame + 1 >= root.total_frames) {
                        root.play_forward = false;
                        root.step_frame(false);
                    } else {
                        root.step_frame(true);
                    }
                } else {
                    if (root.current_frame <= 0) {
                        root.play_forward = true;
                        root.step_frame(true);
                    } else {
                        root.step_frame(false);
                    }
                }
            } else {
                if (root.current_frame + 1 >= root.total_frames) {
                    root.is_playing = false;
                } else {
                    root.step_frame(true);
                }
            }
        }
    }

    height: 46px;
    border-radius: 23px;
    background: MaterialPalette.surface_container_highest.with_alpha(92%);
    border-width: 1.5px;
    border-color: MaterialPalette.outline_variant.with_alpha(60%);
    clip: false;

    HorizontalLayout {
        height: 100%;
        padding-left: 12px;
        padding-right: 14px;
        spacing: 10px;

        // Step Previous Button
        TouchArea {
            width: 30px;
            height: 30px;
            y: (parent.height - self.height) / 2;
            mouse-cursor: pointer;
            accessible-role: button;
            accessible-label: "Previous Frame";
            clicked => { root.step_frame(false); }

            Rectangle {
                width: 100%;
                height: 100%;
                border-radius: 15px;
                background: parent.has-hover ? MaterialPalette.surface_container_high : transparent;
                animate background { duration: 150ms; }

                MaterialText {
                    width: 100%;
                    height: 100%;
                    text: "⏮";
                    font-size: 13px;
                    color: MaterialPalette.on_surface;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        // Play / Pause Button
        play_btn := TouchArea {
            width: 32px;
            height: 32px;
            y: (parent.height - self.height) / 2;
            mouse-cursor: pointer;
            accessible-role: button;
            accessible-label: root.is_playing ? "Pause Trajectory" : "Play Trajectory";
            clicked => {
                if (!root.is_playing && root.playback_mode == 2 && root.current_frame + 1 >= root.total_frames) {
                    root.seek_frame(0);
                }
                root.is_playing = !root.is_playing;
            }

            Rectangle {
                width: 100%;
                height: 100%;
                border-radius: 16px;
                background: play_btn.has-hover ? MaterialPalette.primary.darker(8%) : MaterialPalette.primary;
                animate background { duration: 150ms; }

                Image {
                    width: 16px;
                    height: 16px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    source: root.is_playing ? Icons.pause : Icons.play_arrow;
                    colorize: MaterialPalette.on_primary;
                }
            }
        }

        // Step Next Button
        TouchArea {
            width: 30px;
            height: 30px;
            y: (parent.height - self.height) / 2;
            mouse-cursor: pointer;
            accessible-role: button;
            accessible-label: "Next Frame";
            clicked => { root.step_frame(true); }

            Rectangle {
                width: 100%;
                height: 100%;
                border-radius: 15px;
                background: parent.has-hover ? MaterialPalette.surface_container_high : transparent;
                animate background { duration: 150ms; }

                MaterialText {
                    width: 100%;
                    height: 100%;
                    text: "⏭";
                    font-size: 13px;
                    color: MaterialPalette.on_surface;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        // Scrub Slider Container
        slider_container := Rectangle {
            horizontal-stretch: 1;
            min-width: 100px;
            height: 100%;
            clip: false;

            property <float> progress_ratio: root.total_frames > 1
                ? Math.max(0.0, Math.min(1.0, root.current_frame / (root.total_frames - 1.0)))
                : 0.0;

            // Track background
            track := Rectangle {
                x: 0px;
                y: (parent.height - self.height) / 2;
                width: parent.width;
                height: 6px;
                border-radius: 3px;
                background: MaterialPalette.surface_container_high;

                // Active fill track
                fill_bar := Rectangle {
                    x: 0px;
                    y: 0px;
                    width: Math.max(0px, parent.width * slider_container.progress_ratio);
                    height: 100%;
                    border-radius: 3px;
                    background: MaterialPalette.primary;
                }
            }

            // Draggable Thumb
            thumb := Rectangle {
                property <length> thumb_size: slider_touch.has-hover || slider_touch.is_scrubbing || slider_touch.pressed ? 16px : 14px;
                width: self.thumb_size;
                height: self.thumb_size;
                border-radius: self.thumb_size / 2;
                x: Math.max(0px, Math.min(slider_container.width - self.width,
                    slider_container.width * slider_container.progress_ratio - (self.width / 2)));
                y: (slider_container.height - self.height) / 2;
                background: MaterialPalette.primary;
                border-width: 2px;
                border-color: MaterialPalette.surface_container_lowest;

                animate width { duration: 100ms; }
                animate height { duration: 100ms; }
                animate border-radius { duration: 100ms; }
            }

            // Slider Touch Area (on top of track and thumb)
            slider_touch := TouchArea {
                width: 100%;
                height: 100%;
                mouse-cursor: pointer;
                accessible-role: slider;
                accessible-label: "Trajectory Frame Slider";

                property <bool> is_scrubbing: false;

                function update_from_touch() {
                    let w = self.width / 1px;
                    if (w <= 0.0) {
                        return;
                    }
                    let mx = self.mouse-x / 1px;
                    let ratio = Math.max(0.0, Math.min(1.0, mx / w));
                    let max_idx = root.total_frames > 1 ? (root.total_frames - 1) : 0;
                    let target = Math.round(ratio * max_idx);
                    root.current_frame = target;
                    root.seek_frame(target);
                }

                pointer-event(event) => {
                    if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                        self.is_scrubbing = true;
                        self.update_from_touch();
                    }
                    if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                        self.is_scrubbing = false;
                    }
                }

                moved => {
                    if (self.is_scrubbing || self.pressed) {
                        self.update_from_touch();
                    }
                }

                clicked => {
                    self.update_from_touch();
                }
            }
        }

        // Frame Counter Badge
        Rectangle {
            height: 28px;
            y: (parent.height - self.height) / 2;
            width: counter_layout.preferred-width + 16px;
            border-radius: 14px;
            background: MaterialPalette.surface_container_high.with_alpha(80%);

            counter_layout := HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                alignment: center;

                MaterialText {
                    text: (root.current_frame + 1) + " / " + root.total_frames;
                    font-size: 13px;
                    font-weight: 500;
                    color: MaterialPalette.on_surface_variant;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
            }
        }

        // Playback Mode Button (Loop / Ping-Pong / Play-Once)
        mode_btn := TouchArea {
            width: 30px;
            height: 30px;
            y: (parent.height - self.height) / 2;
            mouse-cursor: pointer;
            accessible-role: button;
            accessible-label: root.playback_mode == 0 ? "Playback Mode: Loop" :
                root.playback_mode == 1 ? "Playback Mode: Ping-Pong" : "Playback Mode: Play Once";
            clicked => {
                root.playback_mode = (root.playback_mode + 1 >= 3) ? 0 : root.playback_mode + 1;
            }

            Rectangle {
                width: 100%;
                height: 100%;
                border-radius: 15px;
                background: mode_btn.has-hover ? MaterialPalette.surface_container_high : transparent;
                animate background { duration: 150ms; }

                MaterialText {
                    width: 100%;
                    height: 100%;
                    text: root.playback_mode == 0 ? "🔁" :
                        root.playback_mode == 1 ? "🔀" : "➡️";
                    font-size: 13px;
                    color: root.playback_mode == 0 ? MaterialPalette.primary : MaterialPalette.on_surface;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        // Playback Speed Selector Pill (0.5x, 1x, 2x, 5x)
        speed_btn := TouchArea {
            width: speed_layout.preferred-width + 16px;
            height: 28px;
            y: (parent.height - self.height) / 2;
            mouse-cursor: pointer;
            accessible-role: button;
            accessible-label: "Playback Speed: " + (root.speed_index == 0 ? "0.5x" :
                root.speed_index == 1 ? "1.0x" :
                root.speed_index == 2 ? "2.0x" : "5.0x");
            clicked => {
                root.speed_index = (root.speed_index + 1 >= 4) ? 0 : root.speed_index + 1;
            }

            Rectangle {
                width: 100%;
                height: 100%;
                border-radius: 14px;
                background: speed_btn.has-hover ? MaterialPalette.surface_container_high :
                    MaterialPalette.surface_container_high.with_alpha(80%);
                border-width: 1px;
                border-color: MaterialPalette.outline_variant.with_alpha(40%);
                animate background { duration: 150ms; }

                speed_layout := HorizontalLayout {
                    padding-left: 6px;
                    padding-right: 6px;
                    alignment: center;

                    MaterialText {
                        text: root.speed_index == 0 ? "0.5x" :
                            root.speed_index == 1 ? "1.0x" :
                            root.speed_index == 2 ? "2.0x" : "5.0x";
                        font-size: 12.5px;
                        font-weight: 600;
                        color: MaterialPalette.primary;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }
                }
            }
        }
    }
}
