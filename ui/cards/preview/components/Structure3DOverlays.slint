import {
    MaterialPalette,
    MaterialTypography,
    MaterialStyleMetrics,
    MaterialText,
    TooltipTarget,
} from "../../../material/material.slint";
import { ViewportColorbar } from "./ViewportColorbar.slint";
import { ViewportScaleBar } from "./ViewportScaleBar.slint";
import { CameraHudState, ElementLegendItem } from "../../../Types.slint";

export component Structure3DOverlays inherits Rectangle {
    in property <bool> file_loaded: false;
    in property <int> total_frames: 0;
    in property <bool> has_interacted: false;
    in property <string> radial_brush_text: "";
    in property <string> measurement_text: "";
    in property <bool> phase_enabled: false;
    in property <bool> phase_computing: false;
    in property <int> phase_cached_frames: 0;
    in property <bool> phase_panel_open: false;
    in property <string> phase_descriptor_name: "q̄₆";
    in property <float> phase_min_threshold: 0.46;
    in property <float> phase_max_threshold: 0.58;
    in property <image> phase_colorbar_image;
    in property <CameraHudState> camera_hud;
    in property <[ElementLegendItem]> element_legend: [];
    in property <bool> has_hidden_elements: false;

    callback toggle_element_visibility(string);
    callback show_all_elements();
    callback clear_measurement();

    // Interactive Clickable Element Legend & Species Visibility Chips (top-left below workflow pill)
    if (root.file_loaded && root.element_legend.length > 0 && root.width >= 380px): Rectangle {
        x: 60px;
        y: 54px;
        width: legend_row.preferred-width + 12px;
        height: 26px;
        border-radius: MaterialStyleMetrics.border_radius_full;
        background: MaterialPalette.surface_container_highest.with_alpha(84%);
        border-width: 1px;
        border-color: MaterialPalette.outline_variant.with_alpha(50%);

        legend_row := HorizontalLayout {
            padding-left: 6px;
            padding-right: 6px;
            spacing: 4px;
            alignment: center;

            for item in root.element_legend: elem_chip := TooltipTarget {
                width: chip_inner.preferred-width + 10px;
                height: 20px;
                y: (parent.height - self.height) / 2;
                mouse-cursor: pointer;
                tooltip_text: item.visible
                    ? ("Hide " + item.symbol + " atoms (" + item.count + ")")
                    : ("Show " + item.symbol + " atoms (" + item.count + ")");
                accessible-role: button;
                accessible-label: "Toggle " + item.symbol + " visibility";
                clicked => { root.toggle_element_visibility(item.symbol); }

                Rectangle {
                    width: 100%;
                    height: 100%;
                    border-radius: MaterialStyleMetrics.border_radius_full;
                    background: item.visible
                        ? (elem_chip.has-hover ? MaterialPalette.surface_container_high : transparent)
                        : MaterialPalette.surface_container_lowest.with_alpha(75%);
                    opacity: item.visible ? 1.0 : 0.48;

                    chip_inner := HorizontalLayout {
                        padding-left: 5px;
                        padding-right: 5px;
                        spacing: 4px;
                        alignment: center;

                        Rectangle {
                            width: 8px;
                            height: 8px;
                            y: (parent.height - self.height) / 2;
                            border-radius: 4px;
                            background: item.color;
                        }

                        MaterialText {
                            text: item.symbol + " " + item.count;
                            style: MaterialTypography.label_small;
                            font-weight: item.visible ? 600 : 400;
                            color: MaterialPalette.on_surface;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            if (root.has_hidden_elements): reset_chip := TooltipTarget {
                width: reset_lbl.preferred-width + 10px;
                height: 20px;
                y: (parent.height - self.height) / 2;
                mouse-cursor: pointer;
                tooltip_text: "Restore visibility of all hidden chemical elements.";
                accessible-role: button;
                accessible-label: "Show All Elements";
                clicked => { root.show_all_elements(); }

                Rectangle {
                    width: 100%;
                    height: 100%;
                    border-radius: MaterialStyleMetrics.border_radius_full;
                    background: reset_chip.has-hover ? MaterialPalette.primary_container : MaterialPalette.surface_container_high;

                    reset_lbl := MaterialText {
                        width: 100%;
                        height: 100%;
                        text: "Show All";
                        style: MaterialTypography.label_small_prominent;
                        color: MaterialPalette.primary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }

    // Dual-View Radial Shell Brushing Status Pill (top-center)
    if (root.file_loaded && root.radial_brush_text != ""): Rectangle {
        x: (parent.width - self.width) / 2;
        y: 12px;
        width: brush_txt.preferred-width + 20px;
        height: 26px;
        border-radius: MaterialStyleMetrics.border_radius_full;
        background: MaterialPalette.primary_container.with_alpha(92%);
        border-width: 1px;
        border-color: MaterialPalette.primary;

        brush_txt := MaterialText {
            width: 100%;
            height: 100%;
            text: root.radial_brush_text;
            style: MaterialTypography.label_small_prominent;
            color: MaterialPalette.on_primary_container;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    // 3D Distance & Angle Ruler Status Pill (top-center)
    if (root.file_loaded && root.measurement_text != ""): Rectangle {
        x: (parent.width - self.width) / 2;
        y: root.radial_brush_text != "" ? 44px : 12px;
        width: measure_row.preferred-width + 20px;
        height: 26px;
        border-radius: MaterialStyleMetrics.border_radius_full;
        background: MaterialPalette.secondary_container.with_alpha(94%);
        border-width: 1px;
        border-color: MaterialPalette.secondary;

        measure_row := HorizontalLayout {
            padding-left: 10px;
            padding-right: 6px;
            spacing: 8px;
            alignment: center;

            MaterialText {
                text: root.measurement_text;
                style: MaterialTypography.label_small_prominent;
                color: MaterialPalette.on_secondary_container;
                vertical-alignment: center;
            }

            clear_measure_btn := TooltipTarget {
                width: 18px;
                height: 18px;
                y: (parent.height - self.height) / 2;
                mouse-cursor: pointer;
                tooltip_text: "Clear 3D measurement (Esc).";
                accessible-role: button;
                accessible-label: "Clear Measurement";
                clicked => { root.clear_measurement(); }

                Rectangle {
                    width: 100%;
                    height: 100%;
                    border-radius: MaterialStyleMetrics.border_radius_full;
                    background: clear_measure_btn.has-hover ? MaterialPalette.surface_container_high : transparent;

                    MaterialText {
                        width: 100%;
                        height: 100%;
                        text: "×";
                        style: MaterialTypography.label_small_prominent;
                        color: MaterialPalette.on_secondary_container;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }

    // Non-blocking Phase Pre-bake / Computing Status Pill (top-center)
    if (root.file_loaded && root.phase_enabled && root.phase_computing): Rectangle {
        x: (parent.width - self.width) / 2;
        y: (root.radial_brush_text != "" ? 44px : 12px) + (root.measurement_text != "" ? 32px : 0px);
        width: phase_comp_row.preferred-width + 20px;
        height: 26px;
        border-radius: MaterialStyleMetrics.border_radius_full;
        background: MaterialPalette.surface_container_highest.with_alpha(92%);
        border-width: 1px;
        border-color: MaterialPalette.primary.with_alpha(70%);

        phase_comp_row := HorizontalLayout {
            padding-left: 10px;
            padding-right: 10px;
            spacing: 6px;
            alignment: center;

            Rectangle {
                width: 7px;
                height: 7px;
                y: (parent.height - self.height) / 2;
                border-radius: 3.5px;
                background: MaterialPalette.primary;
            }

            MaterialText {
                text: root.total_frames > 1
                    ? ("Baking " + root.phase_descriptor_name + " (" + root.phase_cached_frames + " / " + root.total_frames + ")…")
                    : ("Computing " + root.phase_descriptor_name + "…");
                style: MaterialTypography.label_small_prominent;
                color: MaterialPalette.on_surface;
                vertical-alignment: center;
            }
        }
    }

    // Subtle bottom navigation hint (auto-hides after first camera drag or in narrow Dual-View panes)
    if (root.file_loaded && !root.has_interacted && root.width >= 640px): Rectangle {
        x: (parent.width - self.width) / 2;
        y: parent.height - self.height - (root.total_frames > 1 ? 66px : 10px);
        width: hint_text.preferred-width + 20px;
        height: 24px;
        border-radius: MaterialStyleMetrics.border_radius_12;
        background: MaterialPalette.surface_container_highest.with_alpha(60%);

        hint_text := MaterialText {
            text: "🖱 Left: Orbit  •  Right: Pan  •  Scroll: Zoom  •  Space: Play/Pause  •  ←/→: Step  •  H: Home";
            font-size: MaterialTypography.label_medium.font_size;
            color: MaterialPalette.on_surface_variant.with_alpha(80%);
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    // Floating Viewport Colorbar (bottom-right when halos enabled and sidebar collapsed)
    if (root.phase_enabled && !root.phase_panel_open): ViewportColorbar {
        x: parent.width - self.width - 16px;
        y: parent.height - self.height - (root.total_frames > 1 ? 104px : 54px);
        descriptor_name: root.phase_descriptor_name;
        min_val: root.phase_min_threshold;
        max_val: root.phase_max_threshold;
        colorbar_image: root.phase_colorbar_image;
    }

    // Calibrated Dynamic Angstrom Scale Bar (bottom-right)
    if (root.file_loaded && root.camera_hud.scale_bar_label != ""): ViewportScaleBar {
        x: parent.width - self.width - 16px;
        y: parent.height - self.height - (root.total_frames > 1 ? 66px : 16px);
        bar_width: root.camera_hud.scale_bar_px;
        label: root.camera_hud.scale_bar_label;
    }
}
