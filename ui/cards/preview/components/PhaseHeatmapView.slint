import {
    MaterialPalette,
    MaterialTypography,
    MaterialText,
} from "../../../material/material.slint";
import { CrystalMarker } from "./PhaseHeatmapTypes.slint";
import { PhaseHeatmapAxisSelector } from "./PhaseHeatmapAxisSelector.slint";
import { PhaseHeatmapCanvas } from "./PhaseHeatmapCanvas.slint";

export { CrystalMarker }

export component PhaseHeatmapView inherits Rectangle {
    in property <image> heatmap_image;
    in property <int> descriptor_x: 1; // Default Q4Bar
    in property <int> descriptor_y: 0; // Default Q6Bar
    in property <string> descriptor_name_x: "q̄₄";
    in property <string> descriptor_name_y: "q̄₆";
    in property <float> min_x: 0.0;
    in property <float> max_x: 1.0;
    in property <float> min_y: 0.0;
    in property <float> max_y: 1.0;
    in property <float> sel_min_x: 0.0;
    in property <float> sel_max_x: 1.0;
    in property <float> sel_min_y: 0.0;
    in property <float> sel_max_y: 1.0;
    in property <int> matching_atoms: 0;
    in property <int> total_atoms: 0;
    in property <[CrystalMarker]> crystal_markers: [];

    callback set_descriptor_x(int);
    callback set_descriptor_y(int);
    callback set_selection_2d(float, float, float, float); // min_x, max_x, min_y, max_y
    callback export_png();
    callback reset_selection();

    background: transparent;

    VerticalLayout {
        spacing: 5px;

        // 1. Telemetry & Snapshot Export Header
        HorizontalLayout {
            alignment: space-between;

            MaterialText {
                text: "2D Density Map";
                font-size: 11px;
                font-weight: 700;
                color: MaterialPalette.on_surface;
                vertical-alignment: center;
            }

            HorizontalLayout {
                spacing: 6px;
                alignment: center;

                // Reset Selection Button
                reset_btn := TouchArea {
                    width: 22px;
                    height: 20px;
                    mouse-cursor: pointer;
                    accessible-role: button;
                    accessible-label: "Reset 2D Selection Box";
                    clicked => { root.reset_selection(); }

                    Rectangle {
                        width: 100%;
                        height: 100%;
                        border-radius: 4px;
                        background: reset_btn.has-hover ? MaterialPalette.surface_container_highest : transparent;

                        MaterialText {
                            width: 100%;
                            height: 100%;
                            text: "↺";
                            font-size: 12px;
                            color: MaterialPalette.on_surface_variant;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

                // Export PNG Snapshot Button
                export_btn := TouchArea {
                    height: 20px;
                    mouse-cursor: pointer;
                    accessible-role: button;
                    accessible-label: "Export Heatmap PNG";
                    clicked => { root.export_png(); }

                    Rectangle {
                        border-radius: 4px;
                        background: export_btn.has-hover ? MaterialPalette.primary.with_alpha(25%) : MaterialPalette.surface_container_highest;
                        border-width: 1px;
                        border-color: export_btn.has-hover ? MaterialPalette.primary : MaterialPalette.outline_variant.with_alpha(40%);

                        HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 6px;
                            spacing: 4px;
                            alignment: center;

                            MaterialText {
                                text: "📸 PNG";
                                font-size: 10px;
                                font-weight: 600;
                                color: MaterialPalette.primary;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }

        // 2. Axis Selection Rows
        PhaseHeatmapAxisSelector {
            descriptor_x: root.descriptor_x;
            descriptor_y: root.descriptor_y;
            set_descriptor_x(idx) => { root.set_descriptor_x(idx); }
            set_descriptor_y(idx) => { root.set_descriptor_y(idx); }
        }

        // 3. Heatmap Canvas with Coordinate Overlays
        HorizontalLayout {
            spacing: 4px;

            // Y-Axis Label and Bounds
            VerticalLayout {
                width: 24px;
                alignment: space-between;

                MaterialText {
                    text: "" + (Math.round(root.max_y * 100) / 100);
                    font-size: 8px;
                    color: MaterialPalette.on_surface_variant;
                    horizontal-alignment: right;
                }

                MaterialText {
                    text: root.descriptor_name_y;
                    font-size: 9.5px;
                    font-weight: 700;
                    color: MaterialPalette.secondary;
                    horizontal-alignment: right;
                }

                MaterialText {
                    text: "" + (Math.round(root.min_y * 100) / 100);
                    font-size: 8px;
                    color: MaterialPalette.on_surface_variant;
                    horizontal-alignment: right;
                }
            }

            // Central Square Canvas
            PhaseHeatmapCanvas {
                heatmap_image: root.heatmap_image;
                min_x: root.min_x;
                max_x: root.max_x;
                min_y: root.min_y;
                max_y: root.max_y;
                sel_min_x: root.sel_min_x;
                sel_max_x: root.sel_max_x;
                sel_min_y: root.sel_min_y;
                sel_max_y: root.sel_max_y;
                crystal_markers: root.crystal_markers;
                set_selection_2d(min_x, max_x, min_y, max_y) => {
                    root.set_selection_2d(min_x, max_x, min_y, max_y);
                }
                reset_selection => {
                    root.reset_selection();
                }
            }
        }

        // X-Axis Label and Bounds Footer
        HorizontalLayout {
            padding-left: 28px;
            alignment: space-between;

            MaterialText {
                text: "" + (Math.round(root.min_x * 100) / 100);
                font-size: 8px;
                color: MaterialPalette.on_surface_variant;
            }

            MaterialText {
                text: root.descriptor_name_x;
                font-size: 9.5px;
                font-weight: 700;
                color: MaterialPalette.primary;
            }

            MaterialText {
                text: "" + (Math.round(root.max_x * 100) / 100);
                font-size: 8px;
                color: MaterialPalette.on_surface_variant;
            }
        }

        // 4. Selection Telemetry Summary
        HorizontalLayout {
            alignment: space-between;

            MaterialText {
                text: "Selection Box:";
                font-size: 9.5px;
                color: MaterialPalette.on_surface_variant;
            }

            MaterialText {
                text: root.total_atoms > 0
                    ? ("" + root.matching_atoms + " / " + root.total_atoms + " (" + (Math.round(root.matching_atoms * 1000.0 / root.total_atoms) / 10.0) + "%)")
                    : "0 Atoms";
                font-size: 9.5px;
                font-weight: 700;
                color: root.matching_atoms > 0 ? MaterialPalette.primary : MaterialPalette.on_surface_variant;
            }
        }
    }
}
