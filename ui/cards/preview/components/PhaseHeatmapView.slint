import {
    MaterialStyleMetrics,
    MaterialPalette,
    MaterialTypography,
    MaterialText,
    Chip,
} from "../../../material/material.slint";
import { CrystalMarker } from "./PhaseHeatmapTypes.slint";
import { PhaseHeatmapAxisSelector } from "./PhaseHeatmapAxisSelector.slint";
import { PhaseHeatmapCanvas } from "./PhaseHeatmapCanvas.slint";
import { PhaseColorbar } from "./PhaseColorbar.slint";

export { CrystalMarker }

export component PhaseHeatmapView inherits Rectangle {
    in property <bool> full_height: false;
    in property <image> heatmap_image;
    in property <image> colorbar_image;
    in property <int> colormap_index: 0;
    in property <int> preset_index: 0;
    in property <int> descriptor_x: 1; // Default Q4Bar
    in property <int> descriptor_y: 0; // Default Q6Bar
    in property <string> descriptor_name_x: "q̄₄";
    in property <string> descriptor_name_y: "q̄₆";
    in property <float> min_x: 0.0;
    in property <float> max_x: 1.0;
    in property <float> min_y: 0.0;
    in property <float> max_y: 1.0;
    in property <float> sel_min_x: 0.0;
    in property <float> sel_max_x: 1.0;
    in property <float> sel_min_y: 0.0;
    in property <float> sel_max_y: 1.0;
    in property <int> matching_atoms: 0;
    in property <int> total_atoms: 0;
    in property <[CrystalMarker]> crystal_markers: [];

    callback set_descriptor_x(int);
    callback set_descriptor_y(int);
    callback set_colormap(int);
    callback set_preset(int);
    callback set_selection_2d(float, float, float, float); // min_x, max_x, min_y, max_y
    callback export_png();
    callback reset_selection();


    VerticalLayout {
        width: 100%;
        height: 100%;
        padding-left: root.full_height ? 10px : 0px;
        padding-right: root.full_height ? 10px : 0px;
        padding-top: root.full_height ? 8px : 0px;
        padding-bottom: root.full_height ? 8px : 0px;
        spacing: root.full_height ? 6px : 5px;

        // 1. Telemetry & Snapshot Export Header
        HorizontalLayout {
            alignment: space-between;

            MaterialText {
                text: "2D Phase Heatmap";
                font-size: MaterialTypography.label_small.font_size;
                font-weight: 700;
                color: MaterialPalette.on_surface;
                vertical-alignment: center;
            }

            HorizontalLayout {
                spacing: 6px;
                alignment: center;

                // Reset Selection Button
                reset_btn := TouchArea {
                    width: 22px;
                    height: 20px;
                    mouse-cursor: pointer;
                    accessible-role: button;
                    accessible-label: "Reset 2D Selection Box";
                    clicked => { root.reset_selection(); }

                    Rectangle {
                        border-radius: MaterialStyleMetrics.border_radius_4;
                        background: reset_btn.has-hover ? MaterialPalette.surface_container_highest : transparent;

                        MaterialText {
                            width: 100%;
                            height: 100%;
                            text: "↺";
                            font-size: MaterialTypography.label_medium.font_size;
                            color: MaterialPalette.on_surface_variant;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

                // Export PNG Snapshot Button
                export_btn := TouchArea {
                    height: 20px;
                    mouse-cursor: pointer;
                    accessible-role: button;
                    accessible-label: "Export Heatmap PNG";
                    clicked => { root.export_png(); }

                    Rectangle {
                        border-radius: MaterialStyleMetrics.border_radius_4;
                        background: export_btn.has-hover ? MaterialPalette.primary.with_alpha(25%) : MaterialPalette.surface_container_highest;
                        border-width: 1px;
                        border-color: export_btn.has-hover ? MaterialPalette.primary : MaterialPalette.outline_variant.with_alpha(40%);

                        HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 6px;
                            spacing: 4px;
                            alignment: center;

                            MaterialText {
                                text: "📸 PNG";
                                font-size: 10px;
                                font-weight: 600;
                                color: MaterialPalette.primary;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }

        // 2. Crystal Presets Quick Selector
        HorizontalLayout {
            spacing: 3px;
            height: 22px;
            property <[string]> preset_labels: ["Custom", "Liquid", "Glass", "a-Net", "FCC", "HCP", "BCC", "Ico", "Diamond"];

            for p_label[p_idx] in self.preset_labels: Chip {
                horizontal-stretch: 1;
                chip_height: MaterialStyleMetrics.size_20;
                corner_radius: MaterialStyleMetrics.border_radius_8;
                label: p_label;
                selected: root.preset_index == p_idx;
                active_bg: MaterialPalette.primary.with_alpha(25%);
                active_fg: MaterialPalette.primary;
                tooltip_text: "Apply " + p_label + " 2D phase preset.";
                clicked => { root.set_preset(p_idx); }
            }
        }

        // 3. Axis Selection Rows
        PhaseHeatmapAxisSelector {
            descriptor_x: root.descriptor_x;
            descriptor_y: root.descriptor_y;
            set_descriptor_x(idx) => { root.set_descriptor_x(idx); }
            set_descriptor_y(idx) => { root.set_descriptor_y(idx); }
        }

        // 4. Color Palette & Colormap Selector
        HorizontalLayout {
            spacing: 8px;
            alignment: center;

            // Colormap Selector Chips
            HorizontalLayout {
                spacing: 2px;
                property <[string]> cmap_labels: ["Viridis", "Plasma", "Cool", "Turbo"];

                for c_label[c_idx] in self.cmap_labels: Chip {
                    chip_height: MaterialStyleMetrics.size_20;
                    corner_radius: MaterialStyleMetrics.border_radius_8;
                    label: c_label;
                    selected: root.colormap_index == c_idx;
                    active_bg: MaterialPalette.tertiary.with_alpha(25%);
                    active_fg: MaterialPalette.tertiary;
                    tooltip_text: "Switch colormap to " + c_label;
                    clicked => { root.set_colormap(c_idx); }
                }
            }

            // Scalar Palette Colorbar Bar
            PhaseColorbar {
                horizontal-stretch: 1;
                colorbar_image: root.colorbar_image;
                min_threshold: root.sel_min_x;
                max_threshold: root.sel_max_x;
                descriptor_name: root.descriptor_name_x;
            }
        }

        // 3. Heatmap Canvas with Coordinate Overlays
        HorizontalLayout {
            spacing: 4px;
            vertical-stretch: root.full_height ? 1 : 0;
            horizontal-stretch: 1;

            // Y-Axis Label and Bounds
            VerticalLayout {
                width: 24px;
                alignment: space-between;

                MaterialText {
                    text: "" + (Math.round(root.max_y * 100) / 100);
                    font-size: 8px;
                    color: MaterialPalette.on_surface_variant;
                    horizontal-alignment: right;
                }

                MaterialText {
                    text: root.descriptor_name_y;
                    font-size: 9.5px;
                    font-weight: 700;
                    color: MaterialPalette.secondary;
                    horizontal-alignment: right;
                }

                MaterialText {
                    text: "" + (Math.round(root.min_y * 100) / 100);
                    font-size: 8px;
                    color: MaterialPalette.on_surface_variant;
                    horizontal-alignment: right;
                }
            }

            // Central Canvas
            PhaseHeatmapCanvas {
                full_height: root.full_height;
                heatmap_image: root.heatmap_image;
                min_x: root.min_x;
                max_x: root.max_x;
                min_y: root.min_y;
                max_y: root.max_y;
                sel_min_x: root.sel_min_x;
                sel_max_x: root.sel_max_x;
                sel_min_y: root.sel_min_y;
                sel_max_y: root.sel_max_y;
                crystal_markers: root.crystal_markers;
                set_selection_2d(min_x, max_x, min_y, max_y) => {
                    root.set_selection_2d(min_x, max_x, min_y, max_y);
                }
                reset_selection => {
                    root.reset_selection();
                }
            }
        }

        // X-Axis Label and Bounds Footer
        HorizontalLayout {
            padding-left: 28px;
            alignment: space-between;

            MaterialText {
                text: "" + (Math.round(root.min_x * 100) / 100);
                font-size: 8px;
                color: MaterialPalette.on_surface_variant;
            }

            MaterialText {
                text: root.descriptor_name_x;
                font-size: 9.5px;
                font-weight: 700;
                color: MaterialPalette.primary;
            }

            MaterialText {
                text: "" + (Math.round(root.max_x * 100) / 100);
                font-size: 8px;
                color: MaterialPalette.on_surface_variant;
            }
        }

        // 5. Selection Telemetry Summary
        HorizontalLayout {
            alignment: space-between;

            HorizontalLayout {
                spacing: 6px;

                MaterialText {
                    text: "Selection Box:";
                    font-size: 9.5px;
                    color: MaterialPalette.on_surface_variant;
                }

                MaterialText {
                    text: "[" + (Math.round(root.sel_min_x * 100) / 100) + ", " + (Math.round(root.sel_max_x * 100) / 100) + "] × [" + (Math.round(root.sel_min_y * 100) / 100) + ", " + (Math.round(root.sel_max_y * 100) / 100) + "]";
                    font-size: 9.5px;
                    font-weight: 600;
                    color: MaterialPalette.on_surface;
                }
            }

            MaterialText {
                text: root.total_atoms > 0
                    ? ("" + root.matching_atoms + " / " + root.total_atoms + " (" + (Math.round(root.matching_atoms * 1000.0 / root.total_atoms) / 10.0) + "%)")
                    : "0 Atoms";
                font-size: 9.5px;
                font-weight: 700;
                color: root.matching_atoms > 0 ? MaterialPalette.primary : MaterialPalette.on_surface_variant;
            }
        }
    }
}
