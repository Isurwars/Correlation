import {
    MaterialPalette,
    MaterialTypography,
    MaterialText,
} from "../../../material/material.slint";

export component ViewportColorbar inherits Rectangle {
    in property <string> descriptor_name: "q̄₆";
    in property <float> min_val: 0.46;
    in property <float> max_val: 0.58;
    in property <image> colorbar_image;

    width: 190px;
    height: 50px;
    border-radius: 12px;
    background: MaterialPalette.surface_container_highest.with_alpha(88%);
    border-width: 1px;
    border-color: MaterialPalette.outline_variant.with_alpha(50%);
    clip: true;

    VerticalLayout {
        padding-left: 10px;
        padding-right: 10px;
        padding-top: 5px;
        padding-bottom: 5px;
        spacing: 3px;

        // Header: Descriptor label and title
        HorizontalLayout {
            alignment: space-between;
            MaterialText {
                text: root.descriptor_name;
                font-size: 12.5px;
                font-weight: 700;
                color: MaterialPalette.on_surface;
                vertical-alignment: center;
            }
            MaterialText {
                text: "Scalar Halo";
                font-size: 10.5px;
                color: MaterialPalette.on_surface_variant;
                vertical-alignment: center;
            }
        }

        // Color gradient bar
        Rectangle {
            height: 10px;
            border-radius: 4px;
            clip: true;
            background: MaterialPalette.surface_container_high;

            Image {
                width: 100%;
                height: 100%;
                source: root.colorbar_image;
                image-fit: fill;
            }
        }

        // Min / Max labels
        HorizontalLayout {
            alignment: space-between;
            MaterialText {
                text: "" + (Math.round(root.min_val * 100) / 100);
                font-size: 10.5px;
                color: MaterialPalette.on_surface_variant;
            }
            MaterialText {
                text: "" + (Math.round(root.max_val * 100) / 100);
                font-size: 10.5px;
                color: MaterialPalette.on_surface_variant;
            }
        }
    }
}
