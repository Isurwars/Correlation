import {
    MaterialStyleMetrics,
    MaterialPalette,
    MaterialTypography,
    MaterialText,
} from "../../../material/material.slint";
import { PhaseColorbar } from "./PhaseColorbar.slint";

export component ViewportColorbar inherits Rectangle {
    in property <string> descriptor_name: "q̄₆";
    in property <float> min_val: 0.46;
    in property <float> max_val: 0.58;
    in property <image> colorbar_image;

    width: 190px;
    height: 50px;
    border-radius: MaterialStyleMetrics.border_radius_12;
    background: MaterialPalette.surface_container_highest.with_alpha(88%);
    border-width: 1px;
    border-color: MaterialPalette.outline_variant.with_alpha(50%);
    clip: true;

    VerticalLayout {
        padding-left: MaterialStyleMetrics.padding_10;
        padding-right: MaterialStyleMetrics.padding_10;
        padding-top: MaterialStyleMetrics.padding_4;
        padding-bottom: MaterialStyleMetrics.padding_4;
        spacing: MaterialStyleMetrics.spacing_2;

        HorizontalLayout {
            alignment: space-between;
            MaterialText {
                text: root.descriptor_name;
                style: MaterialTypography.label_medium_prominent;
                color: MaterialPalette.on_surface;
                vertical-alignment: center;
            }
            MaterialText {
                text: "Scalar Halo";
                style: MaterialTypography.label_small;
                color: MaterialPalette.on_surface_variant;
                vertical-alignment: center;
            }
        }

        PhaseColorbar {
            colorbar_image: root.colorbar_image;
            min_threshold: root.min_val;
            max_threshold: root.max_val;
            descriptor_name: root.descriptor_name;
            show_title: false;
        }
    }
}
