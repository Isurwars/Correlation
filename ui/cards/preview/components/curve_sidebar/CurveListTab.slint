import {
    MaterialPalette,
    MaterialStyleMetrics,
    MaterialTypography,
    MaterialText,
    ScrollView,
    Vertical,
    Icons,
} from "../../../../material/material.slint";
import { CurveToggleItem } from "../../../../Types.slint";
import { CompactInputField } from "CompactInputField.slint";

component CurveBatchAction inherits TouchArea {
    in property <string> label;

    height: 22px;
    width: action_txt.preferred-width + 8px;
    mouse-cursor: pointer;
    accessible-role: button;
    accessible-label: root.label + " curves";

    Rectangle {
        border-radius: MaterialStyleMetrics.border_radius_4;
        background: root.has-hover ? MaterialPalette.surface_container_highest : transparent;

        action_txt := MaterialText {
            text: root.label;
            style: MaterialTypography.label_small;
            font_weight: 600;
            color: MaterialPalette.primary;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

/// Tab 0 of CurveSidebar: curve filtering, batch visibility, color swatches, and line width.
export component CurveListTab inherits VerticalLayout {
    in property <[CurveToggleItem]> curve_toggle_items: [];
    in-out property <int> active_color_picker_id: -1;
    in-out property <string> curve_filter: "";
    in-out property <string> line_width: "";

    callback filter_curves(string);
    callback invert_curves();
    callback toggle_curve_visibility(int, bool);
    callback toggle_all_curves(bool);
    callback set_curve_color(int, string);
    callback set_curve_width(string);
    callback apply_axis_settings();

    private property <[color]> swatch_colors: [
        #e69f00, #56b4e9, #009e73, #f0e442,
        #0072b2, #d55e00, #cc79a7, #00c49f,
        #1f77b4, #ff7f0e, #2ca02c, #d62728,
        #9467bd, #8c564b, #e377c2, #7f7f7f,
        #bcbd22, #17becf, #332288, #117733,
        #44aa99, #88ccee, #ddcc77, #cc6677
    ];

    private property <[string]> swatch_hexes: [
        "#e69f00", "#56b4e9", "#009e73", "#f0e442",
        "#0072b2", "#d55e00", "#cc79a7", "#00c49f",
        "#1f77b4", "#ff7f0e", "#2ca02c", "#d62728",
        "#9467bd", "#8c564b", "#e377c2", "#7f7f7f",
        "#bcbd22", "#17becf", "#332288", "#117733",
        "#44aa99", "#88ccee", "#ddcc77", "#cc6677"
    ];

    spacing: MaterialStyleMetrics.spacing_6;

    // 1. Search Filter Box
    HorizontalLayout {
        height: 28px;

        search_container := Rectangle {
            horizontal-stretch: 1;
            height: 28px;
            border-radius: MaterialStyleMetrics.border_radius_4;
            background: MaterialPalette.surface_container_highest;
            border-width: 1px;
            border-color: search_input.has-focus ? MaterialPalette.primary : MaterialPalette.outline_variant;

            HorizontalLayout {
                padding-left: MaterialStyleMetrics.padding_8;
                padding-right: MaterialStyleMetrics.padding_6;
                spacing: MaterialStyleMetrics.spacing_6;
                alignment: center;

                VerticalLayout {
                    alignment: center;
                    Image {
                        width: 14px;
                        height: 14px;
                        source: Icons.zoom_in;
                        colorize: MaterialPalette.on_surface_variant;
                    }
                }

                Rectangle {
                    horizontal-stretch: 1;

                    if root.curve_filter == "" && !search_input.has-focus: MaterialText {
                        width: 100%;
                        height: 100%;
                        text: "Filter curves (e.g. Fe, O-H)...";
                        style: MaterialTypography.body_small;
                        color: MaterialPalette.on_surface_variant.with_alpha(60%);
                        vertical-alignment: center;
                    }

                    search_input := TextInput {
                        width: 100%;
                        height: 100%;
                        single-line: true;
                        text <=> root.curve_filter;
                        color: MaterialPalette.on_surface;
                        font-size: MaterialTypography.body_small.font_size;
                        vertical-alignment: center;

                        edited => {
                            root.filter_curves(self.text);
                        }
                    }
                }

                if root.curve_filter != "": clear_search_touch := TouchArea {
                    width: 18px;
                    height: 18px;
                    mouse-cursor: pointer;
                    accessible-role: button;
                    accessible-label: "Clear curve filter";
                    clicked => {
                        root.curve_filter = "";
                        root.filter_curves("");
                    }

                    Rectangle {
                        border-radius: MaterialStyleMetrics.border_radius_full;
                        background: clear_search_touch.has-hover ? MaterialPalette.surface_container_high : transparent;

                        Image {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            width: 12px;
                            height: 12px;
                            source: Icons.close;
                            colorize: MaterialPalette.on_surface_variant;
                        }
                    }
                }
            }
        }
    }

    // 2. All / None / Invert Batch Visibility Row
    HorizontalLayout {
        spacing: MaterialStyleMetrics.spacing_2;
        alignment: center;

        MaterialText {
            horizontal-stretch: 1;
            text: (root.curve_filter == "") ? "Visibility" : "Matching";
            style: MaterialTypography.label_small;
            color: MaterialPalette.on_surface_variant;
            vertical-alignment: center;
        }

        CurveBatchAction {
            label: "All";
            clicked => { root.toggle_all_curves(true); }
        }

        MaterialText {
            text: "/";
            style: MaterialTypography.label_small;
            color: MaterialPalette.outline;
            vertical-alignment: center;
        }

        CurveBatchAction {
            label: "None";
            clicked => { root.toggle_all_curves(false); }
        }

        MaterialText {
            text: "/";
            style: MaterialTypography.label_small;
            color: MaterialPalette.outline;
            vertical-alignment: center;
        }

        CurveBatchAction {
            label: "Invert";
            clicked => { root.invert_curves(); }
        }
    }

    // 3. Curves Scrollable List
    ScrollView {
        vertical-stretch: 1;
        content-height: root.curve_toggle_items.length * 30px;

        VerticalLayout {
            spacing: 2px;
            alignment: start;

            for item in root.curve_toggle_items: VerticalLayout {
                spacing: 0px;
                padding: 0px;

                if item.matches_filter: VerticalLayout {
                    spacing: 2px;

                    if item.id == 1 && root.curve_toggle_items.length > 1 && root.curve_filter == "": HorizontalLayout {
                        padding-top: 6px;
                        padding-bottom: 2px;
                        padding-left: 4px;
                        MaterialText {
                            text: "Partials:";
                            style: MaterialTypography.label_small;
                            font_weight: 600;
                            color: MaterialPalette.primary;
                        }
                    }

                    item_touch := TouchArea {
                        height: 28px;
                        mouse-cursor: pointer;
                        accessible-role: checkbox;
                        accessible-label: item.label;
                        clicked => { root.toggle_curve_visibility(item.id, !item.visible); }

                        Rectangle {
                            background: item_touch.has-hover ? MaterialPalette.surface_container_high : transparent;
                            border-radius: MaterialStyleMetrics.border_radius_2;

                            HorizontalLayout {
                                padding-left: (item.label == "Total") ? 6px : 12px;
                                padding-right: 6px;
                                spacing: MaterialStyleMetrics.spacing_8;

                                Vertical {
                                    alignment: center;
                                    height: 100%;

                                    color_dot_touch := TouchArea {
                                        width: 18px;
                                        height: 18px;
                                        mouse-cursor: pointer;
                                        accessible-role: button;
                                        accessible-label: "Change color for " + item.label;
                                        clicked => { root.active_color_picker_id = (root.active_color_picker_id == item.id) ? -1 : item.id; }

                                        Rectangle {
                                            width: 12px;
                                            height: 12px;
                                            border-radius: MaterialStyleMetrics.border_radius_full;
                                            background: item.visible ? item.color_hex : MaterialPalette.outline;
                                            border-width: color_dot_touch.has-hover ? 2px : 0px;
                                            border-color: MaterialPalette.primary;
                                        }
                                    }
                                }

                                MaterialText {
                                    horizontal-stretch: 1;
                                    text: item.label;
                                    style: (item.label == "Total") ? MaterialTypography.label_large : MaterialTypography.body_medium;
                                    color: item.visible ? MaterialPalette.on_surface : MaterialPalette.on_surface_variant;
                                    overflow: elide;
                                    horizontal-alignment: left;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // 4. In-Place Color Palette Picker
    if root.active_color_picker_id >= 0: Rectangle {
        background: MaterialPalette.surface_container_high;
        border-radius: MaterialStyleMetrics.border_radius_4;
        border-width: 1px;
        border-color: MaterialPalette.outline;

        VerticalLayout {
            padding: MaterialStyleMetrics.padding_8;
            spacing: MaterialStyleMetrics.spacing_6;

            HorizontalLayout {
                alignment: center;
                MaterialText {
                    horizontal-stretch: 1;
                    text: "Select Color";
                    style: MaterialTypography.label_medium;
                    color: MaterialPalette.on_surface;
                    vertical-alignment: center;
                }

                close_picker_touch := TouchArea {
                    width: 20px;
                    height: 20px;
                    mouse-cursor: pointer;
                    accessible-role: button;
                    accessible-label: "Close color picker";
                    clicked => { root.active_color_picker_id = -1; }

                    Rectangle {
                        border-radius: MaterialStyleMetrics.border_radius_full;
                        background: close_picker_touch.has-hover ? MaterialPalette.surface_container_highest : transparent;

                        Image {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            width: 12px;
                            height: 12px;
                            source: Icons.close;
                            colorize: MaterialPalette.on_surface_variant;
                        }
                    }
                }
            }

            VerticalLayout {
                spacing: MaterialStyleMetrics.spacing_4;
                for r_idx in 6: HorizontalLayout {
                    spacing: MaterialStyleMetrics.spacing_4;
                    alignment: center;
                    for c_idx in 4: swatch_touch := TouchArea {
                        width: 28px;
                        height: 24px;
                        mouse-cursor: pointer;
                        accessible-role: button;
                        accessible-label: "Color swatch " + root.swatch_hexes[r_idx * 4 + c_idx];
                        clicked => {
                            root.set_curve_color(root.active_color_picker_id, root.swatch_hexes[r_idx * 4 + c_idx]);
                            root.active_color_picker_id = -1;
                        }
                        Rectangle {
                            width: 20px;
                            height: 20px;
                            border-radius: MaterialStyleMetrics.border_radius_full;
                            background: root.swatch_colors[r_idx * 4 + c_idx];
                            border-width: swatch_touch.has-hover ? 2px : 1px;
                            border-color: swatch_touch.has-hover ? MaterialPalette.primary : MaterialPalette.outline;
                        }
                    }
                }
            }

            CompactInputField {
                placeholder_text: "#RRGGBB";
                accepted(hex) => {
                    if (hex != "") {
                        root.set_curve_color(root.active_color_picker_id, hex);
                        root.active_color_picker_id = -1;
                    }
                }
            }
        }
    }

    // 5. Line Width Configuration
    HorizontalLayout {
        spacing: MaterialStyleMetrics.spacing_8;
        alignment: center;

        MaterialText {
            text: "Line Width:";
            style: MaterialTypography.label_small;
            color: MaterialPalette.on_surface_variant;
            vertical-alignment: center;
        }

        CompactInputField {
            horizontal-stretch: 1;
            placeholder_text: "1.5";
            text <=> root.line_width;
            accepted(w) => {
                root.set_curve_width(w);
                root.apply_axis_settings();
            }
        }

        MaterialText {
            text: "pt";
            style: MaterialTypography.body_small;
            color: MaterialPalette.on_surface_variant;
            vertical-alignment: center;
        }
    }
}

