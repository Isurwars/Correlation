import {
    MaterialPalette,
    MaterialTypography,
    MaterialText,
} from "../../../material/material.slint";

export component PhaseMiniHistogram inherits Rectangle {
    in property <[float]> counts: [];
    in property <float> min_threshold: 0.46;
    in property <float> max_threshold: 0.58;
    in property <float> domain_min: 0.0;
    in property <float> domain_max: 1.0;
    in property <int> matching_atoms: 0;
    in property <int> total_atoms: 0;

    height: 52px;
    border-radius: 6px;
    background: MaterialPalette.surface_container_lowest;
    border-width: 1px;
    border-color: MaterialPalette.outline_variant.with_alpha(50%);
    clip: true;

    VerticalLayout {
        padding-left: 6px;
        padding-right: 6px;
        padding-top: 3px;
        padding-bottom: 3px;
        spacing: 2px;

        // Telemetry header
        HorizontalLayout {
            alignment: space-between;
            MaterialText {
                text: "Distribution";
                font-size: 10.5px;
                font-weight: 600;
                color: MaterialPalette.on_surface_variant;
            }
            MaterialText {
                text: root.total_atoms > 0
                    ? ("" + root.matching_atoms + " / " + root.total_atoms + " (" + (Math.round(root.matching_atoms * 1000.0 / root.total_atoms) / 10.0) + "%)")
                    : "No Data";
                font-size: 10.5px;
                color: root.matching_atoms > 0 ? MaterialPalette.primary : MaterialPalette.on_surface_variant;
                font-weight: 600;
            }
        }

        // Bins container
        bars_rect := Rectangle {
            height: 22px;
            clip: true;

            HorizontalLayout {
                spacing: 1px;
                alignment: stretch;

                for count[idx] in root.counts: Rectangle {
                    horizontal-stretch: 1;
                    height: 100%;

                    property <float> bin_val: root.domain_min + ((idx + 0.5) * (root.domain_max - root.domain_min) / 50.0);
                    property <bool> is_in_range: bin_val >= root.min_threshold && bin_val <= root.max_threshold;

                    Rectangle {
                        y: parent.height - self.height;
                        width: 100%;
                        height: Math.max(1px, parent.height * count);
                        border-radius: 1px;
                        background: parent.is_in_range ? MaterialPalette.primary : MaterialPalette.outline_variant.with_alpha(40%);
                    }
                }
            }
        }

        // Domain bounds footer
        HorizontalLayout {
            alignment: space-between;
            MaterialText {
                text: "" + (Math.round(root.domain_min * 100) / 100);
                font-size: 9.5px;
                color: MaterialPalette.on_surface_variant;
            }
            MaterialText {
                text: "" + (Math.round(root.domain_max * 100) / 100);
                font-size: 9.5px;
                color: MaterialPalette.on_surface_variant;
            }
        }
    }
}
