import {
    MaterialPalette,
    MaterialStyleMetrics,
    MaterialTypography,
    MaterialText,
} from "../../../material/material.slint";

component WorkflowStepPill inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;
    in property <bool> completed: false;
    in property <bool> interactive: true;

    callback clicked();

    height: 28px;
    border-radius: MaterialStyleMetrics.border_radius_full;
    background: root.active ? MaterialPalette.primary_container :
                (root.interactive && step_touch.has-hover) ? MaterialPalette.surface_container_highest : MaterialPalette.surface_container_high;
    animate background { duration: 150ms; }

    HorizontalLayout {
        padding-left: MaterialStyleMetrics.padding_12;
        padding-right: MaterialStyleMetrics.padding_12;

        MaterialText {
            text: root.label;
            style: MaterialTypography.label_medium;
            color: root.active ? MaterialPalette.on_primary_container :
                   root.completed ? MaterialPalette.primary : MaterialPalette.on_surface_variant;
            vertical-alignment: center;
        }
    }

    step_touch := TouchArea {
        enabled: root.interactive;
        mouse-cursor: root.interactive ? pointer : default;
        accessible-role: button;
        accessible-label: root.label;
        clicked => { root.clicked(); }
    }
}

export component WorkflowStepper inherits Rectangle {
    in property <bool> file_loaded: false;
    in property <bool> analysis_running: false;
    in property <bool> analysis_done: false;

    callback browse_file();
    callback open_panel(int);
    callback run_analysis();
    callback cancel_analysis();

    width: 100%;
    height: 28px;
    background: transparent;

    HorizontalLayout {
        width: 100%;
        height: 100%;
        spacing: MaterialStyleMetrics.spacing_8;
        alignment: center;

        WorkflowStepPill {
            label: !root.file_loaded ? "1. Load File (Active)" : "1. File Loaded ✓";
            active: !root.file_loaded;
            completed: root.file_loaded;
            clicked => {
                if (!root.file_loaded) {
                    root.browse_file();
                } else {
                    root.open_panel(0);
                }
            }
        }

        MaterialText {
            text: "➔";
            style: MaterialTypography.label_medium;
            color: MaterialPalette.outline;
            vertical-alignment: center;
        }

        WorkflowStepPill {
            label: (root.file_loaded && !root.analysis_running && !root.analysis_done) ? "2. Configure Options (Active)" :
                   (root.analysis_running || root.analysis_done) ? "2. Options Configured ✓" : "2. Configure Options";
            active: root.file_loaded && !root.analysis_running && !root.analysis_done;
            completed: root.analysis_running || root.analysis_done;
            clicked => { root.open_panel(1); }
        }

        MaterialText {
            text: "➔";
            style: MaterialTypography.label_medium;
            color: MaterialPalette.outline;
            vertical-alignment: center;
        }

        WorkflowStepPill {
            label: root.analysis_running ? "3. Calculating... (Cancel)" :
                   root.analysis_done ? "3. Calculation Complete ✓" : "3. Run Calculation";
            active: root.analysis_running;
            completed: root.analysis_done;
            interactive: root.file_loaded || root.analysis_running;
            clicked => {
                if (root.analysis_running) {
                    root.cancel_analysis();
                } else if (root.file_loaded) {
                    root.run_analysis();
                }
            }
        }

        MaterialText {
            text: "➔";
            style: MaterialTypography.label_medium;
            color: MaterialPalette.outline;
            vertical-alignment: center;
        }

        WorkflowStepPill {
            label: root.analysis_done ? "4. Preview & Export (Active)" : "4. Preview & Export";
            active: root.analysis_done;
            completed: root.analysis_done;
            interactive: root.analysis_done;
            clicked => {
                if (root.analysis_done) {
                    root.open_panel(3);
                }
            }
        }
    }
}
