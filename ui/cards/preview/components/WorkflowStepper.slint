import {
    MaterialPalette,
    MaterialStyleMetrics,
    MaterialTypography,
    MaterialText,
    Chip,
    Icons,
    TooltipTarget,
} from "../../../material/material.slint";

export component WorkflowStepper inherits Rectangle {
    in property <bool> file_loaded: false;
    in property <bool> analysis_running: false;
    in property <bool> analysis_done: false;

    callback browse_file();
    callback open_panel(int);
    callback run_analysis();
    callback cancel_analysis();
    callback dismiss();

    height: 28px;

    HorizontalLayout {
        spacing: MaterialStyleMetrics.spacing_8;
        alignment: center;

        Chip {
            chip_height: MaterialStyleMetrics.size_28;
            corner_radius: MaterialStyleMetrics.border_radius_full;
            outlined: false;
            label: !root.file_loaded ? "1. Load File (Active)" : "1. File Loaded ✓";
            selected: !root.file_loaded;
            idle_fg: (root.file_loaded) ? MaterialPalette.primary : MaterialPalette.on_surface_variant;
            tooltip_text: !root.file_loaded ? "Open a structure or trajectory file (Ctrl+O)." : "Inspect loaded structure and trajectory diagnostics.";
            clicked => {
                if (!root.file_loaded) {
                    root.browse_file();
                } else {
                    root.open_panel(0);
                }
            }
        }

        MaterialText {
            text: "➔";
            style: MaterialTypography.label_medium;
            color: MaterialPalette.outline;
            vertical-alignment: center;
        }

        Chip {
            chip_height: MaterialStyleMetrics.size_28;
            corner_radius: MaterialStyleMetrics.border_radius_full;
            outlined: false;
            label: (root.file_loaded && !root.analysis_running && !root.analysis_done) ? "2. Configure Options (Active)" :
                   (root.analysis_running || root.analysis_done) ? "2. Options Configured ✓" : "2. Configure Options";
            selected: root.file_loaded && !root.analysis_running && !root.analysis_done;
            idle_fg: (root.analysis_running || root.analysis_done) ? MaterialPalette.primary : MaterialPalette.on_surface_variant;
            tooltip_text: "Select calculators and tune bond cutoffs or RDF/angular parameters.";
            clicked => { root.open_panel(1); }
        }

        MaterialText {
            text: "➔";
            style: MaterialTypography.label_medium;
            color: MaterialPalette.outline;
            vertical-alignment: center;
        }

        Chip {
            chip_height: MaterialStyleMetrics.size_28;
            corner_radius: MaterialStyleMetrics.border_radius_full;
            outlined: false;
            label: root.analysis_running ? "3. Calculating... (Cancel)" :
                   root.analysis_done ? "3. Calculation Complete ✓" : "3. Run Calculation";
            selected: root.analysis_running;
            idle_fg: (root.analysis_done) ? MaterialPalette.primary : MaterialPalette.on_surface_variant;
            enabled: root.file_loaded || root.analysis_running;
            tooltip_text: root.analysis_running ? "Cancel the running analysis (Esc)." : "Execute all enabled structural and dynamical calculators (Ctrl+R).";
            clicked => {
                if (root.analysis_running) {
                    root.cancel_analysis();
                } else if (root.file_loaded) {
                    root.run_analysis();
                }
            }
        }

        MaterialText {
            text: "➔";
            style: MaterialTypography.label_medium;
            color: MaterialPalette.outline;
            vertical-alignment: center;
        }

        Chip {
            chip_height: MaterialStyleMetrics.size_28;
            corner_radius: MaterialStyleMetrics.border_radius_full;
            outlined: false;
            label: root.analysis_done ? "4. Preview & Export (Active)" : "4. Preview & Export";
            selected: root.analysis_done;
            idle_fg: (root.analysis_done) ? MaterialPalette.primary : MaterialPalette.on_surface_variant;
            enabled: root.analysis_done;
            tooltip_text: "Open Export & Presentation panel to export CSV, HDF5, Parquet, or publication figures (Ctrl+S).";
            clicked => {
                if (root.analysis_done) {
                    root.open_panel(3);
                }
            }
        }

        if root.analysis_done: dismiss_touch := TooltipTarget {
            width: 24px;
            height: 24px;
            y: (parent.height - self.height) / 2;
            mouse-cursor: pointer;
            tooltip_text: "Hide workflow stepper to maximize viewport height.";
            accessible-role: button;
            accessible-label: "Hide Workflow Stepper";
            clicked => { root.dismiss(); }

            Rectangle {
                border-radius: MaterialStyleMetrics.border_radius_full;
                background: dismiss_touch.has-hover ? MaterialPalette.surface_container_highest : transparent;

                Image {
                    width: 14px;
                    height: 14px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    source: Icons.close;
                    colorize: MaterialPalette.on_surface_variant;
                }
            }
        }
    }
}
