import {
    MaterialStyleMetrics,
    MaterialPalette,
    MaterialTypography,
    MaterialText,
    TooltipTarget,
} from "../../../material/material.slint";

export component PhasePresetsGrid inherits VerticalLayout {
    in property <int> preset_index: 0;
    callback set_preset(int);

    private property <[string]> row1_tips: [
        "Custom user-defined order-parameter thresholds.",
        "Preset for disordered liquid-like local environments.",
        "Preset for amorphous/glassy local environments.",
    ];
    private property <[string]> row2_tips: [
        "Preset for amorphous network-forming motifs.",
        "Preset for Face-Centered Cubic (FCC) crystalline coordination.",
        "Preset for Hexagonal Close-Packed (HCP) crystalline coordination.",
    ];
    private property <[string]> row3_tips: [
        "Preset for Body-Centered Cubic (BCC) crystalline coordination.",
        "Preset for Icosahedral (5-fold) local symmetry.",
        "Preset for Tetrahedral / Diamond cubic coordination.",
    ];

    spacing: 3px;

    MaterialText {
        text: "Phase Presets";
        font-size: MaterialTypography.label_small.font_size;
        font-weight: 600;
        color: MaterialPalette.on_surface_variant;
    }

    // Row 1: Custom, Liquid, Glass
    HorizontalLayout {
        spacing: 4px;
        height: 24px;
        property <[string]> row1_labels: ["Custom", "Liquid", "Glass"];

        for label[idx] in self.row1_labels: TooltipTarget {
            horizontal-stretch: 1;
            height: 100%;
            mouse-cursor: pointer;
            tooltip_text: root.row1_tips[idx];
            clicked => { root.set_preset(idx); }

            Rectangle {
                width: 100%;
                height: 100%;
                border-radius: MaterialStyleMetrics.border_radius_12;
                background: root.preset_index == idx
                    ? MaterialPalette.primary.with_alpha(25%)
                    : (parent.has-hover ? MaterialPalette.surface_container_highest : transparent);
                border-width: root.preset_index == idx ? 1.5px : 1px;
                border-color: root.preset_index == idx ? MaterialPalette.primary : MaterialPalette.outline_variant.with_alpha(40%);

                MaterialText {
                    width: 100%;
                    height: 100%;
                    text: label;
                    font-size: MaterialTypography.label_small.font_size;
                    font-weight: root.preset_index == idx ? 700 : 400;
                    color: root.preset_index == idx ? MaterialPalette.primary : MaterialPalette.on_surface;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }

    // Row 2: a-Net, FCC, HCP
    HorizontalLayout {
        spacing: 4px;
        height: 24px;
        property <[string]> row2_labels: ["a-Net", "FCC", "HCP"];

        for label[idx] in self.row2_labels: TooltipTarget {
            horizontal-stretch: 1;
            height: 100%;
            mouse-cursor: pointer;
            tooltip_text: root.row2_tips[idx];
            clicked => { root.set_preset(idx + 3); }

            Rectangle {
                width: 100%;
                height: 100%;
                border-radius: MaterialStyleMetrics.border_radius_12;
                background: root.preset_index == (idx + 3)
                    ? MaterialPalette.primary.with_alpha(25%)
                    : (parent.has-hover ? MaterialPalette.surface_container_highest : transparent);
                border-width: root.preset_index == (idx + 3) ? 1.5px : 1px;
                border-color: root.preset_index == (idx + 3) ? MaterialPalette.primary : MaterialPalette.outline_variant.with_alpha(40%);

                MaterialText {
                    width: 100%;
                    height: 100%;
                    text: label;
                    font-size: MaterialTypography.label_small.font_size;
                    font-weight: root.preset_index == (idx + 3) ? 700 : 400;
                    color: root.preset_index == (idx + 3) ? MaterialPalette.primary : MaterialPalette.on_surface;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }

    // Row 3: BCC, Ico, Diamond
    HorizontalLayout {
        spacing: 4px;
        height: 24px;
        property <[string]> row3_labels: ["BCC", "Ico", "Diamond"];

        for label[idx] in self.row3_labels: TooltipTarget {
            horizontal-stretch: 1;
            height: 100%;
            mouse-cursor: pointer;
            tooltip_text: root.row3_tips[idx];
            clicked => { root.set_preset(idx + 6); }

            Rectangle {
                width: 100%;
                height: 100%;
                border-radius: MaterialStyleMetrics.border_radius_12;
                background: root.preset_index == (idx + 6)
                    ? MaterialPalette.primary.with_alpha(25%)
                    : (parent.has-hover ? MaterialPalette.surface_container_highest : transparent);
                border-width: root.preset_index == (idx + 6) ? 1.5px : 1px;
                border-color: root.preset_index == (idx + 6) ? MaterialPalette.primary : MaterialPalette.outline_variant.with_alpha(40%);

                MaterialText {
                    width: 100%;
                    height: 100%;
                    text: label;
                    font-size: MaterialTypography.label_small.font_size;
                    font-weight: root.preset_index == (idx + 6) ? 700 : 400;
                    color: root.preset_index == (idx + 6) ? MaterialPalette.primary : MaterialPalette.on_surface;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }
}
