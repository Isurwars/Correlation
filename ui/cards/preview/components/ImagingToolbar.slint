import {
    MaterialPalette,
    MaterialStyleMetrics,
    MaterialTypography,
    MaterialText,
    Icons,
} from "../../../material/material.slint";

component ToolbarIconButton inherits TouchArea {
    in property <image> icon;
    in property <string> label: "";
    in property <string> accessible_name: "";
    in property <bool> active: false;
    in property <color> active_bg: MaterialPalette.primary;
    in property <color> active_fg: MaterialPalette.on_primary;
    in property <color> idle_fg: MaterialPalette.on_surface;

    out property <length> hover_x: self.has-hover ? self.absolute-position.x + self.mouse-x : 0px;
    out property <length> hover_y: self.has-hover ? self.absolute-position.y + self.mouse-y : 0px;

    width: 30px;
    height: 30px;
    mouse-cursor: self.enabled ? pointer : default;
    accessible-role: button;
    accessible-label: root.accessible_name;

    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: MaterialStyleMetrics.border_radius_full;
        background: !root.enabled ? transparent :
                    root.active ? (root.has-hover ? root.active_bg.darker(8%) : root.active_bg) :
                    (root.has-hover ? MaterialPalette.surface_container_high : transparent);
        border-width: root.active ? 1.5px : 0px;
        border-color: root.active ? root.active_fg.with_alpha(35%) : transparent;
        animate background, border-color { duration: 150ms; easing: ease-out; }

        if root.label == "": Image {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 16px;
            height: 16px;
            source: root.icon;
            colorize: !root.enabled ? MaterialPalette.outline :
                      root.active ? root.active_fg : root.idle_fg;
            animate colorize { duration: 150ms; }
        }

        if root.label != "": MaterialText {
            width: 100%;
            height: 100%;
            text: root.label;
            style: root.active ? MaterialTypography.label_medium_prominent : MaterialTypography.label_medium;
            color: !root.enabled ? MaterialPalette.outline :
                   root.active ? root.active_fg : root.idle_fg;
            animate color { duration: 150ms; }
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

component ToolbarDivider inherits VerticalLayout {
    alignment: center;
    Rectangle {
        width: 1px;
        height: 16px;
        background: MaterialPalette.outline_variant.with_alpha(50%);
    }
}

export component ImagingToolbar inherits Rectangle {
    in property <bool> has_active_zoom: false;
    in-out property <int> active_tool: 0;
    in property <int> markers_count: 0;
    in property <string> hover_coord_text: "";
    in property <bool> settings_open: false;

    callback reset_zoom();
    callback clear_markers();
    callback toggle_settings();
    callback update_plot();
    callback copy_clipboard();
    callback export_plot();

    out property <string> tooltip_text:
        copy_btn.has-hover ? "Copy Plot to Clipboard\n\nCopy SVG vector image markup to system clipboard for instant pasting." :
        export_btn.has-hover ? "Export Plot\n\nQuick export current plot visualization directly to SVG or PDF file." :
        update_btn.has-hover ? "Update Plot\n\nApply current axis bounds, ticks, log scaling, and refresh visualization." :
        settings_btn.has-hover ? "Plot Settings & Styling\n\nConfigure axis bounds (X/Y limits), tick intervals, log scale, and curve styling." :
        home_btn.has-hover ? "Home (Reset Zoom)\n\nRestore full coordinate axes limits." :
        zoom_btn.has-hover ? "Rubberband Box Zoom\n\nClick and drag on plot to inspect a specific region of interest." :
        zoom_out_btn.has-hover ? "Click to Zoom Out\n\nClick anywhere on plot to step viewport zoom out centered on click." :
        marker_x_btn.has-hover ? "Add Vertical Marker (+X)\n\nClick plot to place a vertical guide line at target distance or angle." :
        marker_y_btn.has-hover ? "Add Horizontal Marker (+Y)\n\nClick plot to place a horizontal intensity threshold guide." :
        calibrate_btn.has-hover ? "Calibrate Cutoffs\n\nInteractively adjust and auto-detect first coordination shell bond cutoffs on g(r)." :
        peak_btn.has-hover ? "Peak & CN Inspector\n\nClick peak to auto-detect shell & CN, or drag to integrate a custom range." :
        (root.markers_count > 0 && clear_markers_btn.has-hover) ? "Clear Markers\n\nRemove all inspection guides from the plot." : "";

    out property <length> tooltip_x:
        copy_btn.has-hover ? copy_btn.hover_x :
        export_btn.has-hover ? export_btn.hover_x :
        update_btn.has-hover ? update_btn.hover_x :
        settings_btn.has-hover ? settings_btn.hover_x :
        home_btn.has-hover ? home_btn.hover_x :
        zoom_btn.has-hover ? zoom_btn.hover_x :
        zoom_out_btn.has-hover ? zoom_out_btn.hover_x :
        marker_x_btn.has-hover ? marker_x_btn.hover_x :
        marker_y_btn.has-hover ? marker_y_btn.hover_x :
        calibrate_btn.has-hover ? calibrate_btn.hover_x :
        peak_btn.has-hover ? peak_btn.hover_x :
        (root.markers_count > 0 && clear_markers_btn.has-hover) ? clear_markers_btn.hover_x : 0px;

    out property <length> tooltip_y:
        copy_btn.has-hover ? copy_btn.hover_y :
        export_btn.has-hover ? export_btn.hover_y :
        update_btn.has-hover ? update_btn.hover_y :
        settings_btn.has-hover ? settings_btn.hover_y :
        home_btn.has-hover ? home_btn.hover_y :
        zoom_btn.has-hover ? zoom_btn.hover_y :
        zoom_out_btn.has-hover ? zoom_out_btn.hover_y :
        marker_x_btn.has-hover ? marker_x_btn.hover_y :
        marker_y_btn.has-hover ? marker_y_btn.hover_y :
        calibrate_btn.has-hover ? calibrate_btn.hover_y :
        peak_btn.has-hover ? peak_btn.hover_y :
        (root.markers_count > 0 && clear_markers_btn.has-hover) ? clear_markers_btn.hover_y : 0px;

    width: toolbar_layout.preferred-width + 16px;
    height: 38px;
    border-radius: MaterialStyleMetrics.border_radius_full;
    background: MaterialPalette.surface_container_highest;
    border-width: 1.5px;
    border-color: MaterialPalette.outline;

    toolbar_layout := HorizontalLayout {
        height: 100%;
        padding-left: MaterialStyleMetrics.padding_8;
        padding-right: MaterialStyleMetrics.padding_8;
        spacing: 5px;
        alignment: center;

        home_btn := ToolbarIconButton {
            y: (parent.height - self.height) / 2;
            icon: Icons.home;
            enabled: root.has_active_zoom;
            accessible_name: "Home (Reset Zoom)";
            clicked => { root.reset_zoom(); }
        }

        ToolbarDivider {}

        zoom_btn := ToolbarIconButton {
            y: (parent.height - self.height) / 2;
            icon: Icons.zoom_in;
            active: root.active_tool == 1;
            active_bg: MaterialPalette.tertiary;
            active_fg: MaterialPalette.on_tertiary;
            accessible_name: "Box Zoom Tool";
            clicked => { root.active_tool = (root.active_tool == 1 ? 0 : 1); }
        }

        zoom_out_btn := ToolbarIconButton {
            y: (parent.height - self.height) / 2;
            icon: Icons.zoom_out;
            active: root.active_tool == 4;
            active_bg: MaterialPalette.tertiary;
            active_fg: MaterialPalette.on_tertiary;
            accessible_name: "Click to Zoom Out";
            clicked => { root.active_tool = (root.active_tool == 4 ? 0 : 4); }
        }

        ToolbarDivider {}

        marker_x_btn := ToolbarIconButton {
            y: (parent.height - self.height) / 2;
            label: "+X";
            active: root.active_tool == 2;
            accessible_name: "Add Vertical Marker (+X)";
            clicked => { root.active_tool = (root.active_tool == 2 ? 0 : 2); }
        }

        marker_y_btn := ToolbarIconButton {
            y: (parent.height - self.height) / 2;
            label: "+Y";
            active: root.active_tool == 3;
            active_bg: MaterialPalette.secondary;
            active_fg: MaterialPalette.on_secondary;
            accessible_name: "Add Horizontal Marker (+Y)";
            clicked => { root.active_tool = (root.active_tool == 3 ? 0 : 3); }
        }

        clear_markers_btn := ToolbarIconButton {
            visible: root.markers_count > 0;
            width: root.markers_count > 0 ? 30px : 0px;
            y: (parent.height - self.height) / 2;
            icon: Icons.delete_sweep;
            idle_fg: MaterialPalette.error;
            accessible_name: "Clear Plot Markers";
            clicked => { root.clear_markers(); }
        }

        ToolbarDivider {}

        calibrate_btn := ToolbarIconButton {
            y: (parent.height - self.height) / 2;
            icon: Icons.tune;
            active: root.active_tool == 5;
            accessible_name: "Calibrate Bond Cutoffs";
            clicked => { root.active_tool = (root.active_tool == 5 ? 0 : 5); }
        }

        peak_btn := ToolbarIconButton {
            y: (parent.height - self.height) / 2;
            icon: Icons.analytics;
            active: root.active_tool == 6;
            active_bg: MaterialPalette.tertiary;
            active_fg: MaterialPalette.on_tertiary;
            accessible_name: "Peak and Coordination Number Inspector";
            clicked => { root.active_tool = (root.active_tool == 6 ? 0 : 6); }
        }

        ToolbarDivider {}

        settings_btn := ToolbarIconButton {
            y: (parent.height - self.height) / 2;
            icon: Icons.tune;
            active: root.settings_open;
            active_bg: MaterialPalette.secondary;
            active_fg: MaterialPalette.on_secondary;
            accessible_name: "Plot Settings and Styling";
            clicked => { root.toggle_settings(); }
        }

        update_btn := ToolbarIconButton {
            y: (parent.height - self.height) / 2;
            icon: Icons.restart_alt;
            accessible_name: "Refresh Plot Visualization";
            clicked => { root.update_plot(); }
        }

        ToolbarDivider {}

        copy_btn := ToolbarIconButton {
            y: (parent.height - self.height) / 2;
            icon: Icons.save;
            accessible_name: "Copy Plot SVG to Clipboard";
            clicked => { root.copy_clipboard(); }
        }

        export_btn := ToolbarIconButton {
            y: (parent.height - self.height) / 2;
            icon: Icons.save;
            accessible_name: "Export Plot Image";
            clicked => { root.export_plot(); }
        }

        if root.hover_coord_text != "": ToolbarDivider {}

        if root.hover_coord_text != "": VerticalLayout {
            alignment: center;
            padding-left: MaterialStyleMetrics.padding_6;
            padding-right: MaterialStyleMetrics.padding_6;

            MaterialText {
                text: root.hover_coord_text;
                style: MaterialTypography.label_large;
                color: MaterialPalette.on_surface;
                vertical-alignment: center;
            }
        }
    }
}
