import {
    MaterialAnimations,
    MaterialPalette,
    MaterialStyleMetrics,
    MaterialTypography,
    MaterialText,
    Icons,
    Chip,
} from "../../../material/material.slint";

component ToolbarDivider inherits VerticalLayout {
    alignment: center;
    Rectangle {
        width: 1px;
        height: 16px;
        background: MaterialPalette.outline_variant.with_alpha(50%);
    }
}

export component ImagingToolbar inherits Rectangle {
    in property <bool> has_active_zoom: false;
    in-out property <int> active_tool: 0;
    in property <int> markers_count: 0;
    in property <string> hover_coord_text: "";
    in property <bool> settings_open: false;
    in property <bool> can_calibrate_cutoffs: false;

    callback reset_zoom();
    callback clear_markers();
    callback toggle_settings();
    callback update_plot();
    callback copy_clipboard();
    callback export_plot();

    width: toolbar_layout.preferred-width + 16px;
    height: 38px;
    border-radius: MaterialStyleMetrics.border_radius_full;
    background: MaterialPalette.surface_container_highest;
    border-width: 1.5px;
    border-color: MaterialPalette.outline;

    toolbar_layout := HorizontalLayout {
        height: 100%;
        padding-left: MaterialStyleMetrics.padding_8;
        padding-right: MaterialStyleMetrics.padding_8;
        spacing: 5px;
        alignment: center;

        Chip {
            chip_height: MaterialStyleMetrics.size_30;
            corner_radius: MaterialStyleMetrics.border_radius_full;
            outlined: false;
            y: (parent.height - self.height) / 2;
            icon: Icons.home;
            enabled: root.has_active_zoom;
            accessible_name: "Home (Reset Zoom)";
            tooltip_text: "Home (Reset Zoom — H)\n\nRestore full coordinate axes limits.";
            clicked => { root.reset_zoom(); }
        }

        ToolbarDivider {}

        Chip {
            chip_height: MaterialStyleMetrics.size_30;
            corner_radius: MaterialStyleMetrics.border_radius_full;
            outlined: false;
            y: (parent.height - self.height) / 2;
            icon: Icons.zoom_in;
            selected: root.active_tool == 1;
            active_bg: MaterialPalette.tertiary;
            active_fg: MaterialPalette.on_tertiary;
            accessible_name: "Box Zoom Tool";
            tooltip_text: "Rubberband Box Zoom\n\nClick and drag on plot to inspect a specific region of interest.";
            clicked => { root.active_tool = (root.active_tool == 1 ? 0 : 1); }
        }

        Chip {
            chip_height: MaterialStyleMetrics.size_30;
            corner_radius: MaterialStyleMetrics.border_radius_full;
            outlined: false;
            y: (parent.height - self.height) / 2;
            icon: Icons.zoom_out;
            selected: root.active_tool == 4;
            active_bg: MaterialPalette.tertiary;
            active_fg: MaterialPalette.on_tertiary;
            accessible_name: "Click to Zoom Out";
            tooltip_text: "Click to Zoom Out\n\nClick anywhere on plot to step viewport zoom out centered on click.";
            clicked => { root.active_tool = (root.active_tool == 4 ? 0 : 4); }
        }

        ToolbarDivider {}

        Chip {
            chip_height: MaterialStyleMetrics.size_30;
            corner_radius: MaterialStyleMetrics.border_radius_full;
            outlined: false;
            y: (parent.height - self.height) / 2;
            label: "+X";
            selected: root.active_tool == 2;
            accessible_name: "Add Vertical Marker (+X)";
            tooltip_text: "Add Vertical Marker (+X)\n\nClick plot to place a vertical guide line at target distance or angle.";
            clicked => { root.active_tool = (root.active_tool == 2 ? 0 : 2); }
        }

        Chip {
            chip_height: MaterialStyleMetrics.size_30;
            corner_radius: MaterialStyleMetrics.border_radius_full;
            outlined: false;
            y: (parent.height - self.height) / 2;
            label: "+Y";
            selected: root.active_tool == 3;
            active_bg: MaterialPalette.secondary;
            active_fg: MaterialPalette.on_secondary;
            accessible_name: "Add Horizontal Marker (+Y)";
            tooltip_text: "Add Horizontal Marker (+Y)\n\nClick plot to place a horizontal intensity threshold guide.";
            clicked => { root.active_tool = (root.active_tool == 3 ? 0 : 3); }
        }

        Chip {
            chip_height: MaterialStyleMetrics.size_30;
            corner_radius: MaterialStyleMetrics.border_radius_full;
            outlined: false;
            visible: root.markers_count > 0;
            width: root.markers_count > 0 ? 30px : 0px;
            y: (parent.height - self.height) / 2;
            icon: Icons.delete_sweep;
            idle_fg: MaterialPalette.error;
            accessible_name: "Clear Plot Markers";
            tooltip_text: "Clear Markers\n\nRemove all inspection guides from the plot.";
            clicked => { root.clear_markers(); }
        }

        ToolbarDivider {}

        Chip {
            chip_height: MaterialStyleMetrics.size_30;
            corner_radius: MaterialStyleMetrics.border_radius_full;
            outlined: false;
            y: (parent.height - self.height) / 2;
            icon: Icons.hub;
            enabled: root.can_calibrate_cutoffs;
            selected: root.active_tool == 5 && root.can_calibrate_cutoffs;
            accessible_name: "Calibrate Bond Cutoffs";
            tooltip_text: root.can_calibrate_cutoffs
                ? "Calibrate Cutoffs\n\nInteractively adjust and auto-detect first coordination shell bond cutoffs on g(r)."
                : "Calibrate Cutoffs (select a real-space radial plot such as g(r) to calibrate pairwise cutoffs).";
            clicked => { root.active_tool = (root.active_tool == 5 ? 0 : 5); }
        }

        Chip {
            chip_height: MaterialStyleMetrics.size_30;
            corner_radius: MaterialStyleMetrics.border_radius_full;
            outlined: false;
            y: (parent.height - self.height) / 2;
            icon: Icons.analytics;
            selected: root.active_tool == 6;
            active_bg: MaterialPalette.tertiary;
            active_fg: MaterialPalette.on_tertiary;
            accessible_name: "Peak and Coordination Number Inspector";
            tooltip_text: "Peak & CN Inspector\n\nClick peak to auto-detect shell & CN, or drag to integrate a custom range.";
            clicked => { root.active_tool = (root.active_tool == 6 ? 0 : 6); }
        }

        ToolbarDivider {}

        Chip {
            chip_height: MaterialStyleMetrics.size_30;
            corner_radius: MaterialStyleMetrics.border_radius_full;
            outlined: false;
            y: (parent.height - self.height) / 2;
            icon: Icons.tune;
            selected: root.settings_open;
            active_bg: MaterialPalette.secondary;
            active_fg: MaterialPalette.on_secondary;
            accessible_name: "Plot Settings and Styling";
            tooltip_text: "Plot Inspector & Styling\n\nToggle right-hand Curves, Style & Axes, and Tagged Peaks panel.";
            clicked => { root.toggle_settings(); }
        }

        Chip {
            chip_height: MaterialStyleMetrics.size_30;
            corner_radius: MaterialStyleMetrics.border_radius_full;
            outlined: false;
            y: (parent.height - self.height) / 2;
            icon: Icons.restart_alt;
            accessible_name: "Refresh Plot Visualization";
            tooltip_text: "Update Plot\n\nApply current axis bounds, ticks, log scaling, and refresh visualization.";
            clicked => { root.update_plot(); }
        }

        ToolbarDivider {}

        Chip {
            chip_height: MaterialStyleMetrics.size_30;
            corner_radius: MaterialStyleMetrics.border_radius_full;
            outlined: false;
            y: (parent.height - self.height) / 2;
            icon: Icons.content_copy;
            accessible_name: "Copy Plot SVG to Clipboard";
            tooltip_text: "Copy Plot to Clipboard (Ctrl+C)\n\nCopy SVG vector image markup to system clipboard.";
            clicked => { root.copy_clipboard(); }
        }

        Chip {
            chip_height: MaterialStyleMetrics.size_30;
            corner_radius: MaterialStyleMetrics.border_radius_full;
            outlined: false;
            y: (parent.height - self.height) / 2;
            icon: Icons.download;
            accessible_name: "Export Plot Image";
            tooltip_text: "Export Plot (Ctrl+Shift+S)\n\nQuick export current plot visualization directly to SVG or PDF.";
            clicked => { root.export_plot(); }
        }

        if root.hover_coord_text != "": ToolbarDivider {}

        if root.hover_coord_text != "": VerticalLayout {
            alignment: center;
            padding-left: MaterialStyleMetrics.padding_6;
            padding-right: MaterialStyleMetrics.padding_6;

            MaterialText {
                text: root.hover_coord_text;
                style: MaterialTypography.label_large;
                color: MaterialPalette.on_surface;
                vertical-alignment: center;
            }
        }
    }
}
