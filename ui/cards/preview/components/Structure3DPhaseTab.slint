import {
    MaterialAnimations,
    MaterialPalette,
    MaterialStyleMetrics,
    MaterialTypography,
    MaterialText,
    ScrollView,
    Icons,
    MaterialSlider,
    CheckBoxRow,
    TooltipTarget,
} from "../../../material/material.slint";
import { PhaseMiniHistogram } from "./PhaseMiniHistogram.slint";
import { PhasePresetsGrid } from "./PhasePresetsGrid.slint";
import { PhaseDescriptorSelector } from "./PhaseDescriptorSelector.slint";
import { PhaseColorbar } from "./PhaseColorbar.slint";
import { PhaseVisualControls } from "./PhaseVisualControls.slint";

/// Tab 0 of Structure3DSidebar: order parameter phase highlighting, 1D thresholding, and halo controls.
export component Structure3DPhaseTab inherits ScrollView {
    in property <bool> phase_enabled: false;
    in property <int> preset_index: 0;
    in property <int> descriptor_index: 0;
    in property <int> colormap_index: 0;
    in property <float> min_threshold: 0.46;
    in property <float> max_threshold: 0.58;
    in property <float> domain_min: 0.0;
    in property <float> domain_max: 1.0;
    in property <float> halo_intensity: 0.85;
    in property <float> halo_radius_ratio: 2.70;
    in property <float> atom_scale: 0.35;
    in property <bool> dim_non_matching: false;
    in property <bool> hide_non_matching: false;
    in property <[float]> histogram_counts: [];
    in property <int> matching_atoms: 0;
    in property <int> total_atoms: 0;
    in property <image> colorbar_image;
    in property <string> descriptor_name: "q̄₆";

    callback toggle_phase_enabled(bool);
    callback set_preset(int);
    callback set_descriptor(int);
    callback set_colormap(int);
    callback set_thresholds(float, float);
    callback set_intensity(float);
    callback set_radius_ratio(float);
    callback set_atom_scale(float);
    callback set_dim_non_matching(bool);
    callback set_hide_non_matching(bool);

    VerticalLayout {
        spacing: MaterialStyleMetrics.spacing_8;
        padding-right: 2px;

        // Master Toggle Row
        HorizontalLayout {
            alignment: space-between;

            HorizontalLayout {
                spacing: MaterialStyleMetrics.spacing_6;
                alignment: center;

                VerticalLayout {
                    alignment: center;
                    Image {
                        width: 16px;
                        height: 16px;
                        source: Icons.science;
                        colorize: root.phase_enabled ? MaterialPalette.primary : MaterialPalette.on_surface_variant;
                    }
                }

                MaterialText {
                    text: "Halo Highlighting";
                    style: MaterialTypography.label_medium;
                    font_weight: 700;
                    color: MaterialPalette.on_surface;
                    vertical-alignment: center;
                }
            }

            // Master Toggle Pill
            toggle_touch := TooltipTarget {
                width: 64px;
                height: 22px;
                mouse-cursor: pointer;
                tooltip_text: "Toggle Steinhardt / order-parameter halo highlighting in the 3D viewport.";
                accessible-role: button;
                accessible-label: root.phase_enabled ? "Disable Halos" : "Enable Halos";
                clicked => { root.toggle_phase_enabled(!root.phase_enabled); }

                Rectangle {
                    width: 100%;
                    height: 100%;
                    border-radius: MaterialStyleMetrics.border_radius_full;
                    background: root.phase_enabled
                        ? MaterialPalette.primary
                        : (toggle_touch.has-hover ? MaterialPalette.surface_container_highest : MaterialPalette.surface_container_lowest);
                    border-width: 1px;
                    border-color: root.phase_enabled ? MaterialPalette.primary : MaterialPalette.outline;

                    animate background { duration: MaterialAnimations.base_duration; }

                    MaterialText {
                        width: 100%;
                        height: 100%;
                        text: root.phase_enabled ? "Active" : "Off";
                        style: MaterialTypography.label_small;
                        font_weight: 600;
                        color: root.phase_enabled ? MaterialPalette.on_primary : MaterialPalette.on_surface_variant;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // Crystal Presets Grid
        PhasePresetsGrid {
            preset_index: root.preset_index;
            set_preset(idx) => { root.set_preset(idx); }
        }

        // Order Descriptor & Colormap Selector
        PhaseDescriptorSelector {
            descriptor_index: root.descriptor_index;
            colormap_index: root.colormap_index;
            set_descriptor(idx) => { root.set_descriptor(idx); }
            set_colormap(idx) => { root.set_colormap(idx); }
        }

        // Color Palette Gradient & Dynamic Threshold Bounds
        PhaseColorbar {
            colorbar_image: root.colorbar_image;
            min_threshold: root.min_threshold;
            max_threshold: root.max_threshold;
            descriptor_name: root.descriptor_name;
        }

        // 1D Threshold Range Sliders
        HorizontalLayout {
            spacing: MaterialStyleMetrics.spacing_6;

            MaterialSlider {
                horizontal-stretch: 1;
                label: "Min Cutoff";
                value: root.min_threshold;
                minimum: root.domain_min;
                maximum: root.max_threshold;
                display_text: "" + (Math.round(root.min_threshold * 100) / 100);
                tooltip_text: "Lower order-parameter threshold for highlighting matching atoms.";
                changed(val) => { root.set_thresholds(val, root.max_threshold); }
            }

            MaterialSlider {
                horizontal-stretch: 1;
                label: "Max Cutoff";
                value: root.max_threshold;
                minimum: root.min_threshold;
                maximum: root.domain_max;
                display_text: "" + (Math.round(root.max_threshold * 100) / 100);
                tooltip_text: "Upper order-parameter threshold for highlighting matching atoms.";
                changed(val) => { root.set_thresholds(root.min_threshold, val); }
            }
        }

        // 1D Mini-Histogram Distribution
        PhaseMiniHistogram {
            counts: root.histogram_counts;
            min_threshold: root.min_threshold;
            max_threshold: root.max_threshold;
            domain_min: root.domain_min;
            domain_max: root.domain_max;
            matching_atoms: root.matching_atoms;
            total_atoms: root.total_atoms;
        }

        // Core atom dimming / hiding for 1D thresholding
        CheckBoxRow {
            text: "Dim non-matching core atoms";
            check_state_bool: root.dim_non_matching;
            tooltip_text: "Reduce opacity of atoms outside the selected order-parameter range.";
            checked_state_changed(dim) => { root.set_dim_non_matching(dim); }
        }

        CheckBoxRow {
            text: "Hide non-matching core atoms";
            check_state_bool: root.hide_non_matching;
            tooltip_text: "Completely hide atoms outside the selected order-parameter range.";
            checked_state_changed(hide) => { root.set_hide_non_matching(hide); }
        }

        // Visual Controls (Ball Radius, Halo Intensity & Glow Radius)
        PhaseVisualControls {
            halo_intensity: root.halo_intensity;
            halo_radius_ratio: root.halo_radius_ratio;
            atom_scale: root.atom_scale;
            dim_non_matching: root.dim_non_matching;
            hide_non_matching: root.hide_non_matching;
            show_dim_options: false;

            set_intensity(val) => { root.set_intensity(val); }
            set_radius_ratio(val) => { root.set_radius_ratio(val); }
            set_atom_scale(val) => { root.set_atom_scale(val); }
            set_dim_non_matching(dim) => { root.set_dim_non_matching(dim); }
            set_hide_non_matching(hide) => { root.set_hide_non_matching(hide); }
        }
    }
}

