import {
    MaterialPalette,
    MaterialTypography,
    MaterialText,
    FilledButton,
    Icons,
} from "../../../material/material.slint";

export component Structure3DEmptyState inherits Rectangle {
    callback browse_file();
    callback load_sample(string);
    callback load_recent(string);
    in property <[string]> recent_files: [];

    width: 380px;
    height: 190px;
    background: MaterialPalette.surface_container_high.with_alpha(92%);
    border-radius: 16px;
    border-width: 1px;
    border-color: MaterialPalette.outline_variant;

    VerticalLayout {
        padding: 16px;
        spacing: 8px;
        alignment: center;

        MaterialText {
            text: "No Structure Loaded";
            font-size: 15px;
            font-weight: 700;
            color: MaterialPalette.on_surface;
            horizontal-alignment: center;
        }

        MaterialText {
            text: "Open a trajectory or pick a quick demo dataset:";
            font-size: 12px;
            color: MaterialPalette.on_surface_variant;
            horizontal-alignment: center;
            wrap: word-wrap;
        }

        FilledButton {
            height: 34px;
            text: "Open Trajectory File... (Ctrl+O)";
            icon: Icons.folder_open;
            clicked => { root.browse_file(); }
        }

        // Quick Demo Samples
        HorizontalLayout {
            spacing: 6px;
            alignment: center;

            touch_pdsi_3d := TouchArea {
                width: btn_pdsi_3d.preferred-width + 10px;
                height: 26px;
                mouse-cursor: pointer;
                clicked => { root.load_sample("a-PdSi"); }
                btn_pdsi_3d := Rectangle {
                    width: 100%;
                    height: 100%;
                    border-radius: 13px;
                    background: touch_pdsi_3d.has-hover ? MaterialPalette.primary_container : MaterialPalette.surface_container;
                    border-width: 1px;
                    border-color: MaterialPalette.outline_variant;
                    MaterialText {
                        text: "🔬 a-PdSi";
                        font-size: 11px;
                        color: touch_pdsi_3d.has-hover ? MaterialPalette.on_primary_container : MaterialPalette.on_surface;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            touch_cell_3d := TouchArea {
                width: btn_cell_3d.preferred-width + 10px;
                height: 26px;
                mouse-cursor: pointer;
                clicked => { root.load_sample("Cellulose"); }
                btn_cell_3d := Rectangle {
                    width: 100%;
                    height: 100%;
                    border-radius: 13px;
                    background: touch_cell_3d.has-hover ? MaterialPalette.primary_container : MaterialPalette.surface_container;
                    border-width: 1px;
                    border-color: MaterialPalette.outline_variant;
                    MaterialText {
                        text: "🌿 Cellulose";
                        font-size: 11px;
                        color: touch_cell_3d.has-hover ? MaterialPalette.on_primary_container : MaterialPalette.on_surface;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            touch_si_3d := TouchArea {
                width: btn_si_3d.preferred-width + 10px;
                height: 26px;
                mouse-cursor: pointer;
                clicked => { root.load_sample("Si"); }
                btn_si_3d := Rectangle {
                    width: 100%;
                    height: 100%;
                    border-radius: 13px;
                    background: touch_si_3d.has-hover ? MaterialPalette.primary_container : MaterialPalette.surface_container;
                    border-width: 1px;
                    border-color: MaterialPalette.outline_variant;
                    MaterialText {
                        text: "💎 Silicon";
                        font-size: 11px;
                        color: touch_si_3d.has-hover ? MaterialPalette.on_primary_container : MaterialPalette.on_surface;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}
