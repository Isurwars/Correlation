import {
    MaterialPalette,
    MaterialTypography,
    MaterialStyleMetrics,
    MaterialText,
} from "../../../material/material.slint";
import { PhaseSlider } from "./PhaseSlider.slint";
import { PhaseMiniHistogram } from "./PhaseMiniHistogram.slint";
import { PhaseHeatmapView, CrystalMarker } from "./PhaseHeatmapView.slint";

export component PhaseSearchCard inherits Rectangle {
    in property <bool> phase_enabled: false;
    in property <int> preset_index: 0;
    in property <int> descriptor_index: 0;
    in property <int> colormap_index: 0;
    in property <float> min_threshold: 0.46;
    in property <float> max_threshold: 0.58;
    in property <float> domain_min: 0.0;
    in property <float> domain_max: 1.0;
    in property <float> halo_intensity: 0.85;
    in property <float> halo_radius_ratio: 1.35;
    in property <bool> dim_non_matching: false;
    in property <bool> hide_non_matching: false;
    in property <[float]> histogram_counts: [];
    in property <int> matching_atoms: 0;
    in property <int> total_atoms: 0;
    in property <image> colorbar_image;
    in property <string> descriptor_name: "q̄₆";

    // 2D Heatmap Mode properties
    in property <bool> is_2d_mode: false;
    in property <int> descriptor_y_index: 0;
    in property <float> min_threshold_y: 0.46;
    in property <float> max_threshold_y: 0.58;
    in property <float> domain_min_y: 0.0;
    in property <float> domain_max_y: 1.0;
    in property <string> descriptor_name_y: "q̄₆";
    in property <image> heatmap_image;
    in property <[CrystalMarker]> crystal_markers: [];

    callback toggle_enabled(bool);
    callback set_preset(int);
    callback set_descriptor(int);
    callback set_colormap(int);
    callback set_thresholds(float, float);
    callback set_intensity(float);
    callback set_radius_ratio(float);
    callback set_dim_non_matching(bool);
    callback set_hide_non_matching(bool);
    callback close();

    // 2D Heatmap callbacks
    callback set_2d_mode(bool);
    callback set_descriptor_y(int);
    callback set_thresholds_2d(float, float, float, float);
    callback export_heatmap_png();

    width: 330px;
    preferred-height: card_layout.preferred-height;
    height: self.preferred-height;
    border-radius: 14px;
    background: MaterialPalette.surface_container_high.with_alpha(96%);
    border-width: 1.5px;
    border-color: MaterialPalette.outline.with_alpha(70%);
    clip: true;

    card_layout := VerticalLayout {
        padding-left: 10px;
        padding-right: 10px;
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 5px;

        // 1. Header with Master Toggle and Close Button
        HorizontalLayout {
            alignment: space-between;

            HorizontalLayout {
                spacing: 6px;
                alignment: center;

                MaterialText {
                    text: "🔮";
                    font-size: 15px;
                    vertical-alignment: center;
                }

                MaterialText {
                    text: "Halo Options";
                    font-size: 14px;
                    font-weight: 700;
                    color: MaterialPalette.on_surface;
                    vertical-alignment: center;
                }
            }

            HorizontalLayout {
                spacing: 6px;
                alignment: center;

                // Master Toggle Pill
                toggle_touch := TouchArea {
                    width: 64px;
                    height: 22px;
                    mouse-cursor: pointer;
                    accessible-role: button;
                    accessible-label: root.phase_enabled ? "Disable Halos" : "Enable Halos";
                    clicked => { root.toggle_enabled(!root.phase_enabled); }

                    Rectangle {
                        width: 100%;
                        height: 100%;
                        border-radius: 11px;
                        background: root.phase_enabled
                            ? MaterialPalette.primary
                            : (toggle_touch.has-hover ? MaterialPalette.surface_container_highest : MaterialPalette.surface_container_lowest);
                        border-width: 1px;
                        border-color: root.phase_enabled ? MaterialPalette.primary : MaterialPalette.outline;

                        animate background { duration: 150ms; }

                        MaterialText {
                            width: 100%;
                            height: 100%;
                            text: root.phase_enabled ? "Active" : "Off";
                            font-size: 11px;
                            font-weight: 600;
                            color: root.phase_enabled ? MaterialPalette.on_primary : MaterialPalette.on_surface_variant;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

                // Close Button
                close_touch := TouchArea {
                    width: 20px;
                    height: 20px;
                    mouse-cursor: pointer;
                    accessible-role: button;
                    accessible-label: "Close Halo Panel";
                    clicked => { root.close(); }

                    Rectangle {
                        width: 100%;
                        height: 100%;
                        border-radius: 10px;
                        background: close_touch.has-hover ? MaterialPalette.surface_container_highest : transparent;

                        MaterialText {
                            width: 100%;
                            height: 100%;
                            text: "✕";
                            font-size: 11px;
                            color: MaterialPalette.on_surface_variant;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        // 2. Mode Switcher (1D Histogram vs 2D Heatmap)
        HorizontalLayout {
            spacing: 4px;
            height: 22px;

            mode_1d_touch := TouchArea {
                horizontal-stretch: 1;
                mouse-cursor: pointer;
                clicked => { root.set_2d_mode(false); }

                Rectangle {
                    width: 100%;
                    height: 100%;
                    border-radius: 11px;
                    background: !root.is_2d_mode
                        ? MaterialPalette.primary.with_alpha(25%)
                        : (mode_1d_touch.has-hover ? MaterialPalette.surface_container_highest : transparent);
                    border-width: !root.is_2d_mode ? 1.5px : 1px;
                    border-color: !root.is_2d_mode ? MaterialPalette.primary : MaterialPalette.outline_variant.with_alpha(40%);

                    MaterialText {
                        width: 100%;
                        height: 100%;
                        text: "1D Histogram";
                        font-size: 10.5px;
                        font-weight: !root.is_2d_mode ? 700 : 400;
                        color: !root.is_2d_mode ? MaterialPalette.primary : MaterialPalette.on_surface;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            mode_2d_touch := TouchArea {
                horizontal-stretch: 1;
                mouse-cursor: pointer;
                clicked => { root.set_2d_mode(true); }

                Rectangle {
                    width: 100%;
                    height: 100%;
                    border-radius: 11px;
                    background: root.is_2d_mode
                        ? MaterialPalette.primary.with_alpha(25%)
                        : (mode_2d_touch.has-hover ? MaterialPalette.surface_container_highest : transparent);
                    border-width: root.is_2d_mode ? 1.5px : 1px;
                    border-color: root.is_2d_mode ? MaterialPalette.primary : MaterialPalette.outline_variant.with_alpha(40%);

                    MaterialText {
                        width: 100%;
                        height: 100%;
                        text: "2D Heatmap";
                        font-size: 10.5px;
                        font-weight: root.is_2d_mode ? 700 : 400;
                        color: root.is_2d_mode ? MaterialPalette.primary : MaterialPalette.on_surface;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // 3. 2D Heatmap View
        if (root.is_2d_mode): PhaseHeatmapView {
            heatmap_image: root.heatmap_image;
            descriptor_x: root.descriptor_index;
            descriptor_y: root.descriptor_y_index;
            descriptor_name_x: root.descriptor_name;
            descriptor_name_y: root.descriptor_name_y;
            min_x: root.domain_min;
            max_x: root.domain_max;
            min_y: root.domain_min_y;
            max_y: root.domain_max_y;
            sel_min_x: root.min_threshold;
            sel_max_x: root.max_threshold;
            sel_min_y: root.min_threshold_y;
            sel_max_y: root.max_threshold_y;
            matching_atoms: root.matching_atoms;
            total_atoms: root.total_atoms;
            crystal_markers: root.crystal_markers;

            set_descriptor_x(idx) => { root.set_descriptor(idx); }
            set_descriptor_y(idx) => { root.set_descriptor_y(idx); }
            set_selection_2d(min_x, max_x, min_y, max_y) => {
                root.set_thresholds_2d(min_x, max_x, min_y, max_y);
            }
            export_png => { root.export_heatmap_png(); }
            reset_selection => {
                root.set_thresholds_2d(root.domain_min, root.domain_max, root.domain_min_y, root.domain_max_y);
            }
        }

        // 4. 1D Crystal Presets
        if (!root.is_2d_mode): VerticalLayout {
            spacing: 3px;

            MaterialText {
                text: "Phase Presets";
                font-size: 11px;
                font-weight: 600;
                color: MaterialPalette.on_surface_variant;
            }

            // Row 1: Custom, Liquid, Glass
            HorizontalLayout {
                spacing: 4px;
                height: 24px;
                property <[string]> row1_labels: ["Custom", "Liquid", "Glass"];

                for label[idx] in self.row1_labels: TouchArea {
                    horizontal-stretch: 1;
                    height: 100%;
                    mouse-cursor: pointer;
                    clicked => { root.set_preset(idx); }

                    Rectangle {
                        width: 100%;
                        height: 100%;
                        border-radius: 12px;
                        background: root.preset_index == idx
                            ? MaterialPalette.primary.with_alpha(25%)
                            : (parent.has-hover ? MaterialPalette.surface_container_highest : transparent);
                        border-width: root.preset_index == idx ? 1.5px : 1px;
                        border-color: root.preset_index == idx ? MaterialPalette.primary : MaterialPalette.outline_variant.with_alpha(40%);

                        MaterialText {
                            width: 100%;
                            height: 100%;
                            text: label;
                            font-size: 11px;
                            font-weight: root.preset_index == idx ? 700 : 400;
                            color: root.preset_index == idx ? MaterialPalette.primary : MaterialPalette.on_surface;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // Row 2: a-Net, FCC, HCP
            HorizontalLayout {
                spacing: 4px;
                height: 24px;
                property <[string]> row2_labels: ["a-Net", "FCC", "HCP"];

                for label[idx] in self.row2_labels: TouchArea {
                    horizontal-stretch: 1;
                    height: 100%;
                    mouse-cursor: pointer;
                    clicked => { root.set_preset(idx + 3); }

                    Rectangle {
                        width: 100%;
                        height: 100%;
                        border-radius: 12px;
                        background: root.preset_index == (idx + 3)
                            ? MaterialPalette.primary.with_alpha(25%)
                            : (parent.has-hover ? MaterialPalette.surface_container_highest : transparent);
                        border-width: root.preset_index == (idx + 3) ? 1.5px : 1px;
                        border-color: root.preset_index == (idx + 3) ? MaterialPalette.primary : MaterialPalette.outline_variant.with_alpha(40%);

                        MaterialText {
                            width: 100%;
                            height: 100%;
                            text: label;
                            font-size: 11px;
                            font-weight: root.preset_index == (idx + 3) ? 700 : 400;
                            color: root.preset_index == (idx + 3) ? MaterialPalette.primary : MaterialPalette.on_surface;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // Row 3: BCC, Ico, Diamond
            HorizontalLayout {
                spacing: 4px;
                height: 24px;
                property <[string]> row3_labels: ["BCC", "Ico", "Diamond"];

                for label[idx] in self.row3_labels: TouchArea {
                    horizontal-stretch: 1;
                    height: 100%;
                    mouse-cursor: pointer;
                    clicked => { root.set_preset(idx + 6); }

                    Rectangle {
                        width: 100%;
                        height: 100%;
                        border-radius: 12px;
                        background: root.preset_index == (idx + 6)
                            ? MaterialPalette.primary.with_alpha(25%)
                            : (parent.has-hover ? MaterialPalette.surface_container_highest : transparent);
                        border-width: root.preset_index == (idx + 6) ? 1.5px : 1px;
                        border-color: root.preset_index == (idx + 6) ? MaterialPalette.primary : MaterialPalette.outline_variant.with_alpha(40%);

                        MaterialText {
                            width: 100%;
                            height: 100%;
                            text: label;
                            font-size: 11px;
                            font-weight: root.preset_index == (idx + 6) ? 700 : 400;
                            color: root.preset_index == (idx + 6) ? MaterialPalette.primary : MaterialPalette.on_surface;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        // 5. 1D Order Descriptor Selector
        if (!root.is_2d_mode): HorizontalLayout {
            spacing: 6px;

            // Descriptor Pills
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 2px;

                MaterialText {
                    text: "Descriptor";
                    font-size: 11px;
                    font-weight: 600;
                    color: MaterialPalette.on_surface_variant;
                }

                HorizontalLayout {
                    spacing: 2px;
                    height: 22px;
                    property <[string]> desc_labels: ["q̄₆", "q̄₄", "q₆", "q₄", "ŵ₆", "ŵ₄", "s₂", "N_c", "q_tet"];

                    for d_label[d_idx] in self.desc_labels: TouchArea {
                        horizontal-stretch: 1;
                        height: 100%;
                        mouse-cursor: pointer;
                        clicked => { root.set_descriptor(d_idx); }

                        Rectangle {
                            width: 100%;
                            height: 100%;
                            border-radius: 10px;
                            background: root.descriptor_index == d_idx
                                ? MaterialPalette.secondary.with_alpha(25%)
                                : (parent.has-hover ? MaterialPalette.surface_container_highest : transparent);
                            border-width: root.descriptor_index == d_idx ? 1.5px : 1px;
                            border-color: root.descriptor_index == d_idx ? MaterialPalette.secondary : MaterialPalette.outline_variant.with_alpha(40%);

                            MaterialText {
                                width: 100%;
                                height: 100%;
                                text: d_label;
                                font-size: 10.5px;
                                font-weight: root.descriptor_index == d_idx ? 700 : 400;
                                color: root.descriptor_index == d_idx ? MaterialPalette.secondary : MaterialPalette.on_surface;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }

            // Colormap Pills
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 2px;

                MaterialText {
                    text: "Colormap";
                    font-size: 11px;
                    font-weight: 600;
                    color: MaterialPalette.on_surface_variant;
                }

                HorizontalLayout {
                    spacing: 2px;
                    height: 22px;
                    property <[string]> cmap_labels: ["Viridis", "Plasma", "Cool", "Turbo"];

                    for c_label[c_idx] in self.cmap_labels: TouchArea {
                        horizontal-stretch: 1;
                        height: 100%;
                        mouse-cursor: pointer;
                        clicked => { root.set_colormap(c_idx); }

                        Rectangle {
                            width: 100%;
                            height: 100%;
                            border-radius: 10px;
                            background: root.colormap_index == c_idx
                                ? MaterialPalette.tertiary.with_alpha(25%)
                                : (parent.has-hover ? MaterialPalette.surface_container_highest : transparent);
                            border-width: root.colormap_index == c_idx ? 1.5px : 1px;
                            border-color: root.colormap_index == c_idx ? MaterialPalette.tertiary : MaterialPalette.outline_variant.with_alpha(40%);

                            MaterialText {
                                width: 100%;
                                height: 100%;
                                text: c_label;
                                font-size: 10.5px;
                                font-weight: root.colormap_index == c_idx ? 700 : 400;
                                color: root.colormap_index == c_idx ? MaterialPalette.tertiary : MaterialPalette.on_surface;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }

        // 4. Color Palette Gradient & Dynamic Threshold Bounds (inside the card)
        VerticalLayout {
            spacing: 2px;

            Rectangle {
                height: 8px;
                border-radius: 4px;
                clip: true;
                background: MaterialPalette.surface_container_high;
                border-width: 0.5px;
                border-color: MaterialPalette.outline_variant.with_alpha(40%);

                Image {
                    width: 100%;
                    height: 100%;
                    source: root.colorbar_image;
                    image-fit: fill;
                }
            }

            HorizontalLayout {
                alignment: space-between;

                MaterialText {
                    text: "" + (Math.round(root.min_threshold * 100) / 100);
                    font-size: 10px;
                    color: MaterialPalette.on_surface_variant;
                }

                MaterialText {
                    text: root.descriptor_name + " Scalar Palette";
                    font-size: 10px;
                    font-weight: 600;
                    color: MaterialPalette.primary;
                }

                MaterialText {
                    text: "" + (Math.round(root.max_threshold * 100) / 100);
                    font-size: 10px;
                    color: MaterialPalette.on_surface_variant;
                }
            }
        }

        // 6. 1D Threshold Range Sliders
        if (!root.is_2d_mode): HorizontalLayout {
            spacing: 6px;

            PhaseSlider {
                horizontal-stretch: 1;
                label: "Min Cutoff";
                value: root.min_threshold;
                min_val: root.domain_min;
                max_val: root.max_threshold;
                display_text: "" + (Math.round(root.min_threshold * 100) / 100);
                value_changed(val) => { root.set_thresholds(val, root.max_threshold); }
            }

            PhaseSlider {
                horizontal-stretch: 1;
                label: "Max Cutoff";
                value: root.max_threshold;
                min_val: root.min_threshold;
                max_val: root.domain_max;
                display_text: "" + (Math.round(root.max_threshold * 100) / 100);
                value_changed(val) => { root.set_thresholds(root.min_threshold, val); }
            }
        }

        // 6. Visual Controls: Halo Intensity & Radius Ratio
        HorizontalLayout {
            spacing: 6px;

            PhaseSlider {
                horizontal-stretch: 1;
                label: "Glow Intensity";
                value: root.halo_intensity;
                min_val: 0.1;
                max_val: 1.0;
                display_text: "" + (Math.round(root.halo_intensity * 100) / 100);
                value_changed(val) => { root.set_intensity(val); }
            }

            PhaseSlider {
                horizontal-stretch: 1;
                label: "Glow Radius";
                value: root.halo_radius_ratio;
                min_val: 1.1;
                max_val: 2.0;
                display_text: "" + (Math.round(root.halo_radius_ratio * 100) / 100) + "x";
                value_changed(val) => { root.set_radius_ratio(val); }
            }
        }

        // 7. Dim Non-Matching Atoms Checkbox
        TouchArea {
            height: 18px;
            mouse-cursor: pointer;
            clicked => { root.set_dim_non_matching(!root.dim_non_matching); }

            HorizontalLayout {
                spacing: 6px;
                alignment: start;

                Rectangle {
                    width: 14px;
                    height: 14px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 3px;
                    background: root.dim_non_matching ? MaterialPalette.primary : transparent;
                    border-width: 1.5px;
                    border-color: root.dim_non_matching ? MaterialPalette.primary : MaterialPalette.outline;

                    if (root.dim_non_matching): MaterialText {
                        width: 100%;
                        height: 100%;
                        text: "✓";
                        font-size: 10px;
                        font-weight: 700;
                        color: MaterialPalette.on_primary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                MaterialText {
                    text: "Dim non-matching core atoms";
                    font-size: 11.5px;
                    color: MaterialPalette.on_surface;
                    vertical-alignment: center;
                }
            }
        }

        // 8. Hide Non-Matching Atoms Checkbox
        TouchArea {
            height: 18px;
            mouse-cursor: pointer;
            clicked => { root.set_hide_non_matching(!root.hide_non_matching); }

            HorizontalLayout {
                spacing: 6px;
                alignment: start;

                Rectangle {
                    width: 14px;
                    height: 14px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 3px;
                    background: root.hide_non_matching ? MaterialPalette.primary : transparent;
                    border-width: 1.5px;
                    border-color: root.hide_non_matching ? MaterialPalette.primary : MaterialPalette.outline;

                    if (root.hide_non_matching): MaterialText {
                        width: 100%;
                        height: 100%;
                        text: "✓";
                        font-size: 10px;
                        font-weight: 700;
                        color: MaterialPalette.on_primary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                MaterialText {
                    text: "Hide non-matching core atoms";
                    font-size: 11.5px;
                    color: MaterialPalette.on_surface;
                    vertical-alignment: center;
                }
            }
        }

        // 9. 1D Mini-Histogram Distribution
        if (!root.is_2d_mode): PhaseMiniHistogram {
            counts: root.histogram_counts;
            min_threshold: root.min_threshold;
            max_threshold: root.max_threshold;
            domain_min: root.domain_min;
            domain_max: root.domain_max;
            matching_atoms: root.matching_atoms;
            total_atoms: root.total_atoms;
        }
    }
}
