import {
    MaterialPalette,
    MaterialTypography,
    MaterialStyleMetrics,
    MaterialText,
    FilledButton,
    Icons,
} from "../../../material/material.slint";
import { TrajectoryPlaybackBar } from "./TrajectoryPlaybackBar.slint";
import { PhaseSearchCard } from "./PhaseSearchCard.slint";
import { ViewportColorbar } from "./ViewportColorbar.slint";
import { CrystalMarker } from "./PhaseHeatmapView.slint";

export component Structure3DViewport inherits Rectangle {
    in property <image> structure_3d_image;
    in-out property <int> current_frame: 0;
    in property <int> total_frames: 0;
    in property <bool> bonds_enabled: true;
    in property <bool> wireframe_enabled: true;
    in property <bool> in_cell_enabled: false;

    // Phase Search & Halos
    in-out property <bool> phase_panel_open: false;
    in property <bool> phase_enabled: false;
    in property <int> phase_preset: 0;
    in property <int> phase_descriptor: 0;
    in property <int> phase_colormap: 0;
    in property <float> phase_min_threshold: 0.46;
    in property <float> phase_max_threshold: 0.58;
    in property <float> phase_domain_min: 0.0;
    in property <float> phase_domain_max: 1.0;
    in property <float> phase_halo_intensity: 0.85;
    in property <float> phase_halo_radius_ratio: 1.35;
    in property <bool> phase_dim_non_matching: false;
    in property <bool> phase_hide_non_matching: false;
    in property <[float]> phase_histogram_counts: [];
    in property <int> phase_matching_atoms: 0;
    in property <int> phase_total_atoms: 0;
    in property <string> phase_descriptor_name: "q̄₆";
    in property <image> phase_colorbar_image;

    // 2D Phase Search & Heatmap
    in property <bool> phase_is_2d_mode: false;
    in property <int> phase_descriptor_y: 0;
    in property <float> phase_min_threshold_y: 0.46;
    in property <float> phase_max_threshold_y: 0.58;
    in property <float> phase_domain_min_y: 0.0;
    in property <float> phase_domain_max_y: 1.0;
    in property <string> phase_descriptor_name_y: "q̄₆";
    in property <image> phase_heatmap_image;
    in property <[CrystalMarker]> phase_crystal_markers: [];

    callback toggle_phase_search(bool);
    callback set_phase_preset(int);
    callback set_phase_descriptor(int);
    callback set_phase_colormap(int);
    callback set_phase_thresholds(float, float);
    callback set_phase_intensity(float);
    callback set_phase_radius_ratio(float);
    callback set_phase_dim_non_matching(bool);
    callback set_phase_hide_non_matching(bool);

    callback set_phase_2d_mode(bool);
    callback set_phase_descriptor_y(int);
    callback set_phase_thresholds_2d(float, float, float, float);
    callback export_phase_heatmap_png();

    // Workflow properties & callbacks
    in property <bool> file_loaded: false;
    in property <bool> analysis_running: false;
    in property <bool> analysis_done: false;
    in property <string> file_basename: "";
    in property <string> total_atoms: "";
    in property <string> num_frames: "";

    callback run_analysis();
    callback open_panel(int);
    callback browse_file();

    callback rotate_3d(float, float);
    callback pan_3d(float, float);
    callback zoom_3d(float);
    callback reset_view();
    callback toggle_bonds(bool);
    callback toggle_wireframe(bool);
    callback toggle_in_cell(bool);
    callback seek_frame(int);
    callback step_frame(bool);
    callback resized(length, length);

    property <length> last_mouse_x: 0px;
    property <length> last_mouse_y: 0px;
    property <bool> is_dragging: false;
    property <bool> is_panning: false;

    background: MaterialPalette.surface_container_lowest;
    border-radius: 8px;
    clip: true;

    changed width => { root.resized(root.width, root.height); }
    changed height => { root.resized(root.width, root.height); }

    viewport_touch := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: root.is_dragging ? grabbing : grab;

        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.last_mouse_x = self.mouse-x;
                root.last_mouse_y = self.mouse-y;
                root.is_dragging = true;
                root.is_panning = (event.button == PointerEventButton.right);
            }
            if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                root.is_dragging = false;
                root.is_panning = false;
            }
        }

        moved => {
            if (root.is_dragging) {
                let line_dx = (self.mouse-x - root.last_mouse_x) / 1px;
                let line_dy = (self.mouse-y - root.last_mouse_y) / 1px;
                root.last_mouse_x = self.mouse-x;
                root.last_mouse_y = self.mouse-y;

                if (root.is_panning) {
                    root.pan_3d(line_dx, line_dy);
                } else {
                    root.rotate_3d(line_dx, line_dy);
                }
            }
        }

        scroll-event(event) => {
            root.zoom_3d(event.delta-y / 60px);
            accept
        }

        Image {
            width: 100%;
            height: 100%;
            source: root.structure_3d_image;
            image-fit: contain;
        }
    }

    // Centered Empty State when no structure file is loaded
    if (!root.file_loaded): Rectangle {
        width: 340px;
        height: 150px;
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        background: MaterialPalette.surface_container_high.with_alpha(92%);
        border-radius: 16px;
        border-width: 1px;
        border-color: MaterialPalette.outline_variant;

        VerticalLayout {
            padding: 16px;
            spacing: 10px;
            alignment: center;

            MaterialText {
                text: "No Structure Loaded";
                font-size: 15px;
                color: MaterialPalette.on_surface;
                horizontal-alignment: center;
            }

            MaterialText {
                text: "Open a trajectory or structure file to inspect 3D atomic coordinates.";
                font-size: 12px;
                color: MaterialPalette.on_surface_variant;
                horizontal-alignment: center;
                wrap: word-wrap;
            }

            FilledButton {
                height: 36px;
                text: "Open Trajectory File... (Ctrl+O)";
                icon: Icons.folder_open;
                clicked => { root.browse_file(); }
            }
        }
    }

    // Top Floating Bar (3D tools on left, workflow actions on right)
    HorizontalLayout {
        x: 12px;
        y: 12px;
        width: root.width - 24px;
        spacing: 8px;
        alignment: space-between;

        // 1. Left: 3D Visualization Tools
        Rectangle {
            height: 38px;
            border-radius: 19px;
            background: MaterialPalette.surface_container_highest;
            border-width: 1.5px;
            border-color: MaterialPalette.outline;
            width: tools_layout.preferred-width + 16px;

            tools_layout := HorizontalLayout {
                height: 100%;
                padding-left: 8px;
                padding-right: 8px;
                spacing: 6px;
                alignment: center;

                // Fit to box / Reset view
                TouchArea {
                    width: 30px;
                    height: 30px;
                    y: (parent.height - self.height) / 2;
                    mouse-cursor: pointer;
                    clicked => { root.reset_view(); }

                    Rectangle {
                        width: 100%;
                        height: 100%;
                        border-radius: 15px;
                        background: parent.has-hover ? MaterialPalette.surface_container_high : transparent;

                        MaterialText {
                            width: 100%;
                            height: 100%;
                            text: "⟲";
                            font-size: 16px;
                            color: MaterialPalette.on_surface;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

                // Toggle Bonds
                TouchArea {
                    width: 30px;
                    height: 30px;
                    y: (parent.height - self.height) / 2;
                    mouse-cursor: pointer;
                    clicked => { root.toggle_bonds(!root.bonds_enabled); }

                    Rectangle {
                        width: 100%;
                        height: 100%;
                        border-radius: 15px;
                        background: root.bonds_enabled ? MaterialPalette.primary.with_alpha(20%) :
                            (parent.has-hover ? MaterialPalette.surface_container_high : transparent);
                        border-width: root.bonds_enabled ? 1.5px : 0px;
                        border-color: root.bonds_enabled ? MaterialPalette.primary : transparent;

                        MaterialText {
                            width: 100%;
                            height: 100%;
                            text: root.bonds_enabled ? "🔗" : "⛓";
                            font-size: 14px;
                            color: root.bonds_enabled ? MaterialPalette.primary : MaterialPalette.on_surface;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

                // Toggle Wireframe
                TouchArea {
                    width: 30px;
                    height: 30px;
                    y: (parent.height - self.height) / 2;
                    mouse-cursor: pointer;
                    clicked => { root.toggle_wireframe(!root.wireframe_enabled); }

                    Rectangle {
                        width: 100%;
                        height: 100%;
                        border-radius: 15px;
                        background: root.wireframe_enabled ? MaterialPalette.primary.with_alpha(20%) :
                            (parent.has-hover ? MaterialPalette.surface_container_high : transparent);
                        border-width: root.wireframe_enabled ? 1.5px : 0px;
                        border-color: root.wireframe_enabled ? MaterialPalette.primary : transparent;

                        MaterialText {
                            width: 100%;
                            height: 100%;
                            text: "⬡";
                            font-size: 16px;
                            color: root.wireframe_enabled ? MaterialPalette.primary : MaterialPalette.on_surface;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

                // Toggle In-Cell PBC
                TouchArea {
                    width: 30px;
                    height: 30px;
                    y: (parent.height - self.height) / 2;
                    mouse-cursor: pointer;
                    accessible-role: button;
                    accessible-label: root.in_cell_enabled ? "In-Cell PBC Active (Folded & Boundary-Clipped)" : "Standard Non-Forced Coordinates";
                    clicked => { root.toggle_in_cell(!root.in_cell_enabled); }

                    Rectangle {
                        width: 100%;
                        height: 100%;
                        border-radius: 15px;
                        background: root.in_cell_enabled ? MaterialPalette.primary.with_alpha(20%) :
                            (parent.has-hover ? MaterialPalette.surface_container_high : transparent);
                        border-width: root.in_cell_enabled ? 1.5px : 0px;
                        border-color: root.in_cell_enabled ? MaterialPalette.primary : transparent;

                        MaterialText {
                            width: 100%;
                            height: 100%;
                            text: "⊞";
                            font-size: 15px;
                            color: root.in_cell_enabled ? MaterialPalette.primary : MaterialPalette.on_surface;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

                // Toggle Phase Search Panel
                TouchArea {
                    width: 30px;
                    height: 30px;
                    y: (parent.height - self.height) / 2;
                    mouse-cursor: pointer;
                    accessible-role: button;
                    accessible-label: root.phase_panel_open ? "Hide Phase Search" : "Show Phase Search";
                    clicked => { root.phase_panel_open = !root.phase_panel_open; }

                    Rectangle {
                        width: 100%;
                        height: 100%;
                        border-radius: 15px;
                        background: (root.phase_panel_open || root.phase_enabled) ? MaterialPalette.primary.with_alpha(20%) :
                            (parent.has-hover ? MaterialPalette.surface_container_high : transparent);
                        border-width: (root.phase_panel_open || root.phase_enabled) ? 1.5px : 0px;
                        border-color: (root.phase_panel_open || root.phase_enabled) ? MaterialPalette.primary : transparent;

                        MaterialText {
                            width: 100%;
                            height: 100%;
                            text: "🔮";
                            font-size: 14px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        // 2. Right: Unified Workflow Action Bar (Visible when file loaded)
        if (root.file_loaded): Rectangle {
            height: 36px;
            border-radius: 18px;
            background: MaterialPalette.surface_container_highest.with_alpha(85%);
            border-width: 1px;
            border-color: MaterialPalette.outline_variant.with_alpha(50%);
            width: workflow_layout.preferred-width + 16px;

            workflow_layout := HorizontalLayout {
                height: 100%;
                padding-left: 8px;
                padding-right: 8px;
                spacing: 8px;
                alignment: center;

                // File metadata pill
                MaterialText {
                    y: (parent.height - self.height) / 2;
                    text: "📁 " + root.file_basename + " (" + root.total_atoms + " atoms)";
                    font-size: 13px;
                    color: MaterialPalette.on_surface_variant;
                    vertical-alignment: center;
                }

                // Run Analysis Button (Compact pill with centered icon and label)
                run_btn_touch := TouchArea {
                    height: 28px;
                    y: (parent.height - self.height) / 2;
                    width: run_btn_layout.preferred-width + 20px;
                    enabled: !root.analysis_running;
                    mouse-cursor: self.enabled ? pointer : default;
                    clicked => { root.run_analysis(); }

                    Rectangle {
                        width: 100%;
                        height: 100%;
                        border-radius: 14px;
                        background: !run_btn_touch.enabled ? MaterialPalette.surface_container_high :
                            run_btn_touch.has-hover ? MaterialPalette.primary.darker(8%) : MaterialPalette.primary;

                        animate background { duration: 150ms; }

                        run_btn_layout := HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 6px;
                            alignment: center;

                            Image {
                                width: 14px;
                                height: 14px;
                                y: (parent.height - self.height) / 2;
                                source: Icons.play_arrow;
                                colorize: !run_btn_touch.enabled ? MaterialPalette.outline : MaterialPalette.on_primary;
                            }

                            MaterialText {
                                text: root.analysis_running ? "Running..." : "Run Analysis";
                                font-size: 13px;
                                font-weight: 600;
                                color: !run_btn_touch.enabled ? MaterialPalette.outline : MaterialPalette.on_primary;
                                vertical-alignment: center;
                                horizontal-alignment: center;
                            }
                        }
                    }
                }

                // Options Button
                options_touch := TouchArea {
                    width: 28px;
                    height: 28px;
                    y: (parent.height - self.height) / 2;
                    mouse-cursor: pointer;
                    clicked => { root.open_panel(1); }

                    Rectangle {
                        width: 100%;
                        height: 100%;
                        border-radius: 14px;
                        background: options_touch.has-hover ? MaterialPalette.surface_container_high : transparent;

                        MaterialText {
                            width: 100%;
                            height: 100%;
                            text: "⚙";
                            font-size: 14px;
                            color: MaterialPalette.on_surface_variant;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }

    // Trajectory Playback & Scrub Bar (visible when multi-frame trajectory is loaded)
    if (root.file_loaded && root.total_frames > 1): TrajectoryPlaybackBar {
        x: (root.width - self.width) / 2;
        y: root.height - self.height - 12px;
        width: Math.min(root.width - 48px, 680px);
        current_frame <=> root.current_frame;
        total_frames: root.total_frames;
        seek_frame(idx) => { root.seek_frame(idx); }
        step_frame(fwd) => { root.step_frame(fwd); }
    }

    // Subtle bottom navigation hint
    if (root.file_loaded): Rectangle {
        x: (root.width - self.width) / 2;
        y: root.height - self.height - (root.total_frames > 1 ? 66px : 10px);
        width: hint_text.preferred-width + 20px;
        height: 24px;
        border-radius: 12px;
        background: MaterialPalette.surface_container_highest.with_alpha(60%);

        hint_text := MaterialText {
            text: "🖱 Left-drag: Orbit  •  Right-drag: Pan  •  Scroll: Zoom";
            font-size: 12px;
            color: MaterialPalette.on_surface_variant.with_alpha(80%);
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    // Floating Viewport Colorbar (bottom-right when halos enabled and panel closed)
    if (root.phase_enabled && !root.phase_panel_open): ViewportColorbar {
        x: root.width - self.width - 16px;
        y: root.height - self.height - (root.total_frames > 1 ? 66px : 16px);
        descriptor_name: root.phase_descriptor_name;
        min_val: root.phase_min_threshold;
        max_val: root.phase_max_threshold;
        colorbar_image: root.phase_colorbar_image;
    }

    // Floating Halo Options Control Card (top-right, collapsible)
    if (root.phase_panel_open): PhaseSearchCard {
        x: root.width - self.width - 16px;
        y: 52px;
        height: self.preferred-height;
        phase_enabled: root.phase_enabled;
        preset_index: root.phase_preset;
        descriptor_index: root.phase_descriptor;
        colormap_index: root.phase_colormap;
        min_threshold: root.phase_min_threshold;
        max_threshold: root.phase_max_threshold;
        domain_min: root.phase_domain_min;
        domain_max: root.phase_domain_max;
        halo_intensity: root.phase_halo_intensity;
        halo_radius_ratio: root.phase_halo_radius_ratio;
        dim_non_matching: root.phase_dim_non_matching;
        hide_non_matching: root.phase_hide_non_matching;
        histogram_counts: root.phase_histogram_counts;
        matching_atoms: root.phase_matching_atoms;
        total_atoms: root.phase_total_atoms;
        colorbar_image: root.phase_colorbar_image;
        descriptor_name: root.phase_descriptor_name;

        // 2D Heatmap Mode properties
        is_2d_mode: root.phase_is_2d_mode;
        descriptor_y_index: root.phase_descriptor_y;
        min_threshold_y: root.phase_min_threshold_y;
        max_threshold_y: root.phase_max_threshold_y;
        domain_min_y: root.phase_domain_min_y;
        domain_max_y: root.phase_domain_max_y;
        descriptor_name_y: root.phase_descriptor_name_y;
        heatmap_image: root.phase_heatmap_image;
        crystal_markers: root.phase_crystal_markers;

        toggle_enabled(en) => { root.toggle_phase_search(en); }
        set_preset(idx) => { root.set_phase_preset(idx); }
        set_descriptor(idx) => { root.set_phase_descriptor(idx); }
        set_colormap(idx) => { root.set_phase_colormap(idx); }
        set_thresholds(min, max) => { root.set_phase_thresholds(min, max); }
        set_intensity(val) => { root.set_phase_intensity(val); }
        set_radius_ratio(val) => { root.set_phase_radius_ratio(val); }
        set_dim_non_matching(dim) => { root.set_phase_dim_non_matching(dim); }
        set_hide_non_matching(hide) => { root.set_phase_hide_non_matching(hide); }
        close => { root.phase_panel_open = false; }

        set_2d_mode(is_2d) => { root.set_phase_2d_mode(is_2d); }
        set_descriptor_y(idx) => { root.set_phase_descriptor_y(idx); }
        set_thresholds_2d(min_x, max_x, min_y, max_y) => {
            root.set_phase_thresholds_2d(min_x, max_x, min_y, max_y);
        }
        export_heatmap_png => { root.export_phase_heatmap_png(); }
    }
}
