import {
    MaterialPalette,
    MaterialStyleMetrics,
} from "../../../material/material.slint";
import { TrajectoryPlaybackBar } from "./TrajectoryPlaybackBar.slint";
import { CrystalMarker } from "./PhaseHeatmapTypes.slint";
import { DistributionHUDCard } from "./DistributionHUDCard.slint";
import { Structure3DEmptyState } from "./Structure3DEmptyState.slint";
import { Structure3DToolBar } from "./Structure3DToolBar.slint";
import { Structure3DWorkflowBar } from "./Structure3DWorkflowBar.slint";
import { Structure3DOverlays } from "./Structure3DOverlays.slint";
import { OrientationGizmo } from "./OrientationGizmo.slint";
import { AtomInspectorCard } from "./AtomInspectorCard.slint";
import { CameraHudState, InspectedAtomInfo, ElementLegendItem } from "../../../Types.slint";

export component Structure3DViewport inherits Rectangle {
    in property <image> structure_3d_image;
    in-out property <int> current_frame: 0;
    in property <int> total_frames: 0;
    in property <bool> bonds_enabled: true;
    in property <bool> wireframe_enabled: true;
    in property <bool> in_cell_enabled: true;
    in property <bool> is_isometric: false;
    in property <bool> camera_animating: false;
    in property <[ElementLegendItem]> element_legend: [];
    in property <bool> has_hidden_elements: false;
    in-out property <bool> is_playing: false;
    in property <string> backend_label: "";
    in property <bool> gpu_accelerated: false;

    // Phase Search & Halos
    in-out property <bool> phase_panel_open: false;
    in property <bool> phase_enabled: false;
    in property <bool> phase_computing: false;
    in property <float> phase_prebake_progress: 0.0;
    in property <int> phase_cached_frames: 0;
    in property <int> phase_preset: 0;
    in property <int> phase_descriptor: 0;
    in property <int> phase_colormap: 0;
    in property <float> phase_min_threshold: 0.46;
    in property <float> phase_max_threshold: 0.58;
    in property <float> phase_domain_min: 0.0;
    in property <float> phase_domain_max: 1.0;
    in property <float> phase_halo_intensity: 0.85;
    in property <float> phase_halo_radius_ratio: 2.70;
    in property <float> atom_scale: 0.35;
    in property <bool> phase_dim_non_matching: false;
    in property <bool> phase_hide_non_matching: false;
    in property <[float]> phase_histogram_counts: [];
    in property <int> phase_matching_atoms: 0;
    in property <int> phase_total_atoms: 0;
    in property <string> phase_descriptor_name: "q̄₆";
    in property <image> phase_colorbar_image;

    // 2D Phase Search & Heatmap
    in property <bool> phase_is_2d_mode: false;
    in property <int> phase_descriptor_y: 0;
    in property <float> phase_min_threshold_y: 0.46;
    in property <float> phase_max_threshold_y: 0.58;
    in property <float> phase_domain_min_y: 0.0;
    in property <float> phase_domain_max_y: 1.0;
    in property <string> phase_descriptor_name_y: "q̄₆";
    in property <image> phase_heatmap_image;
    in property <[CrystalMarker]> phase_crystal_markers: [];

    // Distribution Mini-Graph HUD
    in-out property <bool> dist_hud_visible: true;
    in property <bool> dist_has_data: false;
    in property <image> dist_chart_image;
    in-out property <int> dist_active_metric: 0;
    in property <string> dist_peak_text: "";

    // Camera HUD, Atom Inspector & Dual-View Radial Brushing
    in property <CameraHudState> camera_hud: {
        ax_x: 0.7, ax_y: 0.3,
        ay_x: 0.0, ay_y: -0.9,
        az_x: -0.7, az_y: 0.3,
        scale_bar_px: 64px,
        scale_bar_label: "5 Å",
    };
    in property <InspectedAtomInfo> inspected_atom;
    in property <string> radial_brush_text: "";
    in property <string> measurement_text: "";
    in property <bool> shift_held: false;

    callback clicked();
    callback pick_atom(float, float);
    callback clear_picked_atom();
    callback measure_atom(float, float);
    callback clear_measurement();
    callback focus_picked_atom();
    callback tick_camera_animation();
    callback toggle_element_visibility(string);
    callback show_all_elements();
    callback export_snapshot();
    callback set_dist_metric(int);
    callback toggle_dist_hud(bool);
    callback toggle_phase_panel();

    // Workflow properties & callbacks
    in property <bool> file_loaded: false;
    in property <bool> analysis_running: false;
    in property <bool> has_validation_errors: false;
    in property <bool> analysis_done: false;
    in property <string> file_basename: "";
    in property <string> total_atoms: "";
    in property <string> num_frames: "";
    in property <[string]> recent_files: [];

    callback run_analysis();
    callback cancel_analysis();
    callback open_panel(int);
    callback browse_file();
    callback load_sample(string);
    callback load_recent(string);

    callback rotate_3d(float, float);
    callback pan_3d(float, float);
    callback zoom_3d(float);
    callback reset_view();
    callback set_camera_preset(int);
    callback toggle_bonds(bool);
    callback toggle_wireframe(bool);
    callback toggle_in_cell(bool);
    callback toggle_projection(bool);
    callback seek_frame(int);
    callback step_frame(bool);
    callback resized(length, length);
    callback set_atom_scale(float);

    property <length> last_mouse_x: 0px;
    property <length> last_mouse_y: 0px;
    property <length> down_mouse_x: 0px;
    property <length> down_mouse_y: 0px;
    property <bool> is_dragging: false;
    property <bool> is_panning: false;
    property <bool> has_interacted: false;

    camera_anim_timer := Timer {
        interval: 16ms;
        running: root.camera_animating;
        triggered() => { root.tick_camera_animation(); }
    }

    // Main 3D Viewport Area
    viewport_container := Rectangle {
        background: MaterialPalette.surface_container_lowest;
        border-radius: MaterialStyleMetrics.border_radius_8;
        clip: true;

        changed width => {
            if (self.width > 10px && self.height > 10px) {
                root.resized(self.width, self.height);
            }
        }
        changed height => {
            if (self.width > 10px && self.height > 10px) {
                root.resized(self.width, self.height);
            }
        }

        viewport_touch := TouchArea {
            mouse-cursor: root.is_dragging ? grabbing : grab;

            double-clicked => {
                if (root.file_loaded && self.width > 10px && self.height > 10px) {
                    root.pick_atom(self.mouse-x / self.width, self.mouse-y / self.height);
                    root.focus_picked_atom();
                }
            }

            pointer-event(event) => {
                if (event.kind == PointerEventKind.down) {
                    root.clicked();
                    root.last_mouse_x = self.mouse-x;
                    root.last_mouse_y = self.mouse-y;
                    root.down_mouse_x = self.mouse-x;
                    root.down_mouse_y = self.mouse-y;
                    root.is_dragging = true;
                    root.is_panning = (event.button == PointerEventButton.right);
                }
                if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                    if (event.kind == PointerEventKind.up && !root.is_panning && root.file_loaded &&
                        self.width > 10px && self.height > 10px) {
                        let moved_x = Math.abs((self.mouse-x - root.down_mouse_x) / 1px);
                        let moved_y = Math.abs((self.mouse-y - root.down_mouse_y) / 1px);
                        if (moved_x < 4.0 && moved_y < 4.0) {
                            if (root.shift_held) {
                                root.measure_atom(self.mouse-x / self.width, self.mouse-y / self.height);
                            } else {
                                root.pick_atom(self.mouse-x / self.width, self.mouse-y / self.height);
                            }
                        }
                    }
                    root.is_dragging = false;
                    root.is_panning = false;
                }
            }

            moved => {
                if (root.is_dragging) {
                    let line_dx = (self.mouse-x - root.last_mouse_x) / 1px;
                    let line_dy = (self.mouse-y - root.last_mouse_y) / 1px;
                    root.last_mouse_x = self.mouse-x;
                    root.last_mouse_y = self.mouse-y;
                    if (Math.abs(line_dx) > 0.5 || Math.abs(line_dy) > 0.5) {
                        root.has_interacted = true;
                    }

                    if (root.is_panning) {
                        root.pan_3d(line_dx, line_dy);
                    } else {
                        root.rotate_3d(line_dx, line_dy);
                    }
                }
            }

            scroll-event(event) => {
                root.zoom_3d(event.delta-y / 120px);
                accept
            }

            Image {
                width: 100%;
                height: 100%;
                source: root.structure_3d_image;
                image-fit: contain;
            }
        }

        // Centered Empty State when no structure file is loaded
            if (!root.file_loaded): Structure3DEmptyState {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            recent_files: root.recent_files;
            browse_file => { root.browse_file(); }
            load_sample(s) => { root.load_sample(s); }
            load_recent(r) => { root.load_recent(r); }
        }

        // Left Vertical Floating 3D Tool Dock
        Structure3DToolBar {
            x: 12px;
            y: 12px;
            bonds_enabled: root.bonds_enabled;
            wireframe_enabled: root.wireframe_enabled;
            in_cell_enabled: root.in_cell_enabled;
            is_isometric: root.is_isometric;
            phase_panel_open: root.phase_panel_open;
            phase_enabled: root.phase_enabled;
            dist_hud_enabled: root.dist_hud_visible;

            reset_view => { root.reset_view(); }
            toggle_bonds(en) => { root.toggle_bonds(en); }
            toggle_wireframe(en) => { root.toggle_wireframe(en); }
            toggle_in_cell(en) => { root.toggle_in_cell(en); }
            toggle_projection(en) => { root.toggle_projection(en); }
            toggle_phase_panel => { root.toggle_phase_panel(); }
            toggle_dist_hud => {
                root.dist_hud_visible = !root.dist_hud_visible;
                root.toggle_dist_hud(root.dist_hud_visible);
            }
            export_snapshot => { root.export_snapshot(); }
        }

        // Top-Left Structure Status Pill (beside vertical dock, clear of Dual-View right edge)
        if (root.file_loaded): Structure3DWorkflowBar {
            x: 60px;
            y: 12px;
            file_basename: root.file_basename;
            total_atoms: root.total_atoms;
            analysis_running: root.analysis_running;
            has_validation_errors: root.has_validation_errors;
            analysis_done: root.analysis_done;

            run_analysis => { root.run_analysis(); }
            cancel_analysis => { root.cancel_analysis(); }
            open_panel(id) => { root.open_panel(id); }
        }

        // Top-Right Interactive Corner Orientation Axis Gizmo
        if (root.file_loaded): OrientationGizmo {
            x: parent.width - self.width - 12px;
            y: 12px;
            hud_state: root.camera_hud;
            set_camera_preset(p) => { root.set_camera_preset(p); }
        }

        // Click-to-Inspect Atom Popover (top-right below Orientation Gizmo)
        if (root.file_loaded && root.inspected_atom.valid): AtomInspectorCard {
            x: parent.width - self.width - 12px;
            y: 96px;
            info: root.inspected_atom;
            focus_atom => { root.focus_picked_atom(); }
            dismissed => { root.clear_picked_atom(); }
        }

        // Trajectory Playback & Scrub Bar (visible when multi-frame trajectory is loaded)
        if (root.file_loaded && root.total_frames > 1): TrajectoryPlaybackBar {
            x: (parent.width - self.width) / 2;
            y: parent.height - self.height - 12px;
            width: Math.min(parent.width - 24px, 680px);
            current_frame <=> root.current_frame;
            total_frames: root.total_frames;
            is_playing <=> root.is_playing;
            phase_enabled: root.phase_enabled;
            phase_computing: root.phase_computing;
            phase_prebake_progress: root.phase_prebake_progress;
            phase_cached_frames: root.phase_cached_frames;
            seek_frame(idx) => { root.seek_frame(idx); }
            step_frame(fwd) => { root.step_frame(fwd); }
        }

        // Floating Distribution HUD Card (bottom-left, hidden in very narrow Dual-View panes to avoid overlap)
        if (root.file_loaded && root.dist_has_data && root.dist_hud_visible && viewport_container.width >= 440px): DistributionHUDCard {
            x: 16px;
            y: parent.height - self.height - (root.total_frames > 1 ? 66px : 16px);
            chart_image: root.dist_chart_image;
            active_metric: root.dist_active_metric;
            peak_text: root.dist_peak_text;
            current_frame: root.current_frame;
            set_metric(m) => {
                root.dist_active_metric = m;
                root.set_dist_metric(m);
            }
            close_hud => {
                root.dist_hud_visible = false;
                root.toggle_dist_hud(false);
            }
        }

        // Status Pills, Computing Indicator, Nav Hint, Colorbar & Scale Bar Overlays
        Structure3DOverlays {
            width: 100%;
            height: 100%;
            file_loaded: root.file_loaded;
            total_frames: root.total_frames;
            has_interacted: root.has_interacted;
            radial_brush_text: root.radial_brush_text;
            measurement_text: root.measurement_text;
            clear_measurement => { root.clear_measurement(); }
            phase_enabled: root.phase_enabled;
            phase_computing: root.phase_computing;
            phase_cached_frames: root.phase_cached_frames;
            phase_panel_open: root.phase_panel_open;
            phase_descriptor_name: root.phase_descriptor_name;
            phase_min_threshold: root.phase_min_threshold;
            phase_max_threshold: root.phase_max_threshold;
            phase_colorbar_image: root.phase_colorbar_image;
            camera_hud: root.camera_hud;
            element_legend: root.element_legend;
            has_hidden_elements: root.has_hidden_elements;
            toggle_element_visibility(sym) => { root.toggle_element_visibility(sym); }
            show_all_elements => { root.show_all_elements(); }
        }
    }
}
