import {
    MaterialStyleMetrics,
    MaterialPalette,
    InputSelect,
    MenuItem,
    Horizontal,
    TabItem,
} from "../../../material/material.slint";

export component PreviewHeader inherits Horizontal {
    in property <[MenuItem]> plot_items: [];
    in-out property <int> selected_plot_index: -1;
    in-out property <int> active_tab: 0;

    callback plot_selected(int);

    out property <string> tooltip_text:
        tab_plot.has_hover ? "2D Plot View\n\n📈 Interactive curve visualizer with zoom, pan, peak tagging, and calibration." :
        tab_3d.has_hover ? "3D Structure View\n\n🌐 Interactive atomic visualizer with orbit camera, bonds, and unit cell wireframe." :
        tab_dual.has_hover ? "Dual Split-Screen View\n\n◫ Side-by-side synchronized 2D plot and 3D molecular viewport." :
        tab_data.has_hover ? "Data Explorer View\n\n📄 Tabular numerical coordinates and distribution intensities." : "";

    out property <length> tooltip_x:
        plot_dropdown_area.has-hover ? plot_dropdown_area.absolute-position.x + plot_dropdown_area.mouse-x :
        tab_plot.has_hover ? tab_plot.abs_x + tab_plot.mouse_x :
        tab_3d.has_hover ? tab_3d.abs_x + tab_3d.mouse_x :
        tab_dual.has_hover ? tab_dual.abs_x + tab_dual.mouse_x :
        tab_data.has_hover ? tab_data.abs_x + tab_data.mouse_x : 0px;

    out property <length> tooltip_y:
        plot_dropdown_area.has-hover ? plot_dropdown_area.absolute-position.y + plot_dropdown_area.mouse-y :
        tab_plot.has_hover ? tab_plot.abs_y + tab_plot.mouse_y :
        tab_3d.has_hover ? tab_3d.abs_y + tab_3d.mouse_y :
        tab_dual.has_hover ? tab_dual.abs_y + tab_dual.mouse_y :
        tab_data.has_hover ? tab_data.abs_y + tab_data.mouse_y : 0px;

    spacing: MaterialStyleMetrics.spacing_8;
    height: MaterialStyleMetrics.size_40;

    plot_dropdown_area := InputSelect {
        horizontal-stretch: 1;
        height: 100%;
        label: "Select Plot";
        enabled: root.plot_items.length > 0;
        items: root.plot_items;
        current_index <=> root.selected_plot_index;

        selected(idx) => {
            root.plot_selected(idx);
        }
    }

    // Connected Segmented Button Group
    Rectangle {
        height: 100%;
        background: MaterialPalette.surface_container;
        border-radius: MaterialStyleMetrics.border_radius_8;
        border-width: 1px;
        border-color: MaterialPalette.outline_variant;
        clip: true;

        HorizontalLayout {
            spacing: 0px;

            tab_plot := TabItem {
                text: "2D Plot";
                active: root.active_tab == 0;
                clicked => { root.active_tab = 0; }
            }

            Rectangle {
                width: 1px;
                background: MaterialPalette.outline_variant;
            }

            tab_3d := TabItem {
                text: "3D View";
                active: root.active_tab == 1;
                clicked => { root.active_tab = 1; }
            }

            Rectangle {
                width: 1px;
                background: MaterialPalette.outline_variant;
            }

            tab_dual := TabItem {
                text: "Dual View";
                active: root.active_tab == 2;
                clicked => { root.active_tab = 2; }
            }

            Rectangle {
                width: 1px;
                background: MaterialPalette.outline_variant;
            }

            tab_data := TabItem {
                text: "Data Explorer";
                active: root.active_tab == 3;
                clicked => { root.active_tab = 3; }
            }
        }
    }
}
