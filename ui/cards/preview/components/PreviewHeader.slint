import {
    MaterialTypography,
    MaterialStyleMetrics,
    MaterialPalette,
    MaterialText,
    InputSelect,
    MenuItem,
    Horizontal,
    TabItem,
    Icons,
    TooltipTarget,
} from "../../../material/material.slint";

export component PreviewHeader inherits Horizontal {
    in property <[MenuItem]> plot_items: [];
    in-out property <int> selected_plot_index: -1;
    in-out property <int> active_tab: 0;
    in-out property <int> dual_scope: 0;
    in property <bool> results_stale: false;
    in property <bool> analysis_running: false;
    in property <bool> has_validation_errors: false;

    callback plot_selected(int);
    callback rerun_analysis();

    spacing: MaterialStyleMetrics.spacing_8;
    height: MaterialStyleMetrics.size_40;

    InputSelect {
        horizontal-stretch: 1;
        height: 100%;
        enabled: root.plot_items.length > 0;
        items: root.plot_items;
        current_index <=> root.selected_plot_index;
        tooltip_text: "Select distribution function to inspect (scroll mouse wheel to cycle plots, or type to filter).";

        selected(idx) => {
            root.plot_selected(idx);
        }
    }

    if root.results_stale && !root.analysis_running: stale_touch := TooltipTarget {
        height: 32px;
        y: (parent.height - self.height) / 2;
        width: stale_row.preferred-width + 18px;
        mouse-cursor: root.has_validation_errors ? default : pointer;
        tooltip_text: root.has_validation_errors
            ? "Parameters modified — fix validation errors before re-running."
            : "Parameters, cutoffs, or active calculators changed since the last run.\n\n⚡ Click to re-run analysis (Ctrl+R) and refresh plots.";
        accessible-role: button;
        accessible-label: "Parameters modified, click to re-run analysis";
        clicked => {
            if (!root.has_validation_errors) {
                root.rerun_analysis();
            }
        }

        Rectangle {
            border-radius: MaterialStyleMetrics.border_radius_full;
            background: stale_touch.has-hover && !root.has_validation_errors
                ? MaterialPalette.warning_container.darker(6%)
                : MaterialPalette.warning_container;
            border-width: 1px;
            border-color: MaterialPalette.warning;

            stale_row := HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                spacing: 6px;
                alignment: center;

                Rectangle {
                    width: 7px;
                    height: 7px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 3.5px;
                    background: MaterialPalette.warning;
                }

                MaterialText {
                    text: "Parameters modified — Re-run";
                    style: MaterialTypography.label_small_prominent;
                    color: MaterialPalette.on_warning_container;
                    vertical-alignment: center;
                }

                Image {
                    width: 14px;
                    height: 14px;
                    y: (parent.height - self.height) / 2;
                    source: Icons.restart_alt;
                    colorize: MaterialPalette.on_warning_container;
                }
            }
        }
    }

    // Connected Segmented Button Group
    Rectangle {
        height: 100%;
        background: MaterialPalette.surface_container;
        border-radius: MaterialStyleMetrics.border_radius_8;
        border-width: 1px;
        border-color: MaterialPalette.outline_variant;
        clip: true;

        HorizontalLayout {

            TabItem {
                text: "2D Plot";
                active: root.active_tab == 0;
                tooltip_text: "2D Plot View (1)\n\n📈 Interactive curve visualizer with zoom, pan, peak tagging, and calibration.";
                clicked => { root.active_tab = 0; }
            }

            Rectangle {
                width: 1px;
                background: MaterialPalette.outline_variant;
            }

            TabItem {
                text: "3D View";
                active: root.active_tab == 1;
                tooltip_text: "3D Structure View (2)\n\n🌐 Interactive atomic visualizer with orbit camera, bonds, and unit cell wireframe.";
                clicked => { root.active_tab = 1; }
            }

            Rectangle {
                width: 1px;
                background: MaterialPalette.outline_variant;
            }

            TabItem {
                text: "Dual View";
                active: root.active_tab == 2;
                tooltip_text: "Dual Split-Screen View (3)\n\n◫ Side-by-side synchronized 2D plot and 3D molecular viewport.";
                clicked => { root.active_tab = 2; }
            }

            Rectangle {
                width: 1px;
                background: MaterialPalette.outline_variant;
            }

            TabItem {
                text: "Data Explorer";
                active: root.active_tab == 3;
                tooltip_text: "Data Explorer View (4)\n\n📄 Tabular numerical coordinates and distribution intensities.";
                clicked => { root.active_tab = 3; }
            }
        }
    }

    // Dual View Inspector Scope Switcher (Visible in Dual View mode)
    Rectangle {
        visible: root.active_tab == 2;
        width: root.active_tab == 2 ? self.preferred-width : 0px;
        height: 100%;
        background: MaterialPalette.surface_container;
        border-radius: MaterialStyleMetrics.border_radius_8;
        border-width: 1px;
        border-color: MaterialPalette.outline_variant;
        clip: true;

        HorizontalLayout {
            padding-left: 8px;

            MaterialText {
                text: "Inspector:";
                font-size: MaterialTypography.label_small.font_size;
                color: MaterialPalette.on_surface_variant;
                vertical-alignment: center;
            }

            Rectangle { width: 6px; }

            TabItem {
                text: "2D";
                compact: true;
                active: root.dual_scope == 0;
                tooltip_text: "Show 2D Inspector\n\nConfigure curves, axes, and tagged peaks for the 2D plot.";
                clicked => { root.dual_scope = 0; }
            }

            Rectangle {
                width: 1px;
                background: MaterialPalette.outline_variant;
            }

            TabItem {
                text: "3D";
                compact: true;
                active: root.dual_scope == 1;
                tooltip_text: "Show 3D Inspector\n\nConfigure atomic rendering, order parameter presets, and phase search.";
                clicked => { root.dual_scope = 1; }
            }
        }
    }
}
