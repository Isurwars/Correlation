import {
    CheckBoxRow,
    MaterialStyleMetrics,
    MaterialSlider,
} from "../../../material/material.slint";

export component PhaseVisualControls inherits VerticalLayout {
    in property <float> halo_intensity: 0.85;
    in property <float> halo_radius_ratio: 2.70;
    in property <float> atom_scale: 0.35;
    in property <bool> dim_non_matching: false;
    in property <bool> hide_non_matching: false;
    in property <bool> show_dim_options: true;

    callback set_intensity(float);
    callback set_radius_ratio(float);
    callback set_atom_scale(float);
    callback set_dim_non_matching(bool);
    callback set_hide_non_matching(bool);

    spacing: MaterialStyleMetrics.spacing_6;

    // Visual Controls: Ball Radius, Halo Intensity & Halo Radius Ratio
    HorizontalLayout {
        spacing: MaterialStyleMetrics.spacing_6;

        MaterialSlider {
            horizontal-stretch: 1;
            label: "Ball Radius";
            value: root.atom_scale;
            minimum: 0.1;
            maximum: 1.5;
            display_text: "" + (Math.round(root.atom_scale * 100) / 100) + "x";
            tooltip_text: "Scale atomic sphere radii relative to covalent radii.";
            changed(val) => { root.set_atom_scale(val); }
        }

        MaterialSlider {
            horizontal-stretch: 1;
            label: "Glow Intensity";
            value: root.halo_intensity;
            minimum: 0.1;
            display_text: "" + (Math.round(root.halo_intensity * 100) / 100);
            tooltip_text: "Adjust brightness/opacity of phase-matching atom halos.";
            changed(val) => { root.set_intensity(val); }
        }

        MaterialSlider {
            horizontal-stretch: 1;
            label: "Glow Radius";
            value: root.halo_radius_ratio;
            minimum: 1.1;
            maximum: 4.5;
            display_text: "" + (Math.round(root.halo_radius_ratio * 100) / 100) + "x";
            tooltip_text: "Adjust outer halo radius multiplier around matching atoms.";
            changed(val) => { root.set_radius_ratio(val); }
        }
    }

    if root.show_dim_options: CheckBoxRow {
        text: "Dim non-matching core atoms";
        check_state_bool: root.dim_non_matching;
        tooltip_text: "Reduce opacity of atoms outside the selected order-parameter range.";
        checked_state_changed(dim) => { root.set_dim_non_matching(dim); }
    }

    if root.show_dim_options: CheckBoxRow {
        text: "Hide non-matching core atoms";
        check_state_bool: root.hide_non_matching;
        tooltip_text: "Completely hide atoms outside the selected order-parameter range.";
        checked_state_changed(hide) => { root.set_hide_non_matching(hide); }
    }
}
