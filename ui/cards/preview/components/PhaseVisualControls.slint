import {
    MaterialPalette,
    MaterialTypography,
    MaterialText,
} from "../../../material/material.slint";
import { PhaseSlider } from "./PhaseSlider.slint";

export component PhaseVisualControls inherits VerticalLayout {
    in property <float> halo_intensity: 0.85;
    in property <float> halo_radius_ratio: 1.35;
    in property <float> atom_scale: 0.35;
    in property <bool> dim_non_matching: false;
    in property <bool> hide_non_matching: false;

    callback set_intensity(float);
    callback set_radius_ratio(float);
    callback set_atom_scale(float);
    callback set_dim_non_matching(bool);
    callback set_hide_non_matching(bool);

    spacing: 5px;

    // Visual Controls: Ball Radius, Halo Intensity & Halo Radius Ratio
    HorizontalLayout {
        spacing: 6px;

        PhaseSlider {
            horizontal-stretch: 1;
            label: "Ball Radius";
            value: root.atom_scale;
            min_val: 0.1;
            max_val: 1.5;
            display_text: "" + (Math.round(root.atom_scale * 100) / 100) + "x";
            value_changed(val) => { root.set_atom_scale(val); }
        }

        PhaseSlider {
            horizontal-stretch: 1;
            label: "Glow Intensity";
            value: root.halo_intensity;
            min_val: 0.1;
            max_val: 1.0;
            display_text: "" + (Math.round(root.halo_intensity * 100) / 100);
            value_changed(val) => { root.set_intensity(val); }
        }

        PhaseSlider {
            horizontal-stretch: 1;
            label: "Glow Radius";
            value: root.halo_radius_ratio;
            min_val: 1.1;
            max_val: 4.5;
            display_text: "" + (Math.round(root.halo_radius_ratio * 100) / 100) + "x";
            value_changed(val) => { root.set_radius_ratio(val); }
        }
    }

    // Dim Non-Matching Atoms Checkbox
    TouchArea {
        height: 18px;
        mouse-cursor: pointer;
        clicked => { root.set_dim_non_matching(!root.dim_non_matching); }

        HorizontalLayout {
            spacing: 6px;
            alignment: start;

            Rectangle {
                width: 14px;
                height: 14px;
                y: (parent.height - self.height) / 2;
                border-radius: 3px;
                background: root.dim_non_matching ? MaterialPalette.primary : transparent;
                border-width: 1.5px;
                border-color: root.dim_non_matching ? MaterialPalette.primary : MaterialPalette.outline;

                if (root.dim_non_matching): MaterialText {
                    width: 100%;
                    height: 100%;
                    text: "✓";
                    font-size: 10px;
                    font-weight: 700;
                    color: MaterialPalette.on_primary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            MaterialText {
                text: "Dim non-matching core atoms";
                font-size: 11.5px;
                color: MaterialPalette.on_surface;
                vertical-alignment: center;
            }
        }
    }

    // Hide Non-Matching Atoms Checkbox
    TouchArea {
        height: 18px;
        mouse-cursor: pointer;
        clicked => { root.set_hide_non_matching(!root.hide_non_matching); }

        HorizontalLayout {
            spacing: 6px;
            alignment: start;

            Rectangle {
                width: 14px;
                height: 14px;
                y: (parent.height - self.height) / 2;
                border-radius: 3px;
                background: root.hide_non_matching ? MaterialPalette.primary : transparent;
                border-width: 1.5px;
                border-color: root.hide_non_matching ? MaterialPalette.primary : MaterialPalette.outline;

                if (root.hide_non_matching): MaterialText {
                    width: 100%;
                    height: 100%;
                    text: "✓";
                    font-size: 10px;
                    font-weight: 700;
                    color: MaterialPalette.on_primary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            MaterialText {
                text: "Hide non-matching core atoms";
                font-size: 11.5px;
                color: MaterialPalette.on_surface;
                vertical-alignment: center;
            }
        }
    }
}
