import {
    MaterialPalette,
    MaterialStyleMetrics,
    FilledCard,
    MaterialText,
    MenuItem,
    Vertical,
    FilledButton,
    Horizontal,
} from "../../material/material.slint";
import { TableRow, CurveToggleItem, CalibrationPair } from "../../Types.slint";
import { WorkflowStepper } from "./components/WorkflowStepper.slint";
import { PreviewHeader } from "./components/PreviewHeader.slint";
import { HeroEmptyState } from "./components/HeroEmptyState.slint";
import { PlotReticleOverlay } from "./components/PlotReticleOverlay.slint";
import { CutoffCalibrationOverlay } from "./components/CutoffCalibrationOverlay.slint";
import { CutoffCalibrationBar } from "./components/CutoffCalibrationBar.slint";
import { ImagingToolbar } from "./components/ImagingToolbar.slint";
import { CurveSidebar } from "./components/CurveSidebar.slint";
import { PlotDataTable } from "./components/PlotDataTable.slint";
import { Structure3DViewport } from "./components/Structure3DViewport.slint";

// ============================================================================
// PreviewCard Component
// ============================================================================
/// Displays preview plot and dataset inspection views for computed distribution
/// functions. Coordinated through focused subcomponents under components/.
// ============================================================================
export component PreviewCard inherits FilledCard {
    in property <bool> enabled: true;
    in property <bool> analysis_done: false;
    in property <image> preview_plot;
    in property <[MenuItem]> plot_items: [];
    in property <[CurveToggleItem]> curve_toggle_items: [];
    in-out property <int> selected_plot_index: -1;
    in property <int> pinned_runs_count: 0;
    in-out property <length> sidebar_width: 180px;

    in property <string> hover_coord_text: "";
    in property <bool> has_active_zoom: false;
    in property <int> markers_count: 0;
    property <int> active_tool: 0; // 0: None, 1: Zoom Box, 2: +X Marker, 3: +Y Marker, 4: Zoom Out
    property <bool> is_selecting: false;
    property <length> drag_start_x: 0px;
    property <length> drag_start_y: 0px;
    property <length> drag_current_x: 0px;
    property <length> drag_current_y: 0px;
    property <bool> is_panning: false;
    property <length> pan_last_x: 0px;
    property <length> pan_last_y: 0px;

    // Table data
    in property <[string]> table_headers: [];
    in property <[TableRow]> table_rows: [];

    in-out property <int> active_tab: 0;
    property <int> active_color_picker_id: -1;

    changed file_loaded => {
        if (root.file_loaded && !root.analysis_done) {
            root.active_tab = 2;
        }
    }

    // Workflow properties & callbacks
    in property <bool> file_loaded: false;
    in property <bool> analysis_running: false;
    in property <string> file_basename: "";
    in property <string> total_atoms: "";
    in property <string> num_frames: "";

    callback plot_selected(int);
    callback write_files();
    callback pin_run();
    callback clear_pinned_runs();
    callback toggle_curve_visibility(int, bool);
    callback toggle_all_curves(bool);
    callback set_curve_color(int, string);
    callback mouse_move(length, length, bool, length, length);
    callback plot_resized(length, length);
    callback zoom_to_rect(float, float, float, float);
    callback plot_pan(float, float);
    callback plot_wheel_zoom(float, float, float);
    callback reset_zoom();
    callback add_marker_at(float, float, bool);
    callback add_marker(bool);
    callback clear_markers();
    callback browse_file();
    callback run_analysis();
    callback open_panel(int);

    // Cutoff Calibration properties & callbacks
    in property <[CalibrationPair]> calibration_pairs: [];
    in-out property <int> active_calibration_pair_index: 0;
    callback select_calibration_pair(int);
    callback auto_detect_cutoff(int);
    callback reset_calibration_pair(int);
    callback drag_cutoff_handle(int, bool, length);

    // 3D Viewport properties & callbacks
    in property <image> structure_3d_image;
    in-out property <int> structure_3d_current_frame: 0;
    in property <int> structure_3d_total_frames: 0;
    in property <bool> structure_3d_bonds_enabled: true;
    in property <bool> structure_3d_wireframe_enabled: true;
    in property <bool> structure_3d_in_cell: false;

    // Phase Search properties & callbacks
    in-out property <bool> structure_3d_phase_panel_open: false;
    in property <bool> structure_3d_phase_enabled: false;
    in property <int> structure_3d_phase_preset: 0;
    in property <int> structure_3d_phase_descriptor: 0;
    in property <int> structure_3d_phase_colormap: 0;
    in property <float> structure_3d_phase_min_threshold: 0.46;
    in property <float> structure_3d_phase_max_threshold: 0.58;
    in property <float> structure_3d_phase_domain_min: 0.0;
    in property <float> structure_3d_phase_domain_max: 1.0;
    in property <float> structure_3d_phase_halo_intensity: 0.85;
    in property <float> structure_3d_phase_halo_radius_ratio: 1.35;
    in property <bool> structure_3d_phase_dim_non_matching: false;
    in property <[float]> structure_3d_phase_histogram_counts: [];
    in property <int> structure_3d_phase_matching_atoms: 0;
    in property <int> structure_3d_phase_total_atoms: 0;
    in property <string> structure_3d_phase_descriptor_name: "q̄₆";
    in property <image> structure_3d_phase_colorbar_image;

    callback toggle_phase_search_3d(bool);
    callback set_phase_preset_3d(int);
    callback set_phase_descriptor_3d(int);
    callback set_phase_colormap_3d(int);
    callback set_phase_thresholds_3d(float, float);
    callback set_phase_intensity_3d(float);
    callback set_phase_radius_ratio_3d(float);
    callback set_phase_dim_non_matching_3d(bool);

    callback rotate_3d(float, float);
    callback pan_3d(float, float);
    callback zoom_3d(float);
    callback reset_view_3d();
    callback toggle_bonds_3d(bool);
    callback toggle_wireframe_3d(bool);
    callback toggle_in_cell_3d(bool);
    callback seek_frame_3d(int);
    callback step_frame_3d(bool);
    callback viewport_3d_resized(length, length);
    callback tab_changed(int);

    changed active_tab => { root.tab_changed(root.active_tab); }

    // Hover state for tooltip (aggregated from child components)
    out property <string> hovered_tooltip_text:
        (root.active_tool == 5 && calibration_bar.hovered_tooltip_text != "") ? calibration_bar.hovered_tooltip_text :
        imaging_toolbar.tooltip_text != "" ? imaging_toolbar.tooltip_text :
        curve_sidebar.tooltip_text != "" ? curve_sidebar.tooltip_text :
        preview_header.tooltip_text != "" ? preview_header.tooltip_text :
        (root.pinned_runs_count > 0 && clear_pinned_area.has-hover) ? "Remove all pinned runs from the comparison overlay." :
        save_results_area.has-hover ? "Export analysis results to files in the selected formats (CSV, HDF5, Parquet, SVG).\n\n💡 Tip: Results are written to the output destination directory." : "";

    out property <length> hovered_x:
        (root.active_tool == 5 && calibration_bar.hovered_tooltip_text != "") ? calibration_bar.hovered_x :
        imaging_toolbar.tooltip_text != "" ? imaging_toolbar.tooltip_x :
        curve_sidebar.tooltip_text != "" ? curve_sidebar.tooltip_x :
        preview_header.tooltip_text != "" ? preview_header.tooltip_x :
        (root.pinned_runs_count > 0 && clear_pinned_area.has-hover) ? clear_pinned_area.absolute-position.x + clear_pinned_area.mouse-x :
        save_results_area.has-hover ? save_results_area.absolute-position.x + save_results_area.mouse-x : 0px;

    out property <length> hovered_y:
        (root.active_tool == 5 && calibration_bar.hovered_tooltip_text != "") ? calibration_bar.hovered_y :
        imaging_toolbar.tooltip_text != "" ? imaging_toolbar.tooltip_y :
        curve_sidebar.tooltip_text != "" ? curve_sidebar.tooltip_y :
        preview_header.tooltip_text != "" ? preview_header.tooltip_y :
        (root.pinned_runs_count > 0 && clear_pinned_area.has-hover) ? clear_pinned_area.absolute-position.y + clear_pinned_area.mouse-y :
        save_results_area.has-hover ? save_results_area.absolute-position.y + save_results_area.mouse-y : 0px;

    out property <length> hovered_width: 0px;
    out property <length> hovered_height: 0px;

    Vertical {
        width: 100%;
        height: 100%;
        spacing: MaterialStyleMetrics.spacing_8;

        // 1. Workflow Stepper
        WorkflowStepper {
            width: 100%;
            height: 28px;
            file_loaded: root.file_loaded;
            analysis_running: root.analysis_running;
            analysis_done: root.analysis_done;
            browse_file => { root.browse_file(); }
            open_panel(idx) => { root.open_panel(idx); }
            run_analysis => { root.run_analysis(); }
        }

        // 2. Header: Plot dropdown and Tabs
        preview_header := PreviewHeader {
            plot_items: root.plot_items;
            selected_plot_index <=> root.selected_plot_index;
            active_tab <=> root.active_tab;
            plot_selected(idx) => { root.plot_selected(idx); }
        }

        // 3. Pinned Runs Info
        Horizontal {
            visible: root.pinned_runs_count > 0;
            height: root.pinned_runs_count > 0 ? MaterialStyleMetrics.size_40 : 0px;
            spacing: MaterialStyleMetrics.spacing_8;

            MaterialText {
                text: "Comparing with " + root.pinned_runs_count + " pinned run(s)";
                color: MaterialPalette.on_surface_variant;
                vertical-alignment: center;
            }

            clear_pinned_area := TouchArea {
                width: 120px;
                height: 100%;
                FilledButton {
                    width: 100%;
                    height: 100%;
                    text: "Clear Pinned";
                    clicked => { root.clear_pinned_runs(); }
                }
            }
        }

        // 4. Body: Tab Host Container (occupies 100% of remaining vertical card height)
        tab_host := Rectangle {
            vertical-stretch: 1;
            horizontal-stretch: 1;
            clip: true;

            // Tab 0: 2D Plot View
            tab_plot := HorizontalLayout {
                width: 100%;
                height: 100%;
                visible: root.active_tab == 0;
                spacing: MaterialStyleMetrics.spacing_8;

                // SVG Plot Area
                plot_container := Rectangle {
                    horizontal-stretch: 1;
                    vertical-stretch: 1;
                    min-height: 120px;
                    background: MaterialPalette.surface;
                    border-radius: MaterialStyleMetrics.border_radius_2;
                    clip: self.width > 1px && self.height > 1px;
                    visible: self.width > 0.1px && self.height > 0.1px;

                    changed width => {
                        if (self.width > 10px && self.height > 10px) {
                            root.plot_resized(self.width, self.height);
                        }
                    }
                    changed height => {
                        if (self.width > 10px && self.height > 10px) {
                            root.plot_resized(self.width, self.height);
                        }
                    }

                    HeroEmptyState {
                        x: 0px;
                        y: 0px;
                        width: 100%;
                        height: 100%;
                        visible: !root.analysis_done || root.selected_plot_index < 0;
                        file_loaded: root.file_loaded;
                        analysis_running: root.analysis_running;
                        analysis_done: root.analysis_done;
                        selected_plot_index: root.selected_plot_index;
                        file_basename: root.file_basename;
                        total_atoms: root.total_atoms;
                        num_frames: root.num_frames;
                        browse_file => { root.browse_file(); }
                        run_analysis => { root.run_analysis(); }
                        open_panel(idx) => { root.open_panel(idx); }
                    }

                    // Interactive Rendered Plot
                    plot_touch := TouchArea {
                        x: 0px;
                        y: 0px;
                        width: 100%;
                        height: 100%;
                        visible: root.selected_plot_index >= 0;
                        mouse-cursor: root.is_panning ? grabbing : (root.active_tool != 0 ? crosshair : default);

                        scroll-event(event) => {
                            root.plot_wheel_zoom(self.mouse-x / 1px, self.mouse-y / 1px, event.delta-y / 1px);
                            accept
                        }

                        pointer-event(event) => {
                            if (event.kind == PointerEventKind.down) {
                                if (event.button == PointerEventButton.right || event.button == PointerEventButton.middle) {
                                    if (root.active_tool != 0) {
                                        root.active_tool = 0;
                                    } else {
                                        root.is_panning = true;
                                        root.pan_last_x = self.mouse-x;
                                        root.pan_last_y = self.mouse-y;
                                    }
                                } else if (event.button == PointerEventButton.left) {
                                    if (root.active_tool == 2) {
                                        root.add_marker_at(self.mouse-x / 1px, self.mouse-y / 1px, true);
                                    } else if (root.active_tool == 3) {
                                        root.add_marker_at(self.mouse-x / 1px, self.mouse-y / 1px, false);
                                    } else if (root.active_tool == 1) {
                                        root.drag_start_x = self.mouse-x;
                                        root.drag_start_y = self.mouse-y;
                                        root.drag_current_x = self.mouse-x;
                                        root.drag_current_y = self.mouse-y;
                                        root.is_selecting = true;
                                    } else if (root.active_tool == 4) {
                                        root.plot_wheel_zoom(self.mouse-x / 1px, self.mouse-y / 1px, -1.0);
                                    }
                                }
                            } else if (event.kind == PointerEventKind.up) {
                                if (event.button == PointerEventButton.right || event.button == PointerEventButton.middle) {
                                    root.is_panning = false;
                                }
                                if (root.is_selecting) {
                                    root.is_selecting = false;
                                    root.zoom_to_rect(root.drag_start_x / 1px, root.drag_start_y / 1px, root.drag_current_x / 1px, root.drag_current_y / 1px);
                                }
                            } else if (event.kind == PointerEventKind.cancel) {
                                root.is_selecting = false;
                                root.is_panning = false;
                            } else if (event.kind == PointerEventKind.move) {
                                if (!root.is_panning && !root.is_selecting) {
                                    root.mouse_move(self.mouse-x, self.mouse-y, self.has-hover, self.width, self.height);
                                }
                            }
                        }

                        changed has-hover => {
                            if (!self.has-hover) {
                                root.is_selecting = false;
                                root.is_panning = false;
                            }
                            root.mouse_move(self.mouse-x, self.mouse-y, self.has-hover, self.width, self.height);
                        }

                        changed mouse-x => {
                            if (!root.is_panning && !root.is_selecting && self.has-hover) {
                                root.mouse_move(self.mouse-x, self.mouse-y, self.has-hover, self.width, self.height);
                            }
                        }

                        changed mouse-y => {
                            if (!root.is_panning && !root.is_selecting && self.has-hover) {
                                root.mouse_move(self.mouse-x, self.mouse-y, self.has-hover, self.width, self.height);
                            }
                        }

                        moved => {
                            if (root.is_panning) {
                                let delta_x = (self.mouse-x - root.pan_last_x) / 1px;
                                let delta_y = (self.mouse-y - root.pan_last_y) / 1px;
                                root.pan_last_x = self.mouse-x;
                                root.pan_last_y = self.mouse-y;
                                if (delta_x != 0 || delta_y != 0) {
                                    root.plot_pan(delta_x, delta_y);
                                }
                            }
                            if (root.is_selecting) {
                                root.drag_current_x = self.mouse-x;
                                root.drag_current_y = self.mouse-y;
                            }
                            root.mouse_move(self.mouse-x, self.mouse-y, self.has-hover, self.width, self.height);
                        }

                        Image {
                            width: 100%;
                            height: 100%;
                            source: root.preview_plot;
                            image-fit: contain;
                        }
                    }

                    // Hover Crosshairs, Reticle, and Mode Badge Overlay
                    PlotReticleOverlay {
                        x: 0px;
                        y: 0px;
                        width: 100%;
                        height: 100%;
                        has_hover: plot_touch.has-hover;
                        mouse_x: plot_touch.mouse-x;
                        mouse_y: plot_touch.mouse-y;
                        selected_plot_index: root.selected_plot_index;
                        active_tool: root.active_tool;
                        is_selecting: root.is_selecting;
                        is_panning: root.is_panning;
                        drag_start_x: root.drag_start_x;
                        drag_start_y: root.drag_start_y;
                        drag_current_x: root.drag_current_x;
                        drag_current_y: root.drag_current_y;
                    }

                    // Cutoff Calibration Overlay (Handles, Shaded Region, and Onset Indicators)
                    calibration_overlay := CutoffCalibrationOverlay {
                        x: 0px;
                        y: 0px;
                        width: 100%;
                        height: 100%;
                        active: root.active_tool == 5;
                        pair: root.calibration_pairs[root.active_calibration_pair_index];
                        drag_min(mx) => { root.drag_cutoff_handle(root.active_calibration_pair_index, false, mx); }
                        drag_max(mx) => { root.drag_cutoff_handle(root.active_calibration_pair_index, true, mx); }
                    }

                    // Floating Cutoff Calibration Wizard Bar (when Tool 5 is active)
                    calibration_bar := CutoffCalibrationBar {
                        visible: root.active_tool == 5 && root.selected_plot_index >= 0;
                        x: parent.width - self.preferred-width - 12px;
                        y: 10px;
                        pairs: root.calibration_pairs;
                        active_pair_index <=> root.active_calibration_pair_index;
                        select_pair(idx) => { root.select_calibration_pair(idx); }
                        auto_detect(idx) => { root.auto_detect_cutoff(idx); }
                        reset_pair(idx) => { root.reset_calibration_pair(idx); }
                        close => { root.active_tool = 0; }
                    }

                    // Floating Imaging Toolbar
                    imaging_toolbar := ImagingToolbar {
                        visible: root.selected_plot_index >= 0;
                        x: 12px;
                        y: 12px;
                        has_active_zoom: root.has_active_zoom;
                        active_tool <=> root.active_tool;
                        markers_count: root.markers_count;
                        hover_coord_text: root.hover_coord_text;
                        reset_zoom => { root.reset_zoom(); }
                        clear_markers => { root.clear_markers(); }
                    }
                }

                // Curve Visibility Sidebar
                curve_sidebar := CurveSidebar {
                    curve_toggle_items: root.curve_toggle_items;
                    sidebar_width <=> root.sidebar_width;
                    active_color_picker_id <=> root.active_color_picker_id;
                    toggle_curve_visibility(id, v) => { root.toggle_curve_visibility(id, v); }
                    toggle_all_curves(v) => { root.toggle_all_curves(v); }
                    set_curve_color(id, c) => { root.set_curve_color(id, c); }
                }
            }

            // Tab 1: Dataset Values Table View
            tab_table := PlotDataTable {
                width: 100%;
                height: 100%;
                visible: root.active_tab == 1;
                table_headers: root.table_headers;
                table_rows: root.table_rows;
            }

            // Tab 2: 3D Molecular Structure Viewport
            tab_structure := Structure3DViewport {
                width: 100%;
                height: 100%;
                visible: root.active_tab == 2;
                structure_3d_image: root.structure_3d_image;
                current_frame <=> root.structure_3d_current_frame;
                total_frames: root.structure_3d_total_frames;
                bonds_enabled: root.structure_3d_bonds_enabled;
                wireframe_enabled: root.structure_3d_wireframe_enabled;
                in_cell_enabled: root.structure_3d_in_cell;
                file_loaded: root.file_loaded;
                analysis_running: root.analysis_running;
                analysis_done: root.analysis_done;
                file_basename: root.file_basename;
                total_atoms: root.total_atoms;
                num_frames: root.num_frames;
                run_analysis => { root.run_analysis(); }
                open_panel(idx) => { root.open_panel(idx); }
                browse_file => { root.browse_file(); }
                rotate_3d(dx, dy) => { root.rotate_3d(dx, dy); }
                pan_3d(dx, dy) => { root.pan_3d(dx, dy); }
                zoom_3d(delta) => { root.zoom_3d(delta); }
                reset_view => { root.reset_view_3d(); }
                toggle_bonds(enabled) => { root.toggle_bonds_3d(enabled); }
                toggle_wireframe(enabled) => { root.toggle_wireframe_3d(enabled); }
                toggle_in_cell(enabled) => { root.toggle_in_cell_3d(enabled); }
                seek_frame(idx) => { root.seek_frame_3d(idx); }
                step_frame(fwd) => { root.step_frame_3d(fwd); }
                resized(w, h) => { root.viewport_3d_resized(w, h); }

                phase_panel_open <=> root.structure_3d_phase_panel_open;
                phase_enabled: root.structure_3d_phase_enabled;
                phase_preset: root.structure_3d_phase_preset;
                phase_descriptor: root.structure_3d_phase_descriptor;
                phase_colormap: root.structure_3d_phase_colormap;
                phase_min_threshold: root.structure_3d_phase_min_threshold;
                phase_max_threshold: root.structure_3d_phase_max_threshold;
                phase_domain_min: root.structure_3d_phase_domain_min;
                phase_domain_max: root.structure_3d_phase_domain_max;
                phase_halo_intensity: root.structure_3d_phase_halo_intensity;
                phase_halo_radius_ratio: root.structure_3d_phase_halo_radius_ratio;
                phase_dim_non_matching: root.structure_3d_phase_dim_non_matching;
                phase_histogram_counts: root.structure_3d_phase_histogram_counts;
                phase_matching_atoms: root.structure_3d_phase_matching_atoms;
                phase_total_atoms: root.structure_3d_phase_total_atoms;
                phase_descriptor_name: root.structure_3d_phase_descriptor_name;
                phase_colorbar_image: root.structure_3d_phase_colorbar_image;

                toggle_phase_search(en) => { root.toggle_phase_search_3d(en); }
                set_phase_preset(idx) => { root.set_phase_preset_3d(idx); }
                set_phase_descriptor(idx) => { root.set_phase_descriptor_3d(idx); }
                set_phase_colormap(idx) => { root.set_phase_colormap_3d(idx); }
                set_phase_thresholds(min, max) => { root.set_phase_thresholds_3d(min, max); }
                set_phase_intensity(val) => { root.set_phase_intensity_3d(val); }
                set_phase_radius_ratio(val) => { root.set_phase_radius_ratio_3d(val); }
                set_phase_dim_non_matching(dim) => { root.set_phase_dim_non_matching_3d(dim); }
            }
        }

        // 5. Footer: Save Results
        Horizontal {
            height: MaterialStyleMetrics.size_40;
            save_results_area := TouchArea {
                accessible-role: button;
                accessible-label: "Save Analysis Results";
                height: 100%;
                horizontal-stretch: 1;
                FilledButton {
                    width: 100%;
                    height: 100%;
                    text: "Save Results";
                    enabled: root.analysis_done;
                    background: MaterialPalette.primary;
                    text_color: MaterialPalette.on_primary;
                    clicked => { root.write_files(); }
                }
            }
        }
    }
}
