import {
    MaterialPalette,
    MaterialStyleMetrics,
    FilledCard,
    MaterialText,
    MenuItem,
    Vertical,
    FilledButton,
    Horizontal,
    SplitterHandle,
} from "../../material/material.slint";
import { TableRow, CurveToggleItem, CalibrationPair, PlotAxisSettings, TaggedPeakRecord, ExportConfig } from "../../Types.slint";
import { WorkflowStepper } from "./components/WorkflowStepper.slint";
import { PreviewHeader } from "./components/PreviewHeader.slint";
import { Plot2DViewport } from "./components/Plot2DViewport.slint";
import { PlotDataTable } from "./components/PlotDataTable.slint";
import { Structure3DViewport } from "./components/Structure3DViewport.slint";
import { PhaseHeatmapView, CrystalMarker } from "./components/PhaseHeatmapView.slint";
import { TabItem } from "../../material/ui/components/tab_item.slint";

export { CrystalMarker }

// ============================================================================
// PreviewCard Component
// ============================================================================
/// Displays preview plot and dataset inspection views for computed distribution
/// functions. Coordinated through focused subcomponents under components/.
// ============================================================================
export component PreviewCard inherits FilledCard {
    in property <bool> enabled: true;
    in property <bool> analysis_done: false;
    in property <image> preview_plot;
    in property <[MenuItem]> plot_items: [];
    in property <[CurveToggleItem]> curve_toggle_items: [];
    in-out property <int> selected_plot_index: -1;
    in property <int> pinned_runs_count: 0;
    in-out property <int> inspector_scope: 0;
    callback toggle_plot_settings();

    in property <string> hover_coord_text: "";
    in property <bool> has_active_zoom: false;
    in property <int> markers_count: 0;
    property <int> active_tool: 0; // 0: None, 1: Zoom Box, 2: +X Marker, 3: +Y Marker, 4: Zoom Out

    // Table data
    in property <[string]> table_headers: [];
    in property <[TableRow]> table_rows: [];

    in-out property <int> active_tab: 0;
    in-out property <float> dual_split_ratio: 0.5;
    in-out property <int> dual_left_view: 0; // 0: g(r), 1: S(Q), 2: PAD, 3: XRD, 4: 2D Phase Heatmap
    callback select_dual_left_plot(int);
    property <int> active_color_picker_id: -1;

    changed file_loaded => {
        if (root.file_loaded && !root.analysis_done) {
            root.active_tab = 1;
        }
    }

    // Workflow properties & callbacks
    in property <bool> file_loaded: false;
    in property <bool> analysis_running: false;
    in property <bool> has_validation_errors: false;
    in property <string> file_basename: "";
    in property <string> total_atoms: "";
    in property <string> num_frames: "";

    callback plot_selected(int);
    callback write_files();
    callback pin_run();
    callback clear_pinned_runs();
    callback toggle_curve_visibility(int, bool);
    callback toggle_all_curves(bool);
    callback filter_curves(string);
    callback invert_curves();
    callback set_curve_color(int, string);
    callback mouse_move(length, length, bool, length, length);
    callback plot_resized(length, length);
    callback zoom_to_rect(float, float, float, float);
    callback plot_pan(float, float);
    callback plot_wheel_zoom(float, float, float);
    callback reset_zoom();
    callback add_marker_at(float, float, bool);
    callback add_marker(bool);
    callback clear_markers();
    callback browse_file();
    callback load_sample(string);
    callback load_recent(string);
    in property <[string]> recent_files: [];
    callback run_analysis();
    callback cancel_analysis();
    callback open_panel(int);
    callback copy_plot_clipboard();
    callback export_plot();
    in-out property <[TaggedPeakRecord]> tagged_peaks: [];
    callback tag_peak_at(float, float);
    callback tag_peak_range(float, float);
    callback remove_tagged_peak(int);
    callback clear_tagged_peaks();
    callback export_tagged_peaks();

    // Plot Viewport Settings properties & callbacks
    in-out property <bool> plot_settings_open: false;
    in-out property <bool> plot_sidebar_collapsed: false;
    in-out property <PlotAxisSettings> axis_settings;
    in-out property <ExportConfig> export_config;
    in-out property <int> selected_curve_id: 0;
    callback apply_axis_settings();
    callback reset_axis_settings();
    callback reset_export_settings();
    callback set_curve_width(string);

    // Cutoff Calibration properties & callbacks
    in property <[CalibrationPair]> calibration_pairs: [];
    in-out property <int> active_calibration_pair_index: 0;
    callback select_calibration_pair(int);
    callback auto_detect_cutoff(int);
    callback reset_calibration_pair(int);
    callback drag_cutoff_handle(int, bool, length);

    // 3D Viewport properties & callbacks
    in property <image> structure_3d_image;
    in-out property <int> structure_3d_current_frame: 0;
    in property <int> structure_3d_total_frames: 0;
    in property <bool> structure_3d_bonds_enabled: true;
    in property <bool> structure_3d_wireframe_enabled: true;
    in property <bool> structure_3d_in_cell: false;
    in-out property <bool> structure_3d_is_playing: false;
    in property <string> structure_3d_backend_label: "";
    in property <bool> structure_3d_gpu_accelerated: false;

    // Phase Search properties & callbacks
    in-out property <bool> structure_3d_phase_panel_open: false;
    in property <bool> structure_3d_phase_enabled: false;
    in property <int> structure_3d_phase_preset: 0;
    in property <int> structure_3d_phase_descriptor: 0;
    in property <int> structure_3d_phase_colormap: 0;
    in property <float> structure_3d_phase_min_threshold: 0.46;
    in property <float> structure_3d_phase_max_threshold: 0.58;
    in property <float> structure_3d_phase_domain_min: 0.0;
    in property <float> structure_3d_phase_domain_max: 1.0;
    in property <float> structure_3d_phase_halo_intensity: 0.85;
    in property <float> structure_3d_phase_halo_radius_ratio: 1.35;
    in property <float> structure_3d_atom_scale: 0.35;
    in property <bool> structure_3d_phase_dim_non_matching: false;
    in property <bool> structure_3d_phase_hide_non_matching: false;
    in property <[float]> structure_3d_phase_histogram_counts: [];
    in property <int> structure_3d_phase_matching_atoms: 0;
    in property <int> structure_3d_phase_total_atoms: 0;
    in property <string> structure_3d_phase_descriptor_name: "q̄₆";
    in property <image> structure_3d_phase_colorbar_image;

    // 2D Phase Search & Heatmap
    in property <bool> structure_3d_phase_is_2d_mode: false;
    in property <int> structure_3d_phase_descriptor_y: 0;
    in property <float> structure_3d_phase_min_threshold_y: 0.46;
    in property <float> structure_3d_phase_max_threshold_y: 0.58;
    in property <float> structure_3d_phase_domain_min_y: 0.0;
    in property <float> structure_3d_phase_domain_max_y: 1.0;
    in property <string> structure_3d_phase_descriptor_name_y: "q̄₆";
    in property <image> structure_3d_phase_heatmap_image;
    in property <[CrystalMarker]> structure_3d_phase_crystal_markers: [];

    // Distribution Mini-Graph HUD
    in property <bool> structure_3d_dist_hud_visible: true;
    in property <bool> structure_3d_dist_has_data: false;
    in property <image> structure_3d_dist_image;
    in property <int> structure_3d_dist_metric: 0;
    in property <string> structure_3d_dist_peak_text: "";

    callback set_structure_3d_dist_metric(int);
    callback toggle_structure_3d_dist_hud(bool);

    callback toggle_phase_search_3d(bool);
    callback toggle_phase_panel_3d();
    callback set_phase_preset_3d(int);
    callback set_phase_descriptor_3d(int);
    callback set_phase_colormap_3d(int);
    callback set_phase_thresholds_3d(float, float);
    callback set_phase_intensity_3d(float);
    callback set_phase_radius_ratio_3d(float);
    callback set_atom_scale_3d(float);
    callback set_phase_dim_non_matching_3d(bool);
    callback set_phase_hide_non_matching_3d(bool);

    callback set_phase_2d_mode_3d(bool);
    callback set_phase_descriptor_y_3d(int);
    callback set_phase_thresholds_2d_3d(float, float, float, float);
    callback export_phase_heatmap_png_3d();

    callback rotate_3d(float, float);
    callback pan_3d(float, float);
    callback zoom_3d(float);
    callback reset_view_3d();
    callback set_camera_preset_3d(int);
    callback toggle_bonds_3d(bool);
    callback toggle_wireframe_3d(bool);
    callback toggle_in_cell_3d(bool);
    callback seek_frame_3d(int);
    callback step_frame_3d(bool);
    callback viewport_3d_resized(length, length);
    callback tab_changed(int);

    changed active_tab => { root.tab_changed(root.active_tab); }

    // Hover state for tooltip (aggregated from child components)
    out property <string> hovered_tooltip_text:
        plot_2d.hovered_tooltip_text != "" ? plot_2d.hovered_tooltip_text :
        preview_header.tooltip_text != "" ? preview_header.tooltip_text :
        (root.pinned_runs_count > 0 && clear_pinned_area.has-hover) ? "Remove all pinned runs from the comparison overlay." : "";

    out property <length> hovered_x:
        plot_2d.hovered_tooltip_text != "" ? plot_2d.hovered_x :
        preview_header.tooltip_text != "" ? preview_header.tooltip_x :
        (root.pinned_runs_count > 0 && clear_pinned_area.has-hover) ? clear_pinned_area.absolute-position.x + clear_pinned_area.mouse-x : 0px;

    out property <length> hovered_y:
        plot_2d.hovered_tooltip_text != "" ? plot_2d.hovered_y :
        preview_header.tooltip_text != "" ? preview_header.tooltip_y :
        (root.pinned_runs_count > 0 && clear_pinned_area.has-hover) ? clear_pinned_area.absolute-position.y + clear_pinned_area.mouse-y : 0px;

    out property <length> hovered_width: 0px;
    out property <length> hovered_height: 0px;

    Vertical {
        width: 100%;
        height: 100%;
        spacing: MaterialStyleMetrics.spacing_8;

        // 1. Workflow Stepper
        WorkflowStepper {
            width: 100%;
            height: 28px;
            file_loaded: root.file_loaded;
            analysis_running: root.analysis_running;
            analysis_done: root.analysis_done;
            browse_file => { root.browse_file(); }
            open_panel(idx) => { root.open_panel(idx); }
            run_analysis => { root.run_analysis(); }
            cancel_analysis => { root.cancel_analysis(); }
        }

        // 2. Header: Plot dropdown and Tabs
        preview_header := PreviewHeader {
            plot_items: root.plot_items;
            selected_plot_index <=> root.selected_plot_index;
            active_tab <=> root.active_tab;
            dual_scope <=> root.inspector_scope;
            plot_selected(idx) => { root.plot_selected(idx); }
        }

        // 3. Pinned Runs Info
        Horizontal {
            visible: root.pinned_runs_count > 0;
            height: root.pinned_runs_count > 0 ? MaterialStyleMetrics.size_40 : 0px;
            spacing: MaterialStyleMetrics.spacing_8;

            MaterialText {
                text: "Comparing with " + root.pinned_runs_count + " pinned run(s)";
                color: MaterialPalette.on_surface_variant;
                vertical-alignment: center;
            }

            clear_pinned_area := TouchArea {
                width: 120px;
                height: 100%;
                FilledButton {
                    width: 100%;
                    height: 100%;
                    text: "Clear Pinned";
                    clicked => { root.clear_pinned_runs(); }
                }
            }
        }

        // 4. Body: Tab Viewports (occupies 100% of remaining vertical card height)
        tab_host := Rectangle {
            width: 100%;
            vertical-stretch: 1;
            horizontal-stretch: 1;
            clip: true;

            property <length> dual_plot_width: (parent.width > 340px)
                ? Math.max(160px, Math.min(parent.width - 160px, parent.width * root.dual_split_ratio - 3px))
                : parent.width * 0.5;

            // Tab 0 (2D Plot) & Tab 2 (Dual View Left Pane)
            tab_plot := Rectangle {
                x: 0px;
                y: 0px;
                width: root.active_tab == 2 ? parent.dual_plot_width : parent.width;
                height: 100%;
                visible: root.active_tab == 0 || root.active_tab == 2;

                VerticalLayout {
                    spacing: 0px;
                    padding: 0px;

                    // Unified View Selector Bar for Dual View mode
                    if (root.active_tab == 2): Rectangle {
                        height: 38px;
                        background: MaterialPalette.surface_container;

                        HorizontalLayout {
                            alignment: start;
                            spacing: 8px;
                            padding-left: 8px;
                            padding-right: 8px;
                            padding-top: 5px;
                            padding-bottom: 5px;

                            Rectangle {
                                height: 28px;
                                background: MaterialPalette.surface_container_high;
                                border-radius: MaterialStyleMetrics.border_radius_8;
                                border-width: 1px;
                                border-color: MaterialPalette.outline_variant;
                                clip: true;

                                HorizontalLayout {
                                    spacing: 0px;

                                    TabItem {
                                        text: "g(r)";
                                        compact: true;
                                        active: root.dual_left_view == 0;
                                        clicked => {
                                            root.dual_left_view = 0;
                                            root.select_dual_left_plot(0);
                                        }
                                    }

                                    Rectangle { width: 1px; background: MaterialPalette.outline_variant; }

                                    TabItem {
                                        text: "S(Q)";
                                        compact: true;
                                        active: root.dual_left_view == 1;
                                        clicked => {
                                            root.dual_left_view = 1;
                                            root.select_dual_left_plot(1);
                                        }
                                    }

                                    Rectangle { width: 1px; background: MaterialPalette.outline_variant; }

                                    TabItem {
                                        text: "PAD";
                                        compact: true;
                                        active: root.dual_left_view == 2;
                                        clicked => {
                                            root.dual_left_view = 2;
                                            root.select_dual_left_plot(2);
                                        }
                                    }

                                    Rectangle { width: 1px; background: MaterialPalette.outline_variant; }

                                    TabItem {
                                        text: "XRD";
                                        compact: true;
                                        active: root.dual_left_view == 3;
                                        clicked => {
                                            root.dual_left_view = 3;
                                            root.select_dual_left_plot(3);
                                        }
                                    }

                                    Rectangle { width: 1px; background: MaterialPalette.outline_variant; }

                                    TabItem {
                                        text: "2D Heatmap";
                                        compact: true;
                                        active: root.dual_left_view == 4;
                                        clicked => {
                                            root.dual_left_view = 4;
                                            root.select_dual_left_plot(4);
                                        }
                                    }
                                }
                            }
                        }
                    }

                    if (root.active_tab == 2): Rectangle {
                        height: 1px;
                        background: MaterialPalette.outline_variant;
                    }

                    // Content View Host
                    Rectangle {
                        vertical-stretch: 1;

                        plot_2d := Plot2DViewport {
                            visible: root.active_tab != 2 || root.dual_left_view != 4;
                            width: 100%;
                            height: 100%;
                            file_loaded: root.file_loaded;
                            analysis_running: root.analysis_running;
                            analysis_done: root.analysis_done;
                            selected_plot_index: root.selected_plot_index;
                            preview_plot: root.preview_plot;
                            file_basename: root.file_basename;
                            total_atoms: root.total_atoms;
                            num_frames: root.num_frames;
                            recent_files: root.recent_files;
                            active_tab: root.active_tab;
                            inspector_scope <=> root.inspector_scope;
                            hover_coord_text: root.hover_coord_text;
                            has_active_zoom: root.has_active_zoom;
                            markers_count: root.markers_count;
                            plot_sidebar_collapsed: root.plot_sidebar_collapsed;
                            tagged_peaks <=> root.tagged_peaks;
                            calibration_pairs: root.calibration_pairs;
                            active_calibration_pair_index <=> root.active_calibration_pair_index;
                            active_tool <=> root.active_tool;
                            browse_file => { root.browse_file(); }
                            load_sample(s) => { root.load_sample(s); }
                            load_recent(r) => { root.load_recent(r); }
                            run_analysis => { root.run_analysis(); }
                            open_panel(idx) => { root.open_panel(idx); }
                            plot_resized(w, h) => { root.plot_resized(w, h); }
                            mouse_move(mx, my, hov, w, h) => { root.mouse_move(mx, my, hov, w, h); }
                            zoom_to_rect(x1, y1, x2, y2) => { root.zoom_to_rect(x1, y1, x2, y2); }
                            plot_pan(dx, dy) => { root.plot_pan(dx, dy); }
                            plot_wheel_zoom(mx, my, d) => { root.plot_wheel_zoom(mx, my, d); }
                            reset_zoom => { root.reset_zoom(); }
                            add_marker_at(mx, my, x_only) => { root.add_marker_at(mx, my, x_only); }
                            clear_markers => { root.clear_markers(); }
                            tag_peak_at(mx, my) => { root.tag_peak_at(mx, my); }
                            tag_peak_range(x1, x2) => { root.tag_peak_range(x1, x2); }
                            remove_tagged_peak(id) => { root.remove_tagged_peak(id); }
                            select_calibration_pair(idx) => { root.select_calibration_pair(idx); }
                            auto_detect_cutoff(idx) => { root.auto_detect_cutoff(idx); }
                            reset_calibration_pair(idx) => { root.reset_calibration_pair(idx); }
                            drag_cutoff_handle(idx, is_max, mx) => { root.drag_cutoff_handle(idx, is_max, mx); }
                            toggle_plot_settings => { root.toggle_plot_settings(); }
                            apply_axis_settings => { root.apply_axis_settings(); }
                            copy_plot_clipboard => { root.copy_plot_clipboard(); }
                            export_plot => { root.export_plot(); }
                        }

                        dual_heatmap := PhaseHeatmapView {
                            visible: root.active_tab == 2 && root.dual_left_view == 4;
                            width: 100%;
                            height: 100%;
                            heatmap_image: root.structure_3d_phase_heatmap_image;
                            descriptor_x: root.structure_3d_phase_descriptor;
                            descriptor_y: root.structure_3d_phase_descriptor_y;
                            descriptor_name_x: root.structure_3d_phase_descriptor_name;
                            descriptor_name_y: root.structure_3d_phase_descriptor_name_y;
                            min_x: root.structure_3d_phase_domain_min;
                            max_x: root.structure_3d_phase_domain_max;
                            min_y: root.structure_3d_phase_domain_min_y;
                            max_y: root.structure_3d_phase_domain_max_y;
                            sel_min_x: root.structure_3d_phase_min_threshold;
                            sel_max_x: root.structure_3d_phase_max_threshold;
                            sel_min_y: root.structure_3d_phase_min_threshold_y;
                            sel_max_y: root.structure_3d_phase_max_threshold_y;
                            matching_atoms: root.structure_3d_phase_matching_atoms;
                            total_atoms: root.structure_3d_phase_total_atoms;
                            crystal_markers: root.structure_3d_phase_crystal_markers;
                            set_descriptor_x(idx) => { root.set_phase_descriptor_3d(idx); }
                            set_descriptor_y(idx) => { root.set_phase_descriptor_y_3d(idx); }
                            set_selection_2d(min_x, max_x, min_y, max_y) => {
                                root.set_phase_thresholds_2d_3d(min_x, max_x, min_y, max_y);
                            }
                            export_png => { root.export_phase_heatmap_png_3d(); }
                            reset_selection => {
                                root.set_phase_thresholds_2d_3d(0.0, 1.0, 0.0, 1.0);
                            }
                        }
                    }
                }
            }

            // Splitter Handle between 2D Plot and 3D Viewport in Dual View (Tab 2)
            tab_splitter := SplitterHandle {
                x: tab_plot.width;
                y: 0px;
                width: 6px;
                height: 100%;
                visible: root.active_tab == 2;
                moved(delta) => {
                    if (parent.width > 0px) {
                        let proposed = (tab_plot.width + delta) / parent.width;
                        root.dual_split_ratio = Math.max(0.15, Math.min(0.85, proposed));
                    }
                }
                reset => {
                    root.dual_split_ratio = 0.5;
                }
            }

            // Tab 1 (3D View) & Tab 2 (Dual View Right Pane)
            tab_structure := Structure3DViewport {
                x: root.active_tab == 2 ? tab_plot.width + 6px : 0px;
                y: 0px;
                width: root.active_tab == 2 ? Math.max(0px, parent.width - tab_plot.width - 6px) : parent.width;
                height: 100%;
                visible: root.active_tab == 1 || root.active_tab == 2;
                structure_3d_image: root.structure_3d_image;
                current_frame <=> root.structure_3d_current_frame;
                total_frames: root.structure_3d_total_frames;
                bonds_enabled: root.structure_3d_bonds_enabled;
                wireframe_enabled: root.structure_3d_wireframe_enabled;
                in_cell_enabled: root.structure_3d_in_cell;
                is_playing <=> root.structure_3d_is_playing;
                backend_label: root.structure_3d_backend_label;
                gpu_accelerated: root.structure_3d_gpu_accelerated;
                file_loaded: root.file_loaded;
                analysis_running: root.analysis_running;
                has_validation_errors: root.has_validation_errors;
                analysis_done: root.analysis_done;
                file_basename: root.file_basename;
                total_atoms: root.total_atoms;
                num_frames: root.num_frames;
                recent_files: root.recent_files;
                clicked => {
                    if (root.active_tab == 2) {
                        root.inspector_scope = 1;
                    }
                }
                run_analysis => { root.run_analysis(); }
                cancel_analysis => { root.cancel_analysis(); }
                open_panel(idx) => { root.open_panel(idx); }
                browse_file => { root.browse_file(); }
                load_sample(s) => { root.load_sample(s); }
                load_recent(r) => { root.load_recent(r); }
                rotate_3d(dx, dy) => { root.rotate_3d(dx, dy); }
                pan_3d(dx, dy) => { root.pan_3d(dx, dy); }
                zoom_3d(delta) => { root.zoom_3d(delta); }
                reset_view => { root.reset_view_3d(); }
                set_camera_preset(p) => { root.set_camera_preset_3d(p); }
                toggle_bonds(enabled) => { root.toggle_bonds_3d(enabled); }
                toggle_wireframe(enabled) => { root.toggle_wireframe_3d(enabled); }
                toggle_in_cell(enabled) => { root.toggle_in_cell_3d(enabled); }
                toggle_phase_panel => { root.toggle_phase_panel_3d(); }
                seek_frame(idx) => { root.seek_frame_3d(idx); }
                step_frame(fwd) => { root.step_frame_3d(fwd); }
                resized(w, h) => { root.viewport_3d_resized(w, h); }

                phase_panel_open <=> root.structure_3d_phase_panel_open;
                phase_enabled: root.structure_3d_phase_enabled;
                phase_preset: root.structure_3d_phase_preset;
                phase_descriptor: root.structure_3d_phase_descriptor;
                phase_colormap: root.structure_3d_phase_colormap;
                phase_min_threshold: root.structure_3d_phase_min_threshold;
                phase_max_threshold: root.structure_3d_phase_max_threshold;
                phase_domain_min: root.structure_3d_phase_domain_min;
                phase_domain_max: root.structure_3d_phase_domain_max;
                phase_halo_intensity: root.structure_3d_phase_halo_intensity;
                phase_halo_radius_ratio: root.structure_3d_phase_halo_radius_ratio;
                atom_scale: root.structure_3d_atom_scale;
                phase_dim_non_matching: root.structure_3d_phase_dim_non_matching;
                phase_hide_non_matching: root.structure_3d_phase_hide_non_matching;
                phase_histogram_counts: root.structure_3d_phase_histogram_counts;
                phase_matching_atoms: root.structure_3d_phase_matching_atoms;
                phase_total_atoms: root.structure_3d_phase_total_atoms;
                phase_descriptor_name: root.structure_3d_phase_descriptor_name;
                phase_colorbar_image: root.structure_3d_phase_colorbar_image;

                phase_is_2d_mode: root.structure_3d_phase_is_2d_mode;
                phase_descriptor_y: root.structure_3d_phase_descriptor_y;
                phase_min_threshold_y: root.structure_3d_phase_min_threshold_y;
                phase_max_threshold_y: root.structure_3d_phase_max_threshold_y;
                phase_domain_min_y: root.structure_3d_phase_domain_min_y;
                phase_domain_max_y: root.structure_3d_phase_domain_max_y;
                phase_descriptor_name_y: root.structure_3d_phase_descriptor_name_y;
                phase_heatmap_image: root.structure_3d_phase_heatmap_image;
                phase_crystal_markers: root.structure_3d_phase_crystal_markers;

                dist_hud_visible: root.structure_3d_dist_hud_visible;
                dist_has_data: root.structure_3d_dist_has_data;
                dist_chart_image: root.structure_3d_dist_image;
                dist_active_metric: root.structure_3d_dist_metric;
                dist_peak_text: root.structure_3d_dist_peak_text;
                set_dist_metric(m) => { root.set_structure_3d_dist_metric(m); }
                toggle_dist_hud(v) => { root.toggle_structure_3d_dist_hud(v); }

                set_atom_scale(val) => { root.set_atom_scale_3d(val); }
            }

            // Tab 3: Dataset Values Table View (Data Explorer)
            tab_table := PlotDataTable {
                x: 0px;
                y: 0px;
                width: 100%;
                height: 100%;
                visible: root.active_tab == 3;
                table_headers: root.table_headers;
                table_rows: root.table_rows;
            }
        }

    }
}
