import { OptionSection } from "../common/OptionSection.slint";
import { ValidatedField } from "../common/ValidatedField.slint";

export component AdvancedOptionsCard inherits OptionSection {
    title: "Advanced Order Parameters";
    reset_enabled: root.file_loaded;

    in property <bool> file_loaded;
    in-out property <string> lef_cutoff;
    in-out property <string> lef_sigma;
    in-out property <string> hyper_samples;
    in property <string> lef_cutoff_error: "";
    in property <string> lef_sigma_error: "";
    in property <string> hyper_samples_error: "";

    ValidatedField {
        field_enabled: root.file_loaded;
        label: "Local Entropy Cutoff (Rc)";
        text <=> root.lef_cutoff;
        error: root.lef_cutoff_error;
        stepper: true;
        step: 0.5;
        minimum: 1.0;
        maximum: 20.0;
        tooltip_text: "Cutoff radius (Rc) for the local entropy integration.\n\n📏 Recommended: 5.0 Å.\n\n🔬 Physics: Defines the maximum distance to consider when calculating the local entropic fingerprint around each atom. Integrates local correlations up to this distance.";
    }

    ValidatedField {
        field_enabled: root.file_loaded;
        label: "Local Entropy Sigma (σ)";
        text <=> root.lef_sigma;
        error: root.lef_sigma_error;
        stepper: true;
        step: 0.05;
        minimum: 0.01;
        maximum: 2.0;
        decimals: 2;
        tooltip_text: "Gaussian kernel width (σ) for the local entropic fingerprint.\n\n📏 Recommended: 0.2 Å.\n\n🔬 Physics: Controls the width of the Gaussian used to broaden the local pair distribution. Too small causes discrete binning noise; too large smears structural detail.";
    }

    ValidatedField {
        field_enabled: root.file_loaded;
        label: "Hyperuniformity Samples";
        text <=> root.hyper_samples;
        error: root.hyper_samples_error;
        stepper: true;
        step: 1000.0;
        minimum: 100.0;
        decimals: 0;
        tooltip_text: "Number of random sample points for hyperuniformity calculation.\n\n📏 Recommended: 10000.\n\n🔬 Physics: More samples improve the statistical accuracy of the local number variance σ²_N(R) and hyperuniformity index χ_H(R). Higher values yield smoother curves but increase computation time.";
    }
}
