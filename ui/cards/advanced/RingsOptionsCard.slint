import { OptionSection } from "../common/OptionSection.slint";
import { ValidatedField } from "../common/ValidatedField.slint";

export component RingsOptionsCard inherits OptionSection {
    title: "Topological Rings";
    reset_enabled: root.file_loaded;

    in property <bool> file_loaded;
    in-out property <string> max_ring_size;
    in property <string> max_ring_error: "";

    ValidatedField {
        field_enabled: root.file_loaded;
        label: "Max Ring Size";
        text <=> root.max_ring_size;
        error: root.max_ring_error;
        stepper: true;
        minimum: 3.0;
        maximum: 30.0;
        decimals: 0;
        tooltip_text: "Maximum ring size for topological ring statistics.\n\n📏 Recommended: 8–12 (default: 12).\n\n🔬 Physics: Rings are closed loops of bonded atoms — they characterize medium-range order in network glasses (e.g., SiO₂ has predominantly 6-membered rings). Larger max sizes capture rare large rings but increase computation time exponentially. For most amorphous networks, rings >12 are statistically rare and computationally expensive.";
    }
}
