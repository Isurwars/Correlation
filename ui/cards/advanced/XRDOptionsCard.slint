import {
    MaterialStyleMetrics,
    MaterialPalette,
    OutlinedCard,
    ExpandableHeader,
    TextField,
    DropDownMenu,
    Vertical,
} from "../../material/material.slint";

export component XRDOptionsCard inherits OutlinedCard {
    in-out property <bool> expanded: true;
    in property <bool> file_loaded;

    in-out property <int> radiation_preset: 0;
    in-out property <string> lambda: "1.5406";
    in-out property <string> theta_min: "10.0";
    in-out property <string> theta_max: "140.0";
    in-out property <string> bin_width: "0.05";

    in property <string> lambda_error: "";
    in property <string> theta_min_error: "";
    in property <string> theta_max_error: "";
    in property <string> bin_width_error: "";

    callback reset();
    callback radiation_preset_changed(int);

    out property <string> hovered_tooltip_text:
        preset_area.has-hover ? "X-ray tube target anode radiation preset.\n\n🔬 Cu-Kα: 1.5406 Å (Standard laboratory diffractometer).\n\n🔬 Mo-Kα: 0.7107 Å (Hard X-rays, higher penetration).\n\n🔬 Co-Kα: 1.7890 Å (Ideal for Fe-rich samples to minimize fluorescence).\n\n🔬 Cr-Kα: 2.2897 Å (Large d-spacing & thin film surface diffraction)." :
        lambda_area.has-hover ? "X-ray incident radiation wavelength (λ) in Ångströms.\n\n📏 Default: 1.5406 Å (Cu-Kα1 weighted doublet).\n\n🔬 Physics: Directly sets reciprocal-to-angular Bragg mapping Q = 4π sin(θ) / λ." :
        min_theta_area.has-hover ? "Minimum scattering angle (2θ) in degrees.\n\n📏 Default: 10.0°.\n\n🔬 Physics: Defines the low-angle boundary of the powder diffraction pattern." :
        max_theta_area.has-hover ? "Maximum scattering angle (2θ) in degrees.\n\n📏 Default: 140.0°.\n\n🔬 Physics: Upper 2θ boundary. Must not exceed 180°." :
        bin_width_area.has-hover ? "Angular step resolution (Δ2θ) in degrees.\n\n📏 Default: 0.05°.\n\n🔬 Physics: Bin width for the powder diffraction histogram. Finer steps resolve split peaks in high-symmetry crystals." : "";

    out property <length> hovered_x:
        preset_area.has-hover ? preset_area.absolute-position.x + preset_area.mouse-x :
        lambda_area.has-hover ? lambda_area.absolute-position.x + lambda_area.mouse-x :
        min_theta_area.has-hover ? min_theta_area.absolute-position.x + min_theta_area.mouse-x :
        max_theta_area.has-hover ? max_theta_area.absolute-position.x + max_theta_area.mouse-x :
        bin_width_area.has-hover ? bin_width_area.absolute-position.x + bin_width_area.mouse-x : 0px;

    out property <length> hovered_y:
        preset_area.has-hover ? preset_area.absolute-position.y + preset_area.mouse-y :
        lambda_area.has-hover ? lambda_area.absolute-position.y + lambda_area.mouse-y :
        min_theta_area.has-hover ? min_theta_area.absolute-position.y + min_theta_area.mouse-y :
        max_theta_area.has-hover ? max_theta_area.absolute-position.y + max_theta_area.mouse-y :
        bin_width_area.has-hover ? bin_width_area.absolute-position.y + bin_width_area.mouse-y : 0px;

    out property <length> hovered_width: 0px;
    out property <length> hovered_height: 0px;

    Vertical {
        padding: MaterialStyleMetrics.spacing_8;
        spacing: MaterialStyleMetrics.spacing_8;

        ExpandableHeader {
            text: "Powder Diffraction (XRD)";
            expanded <=> root.expanded;
            show_reset: true;
            reset_enabled: root.file_loaded;
            reset => { root.reset(); }
        }

        Vertical {
            height: root.expanded ? self.preferred-height : 0px;
            visible: self.height > 0px;
            opacity: root.expanded ? 1.0 : 0.0;
            padding: 0;
            spacing: MaterialStyleMetrics.spacing_8;
            animate height, opacity {
                duration: 250ms;
                easing: ease-in-out;
            }

            preset_area := TouchArea {
                DropDownMenu {
                    enabled: root.file_loaded;
                    width: 100%;
                    label: "Radiation Source";
                    items: [
                        { text: "Cu-Kα (1.5406 Å)", enabled: true },
                        { text: "Mo-Kα (0.7107 Å)", enabled: true },
                        { text: "Co-Kα (1.7890 Å)", enabled: true },
                        { text: "Cr-Kα (2.2897 Å)", enabled: true },
                        { text: "Custom Wavelength", enabled: true }
                    ];
                    current-index <=> root.radiation_preset;
                    selected(idx) => {
                        root.radiation_preset_changed(idx);
                    }
                }
            }

            lambda_area := TouchArea {
                TextField {
                    enabled: root.file_loaded && root.radiation_preset == 4;
                    width: 100%;
                    label: "Wavelength λ (Å)";
                    text <=> root.lambda;
                    has_error: root.lambda_error != "";
                    supporting_text: root.lambda_error;
                }
            }

            min_theta_area := TouchArea {
                TextField {
                    enabled: root.file_loaded;
                    width: 100%;
                    label: "Min 2θ (°)";
                    text <=> root.theta_min;
                    has_error: root.theta_min_error != "";
                    supporting_text: root.theta_min_error;
                }
            }

            max_theta_area := TouchArea {
                TextField {
                    enabled: root.file_loaded;
                    width: 100%;
                    label: "Max 2θ (°)";
                    text <=> root.theta_max;
                    has_error: root.theta_max_error != "";
                    supporting_text: root.theta_max_error;
                }
            }

            bin_width_area := TouchArea {
                TextField {
                    enabled: root.file_loaded;
                    width: 100%;
                    label: "2θ Bin Width (°)";
                    text <=> root.bin_width;
                    has_error: root.bin_width_error != "";
                    supporting_text: root.bin_width_error;
                }
            }
        }
    }
}
