import { DropDownMenu } from "../../material/material.slint";
import { OptionSection } from "../common/OptionSection.slint";
import { ValidatedField } from "../common/ValidatedField.slint";

export component XRDOptionsCard inherits OptionSection {
    title: "Powder Diffraction (XRD)";
    reset_enabled: root.file_loaded;

    in property <bool> file_loaded;

    in-out property <int> radiation_preset: 0;
    in-out property <string> lambda: "1.5406";
    in-out property <string> theta_min: "10.0";
    in-out property <string> theta_max: "140.0";
    in-out property <string> bin_width: "0.05";

    in property <string> lambda_error: "";
    in property <string> theta_min_error: "";
    in property <string> theta_max_error: "";
    in property <string> bin_width_error: "";

    callback radiation_preset_changed(int);

    DropDownMenu {
        enabled: root.file_loaded;
        width: 100%;
        label: "Radiation Source";
        tooltip_text: "X-ray tube target anode radiation preset.\n\n🔬 Cu-Kα: 1.5406 Å (Standard lab diffractometer).\n🔬 Mo-Kα: 0.7107 Å (Hard X-rays, higher penetration).\n🔬 Co-Kα: 1.7890 Å (Ideal for Fe-rich samples).\n🔬 Cr-Kα: 2.2897 Å (Large d-spacing & surface diffraction).";
        items: [
            { text: "Cu-Kα (1.5406 Å)", enabled: true },
            { text: "Mo-Kα (0.7107 Å)", enabled: true },
            { text: "Co-Kα (1.7890 Å)", enabled: true },
            { text: "Cr-Kα (2.2897 Å)", enabled: true },
            { text: "Custom Wavelength", enabled: true }
        ];
        current-index <=> root.radiation_preset;
        selected(idx) => {
            root.radiation_preset_changed(idx);
        }
    }

    ValidatedField {
        field_enabled: root.file_loaded && root.radiation_preset == 4;
        label: "Wavelength λ (Å)";
        text <=> root.lambda;
        error: root.lambda_error;
        stepper: true;
        step: 0.01;
        minimum: 0.1;
        maximum: 10.0;
        decimals: 4;
        tooltip_text: "X-ray incident radiation wavelength (λ) in Ångströms.\n\n📏 Default: 1.5406 Å (Cu-Kα1 weighted doublet).\n\n🔬 Physics: Directly sets reciprocal-to-angular Bragg mapping Q = 4π sin(θ) / λ.";
    }

    ValidatedField {
        field_enabled: root.file_loaded;
        label: "Min 2θ (°)";
        text <=> root.theta_min;
        error: root.theta_min_error;
        stepper: true;
        maximum: 179.0;
        tooltip_text: "Minimum scattering angle (2θ) in degrees.\n\n📏 Default: 10.0°.\n\n🔬 Physics: Defines the low-angle boundary of the powder diffraction pattern.";
    }

    ValidatedField {
        field_enabled: root.file_loaded;
        label: "Max 2θ (°)";
        text <=> root.theta_max;
        error: root.theta_max_error;
        stepper: true;
        minimum: 1.0;
        maximum: 180.0;
        tooltip_text: "Maximum scattering angle (2θ) in degrees.\n\n📏 Default: 140.0°.\n\n🔬 Physics: Upper 2θ boundary. Must not exceed 180°.";
    }

    ValidatedField {
        field_enabled: root.file_loaded;
        label: "2θ Bin Width (°)";
        text <=> root.bin_width;
        error: root.bin_width_error;
        stepper: true;
        step: 0.01;
        minimum: 0.005;
        maximum: 5.0;
        decimals: 3;
        tooltip_text: "Angular step resolution (Δ2θ) in degrees.\n\n📏 Default: 0.05°.\n\n🔬 Physics: Bin width for the powder diffraction histogram. Finer steps resolve split peaks in high-symmetry crystals.";
    }
}
