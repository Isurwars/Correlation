import { DropDownMenu, CheckBoxRow, TooltipTarget } from "../../material/material.slint";
import { OptionSection } from "../common/OptionSection.slint";
import { ValidatedField } from "../common/ValidatedField.slint";

export component SmoothingOptionsCard inherits OptionSection {
    title: "Smoothing";
    reset_enabled: root.file_loaded;

    in property <bool> file_loaded;
    in-out property <bool> smoothing_enabled;
    in-out property <string> smoothing_sigma;
    in-out property <int> smoothing_kernel;
    in property <string> smoothing_sigma_error: "";

    CheckBoxRow {
        enabled: root.file_loaded;
        check_state_bool: root.smoothing_enabled;
        text: "Enable Smoothing";
        tooltip_text: "Apply kernel convolution smoothing to computed distribution histograms.\n\n🔬 Reduces statistical binning noise in small cells or short trajectories.";
        checked_state_changed(s) => {
            root.smoothing_enabled = s;
        }
    }

    ValidatedField {
        field_enabled: root.file_loaded && root.smoothing_enabled;
        label: "Smoothing Sigma";
        text <=> root.smoothing_sigma;
        error: root.smoothing_sigma_error;
        tooltip_text: "Standard deviation (σ) for the smoothing kernel.\n\n📏 Recommended: 0.01 Å.\n\n🔬 Physics: Controls the width of the convolution kernel applied to distribution functions. Larger σ smooths more noise but broadens real peaks — important for resolving the first g(r) peak. As a rule of thumb, σ should be comparable to or smaller than the bin width to avoid over-smoothing physical features.";
    }

    TooltipTarget {
        tooltip_text: "Type of smoothing kernel applied to distribution functions.\n\n🔬 Gaussian: Standard choice — smooth, infinite support. Best for general-purpose smoothing.\n\n🔬 Bump: Compact support with a sharp cutoff. Preserves high-frequency features better than Gaussian — use for crystalline systems with sharp peaks.\n\n🔬 Triweight: Compact support with higher weight near the center. Good for noisy data from small simulation cells, as it suppresses outliers more aggressively.\n\n🔬 Epanechnikov: Statistically optimal kernel (minimizes MISE). Simple parabolic shape with compact support — great for general use.\n\n🔬 Cosine: Smooth cosine-shaped kernel with compact support. Good for periodic-like features in structure factors.\n\n🔬 Biweight: Quartic polynomial kernel. A gentler alternative to Triweight — balances smoothness and peak preservation.";
        DropDownMenu {
            enabled: root.file_loaded && root.smoothing_enabled;
            width: 100%;
            label: "Smoothing Kernel";
            items: [
                { text: "Gaussian", enabled: true },
                { text: "Bump", enabled: true },
                { text: "Triweight", enabled: true },
                { text: "Epanechnikov", enabled: true },
                { text: "Cosine", enabled: true },
                { text: "Biweight", enabled: true }
            ];
            current-index <=> root.smoothing_kernel;
        }
    }
}
