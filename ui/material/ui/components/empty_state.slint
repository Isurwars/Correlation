import { MaterialPalette } from "../styling/material_palette.slint";
import { MaterialStyleMetrics } from "../styling/material_style_metrics.slint";
import { MaterialTypography } from "../styling/material_typography.slint";
import { MaterialText } from "./material_text.slint";
import { Icon } from "./icon.slint";

/// Centered empty state: icon, title, body; `@children` rendered below as actions.
export component EmptyState {
    in property <image> icon;
    in property <string> title;
    in property <string> body;

    property <bool> has_icon: root.icon.width > 0 && root.icon.height > 0;

    VerticalLayout {
        alignment: center;
        spacing: MaterialStyleMetrics.spacing_8;
        padding: MaterialStyleMetrics.padding_16;

        if root.has_icon: Icon {
            source: root.icon;
            colorize: MaterialPalette.on_surface_variant;
            width: MaterialStyleMetrics.icon_size_36;
            height: MaterialStyleMetrics.icon_size_36;
        }
        MaterialText {
            text: root.title;
            style: MaterialTypography.title_medium;
            color: MaterialPalette.on_surface;
            horizontal-alignment: center;
        }
        if root.body != "": MaterialText {
            text: root.body;
            style: MaterialTypography.body_medium;
            color: MaterialPalette.on_surface_variant;
            horizontal-alignment: center;
            wrap: word-wrap;
            overflow: clip;
        }
        @children
    }
}
