import { MaterialStyleMetrics } from "../styling/material_style_metrics.slint";
import { MaterialTypography } from "../styling/material_typography.slint";
import { MaterialPalette } from "../styling/material_palette.slint";
import { MaterialText } from "material_text.slint";
import { Icon } from "icon.slint";
import { Icons } from "../icons/icons.slint";

export component ExpandableHeader inherits TouchArea {
    in property <string> text;
    in-out property <bool> expanded: false;
    in property <bool> show_reset: false;
    in property <bool> reset_enabled: true;
    callback reset();
    height: 48px;

    HorizontalLayout {
        spacing: MaterialStyleMetrics.spacing_4;
        padding_left: MaterialStyleMetrics.spacing_4;
        padding_right: MaterialStyleMetrics.spacing_4;
        alignment: space-between;

        HorizontalLayout {
            spacing: MaterialStyleMetrics.spacing_4;

            VerticalLayout {
                alignment: center;
                Icon {
                    colorize: MaterialPalette.on_surface_variant;
                    height: 24px;
                    width: 24px;
                    source: root.expanded ? Icons.arrow_drop_down : Icons.arrow_right;
                }
            }

            MaterialText {
                text: root.text;
                style: MaterialTypography.title_small;
                vertical-alignment: center;
                color: MaterialPalette.on_surface_variant;
            }
        }

        if root.show_reset: VerticalLayout {
            alignment: center;
            reset_touch := TouchArea {
                width: reset_text.preferred-width + 12px;
                height: 22px;
                enabled: root.reset_enabled;
                accessible-role: button;
                accessible-label: "Reset Defaults";

                Rectangle {
                    width: 100%;
                    height: 100%;
                    background: reset_touch.has-hover ? MaterialPalette.surface_container_highest : MaterialPalette.surface_container_low;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: MaterialPalette.outline_variant.with_alpha(50%);
                    animate background { duration: 150ms; }

                    reset_text := MaterialText {
                        text: "Reset Defaults";
                        style: MaterialTypography.label_small;
                        font_size: 10px;
                        font_weight: MaterialTypography.medium;
                        color: root.reset_enabled ? MaterialPalette.primary : MaterialPalette.outline;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                clicked => {
                    root.reset();
                }
            }
        }
    }

    clicked => {
        root.expanded = !root.expanded;
    }
}
