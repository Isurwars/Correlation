import { TooltipState } from "./tooltip_state.slint";

export component TooltipTarget inherits TouchArea {
    in property <string> tooltip_text;
    property <bool> show_pending: false;

    changed has-hover => {
        if (self.has-hover && root.tooltip_text != "") {
            root.show_pending = true;
            delay_timer.running = true;
        } else {
            root.show_pending = false;
            delay_timer.running = false;
            TooltipState.active = { text: "", x: 0px, y: 0px, width: 0px, height: 0px };
        }
    }

    delay_timer := Timer {
        interval: 150ms;
        triggered => {
            if (root.show_pending && root.has-hover) {
                TooltipState.active = {
                    text: root.tooltip_text,
                    x: root.absolute-position.x,
                    y: root.absolute-position.y,
                    width: root.width,
                    height: root.height,
                };
            }
        }
    }
}
