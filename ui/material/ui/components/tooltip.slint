import { MaterialText } from "./material_text.slint";
import { MaterialPalette } from "../styling/material_palette.slint";
import { MaterialTypography } from "../styling/material_typography.slint";

export component ToolTip {
    in property <string> text;
    in property <length> hovered_x;
    in property <length> hovered_y;
    in property <length> hovered_width;
    in property <length> hovered_height;
    in property <length> parent_width;
    in property <length> parent_height;

    property <length> pref_w: background_layer.preferred_width;
    property <length> pref_h: background_layer.preferred_height;

    property <length> offset_x: 12px;
    property <length> offset_y: 16px;
    property <bool> has_box: root.hovered_width > 0px || root.hovered_height > 0px;
    property <length> raw_x: root.has_box
        ? (root.hovered_x + (root.hovered_width - root.pref_w) / 2)
        : (root.hovered_x + root.offset_x);
    property <length> raw_y: root.has_box
        ? ((root.hovered_y + root.hovered_height + 6px + root.pref_h > root.parent_height - 8px)
            ? max(8px, root.hovered_y - root.pref_h - 6px)
            : (root.hovered_y + root.hovered_height + 6px))
        : ((root.hovered_y + root.offset_y + root.pref_h > root.parent_height - 8px)
            ? max(8px, root.hovered_y - root.pref_h - 8px)
            : (root.hovered_y + root.offset_y));

    x: max(8px, min(max(8px, root.parent_width - root.pref_w - 8px), root.raw_x));
    y: max(8px, min(max(8px, root.parent_height - root.pref_h - 8px), root.raw_y));

    z: 10000;

    opacity: root.visible ? 1.0 : 0.0;
    animate opacity { duration: 120ms; easing: ease-out; }

    background_layer := Rectangle {
        border_radius: 6px;
        background: MaterialPalette.inverse_surface;
        border_width: 1px;
        border_color: MaterialPalette.outline_variant.with_alpha(35%);
        drop-shadow-blur: 10px;
        drop-shadow-offset-y: 3px;
        drop-shadow-color: MaterialPalette.shadow_30;

        layout := VerticalLayout {
            padding_top: 6px;
            padding_bottom: 6px;
            padding_left: 10px;
            padding_right: 10px;

            MaterialText {
                text: root.text;
                max-width: 280px;
                vertical_alignment: center;
                horizontal_alignment: left;
                color: MaterialPalette.inverse_on_surface;
                style: MaterialTypography.body_small;
                wrap: word-wrap;
                overflow: clip;
            }
        }
    }
}
