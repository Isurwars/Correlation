import { MaterialTypography } from "../styling/material_typography.slint";
import { MaterialPalette } from "../styling/material_palette.slint";
import { MaterialStyleMetrics } from "../styling/material_style_metrics.slint";
import { MaterialText } from "./material_text.slint";
import { TooltipState } from "./tooltip_state.slint";

export component TabItem inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> active;
    in property <bool> compact: false;
    in property <string> tooltip_text: "";
    callback clicked();

    out property <bool> has_hover: touch.has-hover;
    out property <length> mouse_x: touch.mouse-x;
    out property <length> mouse_y: touch.mouse-y;
    out property <length> abs_x: touch.absolute-position.x;
    out property <length> abs_y: touch.absolute-position.y;

    accessible-role: tab;
    accessible-checked: root.active;
    accessible-label: root.text;

    height: 100%;
    background: root.active ? MaterialPalette.primary :
                touch.has-hover ? MaterialPalette.surface_container_highest : transparent;

    animate background {
        duration: 150ms;
        easing: ease-out;
    }

    property <bool> show_tooltip_pending: false;

    delay_timer := Timer {
        interval: 250ms;
        triggered => {
            if (root.show_tooltip_pending && touch.has-hover && root.tooltip_text != "") {
                TooltipState.active = {
                    text: root.tooltip_text,
                    x: touch.absolute-position.x,
                    y: touch.absolute-position.y,
                    width: touch.width,
                    height: touch.height,
                };
            }
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
        changed has-hover => {
            if (self.has-hover && root.tooltip_text != "") {
                root.show_tooltip_pending = true;
                delay_timer.running = true;
            } else {
                root.show_tooltip_pending = false;
                delay_timer.running = false;
                if (root.tooltip_text != "" && TooltipState.active.text == root.tooltip_text) {
                    TooltipState.active = { text: "", x: 0px, y: 0px, width: 0px, height: 0px };
                }
            }
        }
    }

    HorizontalLayout {
        padding-left: root.compact ? MaterialStyleMetrics.padding_8 : MaterialStyleMetrics.padding_14;
        padding-right: root.compact ? MaterialStyleMetrics.padding_8 : MaterialStyleMetrics.padding_14;
        alignment: center;
        spacing: root.compact ? MaterialStyleMetrics.spacing_4 : MaterialStyleMetrics.spacing_6;

        if root.icon.width > 0 && root.icon.height > 0: Image {
            source: root.icon;
            width: root.compact ? MaterialStyleMetrics.size_14 : MaterialStyleMetrics.size_16;
            height: root.compact ? MaterialStyleMetrics.size_14 : MaterialStyleMetrics.size_16;
            colorize: root.active ? MaterialPalette.on_primary :
                      touch.has-hover ? MaterialPalette.on_surface : MaterialPalette.on_surface_variant;
            y: (parent.height - self.height) / 2;

            animate colorize {
                duration: 150ms;
                easing: ease-out;
            }
        }

        MaterialText {
            text: root.text;
            style: root.compact ?
                   (root.active ? MaterialTypography.label_small_prominent : MaterialTypography.label_small) :
                   (root.active ? MaterialTypography.label_medium_prominent : MaterialTypography.label_medium);
            color: root.active ? MaterialPalette.on_primary :
                   touch.has-hover ? MaterialPalette.on_surface : MaterialPalette.on_surface_variant;
            horizontal-alignment: center;
            vertical-alignment: center;

            animate color {
                duration: 150ms;
                easing: ease-out;
            }
        }
    }
}
