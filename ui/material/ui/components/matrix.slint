import { ScrollView } from "std-widgets.slint";
import { MaterialText } from "./material_text.slint";
import { MaterialStyleMetrics } from "../styling/material_style_metrics.slint";
import { MaterialPalette } from "../styling/material_palette.slint";
import { MaterialTypography } from "../styling/material_typography.slint";
import { AtomCount } from "../../../Types.slint";

component OffDiagonalCell {
    in property <int> reset_trigger: 0;
    in property <string> initial_text;
    in property <bool> enabled: true;
    in property <bool> is_upper: true; // true = Max (j > i), false = Min (i > j)
    in property <bool> has_error: false;
    callback edited(string);

    property <string> current_text: root.initial_text;

    changed reset_trigger => {
        root.current_text = root.initial_text;
    }

    property <bool> has_focus: input.has_focus;

    width: 76px;
    height: 48px;

    container := Rectangle {
        width: 100%;
        height: 100%;
        background: root.has_error ? MaterialPalette.error_container.with_alpha(40%) :
            root.is_upper ? MaterialPalette.primary_container.with_alpha(40%) :
            MaterialPalette.surface_container_low;
        border-radius: MaterialStyleMetrics.border_radius_4;
        border-width: (root.has_focus || root.has_error) ? 2px : 1px;
        border-color: root.has_error ? MaterialPalette.error :
            root.has_focus ? (root.is_upper ? MaterialPalette.primary : MaterialPalette.tertiary) :
            root.is_upper ? MaterialPalette.primary.with_alpha(40%) :
            MaterialPalette.outline_variant.with_alpha(50%);

        VerticalLayout {
            padding_left: 4px;
            padding_right: 4px;
            padding_top: 2px;
            padding_bottom: 2px;
            spacing: 0px;

            // Micro-badge header
            HorizontalLayout {
                height: 12px;
                alignment: start;
                MaterialText {
                    text: root.is_upper ? "▲ Max" : "▼ Min";
                    style: MaterialTypography.label_small;
                    color: root.has_error ? MaterialPalette.error :
                        root.is_upper ? MaterialPalette.primary : MaterialPalette.tertiary;
                    font_size: 9px;
                    font_weight: MaterialTypography.semibold;
                }
            }

            // Numeric input
            input := TextInput {
                width: parent.width;
                height: 28px;
                font_size: MaterialTypography.body_medium.font_size;
                font_weight: MaterialTypography.medium;
                vertical-alignment: center;
                horizontal-alignment: center;
                single-line: true;
                color: root.has_error ? MaterialPalette.error :
                    root.enabled ? MaterialPalette.on_surface :
                    MaterialPalette.on_surface.with_alpha(38%);
                text <=> root.current_text;
                enabled: root.enabled;

                edited => {
                    root.edited(self.text);
                }
            }
        }
    }
}

component DiagonalCell {
    in property <int> reset_trigger: 0;
    in property <string> initial_max;
    in property <string> initial_min;
    in property <bool> enabled: true;
    in property <bool> has_error: false;
    callback max_edited(string);
    callback min_edited(string);

    property <string> current_max: root.initial_max;
    property <string> current_min: root.initial_min;

    changed reset_trigger => {
        root.current_max = root.initial_max;
        root.current_min = root.initial_min;
    }

    property <bool> max_focused: max_input.has_focus;
    property <bool> min_focused: min_input.has_focus;

    width: 76px;
    height: 48px;

    container := Rectangle {
        width: 100%;
        height: 100%;
        background: root.has_error ? MaterialPalette.error_container.with_alpha(40%) :
            MaterialPalette.surface_container_high;
        border-radius: MaterialStyleMetrics.border_radius_4;
        border-width: (root.max_focused || root.min_focused || root.has_error) ? 2px : 1px;
        border-color: root.has_error ? MaterialPalette.error :
            root.max_focused ? MaterialPalette.primary :
            root.min_focused ? MaterialPalette.tertiary :
            MaterialPalette.outline_variant.with_alpha(60%);

        VerticalLayout {
            spacing: 0px;
            padding: 1px;

            // Top half: Max cutoff (darker tone)
            Rectangle {
                height: 22px;
                background: MaterialPalette.primary_container.with_alpha(40%);
                border-top-left-radius: 3px;
                border-top-right-radius: 3px;

                HorizontalLayout {
                    padding_left: 4px;
                    padding_right: 4px;
                    spacing: 2px;
                    alignment: center;

                    MaterialText {
                        text: "▲";
                        style: MaterialTypography.label_small;
                        color: MaterialPalette.primary;
                        font_size: 9px;
                        font_weight: MaterialTypography.semibold;
                        vertical-alignment: center;
                    }

                    max_input := TextInput {
                        width: parent.width - 12px;
                        height: 20px;
                        font_size: 11px;
                        font_weight: MaterialTypography.medium;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                        single-line: true;
                        color: root.has_error ? MaterialPalette.error :
                            root.enabled ? MaterialPalette.on_surface :
                            MaterialPalette.on_surface.with_alpha(38%);
                        text <=> root.current_max;
                        enabled: root.enabled;

                        edited => {
                            root.max_edited(self.text);
                        }
                    }
                }
            }

            // Divider
            Rectangle {
                height: 1px;
                background: MaterialPalette.outline_variant.with_alpha(60%);
            }

            // Bottom half: Min cutoff (clearer tone)
            Rectangle {
                height: 22px;
                background: MaterialPalette.surface_container_low;
                border-bottom-left-radius: 3px;
                border-bottom-right-radius: 3px;

                HorizontalLayout {
                    padding_left: 4px;
                    padding_right: 4px;
                    spacing: 2px;
                    alignment: center;

                    MaterialText {
                        text: "▼";
                        style: MaterialTypography.label_small;
                        color: MaterialPalette.tertiary;
                        font_size: 9px;
                        font_weight: MaterialTypography.semibold;
                        vertical-alignment: center;
                    }

                    min_input := TextInput {
                        width: parent.width - 12px;
                        height: 20px;
                        font_size: 11px;
                        font_weight: MaterialTypography.medium;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                        single-line: true;
                        color: root.has_error ? MaterialPalette.error :
                            root.enabled ? MaterialPalette.on_surface :
                            MaterialPalette.on_surface.with_alpha(38%);
                        text <=> root.current_min;
                        enabled: root.enabled;

                        edited => {
                            root.min_edited(self.text);
                        }
                    }
                }
            }
        }
    }
}

export component Matrix {
    in property <[AtomCount]> headers;
    in property <bool> enabled: true;
    in property <int> reset_trigger: 0;

    // Callbacks to read and write cell data (reading must be pure/side-effect free)
    pure callback cell_value(int, int) -> string;
    pure callback diagonal_max_value(int) -> string;
    pure callback diagonal_min_value(int) -> string;
    pure callback cell_has_error(int, int) -> bool;

    callback cell_edited(int, int, string);
    callback diagonal_max_edited(int, string);
    callback diagonal_min_edited(int, string);

    // Styling properties
    in property <length> cell_width: 76px;
    in property <length> cell_height: 48px;
    in property <length> header_height: 24px;
    in property <length> header_width: 36px;

    preferred-height: matrix_layout.preferred-height + 12px;
    height: self.preferred-height;
    width: 100%;

    ScrollView {
        width: 100%;
        height: 100%;
        vertical_scrollbar_policy: ScrollBarPolicy.always_off;
        horizontal_scrollbar_policy: ScrollBarPolicy.as_needed;

        viewport-width: matrix_layout.preferred-width;
        viewport-height: matrix_layout.preferred-height;

        matrix_layout := VerticalLayout {
            padding: 4px;
            spacing: 4px;

            // Header Row
            HorizontalLayout {
                spacing: 4px;
                Rectangle {
                    width: root.header_width;
                    height: root.header_height;
                }

                for col[j] in root.headers: Rectangle {
                    width: root.cell_width;
                    height: root.header_height;
                    MaterialText {
                        text: col.symbol;
                        font-weight: MaterialTypography.semibold;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        style: MaterialTypography.label_medium;
                    }
                }
            }

            // Data Rows
            for row[i] in root.headers: HorizontalLayout {
                spacing: 4px;
                Rectangle {
                    width: root.header_width;
                    height: root.cell_height;
                    MaterialText {
                        text: row.symbol;
                        font-weight: MaterialTypography.semibold;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        style: MaterialTypography.label_medium;
                    }
                }

                for col[j] in root.headers: Rectangle {
                    width: root.cell_width;
                    height: root.cell_height;

                    if (i == j): DiagonalCell {
                        reset_trigger: root.reset_trigger;
                        initial_max: root.diagonal_max_value(i);
                        initial_min: root.diagonal_min_value(i);
                        enabled: root.enabled;
                        has_error: root.cell_has_error(i, j);

                        max_edited(val) => {
                            root.diagonal_max_edited(i, val);
                        }
                        min_edited(val) => {
                            root.diagonal_min_edited(i, val);
                        }
                    }

                    if (i != j): OffDiagonalCell {
                        reset_trigger: root.reset_trigger;
                        initial_text: root.cell_value(i, j);
                        enabled: root.enabled;
                        is_upper: j > i;
                        has_error: root.cell_has_error(i, j);

                        edited(val) => {
                            root.cell_edited(i, j, val);
                        }
                    }
                }
            }
        }
    }
}
