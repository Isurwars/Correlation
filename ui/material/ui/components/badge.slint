import { MaterialPalette } from "../styling/material_palette.slint";
import { MaterialStyleMetrics } from "../styling/material_style_metrics.slint";
import { MaterialTypography } from "../styling/material_typography.slint";
import { MaterialText } from "./material_text.slint";

/// Material 3 small label badge. `tone`: 0 neutral, 1 success-ish (primary), 2 error.
export component Badge {
    in property <string> text;
    in property <int> tone: 0;

    property <color> fg: root.tone == 2 ? MaterialPalette.on_error_container
        : root.tone == 1 ? MaterialPalette.on_primary_container : MaterialPalette.on_surface_variant;
    property <color> bg: root.tone == 2 ? MaterialPalette.error_container
        : root.tone == 1 ? MaterialPalette.primary_container : MaterialPalette.surface_container_high;

    height: MaterialStyleMetrics.size_18;
    min-width: MaterialStyleMetrics.size_18;

    Rectangle {
        border_radius: MaterialStyleMetrics.border_radius_full;
        background: root.bg;
    }
    HorizontalLayout {
        padding_left: MaterialStyleMetrics.padding_6;
        padding_right: MaterialStyleMetrics.padding_6;
        MaterialText {
            text: root.text;
            style: MaterialTypography.label_small;
            color: root.fg;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }
}
