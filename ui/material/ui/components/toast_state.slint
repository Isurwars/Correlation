export struct ToastData {
    message: string,
    severity: int, // 0: Info, 1: Success, 2: Warning, 3: Error
    visible: bool,
}

export global ToastState {
    in-out property <ToastData> current: { message: "", severity: 0, visible: false };
    in-out property <int> revision: 0;

    public function show(msg: string, sev: int) {
        root.current = { message: msg, severity: sev, visible: true };
        root.revision += 1;
    }

    public function dismiss() {
        root.current = { message: root.current.message, severity: root.current.severity, visible: false };
    }
}
