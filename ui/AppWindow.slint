    in-out property <int> last_active_panel: 0;

    in-out property <length> right_col_width: 320px;
    in-out property <length> last_right_col_width: 320px;
    in-out property <int> active_right_panel: 0; // 0: Plot Inspector, 1: Structure 3D Inspector, -1: Collapsed
