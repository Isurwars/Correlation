    // Zen Mode & Power-User Overlay state
    in-out property <bool> zen_mode: false;
    property <int> zen_saved_left_panel: 0;
    property <int> zen_saved_right_panel: 0;
    in-out property <bool> command_palette_open: false;
    in-out property <bool> shortcuts_modal_open: false;
    in property <[CommandItem]> command_items: [];
    callback filter_commands(string);

    function toggle_zen_mode() {
        if (!root.zen_mode) {
            root.zen_saved_left_panel = root.active_panel;
            root.zen_saved_right_panel = root.active_right_panel;
            root.active_panel = -1;
            root.active_right_panel = -1;
            root.zen_mode = true;
            ToastState.show("Zen Mode enabled — press Ctrl+\\ to restore panels", 0);
        } else {
            root.active_panel = root.zen_saved_left_panel;
            root.active_right_panel = root.zen_saved_right_panel;
            root.zen_mode = false;
            ToastState.show("Workspace panels restored", 0);
        }
    }

    function execute_command(cmd_id: string) {
        if (cmd_id == "open_file") { root.browse_file(); }
        else if (cmd_id == "run_analysis") {
            if (root.file_loaded && !root.has_validation_errors && !root.analysis_running) {
                root.run_analysis();
            }
        }
        else if (cmd_id == "cancel_analysis") {
            if (root.analysis_running) { root.cancel_analysis(); }
        }
        else if (cmd_id == "export_data") {
            if (root.analysis_done) {
                root.write_files();
                ToastState.show("Exporting analysis data files...", 1);
            }
        }
        else if (cmd_id == "export_plot") {
            if (root.selected_plot_index >= 0) { root.save_plot(); }
        }
        else if (cmd_id == "export_structure") {
            if (root.file_loaded) { root.export_structure(); }
        }
        else if (cmd_id == "copy_svg") {
            if (root.selected_plot_index >= 0) {
                root.copy_plot_clipboard();
                ToastState.show("Plot SVG copied to clipboard", 1);
            }
        }
        else if (cmd_id == "toggle_theme") {
            Palette.color-scheme = Palette.color-scheme == ColorScheme.dark ? ColorScheme.light : ColorScheme.dark;
            ToastState.show(Palette.color-scheme == ColorScheme.dark ? "Switched to Dark Theme" : "Switched to Light Theme", 0);
        }
        else if (cmd_id == "toggle_zen") { root.toggle_zen_mode(); }
        else if (cmd_id == "show_shortcuts") { root.shortcuts_modal_open = true; }
        else if (cmd_id == "view_2d") {
            root.preview_active_tab = 0;
            root.preview_tab_changed(0);
            if (root.active_right_panel >= 0) { root.active_right_panel = 0; }
        }
        else if (cmd_id == "view_3d") {
            root.preview_active_tab = 1;
            root.preview_tab_changed(1);
            if (root.active_right_panel >= 0) { root.active_right_panel = 1; }
        }
        else if (cmd_id == "view_dual") {
            root.preview_active_tab = 2;
            root.preview_tab_changed(2);
        }
        else if (cmd_id == "view_data") {
            root.preview_active_tab = 3;
            root.preview_tab_changed(3);
        }
        else if (cmd_id == "reset_view") {
            root.reset_zoom();
            root.reset_view_3d();
            ToastState.show("Viewport zoom & 3D camera reset", 0);
        }
        else if (cmd_id == "sample_pdsi") { root.load_sample("a-PdSi"); ToastState.show("Loading a-PdSi sample...", 0); }
        else if (cmd_id == "sample_cellulose") { root.load_sample("Cellulose"); ToastState.show("Loading Cellulose sample...", 0); }
        else if (cmd_id == "sample_si") { root.load_sample("Si"); ToastState.show("Loading Silicon sample...", 0); }
    }

    // Export Options Properties & Callbacks
    in-out property <ExportFormatOptions> export_format_options: {
        export_csv: true,
