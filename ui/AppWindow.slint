import {
    MaterialPalette,
    MaterialStyleMetrics,
    MaterialTypography,
    MaterialText,
    MenuItem,
    Vertical,
    Horizontal,
    Icons,
    FilledButton,
    IconButton,
    ScrollView,
    TabItem,
} from "material/material.slint";
import { Palette } from "std-widgets.slint";

import {
    AtomCount,
    BondCutoff,
    CalculatorInfo,
    CalculatorGroup,
    AnalysisOptions,
    AppErrors,
    ExportConfig,
    TableRow,
    CurveToggleItem,
    ComparisonCurveData,
} from "Types.slint";

import { MiniSideBar } from "nav/MiniSideBar.slint";
import { AppFooter } from "nav/AppFooter.slint";
import { OperationsPanelCard } from "cards/operations/OperationsPanelCard.slint";
import { CommonOptionsPanelCard } from "cards/common/CommonOptionsPanelCard.slint";
import { AdvancedOptionsPanelCard } from "cards/advanced/AdvancedOptionsPanelCard.slint";
import { PlotExportPanelCard } from "cards/plot/PlotExportPanelCard.slint";
import { PresetsPanelCard } from "cards/presets/PresetsPanelCard.slint";
import { AnalysesPanelCard } from "cards/analyses/AnalysesPanelCard.slint";
import { PreviewCard } from "cards/preview/PreviewCard.slint";
import { AppToolTips } from "AppToolTips.slint";
import { SplitterHandle } from "SplitterHandle.slint";

export {
    AtomCount,
    BondCutoff,
    CalculatorInfo,
    CalculatorGroup,
    AnalysisOptions,
    AppErrors,
    ExportConfig,
    TableRow,
    CurveToggleItem,
    ComparisonCurveData,
}

// ============================================================================
// AppWindow Component
// ============================================================================
/// This is the main window component for the Correlation application.
/// 
/// C++ Binding Architecture:
/// - The `AppWindow` instance is managed by the `AppController` in C++.
/// - Root properties (like `file_loaded`, `progress`, etc.) are bound to 
///   the `AppController` and `AppBackend` states.
/// - Callbacks (like `run_analysis`, `browse_file`) are mapped to methods in
///   the `AppController` to handle user interactions.
/// - hovered_tooltip_text: A string that is dynamically updated based on the
///   hovered component.
// ============================================================================

// ============================================================================
export component AppWindow inherits Window {
    // ============================================================================
    // Global Properties
    // ============================================================================
    
    /// Status of the file dialog timer
    in property <bool> timer_running: false;

    /// Application version string
    in-out property <string> app_version: "v3.9.5";

    /// GitHub Update Check status
    in-out property <bool> update_available: false;
    in-out property <string> update_version: "";
    in-out property <string> update_url: "https://github.com/Isurwars/Correlation/releases";
    callback open_url(string);

    /// File status and metadata
    in property <bool> file_loaded: false;
    in property <bool> file_loading: false;
    in property <int> num_frames: 0;
    in property <int> total_atoms: 0;
    in property <int> removed_frames_count: 0;
    in property <[AtomCount]> atom_counts: [];
    in-out property <string> file_status_text: "No file loaded.";

    /// Analysis execution state
    in property <bool> analysis_running: false;
    in property <bool> analysis_done: false;
    in property <float> progress: 0.0;
    in property <bool> text_opacity: false;
    in-out property <string> analysis_status_text: "Ready to run analysis.";

    /// Analysis configuration properties
    in-out property <string> in_file_text;
    in property <bool> hdf5_available: true;
    in property <bool> parquet_available: true;
    in-out property <AnalysisOptions> analysis_options: {
        r_max: "20.0",
        r_bin_width: "0.02",
        q_max: "20.0",
        q_bin_width: "0.02",
        r_int_max: "10.0",
        angle_bin_width: "1.0",
        dihedral_bin_width: "1.0",
        max_ring_size: "12",
        smoothing_sigma: "0.01",
        smoothing_kernel: 0,
        smoothing_enabled: true,
        min_frame: "0",
        max_frame: "End",
        time_step: "1.0",
        material_type: 0,
        lef_cutoff: "5.0",
        lef_sigma: "0.2",
        hyper_samples: "10000"
    };
    in-out property <AppErrors> app_errors;
    in-out property <[BondCutoff]> bond_cutoffs: [];
    in-out property <int> bond_cutoffs_reset_trigger: 0;
    in-out property <ExportConfig> export_config: {
        size_preset: 0,
        palette: 0,
        font_scale: "1.0",
        line_width: "3.0",
        marker_size: "3.5",
        show_legend: true,
        show_grid: true,
        show_markers: false,
        fill_area: false
    };

    property <string> min_frame <=> analysis_options.min_frame;
    property <string> max_frame <=> analysis_options.max_frame;
    property <string> r_max <=> analysis_options.r_max;
    property <string> r_bin_width <=> analysis_options.r_bin_width;
    property <string> q_max <=> analysis_options.q_max;
    property <string> q_bin_width <=> analysis_options.q_bin_width;
    property <string> r_int_max <=> analysis_options.r_int_max;
    property <string> angle_bin_width <=> analysis_options.angle_bin_width;
    property <string> dihedral_bin_width <=> analysis_options.dihedral_bin_width;
    property <string> max_ring_size <=> analysis_options.max_ring_size;
    property <bool> smoothing <=> analysis_options.smoothing_enabled;
    property <string> smoothing_sigma <=> analysis_options.smoothing_sigma;
    property <int> smoothing_kernel <=> analysis_options.smoothing_kernel;
    property <string> time_step <=> analysis_options.time_step;
    property <int> material_type <=> analysis_options.material_type;
    property <string> lef_cutoff <=> analysis_options.lef_cutoff;
    property <string> lef_sigma <=> analysis_options.lef_sigma;
    property <string> hyper_samples <=> analysis_options.hyper_samples;

    property <string> r_max_error <=> app_errors.r_max_error;
    property <string> r_bin_error <=> app_errors.r_bin_error;
    property <string> q_max_error <=> app_errors.q_max_error;
    property <string> q_bin_error <=> app_errors.q_bin_error;
    property <string> r_int_max_error <=> app_errors.r_int_max_error;
    property <string> angle_bin_error <=> app_errors.angle_bin_error;
    property <string> dihedral_bin_error <=> app_errors.dihedral_bin_error;
    property <string> max_ring_error <=> app_errors.max_ring_error;
    property <string> smoothing_sigma_error <=> app_errors.smoothing_sigma_error;
    property <string> min_frame_error <=> app_errors.min_frame_error;
    property <string> max_frame_error <=> app_errors.max_frame_error;
    property <string> time_step_error <=> app_errors.time_step_error;
    property <string> lef_cutoff_error <=> app_errors.lef_cutoff_error;
    property <string> lef_sigma_error <=> app_errors.lef_sigma_error;
    property <string> hyper_samples_error <=> app_errors.hyper_samples_error;

    property <int> export_size_preset <=> export_config.size_preset;
    property <int> export_palette <=> export_config.palette;
    property <string> export_font_scale <=> export_config.font_scale;
    property <string> export_line_width <=> export_config.line_width;
    property <string> export_marker_size <=> export_config.marker_size;
    property <bool> export_show_legend <=> export_config.show_legend;
    property <bool> export_show_grid <=> export_config.show_grid;
    property <bool> export_show_markers <=> export_config.show_markers;
    property <bool> export_fill_area <=> export_config.fill_area;
    property <string> export_font_scale_error <=> app_errors.export_font_scale_error;
    property <string> export_line_width_error <=> app_errors.export_line_width_error;
    property <string> export_marker_size_error <=> app_errors.export_marker_size_error;

    // Global: any validation error prevents running analysis
    in-out property <bool> has_validation_errors: false;

    // Presets properties
    in property <[MenuItem]> preset_items: [];
    in-out property <int> selected_preset: -1;

    /// Dynamic calculator groups from CalculatorFactory via C++
    in-out property <[CalculatorGroup]> calculator_groups: [];
    in property <int> total_calculator_count: 0;

    /// Active group flags for auto-hiding option cards
    in property <bool> has_radial_active: false;
    in property <bool> has_scattering_active: false;
    in property <bool> has_angular_active: false;
    in property <bool> has_rings_active: false;

    in property <image> preview_plot;
    in property <[MenuItem]> plot_items: [];
    in property <[CurveToggleItem]> curve_toggle_items: [];
    in-out property <int> selected_plot_index: -1;
    in property <int> pinned_runs_count: 0;
    out property <bool> is_dark: Palette.color_scheme == ColorScheme.dark;

    // Table data and calculated scalar properties
    in property <[string]> table_headers: [];
    in property <[TableRow]> table_rows: [];
    in property <string> diff_msd: "";
    in property <string> diff_vacf: "";
    in property <string> relaxation_time: "";
    in property <string> deborah_number: "";

    in property <[ComparisonCurveData]> comparison_curves: [];
    in property <bool> show_difference: false;

    // Resizable layout geometry properties
    in-out property <length> left_col_width: 220px;
    in-out property <length> last_col_width: 220px;
    in-out property <length> middle_col_width: 220px;
    in-out property <int> active_panel: 0;
    in-out property <int> last_active_panel: 0;

    // Callbacks (Bound to AppController.cpp)
    callback layout_geometry_changed(length, length);
    callback browse_file();
    callback run_analysis();
    callback cancel_analysis();
    callback write_files();
    callback select_plot(int);
    callback toggle_curve_visibility(int, bool);
    callback toggle_all_curves(bool);
    callback set_curve_color(int, string);
    callback toggle_calculator(string, bool);
    callback save_plot();
    callback pin_run();
    callback clear_pinned_runs();
    callback import_comparison_file();
    callback remove_comparison_curve(int);
    callback toggle_difference_plot(bool);
    callback validate_inputs();
    callback mouse_move(length, length, bool, length, length);
    callback plot_resized(length, length);

    // Presets callbacks
    callback export_config_changed();
    callback load_preset(int);
    callback save_preset(string);
    callback delete_preset(int);
    callback reset_presets();
    callback material_type_changed(int);
    callback reset_bond_cutoffs();
    callback reset_rdf_options();
    callback reset_angle_options();
    callback reset_sq_options();
    callback reset_rings_options();
    callback reset_smoothing_options();
    callback reset_advanced_options();
    callback reset_trajectory_options();
    callback reset_export_settings();
    callback reset_analyses_selection();
    callback reset_material_type();
    callback clear_comparison_curves();

    // ============================================================================
    // Core Layout Logic
    // ============================================================================
    

    changed r_max => {
        root.validate_inputs();
    }
    changed r_bin_width => {
        root.validate_inputs();
    }
    changed q_max => {
        root.validate_inputs();
    }
    changed q_bin_width => {
        root.validate_inputs();
    }
    changed r_int_max => {
        root.validate_inputs();
    }
    changed angle_bin_width => {
        root.validate_inputs();
    }
    changed dihedral_bin_width => {
        root.validate_inputs();
    }
    changed max_ring_size => {
        root.validate_inputs();
    }
    changed smoothing => {
        root.validate_inputs();
    }
    changed smoothing_sigma => {
        root.validate_inputs();
    }
    changed min_frame => {
        root.validate_inputs();
    }
    changed max_frame => {
        root.validate_inputs();
    }
    changed time_step => {
        root.validate_inputs();
    }
    changed lef_cutoff => {
        root.validate_inputs();
    }
    changed lef_sigma => {
        root.validate_inputs();
    }
    changed hyper_samples => {
        root.validate_inputs();
    }
    changed material_type => {
        root.material_type_changed(root.material_type);
    }

    changed export_size_preset => {
        root.select_plot(root.selected_plot_index);
    }
    changed export_palette => {
        root.select_plot(root.selected_plot_index);
    }
    changed export_font_scale => {
        root.validate_inputs();
        root.select_plot(root.selected_plot_index);
    }
    changed export_line_width => {
        root.validate_inputs();
        root.select_plot(root.selected_plot_index);
    }
    changed export_marker_size => {
        root.validate_inputs();
        root.select_plot(root.selected_plot_index);
    }
    changed export_show_legend => {
        root.select_plot(root.selected_plot_index);
    }
    changed export_show_grid => {
        root.select_plot(root.selected_plot_index);
    }
    changed export_show_markers => {
        root.select_plot(root.selected_plot_index);
    }
    changed export_fill_area => {
        root.select_plot(root.selected_plot_index);
    }
    changed is_dark => {
        root.select_plot(root.selected_plot_index);
    }
    changed analysis_done => {
        if root.analysis_done {
            root.active_panel = 3;
        }
    }



    /// hovered_tooltip_text: Dynamically update based on the currently
    ///   hovered component.
    property <string> active_panel_tooltip:
        root.active_panel == 0 ? panel_operations.hovered_tooltip_text :
        root.active_panel == 1 ? panel_common.hovered_tooltip_text :
        root.active_panel == 2 ? panel_advanced.hovered_tooltip_text :
        root.active_panel == 3 ? panel_plot_export.hovered_tooltip_text :
        root.active_panel == 4 ? panel_presets.hovered_tooltip_text :
        root.active_panel == 5 ? panel_analyses.hovered_tooltip_text : "";

    property <string> preview_hovered_tooltip: preview_card.hovered_tooltip_text;

    property <string> hovered_tooltip_text: 
        active_panel_tooltip != "" ? active_panel_tooltip : preview_hovered_tooltip;

    property <length> hovered_x:
        root.active_panel == 0 && panel_operations.hovered_tooltip_text != "" ? panel_operations.hovered_x :
        root.active_panel == 1 && panel_common.hovered_tooltip_text != "" ? panel_common.hovered_x :
        root.active_panel == 2 && panel_advanced.hovered_tooltip_text != "" ? panel_advanced.hovered_x :
        root.active_panel == 3 && panel_plot_export.hovered_tooltip_text != "" ? panel_plot_export.hovered_x :
        root.active_panel == 4 && panel_presets.hovered_tooltip_text != "" ? panel_presets.hovered_x :
        root.active_panel == 5 && panel_analyses.hovered_tooltip_text != "" ? panel_analyses.hovered_x :
        preview_hovered_tooltip != "" ? preview_card.hovered_x : 0px;

    property <length> hovered_y:
        root.active_panel == 0 && panel_operations.hovered_tooltip_text != "" ? panel_operations.hovered_y :
        root.active_panel == 1 && panel_common.hovered_tooltip_text != "" ? panel_common.hovered_y :
        root.active_panel == 2 && panel_advanced.hovered_tooltip_text != "" ? panel_advanced.hovered_y :
        root.active_panel == 3 && panel_plot_export.hovered_tooltip_text != "" ? panel_plot_export.hovered_y :
        root.active_panel == 4 && panel_presets.hovered_tooltip_text != "" ? panel_presets.hovered_y :
        root.active_panel == 5 && panel_analyses.hovered_tooltip_text != "" ? panel_analyses.hovered_y :
        preview_hovered_tooltip != "" ? preview_card.hovered_y : 0px;

    property <length> hovered_width:
        root.active_panel == 0 && panel_operations.hovered_tooltip_text != "" ? panel_operations.hovered_width :
        root.active_panel == 1 && panel_common.hovered_tooltip_text != "" ? panel_common.hovered_width :
        root.active_panel == 2 && panel_advanced.hovered_tooltip_text != "" ? panel_advanced.hovered_width :
        root.active_panel == 3 && panel_plot_export.hovered_tooltip_text != "" ? panel_plot_export.hovered_width :
        root.active_panel == 4 && panel_presets.hovered_tooltip_text != "" ? panel_presets.hovered_width :
        root.active_panel == 5 && panel_analyses.hovered_tooltip_text != "" ? panel_analyses.hovered_width :
        preview_hovered_tooltip != "" ? preview_card.hovered_width : 0px;

    property <length> hovered_height:
        root.active_panel == 0 && panel_operations.hovered_tooltip_text != "" ? panel_operations.hovered_height :
        root.active_panel == 1 && panel_common.hovered_tooltip_text != "" ? panel_common.hovered_height :
        root.active_panel == 2 && panel_advanced.hovered_tooltip_text != "" ? panel_advanced.hovered_height :
        root.active_panel == 3 && panel_plot_export.hovered_tooltip_text != "" ? panel_plot_export.hovered_height :
        root.active_panel == 4 && panel_presets.hovered_tooltip_text != "" ? panel_presets.hovered_height :
        root.active_panel == 5 && panel_analyses.hovered_tooltip_text != "" ? panel_analyses.hovered_height :
        preview_hovered_tooltip != "" ? preview_card.hovered_height : 0px;

    title: root.file_loaded ? ("Correlation " + root.app_version + " - " + root.file_status_text) : ("Correlation " + root.app_version);
    icon: @image-url("../Images/Logo.png");
    background: MaterialPalette.background;
    default-font-size: MaterialTypography.body_small.font_size;
    default-font-weight: MaterialTypography.body_small.font_weight;
    default-font-family: "Outfit";
    min-width: 360px;
    min-height: 500px;
    preferred-width: 1180px;
    preferred-height: 795px;
    maximized: true;

    forward_focus: main_focus;

    // ============================================================================
    // Main UI structure
    // ============================================================================
    main_focus := FocusScope {
        key-pressed(event) => {
            if (event.modifiers.control && (event.text == "o" || event.text == "O")) {
                root.browse_file();
                return accept;
            }
            if (event.modifiers.control && (event.text == "r" || event.text == "R")) {
                if (root.file_loaded && !root.has_validation_errors && !root.analysis_running) {
                    root.run_analysis();
                }
                return accept;
            }
            if (event.text == Key.Escape) {
                if (root.analysis_running) {
                    root.cancel_analysis();
                }
                return accept;
            }
            if (event.modifiers.control && event.modifiers.shift && (event.text == "s" || event.text == "S")) {
                if (root.selected_plot_index >= 0) {
                    root.save_plot();
                }
                return accept;
            }
            if (event.modifiers.control && (event.text == "s" || event.text == "S")) {
                if (root.analysis_done) {
                    root.write_files();
                }
                return accept;
            }
            if (event.modifiers.control && (event.text == "d" || event.text == "D")) {
                Palette.color-scheme = Palette.color-scheme == ColorScheme.dark ? ColorScheme.light : ColorScheme.dark;
                return accept;
            }
            if (event.modifiers.control && event.text == "]") {
                if (root.plot_items.length > 0) {
                    root.select_plot(Math.min(root.selected_plot_index + 1, root.plot_items.length - 1));
                }
                return accept;
            }
            if (event.modifiers.control && event.text == "[") {
                if (root.plot_items.length > 0) {
                    root.select_plot(Math.max(root.selected_plot_index - 1, 0));
                }
                return accept;
            }
            return reject;
        }

        VerticalLayout {
            padding: 0;
            spacing: 0;

            Horizontal {
                spacing: 2px;
                padding-left: 2px;
                padding-right: 4px;
                padding-top: 4px;
                padding-bottom: 2px;
                vertical-stretch: 1;

                // 0. Far-Left Activity Bar (MiniSideBar) - Fixed 48px
                mini_sidebar := MiniSideBar {
                    active_panel <=> root.active_panel;
                    file_loaded: root.file_loaded;
                    analysis_running: root.analysis_running;
                    has_validation_errors: root.has_validation_errors;
                    is_dark: root.is_dark;
                    select_panel(id) => {
                        if (id >= 0) {
                            root.last_active_panel = id;
                            root.active_panel = id;
                            root.left_col_width = Math.max(180px, root.last_col_width);
                            root.layout_geometry_changed(root.left_col_width, root.middle_col_width);
                        } else {
                            if (root.active_panel >= 0) {
                                root.last_active_panel = root.active_panel;
                            }
                            root.active_panel = -1;
                        }
                    }
                    run_analysis => { root.run_analysis(); }
                    cancel_analysis => { root.cancel_analysis(); }
                    toggle_theme => {
                        Palette.color-scheme = Palette.color-scheme == ColorScheme.dark ? ColorScheme.light : ColorScheme.dark;
                    }
                    toggle_collapse => {
                        if (root.active_panel >= 0) {
                            root.last_active_panel = root.active_panel;
                            root.active_panel = -1;
                        } else {
                            root.active_panel = root.last_active_panel >= 0 ? root.last_active_panel : 0;
                            root.left_col_width = Math.max(180px, root.last_col_width);
                            root.layout_geometry_changed(root.left_col_width, root.middle_col_width);
                        }
                    }
                }

                // 1. Single Active Panel Column (Column 1)
                Vertical {
                    padding: 0;
                    width: root.active_panel == -1 ? 0px : root.left_col_width;
                    visible: root.active_panel >= 0;
                    horizontal-stretch: 0;
                    spacing: 0;

                    // Panel Header with Title and Close Button
                    Horizontal {
                        height: 36px;
                        padding-left: 8px;
                        padding-right: 4px;
                        alignment: center;

                        MaterialText {
                            text: root.active_panel == 0 ? "Operations" :
                                root.active_panel == 1 ? "Common Options" :
                                root.active_panel == 2 ? "Advanced Options" :
                                root.active_panel == 3 ? "Plot & Export" :
                                root.active_panel == 4 ? "Presets" : "Analyses";
                            style: MaterialTypography.title_small;
                            color: MaterialPalette.on_surface;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }

                        IconButton {
                            icon: Icons.close;
                            tooltip: "Close Panel";
                            inline: true;
                            clicked => {
                                if (root.active_panel >= 0) {
                                    root.last_active_panel = root.active_panel;
                                }
                                root.active_panel = -1;
                            }
                        }
                    }

                    // Panel Content Area (Starts at the top, occupies 100% remaining height)
                    Rectangle {
                        vertical-stretch: 1;

                        // Panel 0: Operations
                        panel_operations := OperationsPanelCard {
                            x: 0;
                            y: 0;
                            width: 100%;
                            height: 100%;
                            visible: root.active_panel == 0;
                            load_enabled: !root.timer_running;
                            file_loading: root.file_loading;
                            browse_file => {
                                root.browse_file();
                            }
                            file_status_text <=> root.file_status_text;
                            file_loaded: root.file_loaded;
                            num_frames: root.num_frames;
                            total_atoms: root.total_atoms;
                            removed_frames_count: root.removed_frames_count;
                            atom_counts: root.atom_counts;

                            material_type <=> root.material_type;
                            time_step <=> root.analysis_options.time_step;
                            time_step_error: root.app_errors.time_step_error;
                            min_frame <=> root.analysis_options.min_frame;
                            max_frame <=> root.analysis_options.max_frame;
                            min_frame_error: root.app_errors.min_frame_error;
                            max_frame_error: root.app_errors.max_frame_error;
                            reset_trajectory_options => {
                                root.reset_trajectory_options();
                            }
                            reset_material_type => {
                                root.reset_material_type();
                            }

                            analysis_running: root.analysis_running;
                            has_validation_errors: root.has_validation_errors;
                            run_analysis => {
                                root.run_analysis();
                            }
                            cancel_analysis => {
                                root.cancel_analysis();
                            }
                        }

                        // Panel 1: Common Options
                        panel_common := CommonOptionsPanelCard {
                            x: 0;
                            y: 0;
                            width: 100%;
                            height: 100%;
                            visible: root.active_panel == 1;
                            file_loaded: root.file_loaded;
                            has_radial_active: root.has_radial_active;
                            has_angular_active: root.has_angular_active;

                            diff_msd: root.diff_msd;
                            diff_vacf: root.diff_vacf;
                            relaxation_time: root.relaxation_time;
                            deborah_number: root.deborah_number;

                            atom_counts: root.atom_counts;
                            bond_cutoffs <=> root.bond_cutoffs;
                            bond_cutoffs_reset_trigger: root.bond_cutoffs_reset_trigger;
                            reset_bond_cutoffs => {
                                root.reset_bond_cutoffs();
                            }

                            r_max <=> root.analysis_options.r_max;
                            r_bin_width <=> root.analysis_options.r_bin_width;
                            r_max_error: root.app_errors.r_max_error;
                            r_bin_error: root.app_errors.r_bin_error;
                            reset_rdf_options => {
                                root.reset_rdf_options();
                            }

                            angle_bin_width <=> root.analysis_options.angle_bin_width;
                            dihedral_bin_width <=> root.analysis_options.dihedral_bin_width;
                            angle_bin_error: root.app_errors.angle_bin_error;
                            dihedral_bin_error: root.app_errors.dihedral_bin_error;
                            reset_angle_options => {
                                root.reset_angle_options();
                            }
                        }

                        // Panel 2: Advanced Options
                        panel_advanced := AdvancedOptionsPanelCard {
                            x: 0;
                            y: 0;
                            width: 100%;
                            height: 100%;
                            visible: root.active_panel == 2;
                            file_loaded: root.file_loaded;
                            has_scattering_active: root.has_scattering_active;
                            has_rings_active: root.has_rings_active;

                            q_max <=> root.analysis_options.q_max;
                            q_bin_width <=> root.analysis_options.q_bin_width;
                            r_int_max <=> root.analysis_options.r_int_max;
                            q_max_error: root.app_errors.q_max_error;
                            q_bin_error: root.app_errors.q_bin_error;
                            r_int_max_error: root.app_errors.r_int_max_error;
                            reset_sq_options => {
                                root.reset_sq_options();
                            }

                            max_ring_size <=> root.analysis_options.max_ring_size;
                            max_ring_error: root.app_errors.max_ring_error;
                            reset_rings_options => {
                                root.reset_rings_options();
                            }

                            smoothing_enabled <=> root.analysis_options.smoothing_enabled;
                            smoothing_sigma <=> root.analysis_options.smoothing_sigma;
                            smoothing_kernel <=> root.analysis_options.smoothing_kernel;
                            smoothing_sigma_error: root.app_errors.smoothing_sigma_error;
                            reset_smoothing_options => {
                                root.reset_smoothing_options();
                            }

                            lef_cutoff <=> root.analysis_options.lef_cutoff;
                            lef_sigma <=> root.analysis_options.lef_sigma;
                            hyper_samples <=> root.analysis_options.hyper_samples;
                            lef_cutoff_error: root.app_errors.lef_cutoff_error;
                            lef_sigma_error: root.app_errors.lef_sigma_error;
                            hyper_samples_error: root.app_errors.hyper_samples_error;
                            reset_advanced_options => {
                                root.reset_advanced_options();
                            }
                        }

                        // Panel 3: Plot & Export
                        panel_plot_export := PlotExportPanelCard {
                            x: 0;
                            y: 0;
                            width: 100%;
                            height: 100%;
                            visible: root.active_panel == 3;
                            enabled: root.file_loaded;

                            comparison_curves: root.comparison_curves;
                            show_difference: root.show_difference;
                            pin_current_run => {
                                root.pin_run();
                            }
                            import_comparison_file => {
                                root.import_comparison_file();
                            }
                            remove_comparison_curve(id) => {
                                root.remove_comparison_curve(id);
                            }
                            toggle_difference_plot(show) => {
                                root.toggle_difference_plot(show);
                            }
                            clear_comparison_curves => {
                                root.clear_comparison_curves();
                            }

                            export_size_preset <=> root.export_size_preset;
                            export_palette <=> root.export_palette;
                            export_font_scale <=> root.export_font_scale;
                            export_line_width <=> root.export_line_width;
                            export_marker_size <=> root.export_marker_size;
                            export_show_legend <=> root.export_show_legend;
                            export_show_grid <=> root.export_show_grid;
                            export_show_markers <=> root.export_show_markers;
                            export_fill_area <=> root.export_fill_area;
                            export_font_scale_error: root.export_font_scale_error;
                            export_line_width_error: root.export_line_width_error;
                            export_marker_size_error: root.export_marker_size_error;
                            reset_export_settings => {
                                root.reset_export_settings();
                            }
                        }

                        // Panel 4: Presets
                        panel_presets := PresetsPanelCard {
                            x: 0;
                            y: 0;
                            width: 100%;
                            height: 100%;
                            visible: root.active_panel == 4;
                            enabled: root.file_loaded;

                            preset_items: root.preset_items;
                            selected_preset <=> root.selected_preset;
                            load_preset(idx) => {
                                root.load_preset(idx);
                            }
                            save_preset(name) => {
                                root.save_preset(name);
                            }
                            delete_preset(idx) => {
                                root.delete_preset(idx);
                            }
                            reset_presets => {
                                root.reset_presets();
                            }
                        }

                        // Panel 5: Analyses
                        panel_analyses := AnalysesPanelCard {
                            x: 0;
                            y: 0;
                            width: 100%;
                            height: 100%;
                            visible: root.active_panel == 5;
                            file_loaded: root.file_loaded;

                            calculator_groups: root.calculator_groups;
                            total_calculator_count: root.total_calculator_count;
                            toggle_calculator(id, enabled) => {
                                root.toggle_calculator(id, enabled);
                            }
                            reset_analyses_selection => {
                                root.reset_analyses_selection();
                            }
                        }
                    }
                }

                // Splitter Handle between Column 1 and Column 2
                splitter_handle := SplitterHandle {
                    visible: (root.active_panel >= 0 || self.is_dragging) && root.width >= 500px;
                    moved(delta) => {
                        let current_w = root.active_panel == -1 ? 0px : root.left_col_width;
                        let target_w = current_w + delta;
                        if (target_w < 100px) {
                            if (root.active_panel >= 0) {
                                root.last_active_panel = root.active_panel;
                            }
                            root.active_panel = -1;
                        } else if (target_w < 180px) {
                            if (root.active_panel == -1) {
                                root.active_panel = root.last_active_panel >= 0 ? root.last_active_panel : 0;
                            }
                            root.left_col_width = 180px;
                            root.last_col_width = 180px;
                            root.layout_geometry_changed(root.left_col_width, root.middle_col_width);
                        } else {
                            if (root.active_panel == -1) {
                                root.active_panel = root.last_active_panel >= 0 ? root.last_active_panel : 0;
                            }
                            root.left_col_width = Math.min(450px, target_w);
                            root.last_col_width = root.left_col_width;
                            root.layout_geometry_changed(root.left_col_width, root.middle_col_width);
                        }
                    }
                    reset => {
                        root.left_col_width = 220px;
                        root.last_col_width = 220px;
                        root.layout_geometry_changed(root.left_col_width, root.middle_col_width);
                    }
                }

                // 2. Right column: Visual Preview Card (Column 2)
                Rectangle {
                    horizontal-stretch: 1;
                    min-width: 200px;
                    visible: root.active_panel == -1 || root.width >= 500px;

                    Vertical {
                        width: 100%;
                        height: 100%;
                        padding: 0;
                        opacity: root.analysis_done ? 1.0 : 0.45;
                        animate opacity { duration: 150ms; }

                        preview_card := PreviewCard {
                            enabled: root.analysis_done;
                            analysis_done: root.analysis_done;
                            vertical-stretch: 1;
                            horizontal-stretch: 1;
                            preview_plot <=> root.preview_plot;
                            plot_items <=> root.plot_items;
                            curve_toggle_items: root.curve_toggle_items;
                            selected_plot_index <=> root.selected_plot_index;
                            pinned_runs_count: root.pinned_runs_count;

                            table_headers: root.table_headers;
                            table_rows: root.table_rows;

                            plot_selected(idx) => {
                                root.select_plot(idx);
                            }
                            toggle_curve_visibility(id, vis) => {
                                root.toggle_curve_visibility(id, vis);
                            }
                            toggle_all_curves(vis) => {
                                root.toggle_all_curves(vis);
                            }
                            set_curve_color(id, col) => {
                                root.set_curve_color(id, col);
                            }
                            save_plot => {
                                root.save_plot();
                            }
                            write_files => {
                                root.write_files();
                            }
                            pin_run => {
                                root.pin_run();
                            }
                            clear_pinned_runs => {
                                root.clear_pinned_runs();
                            }
                            mouse_move(mx, my, hover, w, h) => {
                                root.mouse_move(mx, my, hover, w, h);
                            }
                            plot_resized(w, h) => {
                                root.plot_resized(w, h);
                            }
                        }
                    }
                }
            }

            AppFooter {
                status_text: root.analysis_running ? root.analysis_status_text :
                    root.analysis_done ? "Analysis complete — results ready" :
                    root.file_loaded ? root.file_status_text : "Ready";
                progress: root.progress;
                analysis_running: root.analysis_running;
                update_available: root.update_available;
                update_version: root.update_version;
                update_url: root.update_url;
                open_url(url) => {
                    root.open_url(url);
                }
            }
        }
    }

    AppToolTips {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        hovered_x: root.hovered_x;
        hovered_y: root.hovered_y;
        hovered_width: root.hovered_width;
        hovered_height: root.hovered_height;
        hovered_tooltip_text: root.hovered_tooltip_text;
    }
}
