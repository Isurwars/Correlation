        q_max: "20.0",
        q_bin_width: "0.02",
        r_int_max: "10.0",
        angle_bin_width: "1.0",
        dihedral_bin_width: "1.0",
        max_ring_size: "12",
        smoothing_sigma: "0.01",
        smoothing_kernel: 0,
        smoothing_enabled: true,
        min_frame: "0",
        max_frame: "End",
        time_step: "1.0",
        frame_stride: "1",
        material_type: 0,
        lef_cutoff: "5.0",
        lef_sigma: "0.2",
        hyper_samples: "10000",
        vacf_max_lag: "-1",
        vdos_window: 0,
        vdos_zero_pad: "4",
        xrd_radiation_preset: 0,
        xrd_lambda: "1.5406",
        xrd_theta_min: "10.0",
        xrd_theta_max: "140.0",
        xrd_bin_width: "0.05"
    };
    in-out property <AppErrors> app_errors;
