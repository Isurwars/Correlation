import {
    MaterialPalette,
    MaterialStyleMetrics,
    MaterialTypography,
    MaterialText,
    MenuItem,
    Vertical,
    Horizontal,
    Icons,
    FilledButton,
    IconButton,
    ScrollView,
    SplitterHandle,
    TabItem,
    ToolTip,
} from "material/material.slint";
import { Palette } from "std-widgets.slint";

import {
    AtomCount,
    BondCutoff,
    CalibrationPair,
    CalculatorInfo,
    CalculatorGroup,
    AnalysisOptions,
    AppErrors,
    ExportConfig,
    ExportFormatOptions,
    ExportAnalysisItem,
    TableRow,
    CurveToggleItem,
    ComparisonCurveData,
    FileMetadata,
    WorkflowState,
    SanityBadgeState,
    DomainPresetItem,
} from "Types.slint";

import { MiniSideBar } from "nav/MiniSideBar.slint";
import { SidePanelHost } from "nav/SidePanelHost.slint";
import { AppFooter } from "nav/AppFooter.slint";
import { PreviewCard } from "cards/preview/PreviewCard.slint";

export {
    AtomCount,
    BondCutoff,
    CalibrationPair,
    CalculatorInfo,
    CalculatorGroup,
    AnalysisOptions,
    AppErrors,
    ExportConfig,
    ExportFormatOptions,
    ExportAnalysisItem,
    TableRow,
    CurveToggleItem,
    ComparisonCurveData,
    FileMetadata,
    WorkflowState,
}

// ============================================================================
// AppWindow Component
// ============================================================================
/// This is the main window component for the Correlation application.
/// 
/// C++ Binding Architecture:
/// - The `AppWindow` instance is managed by the `AppController` in C++.
/// - Root properties (like `file_loaded`, `progress`, etc.) are bound to 
///   the `AppController` and `AppBackend` states.
/// - Callbacks (like `run_analysis`, `browse_file`) are mapped to methods in
///   the `AppController` to handle user interactions.
/// - hovered_tooltip_text: A string that is dynamically updated based on the
///   hovered component.
// ============================================================================

// ============================================================================
export component AppWindow inherits Window {
    // ============================================================================
    // Global Properties
    // ============================================================================
    
    /// Status of the file dialog timer
    in property <bool> timer_running: false;

    /// Application version string
    in-out property <string> app_version: "v4.0.2";

    /// GitHub Update Check status
    in-out property <bool> update_available: false;
    in-out property <string> update_version: "";
    in-out property <string> update_url: "https://github.com/Isurwars/Correlation/releases";
    callback open_url(string);

    /// File status and metadata
    in property <bool> file_loaded: false;
    in property <bool> file_loading: false;
    in property <int> num_frames: 0;
    in property <int> total_atoms: 0;
    in property <int> removed_frames_count: 0;
    in property <[AtomCount]> atom_counts: [];
    in-out property <string> file_status_text: "No file loaded.";
    in-out property <string> file_basename: "";
    in property <string> box_volume: "";
    in property <string> box_density: "";
    in property <string> box_dimensions: "";
    in-out property <int> preview_active_tab: 0;
    callback reload_file();

    /// Analysis execution state
    in property <bool> analysis_running: false;
    in property <bool> analysis_done: false;
    in property <float> progress: 0.0;
    in property <bool> text_opacity: false;
    in-out property <string> analysis_status_text: "Ready to run analysis.";

    /// Analysis configuration properties
    in-out property <string> in_file_text;
    in property <bool> hdf5_available: true;
    in property <bool> parquet_available: true;
    in-out property <AnalysisOptions> analysis_options: {
        r_max: "20.0",
        r_bin_width: "0.02",
        q_max: "20.0",
        q_bin_width: "0.02",
        r_int_max: "10.0",
        angle_bin_width: "1.0",
        dihedral_bin_width: "1.0",
        max_ring_size: "12",
        smoothing_sigma: "0.01",
        smoothing_kernel: 0,
        smoothing_enabled: true,
        min_frame: "0",
        max_frame: "End",
        time_step: "1.0",
        frame_stride: "1",
        material_type: 0,
        lef_cutoff: "5.0",
        lef_sigma: "0.2",
        hyper_samples: "10000",
        xrd_radiation_preset: 0,
        xrd_lambda: "1.5406",
        xrd_theta_min: "10.0",
        xrd_theta_max: "140.0",
        xrd_bin_width: "0.05"
    };
    in-out property <AppErrors> app_errors;
    in-out property <[BondCutoff]> bond_cutoffs: [];
    in-out property <int> bond_cutoffs_reset_trigger: 0;
    in-out property <ExportConfig> export_config: {
        size_preset: 0,
        palette: 0,
        font_scale: "1.0",
        line_width: "3.0",
        marker_size: "3.5",
        show_legend: true,
        show_grid: true,
        show_markers: false,
        fill_area: false
    };

    in-out property <int> material_type <=> analysis_options.material_type;

    // Global: any validation error prevents running analysis
    in-out property <bool> has_validation_errors: false;

    // Presets properties
    in property <[MenuItem]> preset_items: [];
    in-out property <int> selected_preset: -1;

    /// Dynamic calculator groups from CalculatorFactory via C++
    in-out property <[CalculatorGroup]> calculator_groups: [];
    in property <int> total_calculator_count: 0;

    /// Active group flags for auto-hiding option cards
    in property <bool> has_radial_active: false;
    in property <bool> has_scattering_active: false;
    in property <bool> has_angular_active: false;
    in property <bool> has_rings_active: false;

    in property <image> preview_plot;
    in property <[MenuItem]> plot_items: [];
    in property <[CurveToggleItem]> curve_toggle_items: [];
    in-out property <int> selected_plot_index: -1;
    in property <int> pinned_runs_count: 0;
    out property <bool> is_dark: Palette.color_scheme == ColorScheme.dark;

    in-out property <string> hover_coord_text: "";
    in-out property <bool> has_active_zoom: false;
    in-out property <int> markers_count: 0;
    in-out property <[CalibrationPair]> calibration_pairs: [];
    in-out property <int> active_calibration_pair_index: 0;
    in-out property <SanityBadgeState> sanity_badge_state: {
        severity: 0,
        title: "Optimal Cutoffs",
        message: "All bond cutoffs satisfy PBC and covalent bounds.",
        has_fix: false,
        fix_action: 0,
        fix_label: "",
    };
    in property <[DomainPresetItem]> domain_presets: [];

    // Table data and calculated scalar properties
    in property <[string]> table_headers: [];
    in property <[TableRow]> table_rows: [];
    in property <string> diff_msd: "";
    in property <string> diff_vacf: "";
    in property <string> relaxation_time: "";
    in property <string> deborah_number: "";

    in property <[ComparisonCurveData]> comparison_curves: [];
    in property <bool> show_difference: false;

    // 3D Viewport properties
    in property <image> structure_3d_image;
    in-out property <int> structure_3d_current_frame: 0;
    in property <int> structure_3d_total_frames: 0;
    in property <bool> structure_3d_bonds_enabled: true;
    in property <bool> structure_3d_wireframe_enabled: true;
    in-out property <bool> structure_3d_in_cell: false;
    // Phase Search properties
    in-out property <bool> structure_3d_phase_panel_open: false;
    in property <bool> structure_3d_phase_enabled: false;
    in property <int> structure_3d_phase_preset: 0;
    in property <int> structure_3d_phase_descriptor: 0;
    in property <int> structure_3d_phase_colormap: 0;
    in property <float> structure_3d_phase_min_threshold: 0.46;
    in property <float> structure_3d_phase_max_threshold: 0.58;
    in property <float> structure_3d_phase_domain_min: 0.0;
    in property <float> structure_3d_phase_domain_max: 1.0;
    in property <float> structure_3d_phase_halo_intensity: 0.85;
    in property <float> structure_3d_phase_halo_radius_ratio: 1.35;
    in property <bool> structure_3d_phase_dim_non_matching: false;
    in property <[float]> structure_3d_phase_histogram_counts: [];
    in property <int> structure_3d_phase_matching_atoms: 0;
    in property <int> structure_3d_phase_total_atoms: 0;
    in property <string> structure_3d_phase_descriptor_name: "q̄₆";
    in property <image> structure_3d_phase_colorbar_image;

    // Resizable layout geometry properties
    in-out property <length> left_col_width: 220px;
    in-out property <length> last_col_width: 220px;
    in-out property <length> middle_col_width: 220px;
    in-out property <int> active_panel: 0;
    in-out property <int> last_active_panel: 0;

    // Export Options Properties & Callbacks
    in-out property <ExportFormatOptions> export_format_options: {
        export_csv: true,
        export_hdf5: false,
        export_arrow: false,
        export_images: true,
        use_zip: false,
    };
    in-out property <[ExportAnalysisItem]> export_analysis_items: [];
    in-out property <bool> export_all_analyses: true;
    callback toggle_export_analysis(string, bool);
    callback toggle_all_export_analyses(bool);
    callback reset_export_options();

    // Callbacks (Bound to AppController.cpp)
    callback layout_geometry_changed(length, length);
    callback browse_file();
    callback run_analysis();
    callback cancel_analysis();
    callback write_files();
    callback select_plot(int);
    callback toggle_curve_visibility(int, bool);
    callback toggle_all_curves(bool);
    callback set_curve_color(int, string);
    callback toggle_calculator(string, bool);
    callback save_plot();
    callback pin_run();
    callback clear_pinned_runs();
    callback import_comparison_file();
    callback remove_comparison_curve(int);
    callback toggle_difference_plot(bool);
    callback validate_inputs();
    callback mouse_move(length, length, bool, length, length);
    callback plot_resized(length, length);
    callback zoom_to_rect(float, float, float, float);
    callback plot_pan(float, float);
    callback plot_wheel_zoom(float, float, float);
    callback reset_zoom();
    callback add_marker_at(float, float, bool);
    callback add_marker(bool);
    callback clear_markers();

    // 3D Viewport callbacks
    callback rotate_3d(float, float);
    callback pan_3d(float, float);
    callback zoom_3d(float);
    callback reset_view_3d();
    callback toggle_bonds_3d(bool);
    callback toggle_wireframe_3d(bool);
    callback toggle_in_cell_3d(bool);
    callback seek_frame_3d(int);
    callback step_frame_3d(bool);
    callback viewport_3d_resized(length, length);
    callback preview_tab_changed(int);
    callback toggle_phase_search_3d(bool);
    callback set_phase_preset_3d(int);
    callback set_phase_descriptor_3d(int);
    callback set_phase_colormap_3d(int);
    callback set_phase_thresholds_3d(float, float);
    callback set_phase_intensity_3d(float);
    callback set_phase_radius_ratio_3d(float);
    callback set_phase_dim_non_matching_3d(bool);

    // Presets callbacks
    callback export_config_changed();
    callback load_preset(int);
    callback save_preset(string);
    callback delete_preset(int);
    callback reset_presets();
    callback material_type_changed(int);
    callback reset_bond_cutoffs();
    callback reset_rdf_options();
    callback reset_angle_options();
    callback reset_sq_options();
    callback reset_xrd_options();
    callback xrd_radiation_preset_changed(int);
    callback apply_min_factor(float);
    callback apply_max_factor(float);
    callback apply_global_cutoff(float);
    callback apply_scaled_cutoffs(float);
    callback set_uniform_cutoff(float);
    callback reset_rings_options();
    callback reset_smoothing_options();
    callback reset_advanced_options();
    callback reset_trajectory_options();
    callback reset_export_settings();
    callback reset_analyses_selection();
    callback reset_material_type();
    callback clear_comparison_curves();
    callback select_calibration_pair(int);
    callback auto_detect_cutoff(int);
    callback reset_calibration_pair(int);
    callback drag_cutoff_handle(int, bool, length);
    callback fix_sanity_issue(int);
    callback apply_domain_preset(int);

    // ============================================================================
    // Core Layout Logic
    // ============================================================================
    

    changed analysis_options => {
        root.validate_inputs();
    }
    changed material_type => {
        root.material_type_changed(root.material_type);
    }
    changed export_config => {
        root.validate_inputs();
        root.select_plot(root.selected_plot_index);
    }
    changed is_dark => {
        root.select_plot(root.selected_plot_index);
    }
    changed analysis_done => {
        if root.analysis_done {
            root.active_panel = 5;
        }
    }

    /// hovered_tooltip_text: Dynamically update based on the currently
    ///   hovered component.
    property <string> active_panel_tooltip: side_panel_host.hovered_tooltip_text;

    property <string> preview_hovered_tooltip: preview_card.hovered_tooltip_text;

    property <string> hovered_tooltip_text: 
        mini_sidebar.hovered_tooltip_text != "" ? mini_sidebar.hovered_tooltip_text :
        active_panel_tooltip != "" ? active_panel_tooltip : preview_hovered_tooltip;

    property <length> hovered_x:
        mini_sidebar.hovered_tooltip_text != "" ? mini_sidebar.hovered_x :
        side_panel_host.hovered_tooltip_text != "" ? side_panel_host.hovered_x :
        preview_hovered_tooltip != "" ? preview_card.hovered_x : 0px;

    property <length> hovered_y:
        mini_sidebar.hovered_tooltip_text != "" ? mini_sidebar.hovered_y :
        side_panel_host.hovered_tooltip_text != "" ? side_panel_host.hovered_y :
        preview_hovered_tooltip != "" ? preview_card.hovered_y : 0px;

    property <length> hovered_width:
        mini_sidebar.hovered_tooltip_text != "" ? mini_sidebar.hovered_width :
        side_panel_host.hovered_tooltip_text != "" ? side_panel_host.hovered_width :
        preview_hovered_tooltip != "" ? preview_card.hovered_width : 0px;

    property <length> hovered_height:
        mini_sidebar.hovered_tooltip_text != "" ? mini_sidebar.hovered_height :
        side_panel_host.hovered_tooltip_text != "" ? side_panel_host.hovered_height :
        preview_hovered_tooltip != "" ? preview_card.hovered_height : 0px;

    title: root.file_loaded ? ("Correlation " + root.app_version + " - " + root.file_status_text) : ("Correlation " + root.app_version);
    icon: @image-url("../Images/Logo.png");
    background: MaterialPalette.background;
    default-font-size: MaterialTypography.body_small.font_size;
    default-font-weight: MaterialTypography.body_small.font_weight;
    default-font-family: "Outfit";
    min-width: 360px;
    min-height: 500px;
    preferred-width: 1180px;
    preferred-height: 795px;
    maximized: true;

    forward_focus: main_focus;

    // ============================================================================
    // Main UI structure
    // ============================================================================
    main_focus := FocusScope {
        key-pressed(event) => {
            if (event.modifiers.control && (event.text == "o" || event.text == "O")) {
                root.browse_file();
                return accept;
            }
            if (event.modifiers.control && (event.text == "r" || event.text == "R")) {
                if (root.file_loaded && !root.has_validation_errors && !root.analysis_running) {
                    root.run_analysis();
                }
                return accept;
            }
            if (event.text == Key.Escape) {
                if (root.analysis_running) {
                    root.cancel_analysis();
                }
                return accept;
            }
            if (event.modifiers.control && event.modifiers.shift && (event.text == "s" || event.text == "S")) {
                if (root.selected_plot_index >= 0) {
                    root.save_plot();
                }
                return accept;
            }
            if (event.modifiers.control && (event.text == "s" || event.text == "S")) {
                if (root.analysis_done) {
                    root.write_files();
                }
                return accept;
            }
            if (event.modifiers.control && (event.text == "d" || event.text == "D")) {
                Palette.color-scheme = Palette.color-scheme == ColorScheme.dark ? ColorScheme.light : ColorScheme.dark;
                return accept;
            }
            if (event.modifiers.control && event.text == "]") {
                if (root.plot_items.length > 0) {
                    root.select_plot(Math.min(root.selected_plot_index + 1, root.plot_items.length - 1));
                }
                return accept;
            }
            if (event.modifiers.control && event.text == "[") {
                if (root.plot_items.length > 0) {
                    root.select_plot(Math.max(root.selected_plot_index - 1, 0));
                }
                return accept;
            }
            return reject;
        }

        VerticalLayout {
            padding: 0;
            spacing: 0;

            Horizontal {
                spacing: 2px;
                padding-left: 2px;
                padding-right: 4px;
                padding-top: 4px;
                padding-bottom: 2px;
                vertical-stretch: 1;

                // 0. Far-Left Activity Bar (MiniSideBar) - Fixed 48px
                mini_sidebar := MiniSideBar {
                    active_panel <=> root.active_panel;
                    file_loaded: root.file_loaded;
                    analysis_running: root.analysis_running;
                    has_validation_errors: root.has_validation_errors;
                    is_dark: root.is_dark;
                    select_panel(id) => {
                        if (id >= 0) {
                            root.last_active_panel = id;
                            root.active_panel = id;
                            root.left_col_width = Math.max(180px, root.last_col_width);
                            root.layout_geometry_changed(root.left_col_width, root.middle_col_width);
                        } else {
                            if (root.active_panel >= 0) {
                                root.last_active_panel = root.active_panel;
                            }
                            root.active_panel = -1;
                        }
                    }
                    run_analysis => { root.run_analysis(); }
                    cancel_analysis => { root.cancel_analysis(); }
                    toggle_theme => {
                        Palette.color-scheme = Palette.color-scheme == ColorScheme.dark ? ColorScheme.light : ColorScheme.dark;
                    }
                    toggle_collapse => {
                        if (root.active_panel >= 0) {
                            root.last_active_panel = root.active_panel;
                            root.active_panel = -1;
                        } else {
                            root.active_panel = root.last_active_panel >= 0 ? root.last_active_panel : 0;
                            root.left_col_width = Math.max(180px, root.last_col_width);
                            root.layout_geometry_changed(root.left_col_width, root.middle_col_width);
                        }
                    }
                }

                // 1. Single Active Panel Column (Column 1)
                side_panel_host := SidePanelHost {
                    width: root.active_panel == -1 ? 0px : root.left_col_width;
                    visible: root.active_panel >= 0;
                    horizontal-stretch: 0;

                    active_panel <=> root.active_panel;
                    last_active_panel <=> root.last_active_panel;

                    timer_running: root.timer_running;
                    file_metadata: {
                        loaded: root.file_loaded,
                        loading: root.file_loading,
                        status_text: root.file_status_text,
                        basename: root.file_basename,
                        num_frames: root.num_frames,
                        total_atoms: root.total_atoms,
                        removed_frames_count: root.removed_frames_count,
                        atom_counts: root.atom_counts,
                        box_volume: root.box_volume,
                        box_density: root.box_density,
                        box_dimensions: root.box_dimensions,
                    };
                    workflow_state: {
                        analysis_running: root.analysis_running,
                        analysis_done: root.analysis_done,
                        has_validation_errors: root.has_validation_errors,
                    };

                    material_type <=> root.material_type;
                    analysis_options <=> root.analysis_options;
                    app_errors: root.app_errors;

                    has_radial_active: root.has_radial_active;
                    has_angular_active: root.has_angular_active;
                    diff_msd: root.diff_msd;
                    diff_vacf: root.diff_vacf;
                    relaxation_time: root.relaxation_time;
                    deborah_number: root.deborah_number;
                    bond_cutoffs <=> root.bond_cutoffs;
                    bond_cutoffs_reset_trigger: root.bond_cutoffs_reset_trigger;
                    sanity_badge_state: root.sanity_badge_state;

                    has_scattering_active: root.has_scattering_active;
                    has_rings_active: root.has_rings_active;

                    comparison_curves: root.comparison_curves;
                    pinned_runs_count: root.pinned_runs_count;
                    show_difference: root.show_difference;
                    export_config <=> root.export_config;

                    calculator_groups <=> root.calculator_groups;
                    total_calculator_count: root.total_calculator_count;

                    export_format_options <=> root.export_format_options;
                    export_analysis_items <=> root.export_analysis_items;
                    export_all_analyses <=> root.export_all_analyses;
                    preset_items: root.preset_items;
                    selected_preset <=> root.selected_preset;

                    browse_file => { root.browse_file(); }
                    reload_file => { root.reload_file(); }
                    reset_trajectory_options => { root.reset_trajectory_options(); }
                    reset_material_type => { root.reset_material_type(); }
                    run_analysis => { root.run_analysis(); }
                    cancel_analysis => { root.cancel_analysis(); }

                    reset_bond_cutoffs => { root.reset_bond_cutoffs(); }
                    fix_sanity_issue(action) => { root.fix_sanity_issue(action); }
                    apply_min_factor(factor) => { root.apply_min_factor(factor); }
                    apply_max_factor(factor) => { root.apply_max_factor(factor); }
                    apply_global_cutoff(cutoff) => { root.apply_global_cutoff(cutoff); }
                    apply_scaled_cutoffs(factor) => { root.apply_scaled_cutoffs(factor); }
                    set_uniform_cutoff(max_val) => { root.set_uniform_cutoff(max_val); }
                    reset_rdf_options => { root.reset_rdf_options(); }
                    reset_angle_options => { root.reset_angle_options(); }

                    reset_sq_options => { root.reset_sq_options(); }
                    reset_xrd_options => { root.reset_xrd_options(); }
                    xrd_radiation_preset_changed(idx) => { root.xrd_radiation_preset_changed(idx); }
                    reset_rings_options => { root.reset_rings_options(); }
                    reset_smoothing_options => { root.reset_smoothing_options(); }
                    reset_advanced_options => { root.reset_advanced_options(); }

                    pin_run => { root.pin_run(); }
                    import_comparison_file => { root.import_comparison_file(); }
                    remove_comparison_curve(id) => { root.remove_comparison_curve(id); }
                    toggle_difference_plot(show) => { root.toggle_difference_plot(show); }
                    clear_comparison_curves => { root.clear_comparison_curves(); }
                    reset_export_settings => { root.reset_export_settings(); }

                    toggle_calculator(id, enabled) => { root.toggle_calculator(id, enabled); }
                    reset_analyses_selection => { root.reset_analyses_selection(); }

                    toggle_export_analysis(id, val) => { root.toggle_export_analysis(id, val); }
                    toggle_all_export_analyses(val) => { root.toggle_all_export_analyses(val); }
                    write_files => { root.write_files(); }
                    reset_export_options => { root.reset_export_options(); }
                    load_preset(idx) => { root.load_preset(idx); }
                    save_preset(name) => { root.save_preset(name); }
                    delete_preset(idx) => { root.delete_preset(idx); }
                    reset_presets => { root.reset_presets(); }
                }

                // Splitter Handle between Column 1 and Column 2
                splitter_handle := SplitterHandle {
                    visible: (root.active_panel >= 0 || self.is_dragging) && root.width >= 500px;
                    moved(delta) => {
                        let current_w = root.active_panel == -1 ? 0px : root.left_col_width;
                        let target_w = current_w + delta;
                        if (target_w < 100px) {
                            if (root.active_panel >= 0) {
                                root.last_active_panel = root.active_panel;
                            }
                            root.active_panel = -1;
                        } else if (target_w < 180px) {
                            if (root.active_panel == -1) {
                                root.active_panel = root.last_active_panel >= 0 ? root.last_active_panel : 0;
                            }
                            root.left_col_width = 180px;
                            root.last_col_width = 180px;
                            root.layout_geometry_changed(root.left_col_width, root.middle_col_width);
                        } else {
                            if (root.active_panel == -1) {
                                root.active_panel = root.last_active_panel >= 0 ? root.last_active_panel : 0;
                            }
                            root.left_col_width = Math.min(450px, target_w);
                            root.last_col_width = root.left_col_width;
                            root.layout_geometry_changed(root.left_col_width, root.middle_col_width);
                        }
                    }
                    reset => {
                        root.left_col_width = 220px;
                        root.last_col_width = 220px;
                        root.layout_geometry_changed(root.left_col_width, root.middle_col_width);
                    }
                }

                // 2. Right column: Visual Preview Card (Column 2)
                preview_card := PreviewCard {
                    horizontal-stretch: 1;
                    vertical-stretch: 1;
                    min-width: 200px;
                    visible: root.active_panel == -1 || root.width >= 500px;
                    active_tab <=> root.preview_active_tab;
                    analysis_done: root.analysis_done;
                    preview_plot <=> root.preview_plot;
                    plot_items <=> root.plot_items;
                    curve_toggle_items: root.curve_toggle_items;
                    selected_plot_index <=> root.selected_plot_index;
                    pinned_runs_count: root.pinned_runs_count;

                    file_loaded: root.file_loaded;
                    analysis_running: root.analysis_running;
                    file_basename: root.file_basename;
                    total_atoms: root.total_atoms;
                    num_frames: root.num_frames;

                    browse_file => { root.browse_file(); }
                    run_analysis => { root.run_analysis(); }
                    open_panel(id) => {
                        root.last_active_panel = id;
                        root.active_panel = id;
                        root.left_col_width = Math.max(180px, root.last_col_width);
                        root.layout_geometry_changed(root.left_col_width, root.middle_col_width);
                    }

                    table_headers: root.table_headers;
                    table_rows: root.table_rows;

                    plot_selected(idx) => {
                        root.select_plot(idx);
                    }
                    toggle_curve_visibility(id, vis) => {
                        root.toggle_curve_visibility(id, vis);
                    }
                    toggle_all_curves(vis) => {
                        root.toggle_all_curves(vis);
                    }
                    set_curve_color(id, col) => {
                        root.set_curve_color(id, col);
                    }
                    write_files => {
                        root.write_files();
                    }
                    pin_run => {
                        root.pin_run();
                    }
                    clear_pinned_runs => {
                        root.clear_pinned_runs();
                    }
                    mouse_move(mx, my, hover, w, h) => {
                        root.mouse_move(mx, my, hover, w, h);
                    }
                    plot_resized(w, h) => {
                        root.plot_resized(w, h);
                    }
                    hover_coord_text: root.hover_coord_text;
                    has_active_zoom: root.has_active_zoom;
                    markers_count: root.markers_count;
                    zoom_to_rect(x1, y1, x2, y2) => {
                        root.zoom_to_rect(x1, y1, x2, y2);
                    }
                    plot_pan(dx, dy) => {
                        root.plot_pan(dx, dy);
                    }
                    plot_wheel_zoom(mx, my, delta) => {
                        root.plot_wheel_zoom(mx, my, delta);
                    }
                    reset_zoom => {
                        root.reset_zoom();
                    }
                    add_marker_at(x, y, is_vert) => {
                        root.add_marker_at(x, y, is_vert);
                    }
                    add_marker(is_vert) => {
                        root.add_marker(is_vert);
                    }
                    clear_markers => {
                        root.clear_markers();
                    }

                    calibration_pairs: root.calibration_pairs;
                    active_calibration_pair_index <=> root.active_calibration_pair_index;
                    select_calibration_pair(idx) => { root.select_calibration_pair(idx); }
                    auto_detect_cutoff(idx) => { root.auto_detect_cutoff(idx); }
                    reset_calibration_pair(idx) => { root.reset_calibration_pair(idx); }
                    drag_cutoff_handle(idx, is_max, mx) => { root.drag_cutoff_handle(idx, is_max, mx); }

                    structure_3d_image: root.structure_3d_image;
                    structure_3d_current_frame <=> root.structure_3d_current_frame;
                    structure_3d_total_frames: root.structure_3d_total_frames;
                    structure_3d_bonds_enabled: root.structure_3d_bonds_enabled;
                    structure_3d_wireframe_enabled: root.structure_3d_wireframe_enabled;
                    structure_3d_in_cell: root.structure_3d_in_cell;

                    rotate_3d(dx, dy) => { root.rotate_3d(dx, dy); }
                    pan_3d(dx, dy) => { root.pan_3d(dx, dy); }
                    zoom_3d(delta) => { root.zoom_3d(delta); }
                    reset_view_3d => { root.reset_view_3d(); }
                    toggle_bonds_3d(enabled) => { root.toggle_bonds_3d(enabled); }
                    toggle_wireframe_3d(enabled) => { root.toggle_wireframe_3d(enabled); }
                    toggle_in_cell_3d(enabled) => {
                        root.structure_3d_in_cell = enabled;
                        root.toggle_in_cell_3d(enabled);
                    }
                    seek_frame_3d(idx) => { root.seek_frame_3d(idx); }
                    step_frame_3d(fwd) => { root.step_frame_3d(fwd); }
                    viewport_3d_resized(w, h) => { root.viewport_3d_resized(w, h); }
                    tab_changed(tab) => { root.preview_tab_changed(tab); }
                    structure_3d_phase_panel_open <=> root.structure_3d_phase_panel_open;
                    structure_3d_phase_enabled: root.structure_3d_phase_enabled;
                    structure_3d_phase_preset: root.structure_3d_phase_preset;
                    structure_3d_phase_descriptor: root.structure_3d_phase_descriptor;
                    structure_3d_phase_colormap: root.structure_3d_phase_colormap;
                    structure_3d_phase_min_threshold: root.structure_3d_phase_min_threshold;
                    structure_3d_phase_max_threshold: root.structure_3d_phase_max_threshold;
                    structure_3d_phase_domain_min: root.structure_3d_phase_domain_min;
                    structure_3d_phase_domain_max: root.structure_3d_phase_domain_max;
                    structure_3d_phase_halo_intensity: root.structure_3d_phase_halo_intensity;
                    structure_3d_phase_halo_radius_ratio: root.structure_3d_phase_halo_radius_ratio;
                    structure_3d_phase_dim_non_matching: root.structure_3d_phase_dim_non_matching;
                    structure_3d_phase_histogram_counts: root.structure_3d_phase_histogram_counts;
                    structure_3d_phase_matching_atoms: root.structure_3d_phase_matching_atoms;
                    structure_3d_phase_total_atoms: root.structure_3d_phase_total_atoms;
                    structure_3d_phase_descriptor_name: root.structure_3d_phase_descriptor_name;
                    structure_3d_phase_colorbar_image: root.structure_3d_phase_colorbar_image;

                    toggle_phase_search_3d(en) => { root.toggle_phase_search_3d(en); }
                    set_phase_preset_3d(idx) => { root.set_phase_preset_3d(idx); }
                    set_phase_descriptor_3d(idx) => { root.set_phase_descriptor_3d(idx); }
                    set_phase_colormap_3d(idx) => { root.set_phase_colormap_3d(idx); }
                    set_phase_thresholds_3d(min, max) => { root.set_phase_thresholds_3d(min, max); }
                    set_phase_intensity_3d(val) => { root.set_phase_intensity_3d(val); }
                    set_phase_radius_ratio_3d(val) => { root.set_phase_radius_ratio_3d(val); }
                    set_phase_dim_non_matching_3d(dim) => { root.set_phase_dim_non_matching_3d(dim); }
                }
            }

            AppFooter {
                status_text: root.analysis_running ? root.analysis_status_text :
                    root.analysis_done ? "Analysis complete — results ready" :
                    root.file_loaded ? root.file_status_text : "Ready";
                progress: root.progress;
                analysis_running: root.analysis_running;
                update_available: root.update_available;
                update_version: root.update_version;
                update_url: root.update_url;
                open_url(url) => {
                    root.open_url(url);
                }
            }
        }
    }

    ToolTip {
        hovered_x: root.hovered_x;
        hovered_y: root.hovered_y;
        hovered_width: root.hovered_width;
        hovered_height: root.hovered_height;
        parent_width: root.width;
        parent_height: root.height;
        visible: root.hovered_tooltip_text != "";
        text: root.hovered_tooltip_text;
    }
}
