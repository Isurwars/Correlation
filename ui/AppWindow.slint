    // ============================================================================
    // Core Layout Logic
    // ============================================================================
    

    changed analysis_options => {
        root.validate_inputs();
    }
    changed material_type => {
        root.material_type_changed(root.material_type);
    }
    changed export_config => {
        root.validate_inputs();
        root.select_plot(root.selected_plot_index);
    }
    changed is_dark => {
        root.select_plot(root.selected_plot_index);
    }
    changed analysis_done => {
        if root.analysis_done {
            root.active_panel = 3;
        }
    }

    /// hovered_tooltip_text: Dynamically update based on the currently
    ///   hovered component.
    property <string> active_panel_tooltip: side_panel_host.hovered_tooltip_text;
    property <string> right_panel_tooltip: right_side_panel_host.hovered_tooltip_text;
    property <string> preview_hovered_tooltip: preview_card.hovered_tooltip_text;

    property <string> hovered_tooltip_text: 
        active_panel_tooltip != "" ? active_panel_tooltip :
        right_panel_tooltip != "" ? right_panel_tooltip : preview_hovered_tooltip;

    property <length> hovered_x:
        side_panel_host.hovered_tooltip_text != "" ? side_panel_host.hovered_x :
        right_side_panel_host.hovered_tooltip_text != "" ? right_side_panel_host.hovered_x :
        preview_hovered_tooltip != "" ? preview_card.hovered_x : 0px;

    property <length> hovered_y:
        side_panel_host.hovered_tooltip_text != "" ? side_panel_host.hovered_y :
        right_side_panel_host.hovered_tooltip_text != "" ? right_side_panel_host.hovered_y :
        preview_hovered_tooltip != "" ? preview_card.hovered_y : 0px;

    property <length> hovered_width:
        side_panel_host.hovered_tooltip_text != "" ? side_panel_host.hovered_width :
        right_side_panel_host.hovered_tooltip_text != "" ? right_side_panel_host.hovered_width :
        preview_hovered_tooltip != "" ? preview_card.hovered_width : 0px;

    property <length> hovered_height:
        side_panel_host.hovered_tooltip_text != "" ? side_panel_host.hovered_height :
        right_side_panel_host.hovered_tooltip_text != "" ? right_side_panel_host.hovered_height :
        preview_hovered_tooltip != "" ? preview_card.hovered_height : 0px;

    title: root.file_loaded ? ("Correlation " + root.app_version + " - " + root.file_status_text) : ("Correlation " + root.app_version);
    icon: @image-url("../Images/Logo.png");
    background: MaterialPalette.background;
    default-font-size: MaterialTypography.body_small.font_size;
    default-font-weight: MaterialTypography.body_small.font_weight;
    default-font-family: "Outfit";
    min-width: 360px;
    min-height: 500px;
    preferred-width: 1180px;
    preferred-height: 795px;
    maximized: true;

    forward_focus: main_focus;

    // ============================================================================
    // Main UI structure
    // ============================================================================
    main_focus := FocusScope {

        key-released(event) => {
            root.shift_key_held = event.modifiers.shift;
            return reject;
        }

        key-pressed(event) => {
            root.shift_key_held = event.modifiers.shift;
            if (event.modifiers.control && (event.text == "k" || event.text == "K")) {
                root.shortcuts_modal_open = false;
                root.command_palette_open = !root.command_palette_open;
                return accept;
            }
            if (event.modifiers.control && event.text == "\\") {
                root.toggle_zen_mode();
                return accept;
            }
            if (event.text == "?" || event.text == Key.F1) {
                root.command_palette_open = false;
                root.shortcuts_modal_open = !root.shortcuts_modal_open;
                return accept;
            }
            if (event.text == Key.Escape) {
                if (root.command_palette_open) {
                    root.command_palette_open = false;
                    return accept;
                }
                if (root.shortcuts_modal_open) {
                    root.shortcuts_modal_open = false;
                    return accept;
                }
                if (root.structure_3d_measurement_text != "") {
                    root.clear_measurement_3d();
                    return accept;
                }
                if (root.structure_3d_inspected_atom.valid) {
                    root.clear_picked_atom_3d();
                    return accept;
                }
                if (root.analysis_running) {
                    root.cancel_analysis();
                    ToastState.show("Analysis cancelled", 2);
                }
                return accept;
            }
            if (event.modifiers.control && (event.text == "o" || event.text == "O")) {
                root.browse_file();
                return accept;
            }
            if (event.modifiers.control && (event.text == "e" || event.text == "E")) {
                if (root.file_loaded) {
                    root.export_structure();
                }
                return accept;
            }
            if (event.modifiers.control && (event.text == "r" || event.text == "R")) {
                if (root.file_loaded && !root.has_validation_errors && !root.analysis_running) {
                    root.run_analysis();
                }
                return accept;
            }
            if (event.modifiers.control && event.modifiers.shift && (event.text == "s" || event.text == "S")) {
                if (root.selected_plot_index >= 0) {
                    root.save_plot();
                }
                return accept;
            }
            if (event.modifiers.control && (event.text == "s" || event.text == "S")) {
                if (root.analysis_done) {
                    root.write_files();
                    ToastState.show("Exporting analysis data files...", 1);
                }
                return accept;
            }
            if (event.modifiers.control && (event.text == "d" || event.text == "D")) {
                Palette.color-scheme = Palette.color-scheme == ColorScheme.dark ? ColorScheme.light : ColorScheme.dark;
                ToastState.show(Palette.color-scheme == ColorScheme.dark ? "Switched to Dark Theme" : "Switched to Light Theme", 0);
                return accept;
            }
            if (event.modifiers.control && event.text == "]") {
                if (root.plot_items.length > 0) {
                    root.select_plot(Math.min(root.selected_plot_index + 1, root.plot_items.length - 1));
                }
                return accept;
            }
            if (event.modifiers.control && event.text == "[") {
                if (root.plot_items.length > 0) {
                    root.select_plot(Math.max(root.selected_plot_index - 1, 0));
                }
                return accept;
            }
            if (event.modifiers.control && (event.text == "c" || event.text == "C")) {
                if ((root.preview_active_tab == 0 || root.preview_active_tab == 2) && root.selected_plot_index >= 0) {
                    root.copy_plot_clipboard();
                    ToastState.show("Plot SVG copied to clipboard", 1);
                    return accept;
                }
            }
            if (event.text == " ") {
                if ((root.preview_active_tab == 1 || root.preview_active_tab == 2) && root.structure_3d_total_frames > 1) {
                    root.structure_3d_is_playing = !root.structure_3d_is_playing;
                    return accept;
                }
            }
            if (event.text == Key.LeftArrow) {
                if ((root.preview_active_tab == 1 || root.preview_active_tab == 2) && root.structure_3d_total_frames > 1) {
                    root.step_frame_3d(false);
                    return accept;
                }
            }
            if (event.text == Key.RightArrow) {
                if ((root.preview_active_tab == 1 || root.preview_active_tab == 2) && root.structure_3d_total_frames > 1) {
                    root.step_frame_3d(true);
                    return accept;
                }
            }
            if (event.text == "f" || event.text == "F") {
                if ((root.preview_active_tab == 1 || root.preview_active_tab == 2) && root.structure_3d_inspected_atom.valid) {
                    root.focus_picked_atom_3d();
                    return accept;
                }
            }
            if (event.text == "h" || event.text == "H") {
                if (root.preview_active_tab == 0) {
                    root.reset_zoom();
                    return accept;
                }
                if (root.preview_active_tab == 1) {
                    root.reset_view_3d();
                    return accept;
                }
                if (root.preview_active_tab == 2) {
                    root.reset_zoom();
                    root.reset_view_3d();
                    return accept;
                }
            }
            if (event.text == "1" || ((event.modifiers.alt || event.modifiers.control) && event.text == "1")) {
                root.preview_active_tab = 0;
                root.preview_tab_changed(0);
                if (root.active_right_panel >= 0) { root.active_right_panel = 0; }
                return accept;
            }
            if (event.text == "2" || ((event.modifiers.alt || event.modifiers.control) && event.text == "2")) {
                root.preview_active_tab = 1;
                root.preview_tab_changed(1);
                if (root.active_right_panel >= 0) { root.active_right_panel = 1; }
                return accept;
            }
            if (event.text == "3" || ((event.modifiers.alt || event.modifiers.control) && event.text == "3")) {
                root.preview_active_tab = 2;
                root.preview_tab_changed(2);
                return accept;
            }
            if (event.text == "4" || ((event.modifiers.alt || event.modifiers.control) && event.text == "4")) {
                root.preview_active_tab = 3;
                root.preview_tab_changed(3);
                return accept;
            }
            return reject;
        }

        VerticalLayout {
            width: 100%;
            height: 100%;
            padding: 0;

            Horizontal {
                spacing: 2px;
                padding-left: 2px;
                padding-right: 4px;
                padding-top: 4px;
                padding-bottom: 2px;
                vertical-stretch: 1;

                // 0. Far-Left Activity Bar (MiniSideBar) - Fixed 48px
                mini_sidebar := MiniSideBar {
                    active_panel <=> root.active_panel;
                    file_loaded: root.file_loaded;
                    analysis_running: root.analysis_running;
                    has_validation_errors: root.has_validation_errors;
                    is_dark: root.is_dark;
                    select_panel(id) => {
                        if (id >= 0) {
                            root.last_active_panel = id;
                            root.active_panel = id;
                            root.left_col_width = Math.max(180px, root.last_col_width);
                            root.layout_geometry_changed(root.left_col_width, root.middle_col_width);
                        } else {
                            if (root.active_panel >= 0) {
                                root.last_active_panel = root.active_panel;
                            }
                            root.active_panel = -1;
                        }
                    }
                    run_analysis => { root.run_analysis(); }
                    cancel_analysis => { root.cancel_analysis(); }
                    toggle_theme => {
                        Palette.color-scheme = Palette.color-scheme == ColorScheme.dark ? ColorScheme.light : ColorScheme.dark;
                        ToastState.show(Palette.color-scheme == ColorScheme.dark ? "Switched to Dark Theme" : "Switched to Light Theme", 0);
                    }
                    toggle_collapse => {
                        if (root.active_panel >= 0) {
                            root.last_active_panel = root.active_panel;
                            root.active_panel = -1;
                        } else {
                            root.active_panel = root.last_active_panel >= 0 ? root.last_active_panel : 0;
                            root.left_col_width = Math.max(180px, root.last_col_width);
                            root.layout_geometry_changed(root.left_col_width, root.middle_col_width);
                        }
                    }
                }

                // 1. Single Active Panel Column (Column 1)
                side_panel_host := SidePanelHost {
                    width: root.active_panel == -1 ? 0px : root.left_col_width;
                    visible: root.active_panel >= 0;
                    horizontal-stretch: 0;

                    active_panel <=> root.active_panel;
                    last_active_panel <=> root.last_active_panel;

                    timer_running: root.timer_running;
                    file_metadata: {
                        loaded: root.file_loaded,
                        loading: root.file_loading,
                        status_text: root.file_status_text,
                        basename: root.file_basename,
                        num_frames: root.num_frames,
                        total_atoms: root.total_atoms,
                        removed_frames_count: root.removed_frames_count,
                        atom_counts: root.atom_counts,
                        box_volume: root.box_volume,
                        box_density: root.box_density,
                        box_dimensions: root.box_dimensions,
                    };
                    workflow_state: {
                        analysis_running: root.analysis_running,
                        analysis_done: root.analysis_done,
                        has_validation_errors: root.has_validation_errors,
                    };

                    material_type <=> root.material_type;
                    analysis_options <=> root.analysis_options;
                    app_errors: root.app_errors;

                    has_radial_active: root.has_radial_active;
                    has_angular_active: root.has_angular_active;
                    physics_diagnostics: root.physics_diagnostics;
                    bond_cutoffs <=> root.bond_cutoffs;
                    bond_cutoffs_reset_trigger: root.bond_cutoffs_reset_trigger;
                    sanity_badge_state: root.sanity_badge_state;

                    has_scattering_active: root.has_scattering_active;
                    has_rings_active: root.has_rings_active;

                    comparison_curves: root.comparison_curves;
                    pinned_runs_count: root.pinned_runs_count;
                    show_difference: root.show_difference;
                    export_config <=> root.export_config;

                    calculator_groups <=> root.calculator_groups;
                    total_calculator_count: root.total_calculator_count;
                    enabled_calculator_count: root.enabled_calculator_count;

                    export_format_options <=> root.export_format_options;
                    export_analysis_items <=> root.export_analysis_items;
                    export_all_analyses <=> root.export_all_analyses;
                    preset_items: root.preset_items;
                    selected_preset <=> root.selected_preset;

                    browse_file => { root.browse_file(); }
                    reload_file => { root.reload_file(); }
                    rename_element(old_sym, new_sym) => { root.rename_element(old_sym, new_sym); }
                    reset_trajectory_options => { root.reset_trajectory_options(); }
                    reset_material_type => { root.reset_material_type(); }
                    run_analysis => { root.run_analysis(); }
                    cancel_analysis => { root.cancel_analysis(); }

                    reset_bond_cutoffs => { root.reset_bond_cutoffs(); }
                    fix_sanity_issue(action) => { root.fix_sanity_issue(action); }
                    apply_min_factor(factor) => { root.apply_min_factor(factor); }
                    apply_max_factor(factor) => { root.apply_max_factor(factor); }
                    apply_global_cutoff(cutoff) => { root.apply_global_cutoff(cutoff); }
                    apply_scaled_cutoffs(factor) => { root.apply_scaled_cutoffs(factor); }
                    set_uniform_cutoff(max_val) => { root.set_uniform_cutoff(max_val); }
                    reset_rdf_options => { root.reset_rdf_options(); }
                    reset_angle_options => { root.reset_angle_options(); }

                    reset_sq_options => { root.reset_sq_options(); }
                    reset_xrd_options => { root.reset_xrd_options(); }
                    xrd_radiation_preset_changed(idx) => { root.xrd_radiation_preset_changed(idx); }
                    reset_rings_options => { root.reset_rings_options(); }
                    reset_smoothing_options => { root.reset_smoothing_options(); }
                    reset_advanced_options => { root.reset_advanced_options(); }

                    pin_run => { root.pin_run(); }
                    import_comparison_file => { root.import_comparison_file(); }
                    remove_comparison_curve(id) => { root.remove_comparison_curve(id); }
                    toggle_difference_plot(show) => { root.toggle_difference_plot(show); }
                    clear_comparison_curves => { root.clear_comparison_curves(); }
                    reset_export_settings => { root.reset_export_settings(); }

                    toggle_calculator(id, enabled) => { root.toggle_calculator(id, enabled); }
                    toggle_calculator_group(grp, enabled) => { root.toggle_calculator_group(grp, enabled); }
                    toggle_all_calculators(enabled) => { root.toggle_all_calculators(enabled); }
                    set_calculator_group_expanded(grp, exp) => { root.set_calculator_group_expanded(grp, exp); }
                    set_all_calculator_groups_expanded(exp) => { root.set_all_calculator_groups_expanded(exp); }
                    reset_analyses_selection => { root.reset_analyses_selection(); }

                    toggle_export_analysis(id, val) => { root.toggle_export_analysis(id, val); }
                    toggle_all_export_analyses(val) => { root.toggle_all_export_analyses(val); }
                    write_files => { root.write_files(); }
                    export_structure => { root.export_structure(); }
                    reset_export_options => { root.reset_export_options(); }
                    load_preset(idx) => { root.load_preset(idx); }
                    save_preset(name) => { root.save_preset(name); }
                    delete_preset(idx) => { root.delete_preset(idx); }
                    reset_presets => { root.reset_presets(); }
                }

                // Splitter Handle between Column 1 and Column 2
                splitter_handle := SplitterHandle {
                    visible: (root.active_panel >= 0 || self.is_dragging) && root.width >= 500px;
                    moved(delta) => {
                        let current_w = root.active_panel == -1 ? 0px : root.left_col_width;
                        let target_w = current_w + delta;
                        if (target_w < 100px) {
                            if (root.active_panel >= 0) {
                                root.last_active_panel = root.active_panel;
                            }
                            root.active_panel = -1;
                        } else if (target_w < 180px) {
                            if (root.active_panel == -1) {
                                root.active_panel = root.last_active_panel >= 0 ? root.last_active_panel : 0;
                            }
                            root.left_col_width = 180px;
                            root.last_col_width = 180px;
                            root.layout_geometry_changed(root.left_col_width, root.middle_col_width);
                        } else {
                            if (root.active_panel == -1) {
                                root.active_panel = root.last_active_panel >= 0 ? root.last_active_panel : 0;
                            }
                            root.left_col_width = Math.min(450px, target_w);
                            root.last_col_width = root.left_col_width;
                            root.layout_geometry_changed(root.left_col_width, root.middle_col_width);
                        }
                    }
                    reset => {
                        root.left_col_width = 220px;
                        root.last_col_width = 220px;
                        root.layout_geometry_changed(root.left_col_width, root.middle_col_width);
                    }
                }

                // 2. Right column: Visual Preview Card (Column 2)
                preview_card := PreviewCard {
                    horizontal-stretch: 1;
                    vertical-stretch: 1;
                    min-width: 200px;
                    visible: root.active_panel == -1 || root.width >= 500px;
                    active_tab <=> root.preview_active_tab;
                    analysis_done: root.analysis_done;
                    preview_plot <=> root.preview_plot;
                    plot_items <=> root.plot_items;
                    curve_toggle_items: root.curve_toggle_items;
                    selected_plot_index <=> root.selected_plot_index;
                    pinned_runs_count: root.pinned_runs_count;

                    file_loaded: root.file_loaded;
                    analysis_running: root.analysis_running;
                    has_validation_errors: root.has_validation_errors;
                    file_basename: root.file_basename;
                    total_atoms: root.total_atoms;
                    num_frames: root.num_frames;

                    browse_file => { root.browse_file(); }
                    run_analysis => { root.run_analysis(); }
                    cancel_analysis => { root.cancel_analysis(); }
                    open_panel(id) => {
                        root.last_active_panel = id;
                        root.active_panel = id;
                        root.left_col_width = Math.max(180px, root.last_col_width);
                        root.layout_geometry_changed(root.left_col_width, root.middle_col_width);
                    }

                    table_headers: root.table_headers;
                    table_rows: root.table_rows;
                    recent_files: root.recent_files;

                    load_sample(s) => { root.load_sample(s); }
                    load_recent(r) => { root.load_recent_file(r); }

                    plot_selected(idx) => {
                        root.select_plot(idx);
                    }
                    toggle_curve_visibility(id, vis) => {
                        root.toggle_curve_visibility(id, vis);
                    }
                    toggle_all_curves(vis) => {
                        root.toggle_all_curves(vis);
                    }
                    filter_curves(f) => {
                        root.filter_curves(f);
                    }
                    invert_curves => {
                        root.invert_curves();
                    }
                    set_curve_color(id, col) => {
                        root.set_curve_color(id, col);
                    }
                    write_files => {
                        root.write_files();
                    }
                    export_plot => {
                        root.save_plot();
                    }
                    copy_plot_clipboard => {
                        root.copy_plot_clipboard();
                        ToastState.show("Plot SVG copied to clipboard", 1);
                    }
                    pin_run => {
                        root.pin_run();
                    }
                    clear_pinned_runs => {
                        root.clear_pinned_runs();
                    }
                    mouse_move(mx, my, hover, w, h) => {
                        root.mouse_move(mx, my, hover, w, h);
                    }
                    plot_resized(w, h) => {
                        root.plot_resized(w, h);
                    }
                    hover_coord_text: root.hover_coord_text;
                    has_active_zoom: root.has_active_zoom;
                    markers_count: root.markers_count;
                    zoom_to_rect(x1, y1, x2, y2) => {
                        root.zoom_to_rect(x1, y1, x2, y2);
                    }
                    plot_pan(dx, dy) => {
                        root.plot_pan(dx, dy);
                    }
                    plot_wheel_zoom(mx, my, delta) => {
                        root.plot_wheel_zoom(mx, my, delta);
                    }
                    reset_zoom => {
                        root.reset_zoom();
                    }
                    add_marker_at(x, y, is_vert) => {
                        root.add_marker_at(x, y, is_vert);
                    }
                    add_marker(is_vert) => {
                        root.add_marker(is_vert);
                    }
                    clear_markers => {
                        root.clear_markers();
                    }

                    tag_peak_at(x, y) => { root.tag_peak_at(x, y); }
                    tag_peak_range(x1, x2) => { root.tag_peak_range(x1, x2); }

                    calibration_pairs: root.calibration_pairs;
                    active_calibration_pair_index <=> root.active_calibration_pair_index;
                    select_calibration_pair(idx) => { root.select_calibration_pair(idx); }
                    auto_detect_cutoff(idx) => { root.auto_detect_cutoff(idx); }
                    reset_calibration_pair(idx) => { root.reset_calibration_pair(idx); }
                    drag_cutoff_handle(idx, is_max, mx) => { root.drag_cutoff_handle(idx, is_max, mx); }

                    structure_3d_image: root.structure_3d_image;
                    structure_3d_current_frame <=> root.structure_3d_current_frame;
                    structure_3d_total_frames: root.structure_3d_total_frames;
                    structure_3d_bonds_enabled: root.structure_3d_bonds_enabled;
                    structure_3d_wireframe_enabled: root.structure_3d_wireframe_enabled;
                    structure_3d_in_cell: root.structure_3d_in_cell;
                    structure_3d_isometric: root.structure_3d_isometric;
                    structure_3d_camera_animating: root.structure_3d_camera_animating;
                    structure_3d_element_legend: root.structure_3d_element_legend;
                    structure_3d_has_hidden_elements: root.structure_3d_has_hidden_elements;
                    structure_3d_is_playing <=> root.structure_3d_is_playing;
                    structure_3d_backend_label: root.structure_3d_backend_label;
                    structure_3d_gpu_accelerated: root.structure_3d_gpu_accelerated;
                    structure_3d_camera_hud: root.structure_3d_camera_hud;
                    structure_3d_inspected_atom: root.structure_3d_inspected_atom;
                    structure_3d_radial_brush_text: root.structure_3d_radial_brush_text;
                    structure_3d_measurement_text: root.structure_3d_measurement_text;
                    shift_key_held: root.shift_key_held;
                    pick_atom_3d(nx, ny) => { root.pick_atom_3d(nx, ny); }
                    clear_picked_atom_3d => { root.clear_picked_atom_3d(); }
                    measure_atom_3d(nx, ny) => { root.measure_atom_3d(nx, ny); }
                    clear_measurement_3d => { root.clear_measurement_3d(); }
                    focus_picked_atom_3d => { root.focus_picked_atom_3d(); }
                    tick_camera_animation_3d => { root.tick_camera_animation_3d(); }
                    toggle_element_visibility_3d(sym) => { root.toggle_element_visibility_3d(sym); }
                    show_all_elements_3d => { root.show_all_elements_3d(); }
                    export_snapshot_3d => { root.export_snapshot_3d(root.structure_3d_snapshot_scale, root.structure_3d_snapshot_bg); }

                    rotate_3d(dx, dy) => { root.rotate_3d(dx, dy); }
                    pan_3d(dx, dy) => { root.pan_3d(dx, dy); }
                    zoom_3d(delta) => { root.zoom_3d(delta); }
                    reset_view_3d => { root.reset_view_3d(); }
                    set_camera_preset_3d(p) => { root.set_camera_preset_3d(p); }
                    toggle_bonds_3d(enabled) => { root.toggle_bonds_3d(enabled); }
                    toggle_wireframe_3d(enabled) => { root.toggle_wireframe_3d(enabled); }
                    toggle_in_cell_3d(enabled) => {
                        root.structure_3d_in_cell = enabled;
                        root.toggle_in_cell_3d(enabled);
                    }
                    toggle_projection_3d(enabled) => {
                        root.structure_3d_isometric = enabled;
                        root.toggle_projection_3d(enabled);
                    }
                    seek_frame_3d(idx) => { root.seek_frame_3d(idx); }
                    step_frame_3d(fwd) => { root.step_frame_3d(fwd); }
                    viewport_3d_resized(w, h) => { root.viewport_3d_resized(w, h); }
                    tab_changed(tab) => {
                        root.preview_tab_changed(tab);
                        if (root.active_right_panel >= 0) {
                            if (tab == 0) { root.active_right_panel = 0; }
                            else if (tab == 1) { root.active_right_panel = 1; }
                        }
                    }
                    dual_split_ratio <=> root.preview_dual_split_ratio;
                    dual_left_view <=> root.preview_dual_left_view;
                    select_dual_left_plot(idx) => { root.select_dual_left_plot(idx); }
                    inspector_scope: root.active_right_panel == 1 ? 1 : 0;
                    structure_3d_phase_panel_open: root.active_right_panel == 1;
                    toggle_phase_panel_3d => {
                        let next = !root.structure_3d_phase_enabled;
                        root.toggle_phase_search_3d(next);
                        if (next) {
                            root.active_right_panel = 1;
                            root.last_active_right_panel = 1;
                            right_side_panel_host.structure_active_tab = 0;
                        }
                    }
                    toggle_plot_settings => {
                        if (root.active_right_panel == 0) {
                            root.active_right_panel = -1;
                        } else {
                            root.active_right_panel = 0;
                            root.right_col_width = Math.max(200px, root.last_right_col_width);
                        }
                    }

                    structure_3d_phase_enabled: root.structure_3d_phase_enabled;
                    structure_3d_phase_computing: root.structure_3d_phase_computing;
                    structure_3d_phase_prebake_progress: root.structure_3d_phase_prebake_progress;
                    structure_3d_phase_cached_frames: root.structure_3d_phase_cached_frames;
                    structure_3d_phase_preset: root.structure_3d_phase_preset;
                    structure_3d_phase_descriptor: root.structure_3d_phase_descriptor;
                    structure_3d_phase_colormap: root.structure_3d_phase_colormap;
                    structure_3d_phase_min_threshold: root.structure_3d_phase_min_threshold;
                    structure_3d_phase_max_threshold: root.structure_3d_phase_max_threshold;
                    structure_3d_phase_domain_min: root.structure_3d_phase_domain_min;
                    structure_3d_phase_domain_max: root.structure_3d_phase_domain_max;
                    structure_3d_phase_halo_intensity: root.structure_3d_phase_halo_intensity;
                    structure_3d_phase_halo_radius_ratio: root.structure_3d_phase_halo_radius_ratio;
                    structure_3d_atom_scale: root.structure_3d_atom_scale;
                    structure_3d_phase_dim_non_matching: root.structure_3d_phase_dim_non_matching;
                    structure_3d_phase_hide_non_matching: root.structure_3d_phase_hide_non_matching;
                    structure_3d_phase_histogram_counts: root.structure_3d_phase_histogram_counts;
                    structure_3d_phase_matching_atoms: root.structure_3d_phase_matching_atoms;
                    structure_3d_phase_total_atoms: root.structure_3d_phase_total_atoms;
                    structure_3d_phase_descriptor_name: root.structure_3d_phase_descriptor_name;
                    structure_3d_phase_colorbar_image: root.structure_3d_phase_colorbar_image;

                    structure_3d_phase_is_2d_mode: root.structure_3d_phase_is_2d_mode;
                    structure_3d_phase_descriptor_y: root.structure_3d_phase_descriptor_y;
                    structure_3d_phase_min_threshold_y: root.structure_3d_phase_min_threshold_y;
                    structure_3d_phase_max_threshold_y: root.structure_3d_phase_max_threshold_y;
                    structure_3d_phase_domain_min_y: root.structure_3d_phase_domain_min_y;
                    structure_3d_phase_domain_max_y: root.structure_3d_phase_domain_max_y;
                    structure_3d_phase_descriptor_name_y: root.structure_3d_phase_descriptor_name_y;
                    structure_3d_phase_heatmap_image: root.structure_3d_phase_heatmap_image;
                    structure_3d_phase_crystal_markers: root.structure_3d_phase_crystal_markers;

                    structure_3d_dist_hud_visible: root.structure_3d_dist_hud_visible;
                    structure_3d_dist_has_data: root.structure_3d_dist_has_data;
                    structure_3d_dist_image: root.structure_3d_dist_image;
                    structure_3d_dist_metric: root.structure_3d_dist_metric;
                    structure_3d_dist_peak_text: root.structure_3d_dist_peak_text;
                    set_structure_3d_dist_metric(m) => { root.set_structure_3d_dist_metric(m); }
                    toggle_structure_3d_dist_hud(v) => { root.toggle_structure_3d_dist_hud(v); }

                    // Phase Search callbacks
                    toggle_phase_search_3d(en) => { root.toggle_phase_search_3d(en); }
                    set_phase_preset_3d(idx) => { root.set_phase_preset_3d(idx); }
                    set_phase_descriptor_3d(idx) => { root.set_phase_descriptor_3d(idx); }
                    set_phase_colormap_3d(idx) => { root.set_phase_colormap_3d(idx); }
                    set_phase_thresholds_3d(min, max) => { root.set_phase_thresholds_3d(min, max); }
                    set_phase_intensity_3d(val) => { root.set_phase_intensity_3d(val); }
                    set_phase_radius_ratio_3d(val) => { root.set_phase_radius_ratio_3d(val); }
                    set_atom_scale_3d(val) => { root.set_atom_scale_3d(val); }
                    set_phase_dim_non_matching_3d(dim) => { root.set_phase_dim_non_matching_3d(dim); }
                    set_phase_hide_non_matching_3d(hide) => { root.set_phase_hide_non_matching_3d(hide); }
                    set_phase_2d_mode_3d(is_2d) => { root.set_phase_2d_mode_3d(is_2d); }
                    set_phase_descriptor_y_3d(idx) => { root.set_phase_descriptor_y_3d(idx); }
                    set_phase_thresholds_2d_3d(x0, x1, y0, y1) => { root.set_phase_thresholds_2d_3d(x0, x1, y0, y1); }
                    export_phase_heatmap_png_3d => { root.export_phase_heatmap_png_3d(); }
                }

                // 3. Splitter Handle between Preview Workspace and Right Inspector
                right_splitter_handle := SplitterHandle {
                    visible: (root.active_right_panel >= 0 || self.is_dragging) && root.width >= 700px;
                    moved(delta) => {
                        let current_w = root.active_right_panel == -1 ? 0px : root.right_col_width;
                        let target_w = current_w - delta;
                        if (target_w < 120px) {
                            if (root.active_right_panel >= 0) {
                                root.last_active_right_panel = root.active_right_panel;
                            }
                            root.active_right_panel = -1;
                        } else if (target_w < 200px) {
                            if (root.active_right_panel == -1) {
                                root.active_right_panel = root.last_active_right_panel >= 0 ? root.last_active_right_panel : 0;
                            }
                            root.right_col_width = 200px;
                            root.last_right_col_width = 200px;
                        } else {
                            if (root.active_right_panel == -1) {
                                root.active_right_panel = root.last_active_right_panel >= 0 ? root.last_active_right_panel : 0;
                            }
                            root.right_col_width = Math.min(520px, target_w);
                            root.last_right_col_width = root.right_col_width;
                        }
                    }
                    reset => {
                        root.right_col_width = 320px;
                        root.last_right_col_width = 320px;
                    }
                }

                // 4. Single Active Right Panel Column (Column 3)
                right_side_panel_host := RightSidePanelHost {
                    width: root.active_right_panel == -1 ? 0px : root.right_col_width;
                    visible: root.active_right_panel >= 0;
                    horizontal-stretch: 0;

                    active_panel <=> root.active_right_panel;
                    last_active_panel <=> root.last_active_right_panel;
                    physics_diagnostics: root.physics_diagnostics;
                    select_panel(id) => {
                        if (id >= 0) {
                            root.last_active_right_panel = id;
                            root.active_right_panel = id;
                            root.right_col_width = Math.max(200px, root.last_right_col_width);
                        } else {
                            if (root.active_right_panel >= 0) {
                                root.last_active_right_panel = root.active_right_panel;
                            }
                            root.active_right_panel = -1;
                        }
                    }

                    // 2D Plot Inspector properties & callbacks
                    curve_toggle_items: root.curve_toggle_items;
                    axis_settings <=> root.axis_settings;
                    export_config <=> root.export_config;
                    active_color_picker_id <=> root.active_color_picker_id;
                    tagged_peaks: root.tagged_peaks;

                    filter_curves(f) => { root.filter_curves(f); }
                    invert_curves => { root.invert_curves(); }
                    toggle_curve_visibility(id, vis) => { root.toggle_curve_visibility(id, vis); }
                    toggle_all_curves(vis) => { root.toggle_all_curves(vis); }
                    set_curve_color(id, col) => { root.set_curve_color(id, col); }
                    set_curve_width(w) => { root.set_curve_width(w); }
                    apply_axis_settings => { root.apply_axis_settings(); }
                    reset_axis_settings => { root.reset_axis_settings(); }
                    reset_export_settings => { root.reset_export_settings(); }
                    remove_tagged_peak(id) => { root.remove_tagged_peak(id); }
                    clear_tagged_peaks => { root.clear_tagged_peaks(); }
                    export_tagged_peaks => { root.export_tagged_peaks(); }

                    // Structure 3D Inspector properties & callbacks
                    phase_enabled: root.structure_3d_phase_enabled;
                    preset_index: root.structure_3d_phase_preset;
                    descriptor_index: root.structure_3d_phase_descriptor;
                    colormap_index: root.structure_3d_phase_colormap;
                    min_threshold: root.structure_3d_phase_min_threshold;
                    max_threshold: root.structure_3d_phase_max_threshold;
                    domain_min: root.structure_3d_phase_domain_min;
                    domain_max: root.structure_3d_phase_domain_max;
                    halo_intensity: root.structure_3d_phase_halo_intensity;
                    halo_radius_ratio: root.structure_3d_phase_halo_radius_ratio;
                    atom_scale: root.structure_3d_atom_scale;
                    dim_non_matching: root.structure_3d_phase_dim_non_matching;
                    hide_non_matching: root.structure_3d_phase_hide_non_matching;
                    histogram_counts: root.structure_3d_phase_histogram_counts;
                    matching_atoms: root.structure_3d_phase_matching_atoms;
                    total_atoms: root.structure_3d_phase_total_atoms;
                    colorbar_image: root.structure_3d_phase_colorbar_image;
                    descriptor_name: root.structure_3d_phase_descriptor_name;

                    is_2d_mode: root.structure_3d_phase_is_2d_mode;
                    descriptor_y_index: root.structure_3d_phase_descriptor_y;
                    min_threshold_y: root.structure_3d_phase_min_threshold_y;
                    max_threshold_y: root.structure_3d_phase_max_threshold_y;
                    domain_min_y: root.structure_3d_phase_domain_min_y;
                    domain_max_y: root.structure_3d_phase_domain_max_y;
                    descriptor_name_y: root.structure_3d_phase_descriptor_name_y;
                    heatmap_image: root.structure_3d_phase_heatmap_image;
                    crystal_markers: root.structure_3d_phase_crystal_markers;

                    bonds_enabled: root.structure_3d_bonds_enabled;
                    wireframe_enabled: root.structure_3d_wireframe_enabled;
                    in_cell_enabled: root.structure_3d_in_cell;
                    is_isometric: root.structure_3d_isometric;
                    depth_cueing_enabled: root.structure_3d_depth_cueing;
                    ssao_enabled: root.structure_3d_ssao_enabled;
                    supercell_x: root.structure_3d_supercell_x;
                    supercell_y: root.structure_3d_supercell_y;
                    supercell_z: root.structure_3d_supercell_z;
                    total_frames: root.structure_3d_total_frames;
                    element_legend: root.structure_3d_element_legend;
                    has_hidden_elements: root.structure_3d_has_hidden_elements;
                    snapshot_scale <=> root.structure_3d_snapshot_scale;
                    snapshot_bg <=> root.structure_3d_snapshot_bg;
                    dist_hud_visible: root.structure_3d_dist_hud_visible;
                    slab_clip: root.structure_3d_slab_clip;

                    toggle_phase_enabled(en) => { root.toggle_phase_search_3d(en); }
                    set_preset(idx) => { root.set_phase_preset_3d(idx); }
                    set_descriptor(idx) => { root.set_phase_descriptor_3d(idx); }
                    set_colormap(idx) => { root.set_phase_colormap_3d(idx); }
                    set_thresholds(min, max) => { root.set_phase_thresholds_3d(min, max); }
                    set_intensity(val) => { root.set_phase_intensity_3d(val); }
                    set_radius_ratio(val) => { root.set_phase_radius_ratio_3d(val); }
                    set_atom_scale(val) => { root.set_atom_scale_3d(val); }
                    set_dim_non_matching(dim) => { root.set_phase_dim_non_matching_3d(dim); }
                    set_hide_non_matching(hide) => { root.set_phase_hide_non_matching_3d(hide); }
                    set_2d_mode(is_2d) => { root.set_phase_2d_mode_3d(is_2d); }
                    set_descriptor_y(idx) => { root.set_phase_descriptor_y_3d(idx); }
                    set_thresholds_2d(min_x, max_x, min_y, max_y) => { root.set_phase_thresholds_2d_3d(min_x, max_x, min_y, max_y); }
                    export_heatmap_png => { root.export_phase_heatmap_png_3d(); }
                    reset_view => { root.reset_view_3d(); }
                    toggle_bonds(en) => { root.toggle_bonds_3d(en); }
                    toggle_wireframe(en) => { root.toggle_wireframe_3d(en); }
                    toggle_in_cell(en) => { root.toggle_in_cell_3d(en); }
                    toggle_projection(en) => { root.toggle_projection_3d(en); }
                    toggle_depth_cueing(en) => { root.toggle_depth_cueing_3d(en); }
                    toggle_ssao(en) => { root.toggle_ssao_3d(en); }
                    set_visual_supercell(nx, ny, nz) => { root.set_visual_supercell_3d(nx, ny, nz); }
                    reset_visual_supercell => { root.reset_visual_supercell_3d(); }
                    export_trajectory_animation(as_gif, bg) => { root.export_trajectory_animation_3d(as_gif, bg); }
                    toggle_element_visibility(sym) => { root.toggle_element_visibility_3d(sym); }
                    show_all_elements => { root.show_all_elements_3d(); }
                    export_snapshot(sc, bg) => { root.export_snapshot_3d(sc, bg); }
                    toggle_dist_hud(v) => { root.toggle_structure_3d_dist_hud(v); }
                    set_slab_clip(clip) => { root.set_slab_clip_3d(clip); }
                    reset_slab_clip => { root.reset_slab_clip_3d(); }
                }

                // 5. Far-Right Activity Bar (RightMiniSideBar) - Fixed 48px
                right_mini_sidebar := RightMiniSideBar {
                    active_panel <=> root.active_right_panel;
                    select_panel(id) => {
                        if (id >= 0) {
                            root.last_active_right_panel = id;
                            root.active_right_panel = id;
                            root.right_col_width = Math.max(200px, root.last_right_col_width);
                        } else {
                            if (root.active_right_panel >= 0) {
                                root.last_active_right_panel = root.active_right_panel;
                            }
                            root.active_right_panel = -1;
                        }
                    }
                    toggle_collapse => {
                        if (root.active_right_panel >= 0) {
                            root.last_active_right_panel = root.active_right_panel;
                            root.active_right_panel = -1;
                        } else {
                            root.active_right_panel = root.last_active_right_panel >= 0 ? root.last_active_right_panel : 0;
                            root.right_col_width = Math.max(200px, root.last_right_col_width);
                        }
                    }
                }
            }

            AppFooter {
                status_text: root.analysis_running ? root.analysis_status_text :
                    root.analysis_done ? "Analysis complete — results ready" :
                    root.file_loaded ? root.file_status_text : "Ready";
                progress: root.progress;
                analysis_running: root.analysis_running;
                update_available: root.update_available;
                update_version: root.update_version;
                update_url: root.update_url;
                backend_label: root.structure_3d_backend_label;
                gpu_accelerated: root.structure_3d_gpu_accelerated;
                open_url(url) => {
                    root.open_url(url);
                }
                open_command_palette => {
                    root.shortcuts_modal_open = false;
                    root.command_palette_open = true;
                }
                open_shortcuts => {
                    root.command_palette_open = false;
                    root.shortcuts_modal_open = true;
                }
            }
        }
    }

    clipboard_transfer := TextInput {
        x: -2000px;
        y: -2000px;
        width: 0px;
        height: 0px;
        text <=> root.clipboard_payload;
    }

    // Non-blocking M3 Toast / Snackbar overlay (bottom-right above AppFooter)
    ToastBanner {
        x: parent.width - self.width - 16px;
        y: parent.height - self.height - 34px;
    }

    // Keyboard Shortcuts Cheat-Sheet Modal (? / F1)
    ShortcutsModal {
        show: root.shortcuts_modal_open;
        closed => {
            root.shortcuts_modal_open = false;
            main_focus.focus();
        }
    }

    // Command Palette Modal (Ctrl+K)
    CommandPalette {
        show: root.command_palette_open;
        items: root.command_items;
        filter_changed(q) => { root.filter_commands(q); }
        execute(id) => { root.execute_command(id); }
        closed => {
            root.command_palette_open = false;
            main_focus.focus();
        }
    }

    ToolTip {
        hovered_x: TooltipState.active.text != "" ? TooltipState.active.x : root.hovered_x;
        hovered_y: TooltipState.active.text != "" ? TooltipState.active.y : root.hovered_y;
        hovered_width: TooltipState.active.text != "" ? TooltipState.active.width : root.hovered_width;
        hovered_height: TooltipState.active.text != "" ? TooltipState.active.height : root.hovered_height;
        parent_width: root.width;
        parent_height: root.height;
        visible: TooltipState.active.text != "" || root.hovered_tooltip_text != "";
        text: TooltipState.active.text != "" ? TooltipState.active.text : root.hovered_tooltip_text;
    }
}
