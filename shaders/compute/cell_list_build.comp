#version 450
layout(local_size_x = 256) in;

// Pass 1a: Build 3D uniform spatial cell linked-list (O(N), race-free atomicExchange)
layout(std430, set = 0, binding = 0) readonly buffer AtomPositions {
    vec4 in_positions[]; // xyz = position (Angstroms), w = element_id
};

layout(std430, set = 0, binding = 1) buffer CellHead {
    uint cell_head[]; // Pre-cleared to 0xFFFFFFFFu via vkCmdFillBuffer
};

layout(std430, set = 0, binding = 2) writeonly buffer AtomNext {
    uint atom_next[];
};

layout(push_constant) uniform CellBuildParams {
    vec4 box_min;
    vec4 box_max;
    ivec4 grid_dims; // xyz = grid dimensions (>= 1), w = periodic flag (1 = periodic, 0 = non-periodic)
    uint num_atoms;
    uint pad0;
    uint pad1;
    uint pad2;
} pc;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= pc.num_atoms) return;

    vec3 pos = in_positions[idx].xyz;
    vec3 box_size = pc.box_max.xyz - pc.box_min.xyz;
    ivec3 g = max(pc.grid_dims.xyz, ivec3(1));
    ivec3 cell = ivec3(0);

    if (box_size.x > 0.0 && box_size.y > 0.0 && box_size.z > 0.0) {
        vec3 frac = (pos - pc.box_min.xyz) / box_size;
        if (pc.grid_dims.w != 0) {
            frac = frac - floor(frac);
        }
        cell = clamp(ivec3(floor(frac * vec3(g))), ivec3(0), g - ivec3(1));
    }

    uint cell_id = uint((cell.z * g.y + cell.y) * g.x + cell.x);
    uint prev = atomicExchange(cell_head[cell_id], idx);
    atom_next[idx] = prev;
}
