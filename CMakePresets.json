{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "dev",
      "displayName": "Development (Single Precision, GUI, Tests)",
      "description": "Default development build with single-precision float, Slint GUI, and tests enabled in build/",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "USE_SINGLE_PRECISION": "ON",
        "BUILD_GUI": "ON",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "dev-single",
      "displayName": "Development (Single Precision, GUI, Tests) [Alias]",
      "description": "Backward-compatible alias for dev preset",
      "inherits": "dev"
    },
    {
      "name": "release",
      "displayName": "Release Packaging Build (No Tests)",
      "description": "Fully optimized release build with Slint GUI and packaging enabled, tests disabled in build-release/",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "USE_SINGLE_PRECISION": "ON",
        "BUILD_GUI": "ON",
        "BUILD_TESTING": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "configurePreset": "dev"
    },
    {
      "name": "dev-single",
      "configurePreset": "dev-single"
    },
    {
      "name": "release",
      "configurePreset": "release"
    }
  ],
  "testPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "jobs": 4
      }
    },
    {
      "name": "dev-single",
      "configurePreset": "dev-single",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "jobs": 4
      }
    }
  ]
}
