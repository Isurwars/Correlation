{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "dev-single",
      "displayName": "Development (Single Precision, GUI, Release)",
      "description": "Default fast development build with float precision and Slint GUI enabled",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "USE_SINGLE_PRECISION": "ON",
        "BUILD_GUI": "ON"
      }
    },
    {
      "name": "dev-double",
      "displayName": "Development (Double Precision, GUI, Release)",
      "description": "High-precision validation build with double precision and Slint GUI enabled",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build-double",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "USE_SINGLE_PRECISION": "OFF",
        "BUILD_GUI": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Release Packaging Build (No Tests)",
      "description": "Fully optimized release build with GUI and packaging targets, testing disabled",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "USE_SINGLE_PRECISION": "ON",
        "BUILD_GUI": "ON",
        "BUILD_TESTING": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev-single",
      "configurePreset": "dev-single"
    },
    {
      "name": "dev-double",
      "configurePreset": "dev-double"
    },
    {
      "name": "release",
      "configurePreset": "release"
    }
  ],
  "testPresets": [
    {
      "name": "dev-single",
      "configurePreset": "dev-single",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "jobs": 4
      }
    },
    {
      "name": "dev-double",
      "configurePreset": "dev-double",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "jobs": 4
      }
    }
  ]
}
